#!/usr/bin/env bash
# 本地层（秒级）门禁：暂存区 ADR 格式门。
# 由 `ponygo init` 生成（不存在时）或**非破坏性追加**哨兵块（已存在未接线时可执行时）；
# 本仓自用 = dogfood。允许 `git commit --no-verify` 绕过，但 CI 层（A4/A5）兜底。
#
# marker（2.4 机器识别用，与哨兵同文）：下一行
# ponygo-gate: adr-verify v1
#
# >>> ponygo-gate: adr-verify v1 >>>
if [ -f "$(git rev-parse --show-toplevel)/.meta/gates/adr-verify.sh" ]; then
  bash "$(git rev-parse --show-toplevel)/.meta/gates/adr-verify.sh" || exit 1
fi
# <<< ponygo-gate: adr-verify v1 <<<

# L1 追加：backlog 账本门（lint + doctor 对账，统一实现见 .meta/gates/backlog-gate.sh）。
# 放在 ponygo-gate 哨兵块之外——判据 2.4 要求 BEGIN..END 段逐字节等于规范块，块内新增会被 init 抹掉。
# 迁移期语义：账本未启用（无 tasks.jsonl）→ 门自身提示跳过；账本存在但非法 / 有孤儿租约 → 拒绝。
if [ -f "$(git rev-parse --show-toplevel)/.meta/gates/backlog-gate.sh" ]; then
  bash "$(git rev-parse --show-toplevel)/.meta/gates/backlog-gate.sh" || exit 1
else
  echo "[pre-commit] 拒绝：.meta/gates/backlog-gate.sh 不存在（门禁缺失即 fail-closed；确需绕过用 --no-verify 并说明理由）" >&2
  exit 1
fi

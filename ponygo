#!/usr/bin/env bash
# ============================================================
# ponygo —— 项目工程化治理元框架的命令行入口（单文件、零依赖 shell）
#
# 用法：
#   ponygo init     [--yes] [--dry-run]   在项目根建立/注入 .agents/ + .meta/ 治理骨架
#   ponygo audit    [--level S|M] [--run-specs] [--dry-run]  自适应体检：打分 + 缺口 + 最小改进动作（有治理根时内嵌级自洽验证，判据不符 exit 1）
#   ponygo status                         查看成熟度级与骨架完整度（骨架缺口或声明级判据不符 exit 1）
#   ponygo upgrade                        跟随框架升级指引（首版不实际合并，见 -h）
#   ponygo sync                           把 constitution 投影到根 AGENTS.md / CLAUDE.md（模板态投影初始引导）
#
# 设计约束：判定优先只读；破坏性动作前必须确认（或 --yes）。
#           只读命令（status/audit）不执行仓库脚本——执行需显式 opt-in（audit --run-specs）。
#           非零退出（non-zero exit）语义：凡机器可查的缺口，命令 exit 1。
# 平台边界：Windows Git Bash / GNU 用户态（find -printf、sed -i、date -d 按 GNU 语义）。
# ============================================================
set -u

# ---------- 常量（与骨架 v2、README、maturity-ladder.md 对齐） ----------
# 分家原则（见 .agents/notes/implemented/architecture/2026-08-31-agents-runtime-vs-meta-truth.md）：
#   .agents/ = AI agent 运行时读写的资产（notes 决策记录、skills 流程技能）——须在工具发现路径上
#   .meta/   = 治理的机器态与真源（meta.yaml / constitution / gates / docs-tier）——经投影或钩子消费
META_DIR=".meta"
AGENTS_RUNTIME_DIR=".agents"
META_YAML="$META_DIR/meta.yaml"
DECISIONS_DIR="$AGENTS_RUNTIME_DIR/notes"
SKILLS_DIR="$AGENTS_RUNTIME_DIR/skills"
CONSTITUTION="$META_DIR/constitution/constitution.md"

# decisions lifecycle 四态 + class 封闭集合（唯一真源，供 audit 与 status 复用）
LIFECYCLES="proposed implemented rejected archived"
CLASSES="feature bug-fix simplification architecture process testing"

# 成熟的阶梯六级（v2.0：文档治理前置——L1 文档有家判据、L2 文档分层激活；L3-L5 为"靠 review"的目标画像）
# 原 L3[文档分层] 并入 L2，原 L4-L6 顺延为 L3-L5（见 revisions/accepted/2026-09-02-doc-governance-frontloaded-to-l0-l1.md）
LEVELS="L0[播种] L1[决策入册+文档有家] L2[承诺可验+文档分层] L3[流程资产] L4[负空间] L5[领域定制]"

# ---------- observe 映射数据块（数据，非代码） ----------
# 口径（方案 v2 §3）：数据块只承载「名称/顺序/目标映射/路径枚举」，**不承载判定逻辑**。
#   * 整段置于**永不调用**的函数体内：bash 只解析函数体、调用才执行，故数据行零副作用；
#   * BEGIN/END 之间每行严格 `key: value` 平铺——禁止 flow-map {}/缩进嵌套/行内注释；
#   * 键名与查询名逐字一致（A2 漂移教训：target_level_<n> 对应 --level 目标映射的 L<n>）；
#   * 消费方 = observe_map_get；必需键与 mapping_version 的 fail-closed 校验属 Executor task-3。
observe_mapping_data() {
# ==== OBSERVE MAPPING BEGIN (data, not code) ====
mapping_version: 1
ob_levels: ob0 ob1 ob2
ob_level0_name: 归属声明
ob_level1_name: 声明与现实一致
ob_level2_name: 收口与变更门禁
ob_advisory_name: ob3 成本与 SLO（目标画像，不参与判定）
target_level_0: ob0
target_level_1: ob0
target_level_2: ob1
target_level_3: ob2
target_level_4: ob2
target_level_5: ob2
kind_enum: desktop k8s-service cli batch library frontend pipeline
contract_version_min: 1.0.3
declaration_paths: docs/observability.yaml docs/observability.yml
declaration_extra_dir: docs/observability.d
placeholder_token: __REPLACE_ME__
mount_carriers: .git/hooks/pre-commit .githooks/pre-commit .githooks/pre-push .pre-commit-config.yaml lefthook.yml .github/workflows .gitlab-ci.yml
skill_dir_rel: .agents/skills/observability-onboarding
external_timeout_seconds: 120
local_timeout_seconds: 3
diff_timeout_seconds: 60
# ==== OBSERVE MAPPING END ====
:
}

# ---------- 工具函数 ----------
die() { printf 'ponygo: %s\n' "$*" >&2; exit 1; }
info() { printf 'ponygo: %s\n' "$*"; }
warn() { printf 'ponygo: %s\n' "$*" >&2; }

# 是否已有治理根
has_meta() { [ -d "$META_DIR" ]; }

# 决策文件计数——排除集 {README.md, AGENTS.md, *.zh.md} 的唯一真源（audit / status / verify_ladder 共用）
count_decisions() {
  find "$DECISIONS_DIR" -type f -name '*.md' ! -name 'README.md' ! -name 'AGENTS.md' ! -name '*.zh.md' 2>/dev/null | wc -l | tr -d ' '
}

# 实例扩展 class（L5 领域定制的开放口）：notes/classes.local 每行一个额外 class 名
# （小写字母/数字/连字符；# 起注释与空行忽略）。封闭集本身不放开，扩展必须显式落盘成文件——
# 扩展是一次治理决策，留有可审计的载体，而非随手 mkdir。
extra_classes() {
  [ -f "$DECISIONS_DIR/classes.local" ] || return 0
  sed 's/\r$//' "$DECISIONS_DIR/classes.local" | grep -vE '^[[:space:]]*(#|$)' | grep -E '^[a-z0-9][a-z0-9-]*$'
}

# 读取当前成熟度级（缺 yaml 或缺 level 行视为 L0；把 "L2" 形式防御性归一为 2）
# 注意：level 行存在但值为空/畸形时**不默认归 0**——返回空串交由 verify_ladder 0.4 判 FAIL，
# 否则 "level: "（空值）会被宽放成假 L0 PASS（判据宽于 maturity-ladder 真源）。
read_level() {
  if [ -f "$META_YAML" ]; then
    if grep -q '^level:' "$META_YAML"; then
      local lv
      lv=$(sed -n 's/^level:[[:space:]]*//p' "$META_YAML" | head -n1 | tr -d '[:space:]"L')
      printf '%s' "$lv"
    else
      echo "0"
    fi
  else
    echo "0"
  fi
}

# 把 level 缓冲成 "L<n>" 显示（内部传整数；空/畸形值显式显示为非法，不伪装成 L0）
fmt_level() { case "$1" in ''|*[!0-9]*) printf 'L<非法:%s>' "${1:-空}" ;; *) printf 'L%s' "$1" ;; esac; }

# 是否空项目（无代码迹象：无常见 manifest / 无源码目录 / 无 .git 之外的文件）
looks_empty() {
  [ -d "$META_DIR" ] && return 1
  # 有任一常见 manifest 或源码树即视为"有代码"（比 depth-selector 的多栈计数更宽——
  # 这里只需判"有没有代码"，depth-selector 才判"有几种栈"）
  for f in package.json Cargo.toml go.mod pyproject.toml setup.py pom.xml build.gradle *.csproj; do
    [ -e "$f" ] && return 1
  done
  for d in src lib app packages crates; do
    [ -d "$d" ] && return 1
  done
  return 0
}

confirm_or_skip() {
  # 除非 --yes，否则打印即将执行并等确认；--dry-run 只打印
  if [ "${DRY_RUN:-0}" = "1" ]; then
    info "[dry-run] $*"
    return 1
  fi
  if [ "${YES:-0}" != "1" ]; then
    printf 'ponygo: 即将执行：%s\nponygo: 回车继续 / 输入 n 取消：' "$*"
    read -r ans || ans=n
    case "$ans" in
      ""|[Yy]|[Yy][Ee][Ss]) return 0 ;;
      *) info "已取消"; return 1 ;;
    esac
  fi
  return 0
}

# ---------- 骨架铺设（init 复用） ----------
write_skeleton() {
  local lvl="${1:-0}"
  mkdir -p "$DECISIONS_DIR"/{proposed,implemented,rejected,archived}
  mkdir -p "$META_DIR"/{constitution,gates,docs-tier}
  mkdir -p "$SKILLS_DIR"

  # 归档搜索隔离（DSH 实证：防陈旧事实按词法命中挤掉当前结果）；已有 .rgignore 则追加不覆盖
  if [ -f .rgignore ]; then
    grep -qF '/.agents/notes/archived/' .rgignore 2>/dev/null || printf '/.agents/notes/archived/\n' >> .rgignore
  else
    printf '/.agents/notes/archived/\n' > .rgignore
  fi

  # 最小 .gitignore（栈无关；构建产物按栈自行补充；已存在则不覆盖）
  if [ ! -f .gitignore ]; then
    printf '# ponygo 最小 .gitignore（栈无关）\n# OS/编辑器噪声：\n.DS_Store\nThumbs.db\n*~\n# 构建产物/依赖目录按栈补充，例如：\n# target/         # Rust\n# node_modules/   # Node\n# __pycache__/    # Python\n' > .gitignore
  fi

  # notes/README.md：缺失时生成与模板仓库 eol 归一后逐字节一致的全量版（内容源收敛为本 heredoc 常量）
  if [ ! -f "$DECISIONS_DIR/README.md" ]; then
    cat > "$DECISIONS_DIR/README.md" <<'PONYGO_EOF'
# notes/ —— 决策记录（ADR / Agent Note）

这是治理根的**记忆**：任何"为什么这样 / 为什么不那样"的决定，都落到这里，
而不是散落在人脑、聊天记录或 PR（拉取请求）线程里。

## 路径规范

```
notes/{lifecycle}/{class}/yyyy-mm-dd-topic-title.md
```

两个轴都编码进**路径**（文件夹即标签，内容里不必重复声明，二者永不漂移）：

- **lifecycle（状态轴，顶层）** 随状态迁移：
  - `proposed/` —— 提案，未实现或部分实现
  - `implemented/` —— 已落地，记录当前态（事实随代码更新）
  - `rejected/` —— 已否决，判定保留在路径 + Status 行
  - `archived/` —— 冻结历史快照（只有 implemented 能进入；原理见 ponygo 框架仓库
    `docs/methodology.md` §2.3：<https://github.com/lanhui100/ponygo/blob/main/docs/methodology.md>）
- **class（类别轴，嵌套）** 来自封闭集合：
  - `feature`（新能力）/ `bug-fix`（修缺陷）/ `simplification`（减复杂度）/
    `architecture`（交付源码的结构）/ `process`（代码周围的工具与流程）/ `testing`（测试策略）
  - class 目录由**写入时创建**，不预建空目录——空目录既不承载事实、又制造"有决策"的假象。
  - **lifecycle 四态目录由 `ponygo init` 预建**（`proposed/ implemented/ rejected/ archived/`）：
    状态轴的空态是合法的——它代表治理根已播种；而 class 是类别轴，空目录不承载事实，故不预建。
  - **领域扩展（L5 开放口）**：六类不够用（领域定制的第一个诉求常是加一个 class）时，
    在本目录放 `classes.local`，每行一个额外 class 名（小写字母/数字/连字符；`#` 起注释）。
    封闭集本身不放开——扩展必须显式落盘成文件，留有可审计的载体，而非随手 mkdir。

## 文件格式契约

头部固定前两行：

```markdown
# Agent Note: <title>

Status: <status>
```

- `Status:` 三选一，必须与所在文件夹一致：`proposed` / `implemented` / `rejected — <一行理由>`。
- 正文从 `## Problem` 开始（先写动机，脱离方案也成立）。
- **正文骨架按 lifecycle 分态**（时态与状态一致，判据 1.8 机械校验）：

  | lifecycle | 正文骨架 |
  |---|---|
  | `proposed/` | `## Proposal`（可将来时）→ `## Alternatives considered` → `## Acceptance criteria` → `## Risks`；禁止现在时 `## Decision` |
  | `implemented/` | `## Decision`（现在时）→ `## Alternatives considered` → `## Consequences`（可选）；禁止提案时代标题（`## Proposal` / `## Plan` / `## Migration plan` / `## Acceptance criteria`） |
  | `rejected/` | 提案原文冻结（保留 `## Proposal`），verdict 只在 `Status:` 行；禁止现在时 `## Decision` |
  | `archived/` | 冻结豁免（保持归档时原貌，不改一字） |

- 每条必含 `## Alternatives considered`（候选方案与落选原因）——记录无备选的决策是在邀请重开争执。
- **迁移即改写**：proposed → implemented 时，移动文件的那次变更必须把 `## Proposal`
  改写为现在时 `## Decision`（Acceptance criteria / Risks 折叠进 `## Consequences`）；
  提案用现在时等于"未批准的方案伪装成已落地的决定"，状态轴在正文层失真。

## 触发规则（谁在什么时候必须写）

非平凡变更 = 命中任一：行为变更 / 架构 / 跨文件或跨包契约 / 流程与工具链 /
测试策略 / 磁盘-线-配置格式 / 维护者可能再访的决定。
命中即同一次变更内新增或更新记录。纯机械或局部编辑豁免。

**时序**：先 ADR 后代码（先于或同一提交）；事后补记是债务，不是常态。

**多类拆条**：一次变更命中多个类别（如"采纳治理 + 架构设计"）→ **拆多条记录，
不合并**——混装会把未实施的方案伪装成已落地（状态轴失真），并污染 class 轴的检索面。

**计划文档的家**：实施计划 = `proposed/` note（`## Proposal` + `## Acceptance criteria`）。
禁止根目录游离 `*plan*.md` / `ROADMAP.md`——计划烂在根目录永远不会被迁移，
且是 spec-speak 的滋生地（status/audit 对游离计划文件输出 WARN）。

## 读触发规则（谁在什么时候必须读旧 ADR，与写触发对称）

只写不读，决策记录就是只写存档。以下时刻必须先读相关旧 ADR 再动手：

- **写新 ADR 前**：按主题词/模块路径/关键符号 `grep` 检索活动树（proposed/implemented/
  rejected；archived 只读史不判）——命中则读全文、链入、判 supersession（见 write-adr
  写前检索程序）；
- **评审变更时**：用 change-review 技能——先检索相关 ADR 再逐项对照（对应性/same-commit/
  Status 迁移），无对应 ADR 的非平凡变更先补 ADR 再评审；
- **找简化/归档时**：读 note 树理解架构意图，按"未来价值"分类（能指导未来工作的理由/
  备选/负面保证保留，其余归档）；
- **治理审查时**：governance-review 决策面抽查（implemented 是否真落地、proposed 是否
  已实施未迁移）；
- **接手陌生模块时**：先读相关 implemented 再读代码——决策史是比代码更便宜的地图。

读的结论只进两处：新 note 的链入/拆条，或评审报告的问题清单——不落盘等于没读。


# ---------- 4. Status 与所在目录不一致（判据 1.7）→ 拒绝 ----------
R=$(new_repo status-drift)
write_adr "$R" .agents/notes/implemented/process/2026-10-29-status-drift.md '# Agent Note: Status 漂移

Status: proposed


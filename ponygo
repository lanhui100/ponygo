  if [ -z "$st" ]; then
    fail "1.7 $f：缺 Status: 行"
  elif [ "$lc" = "archived" ]; then
    [ "$st" = "implemented" ] || [ "$st" = "archived" ] || fail "1.7 $f：archived 下 Status 应为 implemented/archived，实得 $st"

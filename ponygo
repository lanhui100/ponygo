  printf '[%s] FAIL：缺少 sha256 工具（需要 sha256sum 或 shasum -a 256）\n' "$PROG" >&2
  exit 2
fi

usage() {
  printf '[%s] 用法：bash .meta/skills-library/install.sh list\n' "$PROG" >&2
  printf '            bash .meta/skills-library/install.sh install <name>\n' >&2

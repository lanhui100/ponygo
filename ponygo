check_one() { # $1 = 决策文件路径
  local f="$1" b rel lc slashes st d8
  b="${f##*/}"
  [ "$b" = "README.md" ] || [ "$b" = "AGENTS.md" ] && return 0
  rel="${f#"$NOTES_DIR"/}"
  [ "$rel" = "$f" ] && rel="$f"

# ---------- 「交付即接线」装配（plan-freeze §6.1–6.5；幂等、非破坏） ----------
# 哨兵/标记常量（§6.5 逐字形态）：marker 行与哨兵同文，供 2.4 机器识别。
GATE_SENT_BEGIN='# >>> ponygo-gate: adr-verify v1 >>>'
GATE_SENT_END='# <<< ponygo-gate: adr-verify v1 <<<'
GATE_MARKER='# ponygo-gate: adr-verify v1'

# 规范哨兵块（F3 唯一真值）：gate_hook_bytes_ok（接线判据的字节原子）与它做「EOL 归一后逐字节」比较。
# 末行/首行哨兵标记与测试夹具（tests/run.sh append_gate_block）逐字同款。
# 任何变体（echo adr-verify.sh / || true / if false; then … fi / 注释掉调用行）都不相等 → 未接线。
GATE_BLOCK_CANONICAL='# >>> ponygo-gate: adr-verify v1 >>>
if [ -f "$(git rev-parse --show-toplevel)/.meta/gates/adr-verify.sh" ]; then
  bash "$(git rev-parse --show-toplevel)/.meta/gates/adr-verify.sh" || exit 1
fi
# <<< ponygo-gate: adr-verify v1 <<<'

# 取**首个已闭合**哨兵区间（BEGIN..其后首个 END，含两行）。锚定口径与 maturity-ladder §2.4 /
# 测试夹具一致。F17：BEGIN 重复出现时，sed 的 `/BEGIN/,/END/` 会从第一个区间结束后**再开一段**
# 直到文件尾，导致「完整规范块 + 尾随 BEGIN + 用户行」被拼成 8 行、判成「字节非规范」——
# 该文件其实是已接线的（门真的会跑）。故这里只取第一段闭合区间，遇 END 即停。
gate_hook_block() { # <hook 文件>
  awk -v b="$GATE_SENT_BEGIN" -v e="$GATE_SENT_END" '
    { line = $0; sub(/\r$/, "", line) }
    done { next }
    inb { print; if (line == e) done = 1; next }
    line == b { inb = 1; print }
  ' "$1" 2>/dev/null
}

# F13「首个顶层早退行」识别的**唯一实现**（位置判决只在这里落地一次）。
# 旧判据 `^[[:space:]]*(exit|exec)[[:space:]]` 要求命令后必须有空白，于是**裸 `exit`**、
# `exit;`、`exit $?`、`[ -z "$X" ] && exit 0`（复合命令右侧）全被漏判——块被插在其后、
# 永不执行，而 2.4 仍报「已接线」（假绿）。
# 判据 = 词边界 + 命令分隔：`exit` / `exit 0` / `exit $?` / `exit;` / `… && exit 0` /
# `exec /bin/true` 均命中；`return` 只认**行首**（顶层 return 约定不缩进，函数体内的
# `return` 不构成早退，不得误判）；注释行（含行内注释）不算。
# 哨兵区间**内部**的 `|| exit 1` 属于块自身，不计入（否则块会把自己判成「在早退之后」）。
# F18：只有**顶层（嵌套深度 0）**的 exit/exec 才是早退行——`cleanup() { exit 1; }`（函数体内、
# 且函数未被调用）、`case` 分支内、`( … )` 子壳内的 exit 不结束钩子，判成早退=假红（会误杀
# 真实钩子）。函数体用 `name() {` … `}` 的 `{`/`}` 深度跟踪（`${…}` 参数展开不计），子壳用
# `(`/`)` 深度（`$(…)`/`<(…)` 不计），case 用 `case … in` … `esac` 计数。
gate_hook_early_exit_line() { # <hook 文件> → 首个顶层早退行号（无则空）
  local f="$1"
  [ -f "$f" ] || return 0
  awk -v b="$GATE_SENT_BEGIN" -v e="$GATE_SENT_END" '
    function scandepth(s, upto,   i, c, d, pe) {
      d = 0; pe = 0
      for (i = 1; i <= upto; i++) {
        c = substr(s, i, 1)
        if (c == "{" && substr(s, i - 1, 1) == "$") { pe++; continue }
        if (c == "}" && pe > 0) { pe--; continue }
        if (pe > 0) continue
        if (c == "{") d++
        else if (c == "}" && d > 0) d--
      }
      return d
    }
    function scanparen(s, upto,   i, c, d) {
      d = 0
      for (i = 1; i <= upto; i++) {
        c = substr(s, i, 1)
        if (c == "(" && substr(s, i - 1, 1) != "$" && substr(s, i - 1, 1) != "<") d++
        else if (c == ")" && d > 0) d--
      }
      return d
    }
    {
      line = $0; sub(/\r$/, "", line)
      if (line == b) { inb = 1; next }
      if (line == e) { inb = 0; next }
      if (inb) next
      code = line
      if (match(code, /(^|[[:space:]])#/)) code = substr(code, 1, RSTART - 1)
      t = code; sub(/^[[:space:]]+/, "", t)
      if (t == "") next
      isdef = (t ~ /^(function[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(\)[[:space:]]*\{/) || (t ~ /^function[[:space:]]/)
      incase = (cd > 0 || t ~ /^case[[:space:]]/ || t ~ /^[^[:space:]]+\)/)
      rest = code; off = 0; hit = 0
      while (match(rest, /(^|[;&|()[:space:]])(exit|exec)([[:space:];&|)]|$)/) > 0) {
        seg = substr(rest, RSTART, RLENGTH)
        p = index(seg, "exit"); if (p == 0) p = index(seg, "exec")
        tp = off + RSTART + p - 1
        dfn = (fn || isdef) ? fd + scandepth(code, tp - 1) : 0
        dpd = pd + scanparen(code, tp - 1)
        if (dfn == 0 && dpd == 0 && !incase) { hit = 1; break }
        off = tp; rest = substr(code, off + 1)
        if (rest == "") break
      }
      if (hit) { print NR; exit }
      if (t ~ /^return([[:space:];&|]|$)/ && !(fn || isdef) && pd == 0 && !incase) { print NR; exit }
      delta = 0
      if (t ~ /^case[[:space:]]/) delta++
      if (code ~ /(^|[[:space:];])esac([[:space:];&|]|$)/) delta--
      cd += delta; if (cd < 0) cd = 0
      if (fn || isdef) {
        fd += scandepth(code, length(code))
        if (fd > 0) fn = 1; else { fd = 0; fn = 0 }
      }
      pd += scanparen(code, length(code)); if (pd < 0) pd = 0
    }
  ' "$f" 2>/dev/null | head -n1
}

# 块必须位于首个顶层早退行（exit/exec/return）**之前**（F1/F13）：末尾追加在 `exit 0` /
# 裸 `exit` / `exec 他脚本` 钩子里永不执行，而旧判据仍报「已接线」= 假绿。
gate_hook_block_before_exit() { # <hook 文件> → 0 = 位置安全
  local f="$1" bs="" es=""
  bs=$(grep -nF -m1 "$GATE_SENT_BEGIN" "$f" 2>/dev/null | head -n1 | cut -d: -f1)
  [ -n "$bs" ] || return 1
  es=$(gate_hook_early_exit_line "$f")
  [ -n "$es" ] || return 0
  [ "$bs" -lt "$es" ]
}

# 哨兵块结构是否完整（BEGIN 与 END 两行都在）——半截块（写中断残留）不完整，须整块重建
gate_hook_block_complete() { # <hook 文件> → 0 = 两个哨兵行都在
  local f="$1"
  grep -qxF "$GATE_SENT_BEGIN" "$f" 2>/dev/null || return 1
  grep -qxF "$GATE_SENT_END" "$f" 2>/dev/null || return 1
  return 0
}

# 已接线 = 哨兵区间逐字节等于规范块（EOL 归一，F3）。**只回答问题「字节对不对」**，
# 不回答「这段字节会不会被执行」——后者是 gate_hook_block_before_exit（F1）。
# 两者由 gate_hook_wired 合成唯一对外口径，本函数仅是它的原子谓词之一，勿单独作为接线判据。
gate_hook_bytes_ok() { # <hook 文件> → 0 = 哨兵区间逐字节等于规范块
  local f="$1" got=""
  [ -f "$f" ] || return 1
  grep -qxF "$GATE_SENT_END" "$f" 2>/dev/null || return 1
  got=$(gate_hook_block "$f" | tr -d '\r')
  [ "$got" = "$GATE_BLOCK_CANONICAL" ] || return 1
  return 0
}

# 接线判据的**唯一单点**（F1 + F3 合流）：字节等于规范块（F3）∧ 块在首个顶层 exit/exec
# 之前（F1：位置在后 = 永不执行 = 假绿）。init 侧（已接线则不动 / 未接线则迁移）、
# verify_ladder 2.4、status 的接线报告**全部**只走这一个函数——否则会出现
# 「init 认为已接线、status 认为未接线」的双口径（L3-B 指出的正是这种不一致）。
gate_hook_wired() { # <hook 文件> → 0 = 已接线（字节规范 + 位置可执行）
  gate_hook_bytes_ok "$1" || return 1
  gate_hook_block_before_exit "$1" || return 1
  return 0
}

# 「有效内容」判定（W6）：去掉空白行与 # 注释行后仍无任何字符 = 空文件（不是内容）。
# 用它替代 -size 0 / -s —— `printf '\n' > x.spec.sh`、注释-only 的 spec 都能过 -s，
# 却证明不了任何拒绝语义；三处口径（2.3 形状判据 / M 档 negspec 计分 / run_gate_specs 判 FAIL）
# 必须同一套判定，否则「形状 PASS / 计分 +1 / 执行 [ok]」任一处都能被 1 字节刷绿。
file_has_content() { # <文件> → 0 = 有有效内容；非 0 = 空/仅空白/仅注释/不可读
  [ -f "$1" ] || return 1
  grep -qvE '^[[:space:]]*(#|$)' "$1" 2>/dev/null
}

# 实例门与负样本的机械配对：只按同 Stem、同语言后缀推导，不维护第二份映射表。
# 返回 0 = 全部有配对（含零实例门）；1 = 有缺口，逐行列出具体门与所缺 spec。
# ci-verify.sh 只编排其他门，不是独立判定门；框架内置门与实例门用同一算法配对，
# 但仅实例门参与 M 档计分，防止框架随骨架交付的资产白送实例成熟度分。
check_gate_spec_pairing() {
  local gate="" name="" ext="" stem="" spec="" missing=0
  while IFS= read -r -d '' gate; do
    file_has_content "$gate" || continue
    name="${gate##*/}"; ext="${name##*.}"; stem="${name%.*}"
    case "$ext" in sh|ps1) ;; *) continue ;; esac
    [ "$name" = "ci-verify.sh" ] && continue
    spec="${gate%.*}.spec.${ext}"
    if [ ! -f "$spec" ] || ! file_has_content "$spec"; then
      printf '  - %s 缺负样本 spec %s（同 Stem、同 .%s 后缀；空 spec 不计）\n' "$gate" "$spec" "$ext"
      missing=1
    fi
  done < <(find "$META_DIR/gates" -maxdepth 1 -type f \
      \( -name '*.sh' -o -name '*.ps1' \) ! -name '*.spec.*' -print0 2>/dev/null | sort -z)
  return "$missing"
}

# ---------- 2.3 拒绝断言的证据判据（P1-9 / 2026-11-11；单一实现） ----------
# 为什么加固：旧的 `grep -E '(^|[^[:alnum:]_])(exit|return)[[:space:]]+[1-9]' <spec>` 会被**文本**
# 骗过——`# 违规必须 exit 1` 这样的注释、或 `echo "违规必须 exit 1"` 这样的字符串，都能让一个只
# `exit 0` 的空壳 spec 冒充「证明门会拒绝非法样本」。零断言的 pass 比不写 spec 更坏：它把
# 「没人验证」伪装成「已验证」（零断言 = 零证据）。
# 判据：先剔除**注释与字符串**（整行注释 / 行内 `#` 起的注释 / 单双引号内全部内容——echo/printf 的
# 参数因此一律不算证据），再要求非零退出落在真实控制流位置：
#   (^|[;&|]|then|else)[[:space:]]*(exit|return)[[:space:]]+[1-9]
# 落地取舍（契约 §P1-9 的语义而非字面）：**不**整行剔除「含 echo/printf 的行」。冻结夹具的标准形态
# `if bash <gate> --bad; then echo "未拒绝"; exit 1; fi` 正是「含 echo 的行 + 真实断言」，整行剔除
# 会把它误杀成 FAIL（verify-p0 E/F、verify-p1 add_gate、tests/run.sh add_instance_gate 都这个形态）；
# 剔除**字符串**同样让「echo 里写 exit 1」不算证据，且不误伤真实断言。
spec_reject_assertion() { # <spec 文件> → 0 = 含真实的拒绝断言（非注释/非字符串）
  local f="$1" code=""
  [ -f "$f" ] || return 1
  file_has_content "$f" || return 1
  code=$(awk '
    { line = $0; sub(/\r$/, "", line) }
    line ~ /^[[:space:]]*#/ { next }           # 整行注释：不是代码
    {
      out = ""; i = 1; sq = 0; dq = 0; n = length(line); prev = ""
      while (i <= n) {
        c = substr(line, i, 1)
        if (sq) { if (c == "\047") { sq = 0 }; i++; continue }
        if (dq) { if (c == "\"") { dq = 0 }; i++; continue }
        if (c == "\047") { sq = 1; i++; continue }
        if (c == "\"") { dq = 1; i++; continue }
        # 行内注释起点：`#` 出现在行首或空白/命令分隔之后（`${a#b}` 这类参数展开不算注释）
        if (c == "#" && (prev == "" || prev == " " || prev == "\t" || prev == ";" || prev == "&" || prev == "|")) { break }
        out = out c; prev = c; i++
      }
      print out
    }
  ' "$f" 2>/dev/null)
  printf '%s\n' "$code" | grep -qE '(^|[;&|]|then|else)[[:space:]]*(exit|return)[[:space:]]+[1-9]'
}

# 2.3 的**扫描面**：只查「与门配对」的 spec（同 Stem、同语言后缀；含框架门自带的 spec）。
# 为什么收窄：纯正向 smoke spec（只 `exit 0`、没有对应门）不是负样本证据，也不是欠账——把它算进
# 「缺拒绝断言」等于逼人给冒烟脚本写假的拒绝断言（假门禁）。无对应门的 spec 不在本清单里。
paired_spec_files() { # 逐个打印与门配对的 spec 路径（maxdepth 1，与 check_gate_spec_pairing 同口径）
  local gate="" name="" ext="" spec=""
  while IFS= read -r -d '' gate; do
    file_has_content "$gate" || continue
    name="${gate##*/}"; ext="${name##*.}"
    case "$ext" in sh|ps1) ;; *) continue ;; esac
    spec="${gate%.*}.spec.${ext}"
    [ -f "$spec" ] && printf '%s\n' "$spec"
  done < <(find "$META_DIR/gates" -maxdepth 1 -type f \
      \( -name '*.sh' -o -name '*.ps1' \) ! -name '*.spec.*' -print0 2>/dev/null | sort -z)
  return 0
}

# 文件权限（八进制；GNU/BSD stat 双兼容）
file_mode() { # <文件> → 如 755
  if stat -c %a "$1" >/dev/null 2>&1; then stat -c %a "$1"; else stat -f %Lp "$1" 2>/dev/null; fi
}

# F4 写失败必须响亮：装配期写入失败一律登记到本清单，由 cmd_init 汇总成
# 「[WARN] + 失败清单 + 可执行补救」并**返回非零**。绝不允许把 mv/mktemp 的
# `Permission denied` 裸泄漏成一行噪声后 rc=0（那等于「装配没做成但机器说成功」）。
GATE_WRITE_FAILS=""
gate_write_fail() { # <目标> <因由>
  GATE_WRITE_FAILS="${GATE_WRITE_FAILS}${1} — ${2}"$'\n'
}

# 汇总打印失败清单 + 补救；返回 0 表示「确实有失败」（调用方据此非零退出）。
# 清单口径 = 「装配没能完整达成」：既含写入失败（F4），也含**拒绝装配**（F15 越界、F14 含
# 外来内容需人工清理）——两者都不得以 rc=0 冒充成功。
gate_assembly_failed() {
  [ -n "$GATE_WRITE_FAILS" ] || return 1
  local n=0 ln=""
  n=$(printf '%s' "$GATE_WRITE_FAILS" | grep -c . 2>/dev/null || true)
  warn "[WARN] 门禁装配未完成 ${n:-1} 项（写入失败或被拒绝——本次不会假装成功）："
  printf '%s' "$GATE_WRITE_FAILS" | while IFS= read -r ln; do
    [ -n "$ln" ] && warn "  - $ln"
  done
  warn "补救：按上面清单逐项修——① 目录不可写 → chmod u+w <该目录>（钩子落点 = core.hooksPath 目录，资产 = .meta/gates/）；② 目标文件只读/被占用 → chmod u+w <该文件>；③ 磁盘满/只读挂载 → 换可写盘。修完重跑 ponygo init（幂等装配：资产按规范内容自愈 + 钩子重建）。"
  return 0
}

# F2 原子写：同目录 mktemp → 写入（内容走 stdin）→ chmod → mv -f 原子替换。
# 禁止 `>>` 追加直写目标文件与多次 printf 直写（半截内容会被 git 当成有效钩子执行）。
write_atomic() { # <目标路径> <权限，空=不改> ；内容走 stdin
  local dst="$1" mode="$2" dir="" tmp=""
  dir=$(dirname "$dst")
  mkdir -p "$dir" || return 1
  tmp=$(mktemp "$dir/.ponygo.tmp.XXXXXX" 2>/dev/null) || return 1
  if ! cat > "$tmp"; then rm -f "$tmp"; return 1; fi
  if [ -n "$mode" ]; then
    chmod "$mode" "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  mv -f "$tmp" "$dst" || { rm -f "$tmp"; return 1; }
  return 0
}

# F10 资产自愈：A1/A2/A4 是**框架不可变**资产（宇宙表成员）。规范内容走 stdin。
#   缺失                                  → 原子写入（755）
#   存在但与内置规范不一致（半截/被改）    → 用规范内容原子覆盖 + 一行 WARN
#   一致                                  → 一字不动（幂等：重复 init 的字节/mtime 不变）
# A3（钩子）/A5（workflow）是实例可编辑文件 → **不做**内容自愈，只补接线与缺失。
gate_asset_put() { # <目标路径> <权限> <资产名>；规范内容走 stdin
  local dst="$1" mode="$2" name="$3" canon="" same=0
  canon=$(mktemp) || { gate_write_fail "$dst" "$name 自愈失败：无法创建比对临时文件"; return 1; }
  if ! cat > "$canon"; then rm -f "$canon"; gate_write_fail "$dst" "$name 自愈失败：无法读取内置规范内容"; return 1; fi
  if [ -f "$dst" ]; then
    cmp -s <(tr -d '\r' < "$dst") <(tr -d '\r' < "$canon") && same=1
    if [ "$same" = "0" ]; then
      if write_atomic "$dst" "$mode" < "$canon"; then
        warn "[WARN] $name 与内置规范不一致（半截/被改）→ 已按规范内容原子覆盖（F10 资产自愈）：$dst"
      else
        rm -f "$canon"; gate_write_fail "$dst" "写入失败（原子替换 mv 失败/目录不可写）——$name 未能自愈"; return 1
      fi
    fi
  else
    if ! write_atomic "$dst" "$mode" < "$canon"; then
      rm -f "$canon"; gate_write_fail "$dst" "写入失败（原子替换 mv 失败/目录不可写）——$name 未能生成"; return 1
    fi
  fi
  rm -f "$canon"
  return 0
}

# F14/F17 哨兵块计数（含重复块与残块；grep 按行计）
gate_hook_begin_count() { # <hook 文件> → BEGIN 行数（无则 0）
  local n=0
  [ -f "$1" ] || { printf 0; return 0; }
  n=$(grep -cF "$GATE_SENT_BEGIN" "$1" 2>/dev/null || true)
  printf '%s' "${n:-0}"
}

# F14+F17「哨兵残留里是否含外来内容」的**唯一判定**：扫描**每一个** BEGIN（重复/尾随/未闭合
# 一律算），只看**未闭合**区间（BEGIN → 下一个 BEGIN 或文件尾；已由 END 闭合的区间语义由
# 哨兵界定，属 F3 变体、可重建，不在本判据内）。
# 判据：未闭合区间的每一非空行必须逐行等于规范块后续行（= 写到一半的纯规范残块）；
# 任何一行不等 → 外来内容（用户自有行）→ 禁止删字节。
# F17：本判据必须**独立于「是否已接线」**——「完整规范块 + 其后又一个 BEGIN + 用户行」时
# 文件是「已接线」的，若先判接线就会跳过保护，把用户行删掉（BLOCKING 数据丢失）。
gate_hook_residue_foreign() { # <hook 文件> → 0 = 残留含外来内容（禁止删字节）
  local f="$1" verdict=""
  [ -f "$f" ] || return 1
  grep -qxF "$GATE_SENT_BEGIN" "$f" 2>/dev/null || return 1
  verdict=$(PONYGO_CANON="$GATE_BLOCK_CANONICAL" awk -v b="$GATE_SENT_BEGIN" -v e="$GATE_SENT_END" '
      BEGIN { n = split(ENVIRON["PONYGO_CANON"], C, "\n"); state = 0; idx = 0; bad = 0; foreign = 0 }
      { line = $0; sub(/\r$/, "", line) }
      line == b {
        if (state == 1 && bad) { foreign = 1; exit }
        state = 1; idx = 1; bad = 0; next
      }
      state == 1 && line == e { state = 0; next }
      state == 1 {
        if (line ~ /^[[:space:]]*$/) next
        idx++
        if (idx > n || line != C[idx]) bad = 1
        next
      }
      END {
        if (state == 1 && bad) foreign = 1
        print (foreign ? "FOREIGN" : "PURE")
      }
    ' "$f" 2>/dev/null)
  [ "$verdict" = "FOREIGN" ]
}

# F1+F2：把规范块前置到 shebang 行之后（无 #! 首行 → 文件最前），一次原子替换。
# 既有字节顺序/内容零改动、权限不动。
#   purge=1（默认）：旧块（规范与否）与纯半截块（有 BEGIN 无 END 且只含规范行）先整段摘除
#     再前置重建——自愈；单次 awk 产出完整新内容，杜绝「半截钩子」跨写窗口。
#   purge=0（F14 保字节模式）：只插入规范块，**一行都不删**——用于「未闭合块里含外来内容」
#     的现场（删了就会丢用户的自有行；清理责任交回人）。
gate_hook_write_block() { # <hook 文件> [purge=1|0] → 0 = 已写
  local f="$1" purge="${2:-1}" dir="" tmp="" mode="" blk=""
  [ -f "$f" ] || return 1
  dir=$(dirname "$f")
  mode=$(file_mode "$f" 2>/dev/null || true)
  tmp=$(mktemp "$dir/.ponygo.hook.XXXXXX" 2>/dev/null) || return 1
  blk="$GATE_BLOCK_CANONICAL"
  # CRLF 钩子在 bash 下本就不可执行（`then\r` 不是关键字）——整体归一为 LF（一次原子替换），
  # 既避免同一文件内 EOL 混排，也让既有钩子第一次真正可跑；EOL 归一后判据口径不变（F3）。
  if grep -q $'\r' "$f" 2>/dev/null; then
    warn "既有钩子为 CRLF 行尾（bash 下 then\r 非法）→ 已统一归一为 LF 后前置规范块"
  fi
  # 缺陷修复（W5-4，pre-existing）：规范块原先只在「遇到第一条块外行」时才输出（!placed 分支），
  # 于是「0 字节钩子」与「整文件只有哨兵残块」两种形态根本走不到该分支 → 输出 0 字节、
  # 而调用方照旧打印「已重写为规范块并前置到 shebang 之后」+ rc=0：文件永不愈合，
  # status 2.4 的补救「bash ponygo init」成为死循环；纯残块钩子还会被静默清空（无 WARN）。
  # 收口：END 兜底——块外无行时也写出规范块；整文件确实为空时补 shebang（否则文件没有解释器行）。
  # 边界不变：块外字节一律保留（purge 只吞已识别的哨兵段），绝不删除用户行。
  if ! PONYGO_BLK="$blk" awk -v b="$GATE_SENT_BEGIN" -v e="$GATE_SENT_END" -v purge="$purge" '
      BEGIN { blk = ENVIRON["PONYGO_BLK"]; if (blk != "") blk = blk "\n" }
      { line = $0; sub(/\r$/, "", line); saw = 1 }
      purge && line == b { inblk = 1; next }
      inblk && line == e { inblk = 0; next }
      inblk { next }
      !placed {
        placed = 1
        if (line ~ /^#!/) { print line; printf "%s", blk; next }
        printf "%s", blk
      }
      { print line }
      END {
        if (placed) exit
        if (!saw) print "#!/usr/bin/env bash"
        printf "%s", blk
      }
    ' "$f" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if [ -n "$mode" ]; then
    chmod "$mode" "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  mv -f "$tmp" "$f" || { rm -f "$tmp"; return 1; }
  return 0
}

# CI provider 探测（§6.3：只按证据说话）。github 优先——A5 是 GitHub 专属薄壳。
# F11：判 github 的证据收窄为「remote URL 含 github」**或**「.github/workflows/ 目录存在」。
# 仅 .github/ 存在（ISSUE_TEMPLATE、CODEOWNERS、dependabot 等）与 Actions 无关，
# 拿它当证据会在 GitLab 项目里凭空生成一个永不运行的 GitHub 适配器，并让 status 误报「已生成」。
ci_provider() { # → github|gitlab|jenkins|azure|drone|bitbucket|none
  local remote=""
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    remote=$(git remote get-url origin 2>/dev/null || true)
  fi
  case "$remote" in *github*) printf 'github'; return 0 ;; esac
  if [ -d .github/workflows ]; then printf 'github'; return 0; fi
  if [ -f .gitlab-ci.yml ]; then printf 'gitlab'; return 0; fi
  if [ -f Jenkinsfile ]; then printf 'jenkins'; return 0; fi
  if [ -f azure-pipelines.yml ]; then printf 'azure'; return 0; fi
  if [ -f .drone.yml ]; then printf 'drone'; return 0; fi
  if [ -f bitbucket-pipelines.yml ]; then printf 'bitbucket'; return 0; fi
  printf 'none'
}

# ---------- 非 GitHub forge 的 1.10 载体（P1-3 / 2026-11-11） ----------
# 「有 CI 配置文件」≠「有人在跑 1.10 判定」：零字节占位文件（`touch .gitlab-ci.yml`）或跑别的
# 流水线的配置都不构成载体。判据 = 该 forge 的 CI 文件**非空**（有效行，空白/注释不算）且含
# `ci-verify` / `verify-note` 的调用痕迹（与 A4 / A1 的接线口径同源）。未命中 → 按 missing 处理：
# 1.10 进 unverified（诚实条款：未验证不得放行，也不得因"文件在场"冒充载体）。
other_forge_ci_wired() { # <provider> → 0 = 该 forge 的 CI 文件是 1.10 的真实载体
  local p="$1" f=""
  case "$p" in
    gitlab)    f=".gitlab-ci.yml" ;;
    jenkins)   f="Jenkinsfile" ;;
    azure)     f="azure-pipelines.yml" ;;
    drone)     f=".drone.yml" ;;
    bitbucket) f="bitbucket-pipelines.yml" ;;
    *) return 1 ;;
  esac
  [ -f "$f" ] || return 1
  file_has_content "$f" || return 1
  grep -qE 'ci-verify|verify-note' "$f" 2>/dev/null
}

# ---------- 自适应深度信号 4：区分 init 自身产物（P1-4 / 2026-11-11） ----------
# 信号 4「已有治理痕迹」问的是「**项目自己**已经建了治理面吗」。`ponygo init` 刚铺下的
# `.githooks/pre-commit`（A3）与 `.github/workflows/ponygo-governance.yml`（A5）是脚手架产物，
# 不是项目痕迹；把两者算成信号会让每个干净实例 init 完就自动升 M 档。
# 判据（只读、不执行任何脚本）：文件内容与 init 模板逐字节一致（EOL 归一）= init 产物。
init_artifact_equal() { # <文件> <模板函数名> → 0 = 内容即 init 模板
  local f="$1" tplfn="$2" want="" got=""
  [ -f "$f" ] || return 1
  want=$("$tplfn" 2>/dev/null | tr -d '\r')
  got=$(tr -d '\r' < "$f" 2>/dev/null)
  [ -n "$want" ] && [ "$got" = "$want" ]
}
githooks_only_init_artifacts() { # → 0 = .githooks 下只有 init 写的 pre-commit（或无内容）
  local f rel
  [ -d .githooks ] || return 0
  while IFS= read -r f; do
    rel="${f#./}"
    case "$rel" in
      .githooks/pre-commit) init_artifact_equal "$f" init_hook_template && continue ;;
    esac
    return 1
  done < <(find .githooks -type f 2>/dev/null)
  return 0
}
github_only_init_artifacts() { # → 0 = .github 下只有 init 写的 A5 适配器（或无内容）
  local f rel
  [ -d .github ] || return 0
  while IFS= read -r f; do
    rel="${f#./}"
    case "$rel" in
      .github/workflows/ponygo-governance.yml) init_artifact_equal "$f" ci_adapter_template && continue ;;
    esac
    return 1
  done < <(find .github -type f 2>/dev/null)
  return 0
}

# hooksPath → 归一化绝对目录（R9：相对/绝对/符号链接同一口径；不可达 → 空串）
# F6：git 对 core.hooksPath 的 `~` / `~/` 按 $HOME 展开，判定侧必须同口径展开——
# 否则 `core.hooksPath='~/hk'` 会被当成仓内相对路径 `./~/hk`（既假 FAIL，又诱导人在仓里
# 造一个叫 `~` 的目录）。只展开「首个路径段就是 ~」的两种合法形态，其余一律不动。
hook_dir_resolved() { # <repo root> <hooksPath>
  local root="$1" hp="$2" d="" home="${HOME:-}"
  case "$hp" in
    '~')   [ -n "$home" ] && hp="$home" ;;
    '~/'*) [ -n "$home" ] && hp="$home/${hp#\~/}" ;;
  esac
  case "$hp" in
    /*) d=$(cd "$hp" 2>/dev/null && pwd -P) ;;
    *)  d=$(cd "$root/$hp" 2>/dev/null && pwd -P) ;;
  esac
  printf '%s' "${d:-}"
}

# F15 越界判定（**单点**）：钩子目录必须落在仓库根之下，否则装配会把钩子写到仓库外
# （`core.hooksPath=..` → 父目录/pre-commit，等于往别人的目录里塞文件）。
# 两侧都取真实路径（符号链接同一口径）；`<root>/x` 与 root 自身算仓内。
hook_dir_under_root() { # <repo root> <已解析钩子目录> → 0 = 在仓库根之下
  local root="$1" dir="$2" rr=""
  [ -n "$root" ] && [ -n "$dir" ] || return 1
  rr=$(cd "$root" 2>/dev/null && pwd -P) || rr="$root"
  [ -n "$rr" ] || return 1
  case "$dir" in
    "$rr"|"$rr"/*) return 0 ;;
  esac
  return 1
}

# F15 装配侧守卫：hooksPath 越界 → **拒绝装配**（不写任何文件、不 chmod、不改 git config）。
# 返回 0 = 已判定越界（打 WARN + 登记装配失败 → cmd_init 非零）；1 = 无越界 / 无从判定
# （非 git、hooksPath 未设、目录不可达三类各有自己的分支，不在这里抢）。
gate_hooks_path_escape() {
  local root="" hp="" dir=""
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
  hp=$(git config core.hooksPath 2>/dev/null || true)
  [ -n "$hp" ] || return 1
  root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  [ -n "$root" ] || return 1
  dir=$(hook_dir_resolved "$root" "$hp")
  [ -n "$dir" ] || return 1
  hook_dir_under_root "$root" "$dir" && return 1
  warn "[WARN] core.hooksPath 越界（钩子目录不在仓库根之下，装配会把钩子写到仓库外）：$hp → $dir"
  warn "  已拒绝装配：不写任何文件、不改权限、不动 git config。补救：git config core.hooksPath .githooks 后重跑 ponygo init"
  gate_write_fail "$dir/pre-commit" "装配被拒绝：core.hooksPath 越界（落点在仓库外 $dir）——未写任何文件"
  return 0
}

# 2.4「本地层已接 ADR 门」判据的**唯一实现**（verify_ladder 2.4 与 status 的
# gate_wiring_report 共用一处口径——两处各写一份必然漂移，F5 的按因补救会有一处退回统一文案）。
# 判据 = ① hooksPath 已设 ② 归一化目录可达且在仓库根之下（F15：越界=落点在仓库外，拒绝）
# ③ pre-commit 存在且可执行
# ④ 哨兵区间逐字节等于规范块（F3）⑤ 块起始行 < 首个顶层早退行（F13：exit/exit 0/exit;/
# `&& exit 0`/exec/return——块落在早退之后 = 永不执行 = 假绿）⑥ <root>/.meta/gates/adr-verify.sh 存在。
# F5：失败**按因**给补救——非 git / 目录不可达 / 钩子不可执行三类给统一「bash ponygo init」
# 是缺陷（对它们无效），各自需要 git init / git config / chmod +x。
# 输出（全局）：G24_OK=1 通过；G24_CAUSE 失败因由；G24_FIX 可执行补救命令。
gate_24_probe() {
  G24_OK=0; G24_CAUSE=""; G24_FIX=""
  local root="" hp="" dir="" hook="" es=""
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    G24_CAUSE="不在 git 仓库内，本地钩子无从挂载"
    G24_FIX="git init（本目录还不是仓库）后重跑 ponygo init 装配本地层"
    return 1
  fi
  hp=$(git config core.hooksPath 2>/dev/null)
  if [ -z "$hp" ]; then
    G24_CAUSE="core.hooksPath 未设（本地层没有落点）"
    G24_FIX="bash ponygo init（设 core.hooksPath=.githooks + 生成 A3 钩子 + chmod +x）"
    return 1
  fi
  root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  dir=$(hook_dir_resolved "${root:-.}" "$hp")
  if [ -z "$dir" ]; then
    G24_CAUSE="core.hooksPath 指向的目录不可达：$hp"
    G24_FIX="git config core.hooksPath .githooks（把落点改回仓内目录）后重跑 ponygo init 装配"
    return 1
  fi
  # F15：落点在仓库外 → 装配与判据都必须拒绝（不得往仓库外写钩子）
  if ! hook_dir_under_root "${root:-.}" "$dir"; then
    G24_CAUSE="core.hooksPath 越界（钩子目录不在仓库根之下，装配会把钩子写到仓库外）：$hp → $dir"
    G24_FIX="git config core.hooksPath .githooks（把落点改回仓内目录）后重跑 ponygo init 装配"
    return 1
  fi
  hook="$dir/pre-commit"
  if [ ! -f "$hook" ]; then
    G24_CAUSE="钩子缺失：$hp/pre-commit"
    G24_FIX="bash ponygo init（生成 A3：marker + 规范哨兵块 + chmod +x）"
    return 1
  fi
  if [ ! -x "$hook" ]; then
    G24_CAUSE="钩子不可执行（git 会静默忽略）：$hp/pre-commit"
    # F16：只给 chmod +x 是**半截补救**——照做后 2.4 仍红（块还可能未接线/位置不对）。
    # 两步化，且第一句仍是本分支特有因由（不得退化成统一「bash ponygo init」文案，F5）。
    G24_FIX="分两步：① chmod +x $hp/pre-commit（恢复执行位——init 不会替你激活沉睡钩子，执行位是人的决定）② ponygo init（幂等补块：块未接线或位置在早退行之后时按规范块前置；已接线则一字不动）"
    return 1
  fi
  if ! grep -qxF "$GATE_SENT_END" "$hook" 2>/dev/null; then
    G24_CAUSE="钩子未接 ADR 门（缺哨兵尾行 $GATE_SENT_END）：$hp/pre-commit"
    G24_FIX="bash ponygo init（按规范块重建哨兵块并前置到 shebang 之后）"
    return 1
  fi
  # 判定单点：接线与否只由 gate_hook_wired 裁决（字节 F3 ∧ 位置 F1）。
  # 下面两个原子谓词**只用于分因**给对症补救，不参与裁决——避免双口径。
  if ! gate_hook_wired "$hook"; then
    if ! gate_hook_bytes_ok "$hook"; then
      G24_CAUSE="钩子哨兵块与规范块不逐字节一致（echo/|| true/if false/注释掉调用行等变体一律不算接线）：$hp/pre-commit"
      G24_FIX="bash ponygo init（删旧块 + 前置规范块为一次原子替换）"
    else
      # F13：位置因由复用 gate_hook_early_exit_line（位置判决的单点实现），点名首个早退行号
      es=$(gate_hook_early_exit_line "$hook")
      G24_CAUSE="哨兵块位于首个顶层早退行（第 ${es:-?} 行：exit/exec/return，含裸 exit 与 exit;）之后（该块永不执行）：$hp/pre-commit"
      G24_FIX="bash ponygo init（删旧块并把规范块前置到 shebang 之后）"
    fi
    return 1
  fi
  if [ ! -f "$META_DIR/gates/adr-verify.sh" ]; then
    G24_CAUSE="缺门禁本体 $META_DIR/gates/adr-verify.sh"
    G24_FIX="bash ponygo init（A1 资产按规范内容自愈重建）"
    return 1
  fi
  G24_OK=1
  return 0
}

# ensure_gate_wiring —— 「交付即接线」装配入口（cmd_init 调用；.meta 已存在也照跑，§6.2）。
# 幂等装配：缺失才补；hooksPath 已设一律不动（§6.1）。既有钩子只在「未接线」时被重写，
# 而重写只做两件事——摘除旧哨兵块 + 把规范块前置到 shebang 之后（原字节顺序与权限不动）。
# F2：整个「读-判-写」段在 .git/ponygo-init.lock 上持 flock（无 flock 命令降级 mkdir 原子锁），
#      获锁后重新读取 hooksPath / 钩子内容再判定，并发 init 不可能写出两块。
# 正常装配路径不返回非零（唯一非零 = R15 的非 TTY 未确认，在 cmd_init 里）——
# C2 由「恒定装配」满足，而非由「失败报错」满足。
ensure_gate_wiring() {
  local provid="" fresh="${GATE_FRESH_SEED:-0}"
  provid=$(ci_provider)

  # --dry-run：只打印计划，不落盘、不动 git config（§4 矩阵）
  if [ "${DRY_RUN:-0}" = "1" ]; then
    local a
    # 计划清单必须与 write_gate_assets 的真实落盘集**同源**（A1/A2/A4/A6/A7/A8/A9），
    # 少列一项就是「计划 ≠ 实跑」——dry-run 的意义是让人相信接下来的写盘面。
    for a in adr-verify.sh adr-verify.spec.sh ci-verify.sh archive-verify.sh archive-verify.spec.sh \
             no-residue.sh no-residue.spec.sh; do
      [ -f "$META_DIR/gates/$a" ] || info "[dry-run] 将生成 $META_DIR/gates/$a（缺失）+ chmod +x"
    done
    if [ "$provid" = "github" ]; then
      github_governance_wired || info "[dry-run] 将生成 .github/workflows/ponygo-governance.yml（A5 薄适配器）"
    else
      info "[dry-run] 远端层：未检出 GitHub（provider=$provid）→ 不生成 A5，需在你的 CI 里加 bash .meta/gates/ci-verify.sh"
    fi
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      info "[dry-run] 非 git 仓库：不设 core.hooksPath（git init 后重跑 ponygo init 才挂载本地层）"
      return 0
    fi
    local hp="" root="" dir=""
    hp=$(git config core.hooksPath 2>/dev/null || true)
    root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [ -z "$hp" ]; then
      # F6c：dry-run 必须与实跑一致——钩子已存在但不可执行时，实跑是「沉睡钩子：不改权限」，
      # 故 dry-run 不得再承诺「创建 + chmod +x」（该文件已存在，框架也不替人改权限）。
      info "[dry-run] 将设 core.hooksPath=.githooks（回读校验）"
      if [ ! -f .githooks/pre-commit ]; then
        info "[dry-run] 将创建 .githooks/pre-commit（A3：marker + 规范哨兵块 + 非注释调用行），新文件自带执行位"
      elif [ -x .githooks/pre-commit ]; then
        info "[dry-run] .githooks/pre-commit 已存在且可执行 —— 不动字节，按哨兵块现状判定是否补/前置"
      else
        info "[dry-run] .githooks/pre-commit 存在但不可执行 —— 不动权限（需人 chmod +x 后重跑）"
      fi
      return 0
    fi
    info "[dry-run] 既有 core.hooksPath=$hp —— 不动，只在其中补/前置 pre-commit 哨兵块"
    dir=$(hook_dir_resolved "$root" "$hp")
    if [ -n "$dir" ] && ! hook_dir_under_root "${root:-.}" "$dir"; then
      info "[dry-run] core.hooksPath 越界（钩子目录不在仓库根之下）：$hp → $dir —— 将拒绝装配（不写任何文件、不改权限；2.4 会 FAIL）"
      return 0
    fi
    if [ -z "$dir" ]; then
      info "[dry-run] hooksPath 目录不可达：$hp（2.4 会 FAIL）"
    elif [ ! -f "$dir/pre-commit" ]; then
      info "[dry-run] 将新建 $hp/pre-commit（A3）+ chmod +x"
    elif gate_hook_residue_foreign "$dir/pre-commit"; then
      info "[dry-run] $hp/pre-commit 含外来内容的哨兵残留（重复/未闭合 BEGIN 区间内有非规范行）—— 先于接线判定保护：零字节删除、只插入规范块（未接线时）+ WARN + 本次 init 非零（需人工清理）"
    elif [ "$(gate_hook_begin_count "$dir/pre-commit")" -gt 1 ]; then
      info "[dry-run] $hp/pre-commit 有多个哨兵块/残块（区间内均无外来内容）→ 将去重为一个规范块（rc=0）"
    elif gate_hook_wired "$dir/pre-commit"; then
      info "[dry-run] $hp/pre-commit 已接线（规范块 + 前置位置）—— 不动"
    elif [ -x "$dir/pre-commit" ]; then
      info "[dry-run] 将把规范哨兵块前置到 shebang 之后（原字节顺序与权限不动；旧块/半截块一并重建）"
    else
      info "[dry-run] $hp/pre-commit 存在但不可执行 —— 不动权限（需人 chmod +x 后重跑）"
    fi
    return 0
  fi

  # F2 锁：写段一律在 git 目录的 ponygo-init.lock 上持锁；非 git / 无 git 目录 → 无共享写目标，直跑
  local lockfile="" gd="" lk="" n=0
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    gd=$(git rev-parse --git-common-dir 2>/dev/null || true)
    [ -n "$gd" ] || gd=$(git rev-parse --git-dir 2>/dev/null || true)
    if [ -n "$gd" ]; then
      gd=$(cd "$gd" 2>/dev/null && pwd -P) || gd=""
      if [ -n "$gd" ] && [ -d "$gd" ]; then lockfile="$gd/ponygo-init.lock"; fi
    fi
  fi
  if [ -z "$lockfile" ]; then
    ensure_gate_wiring_locked
    return 0
  fi
  if command -v flock >/dev/null 2>&1; then
    # 注意：**不使用子 shell**（`( … ) 9>>lock`）——F4 的失败清单是 shell 变量，
    # 在子 shell 里登记的失败会随子 shell 退出一起消失（写失败就又被吞成 rc=0）。
    # 这里用 `exec 9>>` 在同一 shell 内持锁，装配结束后显式关闭 fd。
    if ! exec 9>>"$lockfile"; then
      warn "无法打开装配锁文件（$lockfile）→ 无锁继续；写入仍为 mktemp+mv 原子替换"
      ensure_gate_wiring_locked
      return 0
    fi
    flock -w 10 9 || warn "装配锁等待超时（10s，$lockfile）→ 继续；写入仍为 mktemp+mv 原子替换"
    ensure_gate_wiring_locked
    exec 9>&-
    return 0
  fi
  # 降级：mkdir 原子锁（无 flock 命令时；最多等 10s，超时也继续——原子替换仍保证不写出半截块）
  lk="$lockfile.d"
  while ! mkdir "$lk" 2>/dev/null; do
    n=$((n+1))
    if [ "$n" -ge 100 ]; then
      warn "装配锁等待超时（10s，$lk）→ 继续；写入仍为 mktemp+mv 原子替换"
      lk=""
      break
    fi
    sleep 0.1
  done
  ensure_gate_wiring_locked
  [ -n "$lk" ] && rmdir "$lk" 2>/dev/null
  return 0
}

# 装配主体（持锁调用；F2 要求获锁后**重新读取**再判定，故一切读操作都在这里）
ensure_gate_wiring_locked() {
  local root="" hp="" dir="" hook="" provid=""
  provid=$(ci_provider)

  # 0) F15 越界守卫：hooksPath 解析到仓库外（如 `core.hooksPath=..`）→ 拒绝装配。
  #    放在资产写入之前，保证「不写任何文件、不 chmod、不动 git config」；失败登记进
  #    装配失败清单 → cmd_init 非零（越界不是「装好了」，是「拒绝装」）。
  if gate_hooks_path_escape; then
    return 0
  fi

  # 1) A1/A2/A4：缺失才写 + 内容与规范不一致则自愈覆盖（F10）+ chmod +x
  write_gate_assets

  # 2) A5：只按 forge 证据生成（§6.3）；非 GitHub 不生成，由 status/audit 给可执行指引（不静默）。
  #    主 ci.yml 已有 governance 执行面时视为等价接线，不再生成重复的独立 workflow。
  if [ "$provid" = "github" ]; then
    if github_governance_wired; then
      info "远端层：GitHub 治理执行面已接线（A5 文件或 ci.yml governance job）——不重复生成"
    elif write_ci_adapter; then
      info "远端层：检出 GitHub → 生成 .github/workflows/ponygo-governance.yml（A5 薄壳，调 .meta/gates/ci-verify.sh）"
    else
      gate_write_fail ".github/workflows/ponygo-governance.yml" "写入失败（目录不可写/原子替换失败）——A5 薄适配器未能生成"
    fi
  else
    info "远端层：未检出 GitHub（provider=$provid）→ 不生成 A5；在你的 CI 里加一步 bash .meta/gates/ci-verify.sh（A4 门禁本体已就位）"
  fi

  # 3) 非 git：不设 hooksPath（R14），保持 exit 0，但必须明说补救路径（C2：不得静默缺席）
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    info "非 git 仓库：本地层钩子无从挂载——先 git init，再重跑 ponygo init（届时自动 git config core.hooksPath .githooks）"
    return 0
  fi
  root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [ -z "$root" ]; then
    warn "无法解析仓库根（git rev-parse --show-toplevel 为空）→ 跳过本地层装配"
    return 0
  fi

  # 4) hooksPath：未设 → 设为 .githooks 并回读校验（R13）；已设 → 一律不动（husky 绝对路径同，§6.1）
  local hp_self_set=0
  hp=$(git config core.hooksPath 2>/dev/null || true)
  if [ -z "$hp" ]; then
    git config core.hooksPath .githooks
    hp_self_set=1
    hp=$(git config core.hooksPath 2>/dev/null || true)
    if [ "$hp" = ".githooks" ]; then
      info "已设 core.hooksPath=.githooks（回读校验通过）"
    else
      warn "core.hooksPath 写入后回读不一致（期望 .githooks，实得 ${hp:-空}）→ 手工执行：git config core.hooksPath .githooks"
      return 0
    fi
  else
    info "既有 core.hooksPath=$hp —— 一律不动（改它会静默停用 husky 等既有装配），直接对该目录的 pre-commit 动手"
  fi

  # 5) 归一化钩子目录（R9）；目录不存在时只有「本函数刚设的 hooksPath」才代建——
  #    已设 hooksPath 指向不可达目录属实例配置错误，框架不替它猜（打印指引，2.4 会 FAIL）
  dir=$(hook_dir_resolved "$root" "$hp")
  if [ -z "$dir" ] && [ "$hp_self_set" = "1" ]; then
    mkdir -p "$root/$hp" && dir=$(hook_dir_resolved "$root" "$hp")
  fi
  if [ -z "$dir" ]; then
    warn "core.hooksPath 指向的目录不可达：$hp → 建该目录或改指 .githooks 后重跑 ponygo init（2.4 会 FAIL）"
    return 0
  fi
  hook="$dir/pre-commit"

  # 6) A3（F1/F2/F3 + F14/F17）：
  #    ① 哨兵残留含外来内容 → **先行保护**（独立于「是否已接线」：完整块 + 尾随 BEGIN + 用户行
  #       时文件是「已接线」的，先判接线就会跳过保护、把用户行删掉）；零字节删除 + WARN + 非零；
  #    ② 多个哨兵块/残块但区间内无外来内容 → 安全去重为一个规范块（rc=0）；
  #    ③ 已接线（逐字节等于规范块）且块前置于首个顶层早退行 → 一字不动；
  #    ④ 无块 / 半截块 / 块在早退行之后 → 一次原子替换重写为「shebang 之后前置的规范块」；
  #    ⑤ 首次播种（fresh=1）对「结构完整但内容非规范」的块只 WARN 不动字节——首次播种不得
  #       销毁既有钩子内容，合规性交给 2.4；再跑一次 init（has_meta 幂等装配分支）即重建。
  #    权限永不由框架改（沉睡钩子是人的决定，2.4 会因缺执行位 FAIL 并给出 chmod +x）。
  if [ ! -f "$hook" ]; then
    write_gate_hook "$hook" && info "新建 $hp/pre-commit（A3：marker + 规范哨兵块 + 非注释调用行）并 chmod +x"
  elif gate_hook_residue_foreign "$hook"; then
    # F14/F17：任何 BEGIN 的未闭合区间里含**外来内容** → **一个字节都不删**。
    # 已接线 → 一字不动，只 WARN + 非零；未接线 → 只在 shebang 之后插入规范块（其余行全留）。
    if gate_hook_wired "$hook"; then
      warn "[WARN] 检测到含外来内容的哨兵残留（重复/未闭合 BEGIN 区间内有非规范行），需人工清理：$hp/pre-commit"
      warn "  该钩子已接线，本次未改动任何字节（零丢失）——请人工清理残块后重跑 ponygo init"
      gate_write_fail "$hp/pre-commit" "哨兵残留含外来内容 → 未自愈（避免删除用户行），需人工清理残块后重跑 ponygo init"
    elif gate_hook_write_block "$hook" 0; then
      warn "[WARN] 检测到含外来内容的未闭合哨兵块（有 BEGIN 无 END），需人工清理：$hp/pre-commit"
      warn "  已只在 shebang 之后插入规范块，原文件每一行（含用户自有行）都保留——未删除任何字节；请人工清理残块后重跑 ponygo init"
      gate_write_fail "$hp/pre-commit" "未闭合哨兵块含外来内容 → 未自愈（避免删除用户行），需人工清理残块后重跑 ponygo init"
    else
      gate_write_fail "$hp/pre-commit" "写入失败（原子替换 mktemp/mv 失败，目录不可写？）——规范块未能插入"
    fi
  elif [ "$(gate_hook_begin_count "$hook")" -gt 1 ]; then
    # F17 正向对照：多个哨兵块/残块，但未闭合区间内全是规范行 → 可安全去重为一个规范块，rc=0
    if gate_hook_write_block "$hook"; then
      info "$hp/pre-commit 有多个哨兵块/残块（区间内均为规范行，无外来内容）→ 已去重为一个规范块（原字节顺序与权限不动）"
      [ -x "$hook" ] || info "提示：该钩子不可执行（沉睡钩子）——框架不改权限：chmod +x $hp/pre-commit"
    else
      gate_write_fail "$hp/pre-commit" "写入失败（原子替换/grep 失败，目录不可写？）——哨兵块未能去重"
    fi
  elif gate_hook_wired "$hook"; then
    if [ -x "$hook" ]; then
      info "$hp/pre-commit 已接线（规范哨兵块 + 前置位置 + 执行位）——不覆盖、不重复写"
    else
      info "$hp/pre-commit 已接线但缺执行位（git 会静默忽略）——不改权限：chmod +x $hp/pre-commit"
    fi
  elif [ "$fresh" = "1" ] && gate_hook_block_complete "$hook"; then
    warn "$hp/pre-commit 哨兵块非规范或位置在早退行之后（首次播种不改写既有块）→ 再跑一次 ponygo init 将按规范块重建（2.4 现报未接线）"
  elif gate_hook_write_block "$hook"; then
    warn "$hp/pre-commit 哨兵块非规范或位置在早退行之后 → 已重写为规范块并前置到 shebang 之后（原字节顺序与权限不动）"
    [ -x "$hook" ] || info "提示：该钩子不可执行（沉睡钩子）——框架不改权限：chmod +x $hp/pre-commit"
  else
    gate_write_fail "$hp/pre-commit" "写入失败（原子替换/grep 失败，目录不可写？）——哨兵块未能重建"
  fi
  return 0
}

# 治理门接线现场（status / audit 双挂；报告性输出，不改退出码——硬判据在 verify_ladder 2.4）
# 本地层结论**复用 gate_24_probe**（与 2.4 同一口径）；F5：未接线时按因给补救，
# 三类「装配前提未满足」（非 git / 目录不可达 / 钩子不可执行）不得给统一「bash ponygo init」。
# P1-2（2026-11-11）措辞降级：「已接线」→「已挂载」，并紧随一句「未验证门会拒绝」——
# 挂载只回答「钩子/适配器在不在位、字节对不对」，**不回答门是否真跑过**（2.4 判据语义不变，
# 六条 AND 一字未改）；验证入口是 opt-in 的 `ponygo audit --run-specs` 与 CI。
GATE_VERIFY_HINT='未验证门会拒绝（验证入口：`ponygo audit --run-specs` / CI）'
gate_wiring_report() {
  local provid="" state="" hp=""
  provid=$(ci_provider)
  hp=$(git config core.hooksPath 2>/dev/null || true)
  if gate_24_probe; then
    state="已挂载（${hp}/pre-commit → .meta/gates/adr-verify.sh，暂存区 ADR 门生效；$GATE_VERIFY_HINT）"
  else
    state="未接线（本地层不拦截暂存区 ADR）——因由：${G24_CAUSE}；补救：${G24_FIX}；$GATE_VERIFY_HINT"
  fi
  printf '治理门接线：%s\n' "$state"
  case "$provid" in
    github)
      if github_governance_wired; then
        printf '远端层：GitHub Actions 治理执行面已挂载（ponygo-governance.yml 或 ci.yml 的 governance job → bash .meta/gates/ci-verify.sh；%s）\n' "$GATE_VERIFY_HINT"
      else
        printf '远端层：GitHub 证据在但适配器缺失 → 补 bash ponygo init（会生成 .github/workflows/ponygo-governance.yml），或在 ci.yml 增加 governance job 调 bash .meta/gates/ci-verify.sh\n'
      fi
      ;;
    none)
      printf '远端层：无 CI（本地层已强制）→ 远端层未生效；补 .github/workflows/ponygo-governance.yml 或自有 CI 调 bash .meta/gates/ci-verify.sh\n'
      ;;
    *)
      # P1-3：非 GitHub forge 的「接了没接」由 other_forge_ci_wired 单点判定（非空 + 调用痕迹），
      # 与 1.10 载体判据同一口径——报告不再把「文件在场」说成「已接」。
      if other_forge_ci_wired "$provid"; then
        printf '远端层：%s 流水线已挂载 1.10 门（CI 文件内含 ci-verify / verify-note 调用；%s）\n' "$provid" "$GATE_VERIFY_HINT"
      else
        printf '远端层：检出 %s 但未接门（CI 文件为空或无 ci-verify / verify-note 调用痕迹）→ 在你的 CI 里加一步 bash .meta/gates/ci-verify.sh（A4 门禁本体已就位）\n' "$provid"
      fi
      ;;
  esac
  return 0
}

# ---------- 替代治理形态：检出 → 适配任务书（wave-5：不阻断 init） ----------
ADAPT_BOOK_DIR="$META_DIR/adaptation"
ADAPT_BOOK="$ADAPT_BOOK_DIR/alt-governance.md"

# 检出既有治理形态（"已认可替代物"条款），输出按固定序的 "路径<TAB>类别" 行（无命中输出空）。
# 类别：decision=决策载体 hook=本地钩子 ci=远端流水线 contract=协作契约 owner=代码所有权 agents=AI 常载命约
detect_alt_gov_hits() {
  local d
  for d in docs/adr docs/decisions docs/architecture/decisions; do
    [ -d "$d" ] && printf '%s\tdecision\n' "$d"
  done
  # [ -e ] 同时覆盖文件与目录（.github/workflows 是目录，其余是文件）
  for d in .pre-commit-config.yaml lefthook.yml .husky; do
    [ -e "$d" ] && printf '%s\thook\n' "$d"
  done
  # .github/workflows/：只装框架自己生成的 A5（ponygo-governance.yml）不算替代治理形态——
  # 框架自身产物不是「别家流水线」（否则模板仓/已接线实例会永久假 WARN）。
  if [ -d .github/workflows ] \
     && find .github/workflows -maxdepth 1 -type f ! -name 'ponygo-governance.yml' -print -quit 2>/dev/null | grep -q .; then
    printf '%s\tci\n' .github/workflows
  fi
  for d in .gitlab-ci.yml Jenkinsfile azure-pipelines.yml .drone.yml bitbucket-pipelines.yml; do
    [ -e "$d" ] && printf '%s\tci\n' "$d"
  done
  [ -e CONTRIBUTING.md ] && printf 'CONTRIBUTING.md\tcontract\n'
  [ -e CODEOWNERS ] && printf 'CODEOWNERS\towner\n'
  # 既有 AI 常载命约：文件存在且**不含** ponygo 标记（ponygo / BEGIN constitution）才算替代物
  for d in AGENTS.md CLAUDE.md; do
    [ -f "$d" ] || continue
    grep -qE 'ponygo|BEGIN constitution' "$d" 2>/dev/null || printf '%s\tagents\n' "$d"
  done
}

adapt_kind_label() {
  case "$1" in
    decision) printf '决策载体' ;;
    hook)     printf '本地钩子' ;;
    ci)       printf '远端流水线' ;;
    contract) printf '协作契约' ;;
    owner)    printf '代码所有权' ;;
    agents)   printf 'AI 常载命约' ;;
    *)        printf '未知' ;;
  esac
}

# 语义映射：与 .agents/notes / .githooks / ci-verify.sh / constitution 的对应关系
adapt_map_text() {
  case "$1" in
    decision) printf '与 `.agents/notes/` 同权——notes 是决策的唯一真源（lifecycle/class 归档 + `Status:` 头）；既有目录降级为历史存档，不再新增' ;;
    hook)     printf '与 `.githooks/`（A3 钩子）同权——pre-commit 的强制点唯一，哨兵块由框架前置插入，不双跑' ;;
    ci)       printf '与 `.meta/gates/ci-verify.sh`（A4 远端门）同权——流水线只做「调一步门」的薄壳，不承载判定逻辑' ;;
    contract) printf '与 `constitution` 同权——贡献流程属常载命约（`.meta/constitution/constitution.md` → 根 AGENTS.md / CLAUDE.md 投影）' ;;
    owner)    printf '与 `.meta/gates/` 的人审侧互补——机械门判「有没有/对不对」，CODEOWNERS 判「谁批」' ;;
    agents)   printf '与 ponygo 的常载命约投影同权——同一入口文件，ponygo 只占哨兵块区间（`<!-- BEGIN constitution -->`…`<!-- END constitution -->`）' ;;
  esac
}

# 唯一动作（每项只有一条可执行动作，不做迁移工程）
adapt_action_text() {
  case "$1" in
    decision) printf '既有决策目录原样保留只读（不迁移、不改写），新决策一律落 `.agents/notes/{lifecycle}/process/`；并落一条 `*alt-governance*.md` 写明两处分工' ;;
    hook)     printf '无需动手：框架已自动把哨兵块插入其 pre-commit，hooksPath 不动（若 `.pre-commit-config.yaml` 是外部框架的配置文件而 hooksPath 为空，框架挂 `.githooks`，两者同时生效但不重复跑同一脚本）' ;;
    ci)       printf '在既有流水线加一步 `bash .meta/gates/ci-verify.sh`，不要新建 workflow' ;;
    contract) printf '在既有 CONTRIBUTING.md 顶部加一行指向 `.meta/constitution/constitution.md` 与根 `AGENTS.md`（不迁移、不重写既有正文）' ;;
    owner)    printf '在 constitution 的 Mission 节写一句「CODEOWNERS 即人审门」，不新建第二份所有权文件' ;;
    agents)   printf '把既有正文与 ponygo 常载命约并入同一文件：ponygo 区块用哨兵块包裹，其余正文一字不动，随后 `ponygo sync` 只替换哨兵区间' ;;
  esac
}

# 完成判据（机器可查或一次人工确认）
adapt_done_text() {
  case "$1" in
    decision) printf '`.agents/notes/**/process/*alt-governance*.md` 存在，且写明旧决策目录「只读 / 新决策入 notes」' ;;
    hook)     printf '该配置的 pre-commit 内含 ponygo 哨兵块且 `git commit` 仍能通过；`ponygo status` 的 2.4 无 FAIL' ;;
    ci)       printf '流水线里出现 `bash .meta/gates/ci-verify.sh` 这一步，且一次 PR 运行通过' ;;
    contract) printf 'CONTRIBUTING.md 内出现指向 `.meta/constitution/constitution.md` 的路径' ;;
    owner)    printf 'constitution 的 Mission 节有一句明确 CODEOWNERS 是评审门' ;;
    agents)   printf '`AGENTS.md` / `CLAUDE.md` 同时含既有项目指令与 ponygo 标记区（`ponygo` / `BEGIN constitution`），重跑 `ponygo sync` 后既有正文不变' ;;
  esac
}

# 终端摘要用的极短句（一行一项）
adapt_short_text() {
  case "$1" in
    decision) printf '旧决策目录只读，新决策落 .agents/notes/' ;;
    hook)     printf '哨兵块已自动插入其 pre-commit，hooksPath 不动' ;;
    ci)       printf '流水线加一步 bash .meta/gates/ci-verify.sh，勿新建 workflow' ;;
    contract) printf '顶部加一行指向 .meta/constitution/ 与 AGENTS.md' ;;
    owner)    printf 'constitution 记一句「CODEOWNERS = 人审门」' ;;
    agents)   printf '与 ponygo 常载命约合并为同一文件（哨兵块隔离）' ;;
  esac
}

# 幂等重写任务书：命中即生成（内容纯函数 → 二次 init md5 不变）；无命中删文件。
# dry=1 时只打印计划，零落盘。
write_adaptation_book() {
  local dry="${1:-0}" hits n i path kind tmp
  hits=$(detect_alt_gov_hits)
  if [ -z "$hits" ]; then
    if [ -f "$ADAPT_BOOK" ]; then
      if [ "$dry" = "1" ]; then
        info "[dry-run] 已无替代治理形态 → 将删除 $ADAPT_BOOK"
      else
        rm -f "$ADAPT_BOOK"
        rmdir "$ADAPT_BOOK_DIR" 2>/dev/null
        info "已无替代治理形态——$ADAPT_BOOK 已移除"
      fi
    fi
    return 0
  fi
  n=$(printf '%s\n' "$hits" | wc -l | tr -d ' ')
  if [ "$dry" = "1" ]; then
    info "[dry-run] 将幂等重写 $ADAPT_BOOK（检出替代治理形态 $n 项）"
    return 0
  fi
  mkdir -p "$ADAPT_BOOK_DIR" 2>/dev/null
  tmp=$(mktemp "$ADAPT_BOOK_DIR/.alt-governance.XXXXXX" 2>/dev/null) || { warn "无法创建临时文件：适配任务书未更新（重跑 ponygo init）"; return 0; }
  {
    printf '# 替代治理形态适配任务书\n\n'
    printf '> 由 `ponygo init` 生成：**幂等重写，勿手工编辑**（检测清单真源 = `ponygo` 的 `detect_alt_gov_hits`）。\n'
    printf '> 本文件**不阻断**装配（`ponygo init` 照常完成，rc=0）；它替代「先别注入、先去 audit」的旧阻断叙事。\n'
    printf '> 未登记适配决策前 `ponygo status` / `ponygo audit` 会持续 WARN；全局完成判据 = 落一条\n'
    printf '> `.agents/notes/**/process/*alt-governance*.md` 写明下表各项的处置。\n\n'
    printf '## 检出项（%s 项）\n\n' "$n"
    printf '| # | 检出项 | 类别 |\n|---|---|---|\n'
    i=0
    while IFS="$(printf '\t')" read -r path kind; do
      i=$((i+1))
      printf '| %s | `%s` | %s |\n' "$i" "$path" "$(adapt_kind_label "$kind")"
    done <<EOF_HITS
$hits
EOF_HITS
    printf '\n## 逐项适配（检出项 → 语义映射 → 唯一动作 → 完成判据）\n'
    i=0
    while IFS="$(printf '\t')" read -r path kind; do
      i=$((i+1))
      printf '\n### %s. `%s`（%s）\n\n' "$i" "$path" "$(adapt_kind_label "$kind")"
      printf -- '- **检出项**：`%s`（%s）\n' "$path" "$(adapt_kind_label "$kind")"
      printf -- '- **语义映射**：%s\n' "$(adapt_map_text "$kind")"
      printf -- '- **唯一动作**：%s\n' "$(adapt_action_text "$kind")"
      printf -- '- **完成判据**：%s\n' "$(adapt_done_text "$kind")"
    done <<EOF_HITS
$hits
EOF_HITS
  } > "$tmp" 2>/dev/null
  if [ -f "$ADAPT_BOOK" ] && cmp -s "$tmp" "$ADAPT_BOOK"; then
    rm -f "$tmp"
    info "适配任务书已是最新：$ADAPT_BOOK（$n 项）"
  else
    if mv -f "$tmp" "$ADAPT_BOOK" 2>/dev/null; then
      chmod 644 "$ADAPT_BOOK" 2>/dev/null || true
      info "适配任务书已写入：$ADAPT_BOOK（$n 项）"
    else
      rm -f "$tmp"
      warn "写入失败：$ADAPT_BOOK（目录不可写）——适配任务书未更新"
    fi
  fi
  return 0
}

# 终端摘要：首行 N 项 + 任务书路径，每项一行，末行 WARN 提示；总行数恒 ≤ 6（>4 项折叠）
print_adaptation_summary() {
  local hits n i path kind shown=0 rest
  hits=$(detect_alt_gov_hits)
  [ -n "$hits" ] || return 0
  n=$(printf '%s\n' "$hits" | wc -l | tr -d ' ')
  info "检出替代治理形态 $n 项 → 适配任务书：$ADAPT_BOOK"
  if [ "$n" -le 4 ]; then
    while IFS="$(printf '\t')" read -r path kind; do
      info "  - $path（$(adapt_kind_label "$kind")）：$(adapt_short_text "$kind")"
    done <<EOF_HITS
$hits
EOF_HITS
  else
    while IFS="$(printf '\t')" read -r path kind; do
      shown=$((shown+1))
      if [ "$shown" -le 3 ]; then
        info "  - $path（$(adapt_kind_label "$kind")）：$(adapt_short_text "$kind")"
      fi
    done <<EOF_HITS
$hits
EOF_HITS
    rest=$((n-3))
    info "  + $rest 项见任务书"
  fi
  info "未登记适配决策前 status 会持续 WARN（完成判据：.agents/notes/**/process/*alt-governance*.md）"
  return 0
}

# ---------- 命令实现 ----------

cmd_init() {
  local dry=0
  [ "${DRY_RUN:-0}" = "1" ] && dry=1
  # wave-5：`--yes` 与交互确认已彻底移除，R15「非 TTY 且无 --yes → die」随之删除——
  # 无确认可等，非交互环境（CI / 管道 / </dev/null）与 TTY 走同一条路径。
  # --dry-run 语义不变：每个写点显式守 `dry`，dry 下零落盘、零 git config 变更。

  if has_meta; then
    info "已存在 .meta/ 治理根（level=$(read_level)）。"
    # F3/W1：--repair-skeleton 是**单一职责**的骨架补缺——只从 write_skeleton 模板补缺失文件
    # （只补 `! -f`，绝不覆盖既有文件）。它**不跑** ensure_gate_wiring（那里会按模板原子覆盖
    # A1/A2——实例加固过的门禁会被静默回滚，与「骨架零缺口…未写任何文件」自相矛盾）、
    # 不写适配任务书、不投影 constitution：输出只讲骨架事实。
    # 无 .meta/ 时本旗标不生效（走下面的既有「铺新骨架」语义，不额外报错）。
    if [ "${REPAIR_SKELETON:-0}" = "1" ]; then
      if ! repair_skeleton_gaps "$dry"; then
        gate_assembly_failed   # 打印已登记的写失败清单（无失败则静默返回）
        exit 1
      fi
      exit 0
    fi
    info "不重铺骨架；执行「交付即接线」幂等装配（缺什么补什么，既有文件一字不动）。"
    GATE_FRESH_SEED=0
    ensure_gate_wiring
    # F4：写入失败必须响亮——WARN + 失败清单 + 可执行补救，然后非零退出
    # （禁止裸 `Permission denied` 一行噪声 + rc=0：那等于「装配没做成但机器说成功」）
    gate_assembly_failed && exit 1
    write_adaptation_book "$dry"
    print_adaptation_summary
    info "完成（幂等装配）。下一步：ponygo status 看级自洽与门禁接线，ponygo audit 体检。"
    exit 0
  fi

  if looks_empty; then
    info "探测：空项目 / 新项目 → 全新铺骨架"
    if [ "$dry" = "1" ]; then
      info "[dry-run] 将在新项目根建立 .agents/ + .meta/ 治理骨架（level: 0）"
    else
      write_skeleton 0
    fi
  else
    if [ -n "$(detect_alt_gov_hits)" ]; then
      info "探测：有代码，且发现既有治理形态（已认可替代物）→ 照常装配，并生成适配任务书（不阻断）"
    else
      info "探测：有代码但无治理 → 注入骨架（不碰业务代码）"
    fi
    if [ "$dry" = "1" ]; then
      info "[dry-run] 注入 .agents/ + .meta/ 治理骨架到既有代码仓库（只增不改业务文件）"
    else
      write_skeleton 0
    fi
  fi

  # 「交付即接线」：A1/A2/A4 已随骨架落地，这里补本地层（hooksPath + A3 钩子）并按 forge 生成 A5。
  # 与 has_meta 分支共用同一函数——两个入口的装配语义必须一致（否则既有实例永远收不到改造）；
  # 唯一差别：首次播种（fresh=1）不重写「结构完整但内容非规范」的既有块，交给下一次 init 重建。
  # F8：fresh 路径在 --dry-run 下也必须走到这里——ensure_gate_wiring 的 dry-run 分支打印
  #     装配计划（hooksPath/A3/A5 的去向）后返回，全程零落盘、零 git config 改动。
  GATE_FRESH_SEED=1
  ensure_gate_wiring
  # F4：同 has_meta 分支——写失败一律非零退出
  gate_assembly_failed && exit 1

  # 替代治理形态 → 适配任务书（幂等；无命中删文件）；摘要打印在同步之前，WARN 指引先于「完成」行
  write_adaptation_book "$dry"
  print_adaptation_summary

  # 铺完骨架后始终投影：模板态投初始引导（bootstrap），已填槽投常载命约
  # （--dry-run 只打印计划：原来由 confirm_or_skip 的 dry-run 分支挡住 do_sync，这里显式守）
  if [ "$dry" = "1" ]; then
    info "[dry-run] 把 constitution 投影到根 AGENTS.md / CLAUDE.md（模板态投影初始引导）"
  else
    do_sync
  fi
  info "完成。当前 level=$(read_level)。下一步：ponygo status 查看骨架完整度。"
}

# ---------- F8：机读面（--json）——固定词表、禁自由文本、exit 字段 == 真实退出码 ----------
# 人类报告在 JSON 模式下整体改道 stderr（cmd_audit / cmd_status 入口 `exec 3>&1 1>&2`），
# stdout 只留**单行** JSON；WARN 本来就走 stderr，不混入机器通道。
# fails / gaps 只收**稳定 id**（判据号或固定枚举），绝不塞自由文本——词表变了先改契约。
level_as_int() { # <read_level 的原始值> → 整数；非法/缺失 → -1（JSON 只接受整数，不塞字符串）
  local lv="$1"
  case "$lv" in
    ''|*[!0-9]*) printf -- '-1' ;;
    *) printf '%s' "$lv" ;;
  esac
}
# P1-8（2026-11-11）：`level_declared > level_verified` 时人读面结论行显式写「已声明 Lx，仅验证到 Ly」。
# 为什么必须显式：`level:` 是**声明**（当前档位），本命令只机械验到 min(声明, 2)；两者差一档时
# 只印「级自洽验证：通过」会让人把「声明高」读成「已验证高」（假绿）。一致时零噪音（L0–L2 声明即验到）。
# 与 JSON 的 level_declared / level_verified 同源同一个 VL_VERIFIED_LEVEL（禁第二份计算）。
status_level_gap_line() { # <声明级（整数；非法/缺失 → 不打印）>
  local decl="${1:--1}" ver="${VL_VERIFIED_LEVEL:-0}" tail="未验证 ≠ 通过"
  case "$decl" in ''|*[!0-9]*) return 0 ;; esac
  case "$ver" in ''|*[!0-9]*) return 0 ;; esac
  [ "$decl" -gt "$ver" ] || return 0
  [ "$decl" -ge 3 ] && tail="未验证 ≠ 通过；L3–L5 属目标画像，按 maturity-ladder §2 的依赖清单自证"
  printf '已声明 L%s，仅验证到 L%s——差额 %s 档未验证（%s）\n' "$decl" "$ver" "$((decl-ver))" "$tail"
  return 0
}
gates_local_state() { # → wired|not_wired|skipped（与 2.4 / gate_wiring_report 同一 probe，禁第二口径）
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { printf 'skipped'; return 0; }
  if gate_24_probe; then printf 'wired'; else printf 'not_wired'; fi
}
# GitHub 远端执行面：独立 A5 文件，或主 ci.yml 内 `governance` job 直接跑 A4。
# 后一种是「同 workflow 可被聚合门 needs 消费」的形态，和 A5 等价接线，不得误报缺失。
github_governance_wired() {
  [ -f .github/workflows/ponygo-governance.yml ] && return 0
  [ -f .github/workflows/ci.yml ] || return 1
  awk '
    /^  governance:[[:space:]]*$/ { injob=1; next }
    injob && /^  [A-Za-z0-9_-]+:[[:space:]]*$/ { injob=0 }
    injob && /^[[:space:]]*-[[:space:]]*run:[[:space:]]*bash[[:space:]]+\.meta\/gates\/ci-verify\.sh[[:space:]]*$/ { found=1 }
    END { exit(found ? 0 : 1) }
  ' .github/workflows/ci.yml
}

gates_remote_state() { # → wired|missing|none|other（只按 forge 证据形状判定）
  local p=""
  p=$(ci_provider)
  case "$p" in
    none)   printf 'none' ;;
    github) if github_governance_wired; then printf 'wired'; else printf 'missing'; fi ;;
    *)      printf 'other' ;;
  esac
}

# 1.10（必含 ## Alternatives considered）的「门禁载体」判定 —— status / audit 的 coverage 结论唯一口径。
# 载体 = **接线点**：本地层（core.hooksPath 解析出的可执行 pre-commit；未设时看 .githooks/ 与
# .git/hooks/）或远端层（CI 适配器 / 其它 forge 的 CI 配置）。
# 语义边界：载体是"谁会在 commit/CI 时真的跑 1.10 的判定"，**不是**"A1 资产文件是否存在"——
# 一个没人调用的脚本证明不了有人在跑它（诚实条款）。故只探测接线点，不把资产存在性当载体。
# **只做存在性/权限探测**，不执行任何仓库脚本（只读命令边界，C3）。
lv110_carrier() {
  local hp="" hd=""
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    hp=$(git config core.hooksPath 2>/dev/null)
  fi
  if [ -n "$hp" ]; then
    hd="$hp"
    if [ -f "$hd/pre-commit" ] && [ -x "$hd/pre-commit" ]; then return 0; fi
  else
    hd=".githooks"
    if [ -f "$hd/pre-commit" ] && [ -x "$hd/pre-commit" ]; then return 0; fi
    if [ -f ".git/hooks/pre-commit" ] && [ -x ".git/hooks/pre-commit" ]; then return 0; fi
  fi
  local p=""
  p=$(ci_provider)
  case "$p" in
    none) return 1 ;;
    github) github_governance_wired && return 0; return 1 ;;
    # P1-3（2026-11-11）：非 GitHub forge 不再「有文件即算载体」——须该 forge 的 CI 文件非空
    # 且含 ci-verify / verify-note 调用痕迹（other_forge_ci_wired 单点判定）。零字节占位
    # 或跑别的流水线的配置 → 载体缺失，1.10 进 unverified（不放行）。
    *) other_forge_ci_wired "$p" && return 0; return 1 ;;
  esac
}

# status 的「环境依赖」行（Wave13 P3-6）：一行暴露运行时依赖，缺项 ✗；不改退出码、不写仓库文件。
# 探针冻结（契约 §8.1）：git --version / GNU date -d @0 / 临时目录 find -printf /
# mktemp 单文件 sed -i（**禁写仓库**）/ observe skill 目录 + references/contract.json。
# 探针临时资源的清理（信号落在探针窗口也不泄漏：EXIT/INT/TERM 三钩共用，幂等）
ENVPROBE_DIR=""
ENVPROBE_FILE=""
status_env_cleanup() {
  if [ -n "${ENVPROBE_DIR:-}" ]; then rm -rf "$ENVPROBE_DIR" 2>/dev/null || true; ENVPROBE_DIR=""; fi
  if [ -n "${ENVPROBE_FILE:-}" ]; then rm -f "$ENVPROBE_FILE" 2>/dev/null || true; ENVPROBE_FILE=""; fi
  return 0
}
status_env_line() {
  local m_git='✗' m_date='✗' m_find='✗' m_sed='✗' m_obs='✗' d=""
  local t_exit="" t_int="" t_term=""
  # 三钩收口（与 skeleton_drift / cmd_upgrade 同款）：SIGTERM/SIGINT 落在 mktemp 窗口不得残留
  t_exit=$(trap -p EXIT); t_int=$(trap -p INT); t_term=$(trap -p TERM)
  trap 'status_env_cleanup' EXIT
  trap 'status_env_cleanup; observe_tmp_cleanup; trap - EXIT INT TERM; exit 130' INT
  trap 'status_env_cleanup; observe_tmp_cleanup; trap - EXIT INT TERM; exit 143' TERM
  if command -v git >/dev/null 2>&1 && git --version >/dev/null 2>&1; then m_git='✓'; fi
  if date -d @0 '+%Y' >/dev/null 2>&1; then m_date='✓'; fi
  ENVPROBE_DIR=$(mktemp -d 2>/dev/null) || ENVPROBE_DIR=""
  if [ -n "$ENVPROBE_DIR" ]; then
    if ( cd "$ENVPROBE_DIR" && find . -maxdepth 0 -printf '%f' 2>/dev/null | grep -q . ); then m_find='✓'; fi
  fi
  ENVPROBE_FILE=$(mktemp 2>/dev/null) || ENVPROBE_FILE=""
  if [ -n "$ENVPROBE_FILE" ]; then
    printf 'a\n' >"$ENVPROBE_FILE" 2>/dev/null || true
    if sed -i 's/a/b/' "$ENVPROBE_FILE" >/dev/null 2>&1; then m_sed='✓'; fi
  fi
  d=$(observe_skill_dir_soft 2>/dev/null)
  if [ -n "${d:-}" ] && [ -d "$d" ] && [ -f "$d/references/contract.json" ]; then m_obs='✓'; fi
  status_env_cleanup
  if [ -n "$t_exit" ]; then eval "$t_exit"; else trap - EXIT; fi
  if [ -n "$t_int" ]; then eval "$t_int"; else trap - INT; fi
  if [ -n "$t_term" ]; then eval "$t_term"; else trap - TERM; fi
  printf '环境：git %s / GNU date %s / find -printf %s / sed -i %s / observe skill %s\n' \
    "$m_git" "$m_date" "$m_find" "$m_sed" "$m_obs"
}
json_escape() { # <任意字符串> → JSON 安全的内容（不含外层引号；W9-B7）
  # 严格转义 `"`、`\`、换行/回车/制表符与其余 C0 控制字符（→ \u00XX）；非 ASCII 原样保留（UTF-8 直出）。
  awk 'BEGIN{
    s = ARGV[1]
    gsub(/\\/, "\\\\", s)
    gsub(/"/,  "\\\"", s)
    gsub(/\t/, "\\t", s); gsub(/\r/, "\\r", s); gsub(/\n/, "\\n", s)
    for (i = 1; i < 32; i++) {
      if (i == 9 || i == 10 || i == 13) continue
      gsub(sprintf("%c", i), sprintf("\\u%04x", i), s)
    }
    printf "%s", s
  }' "$1"
}
json_id_list() { # <空格分隔的 id 列表> → "a","b"（空输入 → 空；元素为受控 token，无需转义）
  local v out=""
  for v in $1; do out="${out}${out:+,}\"${v}\""; done
  printf '%s' "$out"
}
json_path_list() { # <空格分隔的仓库相对路径> → "a","b"（空 → 空；路径按 JSON 规则转义）
  local v out=""
  for v in $1; do out="${out}${out:+,}\"$(json_escape "$v")\""; done
  printf '%s' "$out"
}
# 配对豁免门（P1-1 / 2026-11-11）：UPGRADE_UNIVERSE 里「有门无同名 spec」的框架门资产。
# 为什么需要这份清单：判据 2.3 要求实例门配同名负样本 spec，而框架门 ci-verify.sh（A4）由
# `ci-verify.sh` 整树跑、无独立 spec——它属**框架侧**豁免，不是实例欠账。把豁免清单从宇宙表
# **派生**（不手抄第二个名单），保证新增框架门时清单自动跟随；JSON 的 exempt_gates 与将来
# 的报告/门禁共用这一处实现（禁第二副本）。
exempt_gate_names() { # → 逐个打印豁免门文件名（至少有 ci-verify.sh）
  local f base stem rel have_spec
  for f in $UPGRADE_UNIVERSE; do
    case "$f" in .meta/gates/*) ;; *) continue ;; esac
    base="${f##*/}"
    # 只认**门禁脚本**（.sh / .ps1）：宇宙表同目录下还有 README.md（契约文档，不是门），
    # 把它算进豁免清单等于给「配对豁免」开一个不可复核的洞。
    case "$base" in
      *.spec.*) continue ;;
      *.sh|*.ps1) ;;
      *) continue ;;
    esac
    stem="${base%.sh}"; stem="${stem%.ps1}"
    have_spec=0
    for rel in $UPGRADE_UNIVERSE; do
      case "$rel" in
        ".meta/gates/${stem}.spec."*) have_spec=1; break ;;
      esac
    done
    [ "$have_spec" = "1" ] || printf '%s\n' "$base"
  done
}
json_exempt_gates() { # → "exempt_gates":[...]（单项文件名；空 → []）
  local v out=""
  for v in $(exempt_gate_names); do out="${out}${out:+,}\"${v}\""; done
  printf '"exempt_gates":[%s]' "$out"
}
# miss_ids（P1-1）：**未达标判据的稳定 id**（级自洽 fail ∪ 缺口 id；去重；hits ≥ total 时为空 = []）。
# 语义边界：这是「缺了什么证据」的机器词表，不是自由文本；与 level_verified 独立——
# 未验证 ≠ 通过，两者都不得靠声明抬价。
json_miss_ids() { # <hits|-> <total|-> [额外 id 列表]
  local h="$1" t="$2" extra="${3:-}" ids="" v seen="" out=""
  if [ "$h" = "-" ]; then
    # status：无四问计分；缺项 = 级自洽判据（verdict 非 pass 时）
    [ "${VL_VERDICT:-unverified}" = "pass" ] && { printf ''; return 0; }
    ids="${VL_FAIL_IDS:-}"
  else
    [ "$h" -ge 0 ] 2>/dev/null || { printf ''; return 0; }
    [ "$t" -gt 0 ] 2>/dev/null || { printf ''; return 0; }
    [ "$h" -lt "$t" ] || { printf ''; return 0; }
    ids="${VL_FAIL_IDS:-}${extra:+${VL_FAIL_IDS:+ }$extra}"
  fi
  for v in $ids; do
    case " $seen " in *" $v "*) continue ;; esac
    seen="$seen $v"; out="${out}${out:+,}\"${v}\""
  done
  printf '%s' "$out"
}
json_warnings() { # P1-10：残留投影等人工处置项 → "warnings":[...]（稳定 id：<类别>:<文件>）
  # 只收**可处置**告警（不是自由文本、不是退出码依据）：`residual_projection:AGENTS.md` 表示
  # 「声明已关掉 AI 投影但该文件仍留 BEGIN 哨兵块」——机器可据此提醒人手工删块。
  local v out=""
  for v in ${RESID_PROJ_FILES:-}; do out="${out}${out:+,}\"residual_projection:${v}\""; done
  printf '"warnings":[%s]' "$out"
}
json_coverage() { # 判据覆盖块 → "coverage":{...}（status / audit **同源**，禁第二副本）
  # L1 未实际运行（含 L0、无 meta 与提前退出）时不得沿用任何非空 verified 默认值。
  # L1 已跑时才按 1.9b 的真实判定状态区分；1.10 始终只读未执行，不冒充已验证。
  if [ "${L1_JUDGED:-0}" != "1" ]; then
    printf '%s' '"coverage":{"verified":[],"unverified":["1.1-1.10"],"reason":"l1-not-run"}'
  elif [ "${AS19_JUDGED:-0}" = "1" ]; then
    printf '%s' '"coverage":{"verified":["1.1-1.9"],"unverified":["1.10"],"reason":"readonly-no-repo-exec"}'
  else
    printf '%s' '"coverage":{"verified":["1.1-1.8"],"unverified":["1.10"],"skipped":["1.9b"],"reason":"readonly-no-repo-exec"}'
  fi
}
audit_json_line() { # <exit code> → 单行 JSON
  # coverage：判据覆盖固定词表（1.10 不由本命令验证）；drift：骨架漂移观察项（不参与退出码）。
  # skills：技能三层归属块（spec §5.5；与 status **同源** compute_skills_state + json_skills）。
  # 键序不作为契约（只保证字段存在/值正确），但保持**单行**。
  # P1-1（2026-11-11）：level_declared/level_verified 分离（未验证 ≠ 通过）、miss_ids（未达标判据
  # id）、exempt_gates（配对豁免门，派生自 UPGRADE_UNIVERSE）。四者与 status 同源同词表。
  printf '{"schema":"ponygo.audit/1","command":"audit","tier":"%s","hits":%s,"total":%s,"level":%s,"level_declared":%s,"level_verified":%s,"ladder":{"verdict":"%s","fails":[%s]},"gates":{"local":"%s","remote":"%s"},"miss_ids":[%s],%s,"gaps":[%s],%s,%s,%s,"drift":{"count":%s,"files":[%s]},"exit":%s}\n' \
    "${AUDIT_TIER:-S}" "${AUDIT_HIT:-0}" "${AUDIT_TOTAL:-0}" "${AUDIT_LEVEL_INT:--1}" \
    "${AUDIT_LEVEL_INT:--1}" "${VL_VERIFIED_LEVEL:-0}" \
    "${VL_VERDICT:-unverified}" "$(json_id_list "${VL_FAIL_IDS:-}")" \
    "$(gates_local_state)" "$(gates_remote_state)" \
    "$(json_miss_ids "${AUDIT_HIT:-0}" "${AUDIT_TOTAL:-0}" "${AUDIT_GAP_IDS:-}")" "$(json_exempt_gates)" \
    "$(json_id_list "${AUDIT_GAP_IDS:-}")" "$(json_coverage)" "$(json_skills)" "$(json_warnings)" \
    "${AUDIT_DRIFT_COUNT:--1}" "$(json_path_list "${AUDIT_DRIFT_FILES:-}")" "$1"
}
status_json_line() { # <exit code> → 单行 JSON（W9-B2：skeleton 三字段是**仓库相对路径数组**，非计数）
  # coverage：判据覆盖固定词表（lv=0 也带，词表不随级别变化）；drift 在 skeleton 内（与人类输出同源）。
  # skills：技能三层归属块（spec §5.5；库缺失在 library.missing，不并入 skeleton.missing_files）。
  # P1-1（2026-11-11）：与 audit 同源的四字段（level_declared/level_verified/miss_ids/exempt_gates）。
  printf '{"schema":"ponygo.status/1","command":"status","level":%s,"level_declared":%s,"level_verified":%s,"skeleton":{"missing_dirs":[%s],"missing_files":[%s],"drift":[%s]},"gates":{"local":"%s","remote":"%s"},"ladder":{"verdict":"%s","fails":[%s]},"miss_ids":[%s],%s,%s,%s,%s,"exit":%s}\n' \
    "${STATUS_LEVEL_INT:--1}" "${STATUS_LEVEL_INT:--1}" "${VL_VERIFIED_LEVEL:-0}" \
    "$(json_path_list "${STATUS_MISSING_DIRS:-}")" \
    "$(json_path_list "${STATUS_MISSING_FILES:-}")" "$(json_path_list "${STATUS_DRIFT:-}")" \
    "$(gates_local_state)" "$(gates_remote_state)" \
    "${VL_VERDICT:-unverified}" "$(json_id_list "${VL_FAIL_IDS:-}")" \
    "$(json_miss_ids "-" "-")" "$(json_exempt_gates)" "$(json_coverage)" "$(json_skills)" "$(json_warnings)" "$1"
}
json_verdict_fallback() { # <exit code>：ladder 未落 verdict 时的兜底（W9-A3）
  # exit 3 = 证据不足，不是硬失败；其余非零仍按 fail，0 且未判定则为 unverified。
  if [ -z "${VL_VERDICT:-}" ]; then
    if [ "$1" = "3" ]; then VL_VERDICT="unverified";
    elif [ "$1" != "0" ]; then VL_VERDICT="fail";
    else VL_VERDICT="unverified"; fi
  fi
}
audit_done() { # <exit code>：JSON 模式先把单行 JSON 送到原 stdout（fd 3），再按真实码退出
  json_verdict_fallback "$1"
  if [ "${AUDIT_JSON:-0}" = "1" ]; then audit_json_line "$1" >&3; fi
  exit "$1"
}
status_done() { # <exit code>
  json_verdict_fallback "$1"
  if [ "${STATUS_JSON:-0}" = "1" ]; then status_json_line "$1" >&3; fi
  exit "$1"
}

# ============================================================
# 技能三层归属（spec-ponygo-v2.6 §2 / §5.1–§5.5）
#   基线     = .agents/skills/{write-adr,change-review,governance-review}（模板逐字节锁，不计 L3）
#   模板库   = .meta/skills-library/（init 播种、**不自动安装**；= OPTIONAL_UNIVERSE 九文件）
#   实例自有 = 其余 .agents/skills/*（L3 唯一证据来源）
# 只读纪律：只做存在性探测 / sha256 比较 / 文本解析，**不执行**任何仓库脚本
#   （含 install.sh 的 check——判定优先只读，见文件头 C3）。
# 归属真源 = 文件位置 + `.ponygo-installed` 标记；副本三态与 install.sh check 同一口径
#   （spec §3.2：modified 优先，其次 stale，否则 ok），此处不另立第二套判定。
# ============================================================
SKILLS_LIBRARY_DIR="$META_DIR/skills-library"
SKILL_CATALOG="$SKILLS_LIBRARY_DIR/catalog.tsv"
SKILL_MARKER_FILE=".ponygo-installed"
SKILL_BASELINE_NAMES="write-adr change-review governance-review"

# sha256 比较依赖 GNU sha256sum（与 .meta/gates 既有资产同一平台前提：GNU 用户态）。
skill_sha() { sha256sum "$1" 2>/dev/null | awk '{print $1}'; }

skill_names() { # → 逐个打印 .agents/skills/ 下的技能名（以 SKILL.md 在场为「是技能」）
  local d="" n=""
  [ -d "$SKILLS_DIR" ] || return 0
  for d in "$SKILLS_DIR"/*/; do
    [ -d "$d" ] || continue
    [ -f "$d/SKILL.md" ] || continue
    n="${d%/}"
    printf '%s\n' "${n##*/}"
  done
}

skill_marked() { # <name> → 0 = 该技能是库安装副本（带 .ponygo-installed 标记）
  [ -f "$SKILLS_DIR/$1/$SKILL_MARKER_FILE" ]
}

skill_copy_exists() { # <name> → 0 = .agents/skills/<name> 已有副本（不论带不带标记）
  [ -d "$SKILLS_DIR/$1" ]
}

skill_marker_sha() { # <marker 文件> → library_sha256 值（无该行则空）
  sed -n 's/^library_sha256=//p' "$1" 2>/dev/null | head -n1 | tr -d '[:space:]'
}

skill_copy_state() { # <name> → ok|stale|modified|-（- = 非库安装副本）
  # 三态口径同 spec §3.2：本地改过（installed sha ≠ marker.library_sha256）= modified（优先）；
  # 否者库已更新或库侧已不可得（library sha 缺失/不等 marker）= stale；否则 ok。
  local n="$1" mf="$SKILLS_DIR/$1/$SKILL_MARKER_FILE" msha="" inst="" cur=""
  [ -f "$mf" ] || { printf '%s' '-'; return 0; }
  msha=$(skill_marker_sha "$mf")
  inst=$(skill_sha "$SKILLS_DIR/$n/SKILL.md")
  cur=$(skill_sha "$SKILLS_LIBRARY_DIR/$n/SKILL.md")
  if [ -n "$msha" ] && [ "$inst" != "$msha" ]; then
    printf '%s' 'modified'
  elif [ -z "$msha" ] || [ -z "$cur" ] || [ "$cur" != "$msha" ]; then
    printf '%s' 'stale'
  else
    printf '%s' 'ok'
  fi
}

skill_fm_field() { # <SKILL.md> <键> → frontmatter（首个 --- 区块）内该键的值；无则空
  awk -v k="$2" '
    NR == 1 { if ($0 !~ /^---[[:space:]]*$/) exit; infm = 1; next }
    infm && /^---[[:space:]]*$/ { exit }
    infm {
      i = index($0, ":"); if (i < 2) next
      key = substr($0, 1, i - 1); gsub(/[[:space:]]/, "", key)
      if (key != k) next
      v = substr($0, i + 1); sub(/^[[:space:]]+/, "", v); sub(/[[:space:]]+$/, "", v)
      print v; exit
    }
  ' "$1" 2>/dev/null
}

skill_description_ok() { # <SKILL.md> → 0 = frontmatter description 内联触发词（spec §3.3）
  local desc=""
  desc=$(skill_fm_field "$1" description)
  [ -n "$desc" ] || return 1
  printf '%s' "$desc" | grep -Eqi '何时用|use when|when to use|trigger'
}

skill_missing_sections() { # <SKILL.md> → 缺失要素标签（空格分隔；空 = 四要素齐）
  # 四要素（spec §3.3 / §5.2 3.4）：`## 真相源` / `## 步骤` / `## 校准样例` / `## 验证与报告`，
  # 允许英文等价；**围栏感知**——围栏内的标题不算在场（复用 heading_outside_fence，
  # 与 1.8/1.10 同一实现，禁第二份围栏解析）。标题用前缀匹配而非整行等值：既有基线写法
  # `## 真相源（冲突以它们为准）` 必须算在场。
  local f="$1" miss=""
  heading_outside_fence "$f" '## (真相源|Truth sources)'                || miss="$miss 真相源"
  heading_outside_fence "$f" '## (步骤|Steps)'                          || miss="$miss 步骤"
  heading_outside_fence "$f" '## (校准样例|Calibration examples)'        || miss="$miss 校准样例"
  heading_outside_fence "$f" '## (验证与报告|Verification and report)'   || miss="$miss 验证与报告"
  printf '%s' "$miss"
}

skill_shape_audit() { # 3.3 / 3.4 逐技能判定 → SKILL_SHAPE_BAD_33 / SKILL_SHAPE_BAD_34 / SKILL_FAIL_LINES
  # FAIL 行的三要素：判据号 + 技能名 + 缺什么 + **最小修法**（spec §5.2 要求逐技能逐项打印）。
  local n="" f="" nm="" miss="" fix=""
  SKILL_SHAPE_BAD_33=0; SKILL_SHAPE_BAD_34=0; SKILL_FAIL_LINES=""
  for n in $(skill_names); do
    f="$SKILLS_DIR/$n/SKILL.md"
    nm=$(skill_fm_field "$f" name)
    if [ "$nm" != "$n" ]; then
      SKILL_SHAPE_BAD_33=1
      SKILL_FAIL_LINES="${SKILL_FAIL_LINES}  - 3.3 ${n}：frontmatter name 与目录不同名（实得 '${nm:-空}'）"$'\n'
      SKILL_FAIL_LINES="${SKILL_FAIL_LINES}    修法：把 SKILL.md 头部改为 name: ${n}（kebab-case，必须与目录同名）"$'\n'
    elif ! printf '%s' "$nm" | grep -qE '^[a-z0-9]+(-[a-z0-9]+)*$'; then
      SKILL_SHAPE_BAD_33=1
      SKILL_FAIL_LINES="${SKILL_FAIL_LINES}  - 3.3 ${n}：name 不是 kebab-case（实得 '${nm}'）"$'\n'
      SKILL_FAIL_LINES="${SKILL_FAIL_LINES}    修法：改为 name: ${n}（小写字母/数字，单词间用连字符）"$'\n'
    fi
    if ! skill_description_ok "$f"; then
      SKILL_SHAPE_BAD_33=1
      if [ -z "$(skill_fm_field "$f" description)" ]; then
        SKILL_FAIL_LINES="${SKILL_FAIL_LINES}  - 3.3 ${n}：frontmatter 缺 description（或首行不是 --- 区块）"$'\n'
        SKILL_FAIL_LINES="${SKILL_FAIL_LINES}    修法：首两行写 --- / name / description，description 以「何时用：…」开头"$'\n'
      else
        SKILL_FAIL_LINES="${SKILL_FAIL_LINES}  - 3.3 ${n}：description 未内联触发词（缺 何时用 / Use when / When to use / trigger）"$'\n'
        SKILL_FAIL_LINES="${SKILL_FAIL_LINES}    修法：description 写成「何时用：<用变更本身的可见特征写触发条件>」"$'\n'
      fi
    fi
    miss=$(skill_missing_sections "$f")
    if [ -n "$miss" ]; then
      SKILL_SHAPE_BAD_34=1
      SKILL_FAIL_LINES="${SKILL_FAIL_LINES}  - 3.4 ${n}：缺要素${miss}"$'\n'
      SKILL_FAIL_LINES="${SKILL_FAIL_LINES}    修法：补齐缺失小节（英文等价可用：## Truth sources / ## Steps / ## Calibration examples / ## Verification and report；围栏内的标题不算在场）"$'\n'
    fi
  done
  return 0
}

skill_evidence_met() { # <kind> <arg> <min> → 0 = 证据达阈值；1 = 未达/不可求值。副作用：SK_EV_TEXT
  # 证据求值口径 = spec §3.1 的封闭集合；`min` 对布尔型 kind 忽略（写 1）。
  local kind="$1" arg="$2" min="$3" n=0 d="" hit="" td="" ci="" c="" sr=""
  SK_EV_TEXT=""
  case "$kind" in
    none) SK_EV_TEXT="catalog 声明 none（永不建议）"; return 1 ;;
    notes_class)
      d="$DECISIONS_DIR/implemented/$arg"
      if [ -n "$arg" ] && [ "$arg" != "-" ] && [ -d "$d" ]; then
        n=$(find "$d" -maxdepth 1 -type f -name '*.md' ! -name 'README.md' ! -name '*.zh.md' 2>/dev/null | wc -l | tr -d ' ')
      fi
      SK_EV_TEXT="implemented/${arg} 决策 ${n} 篇（阈值 ${min}）"
      [ "${n:-0}" -ge "${min:-1}" ] 2>/dev/null && return 0
      return 1 ;;
    archive_sealed)
      if [ -f "$DECISIONS_DIR/archived/manifest.sha256" ]; then
        n=$(tr -d '\r' < "$DECISIONS_DIR/archived/manifest.sha256" 2>/dev/null | grep -cE '^[0-9a-f]{64}  .' || true)
      fi
      SK_EV_TEXT="已封印归档件 ${n} 条（阈值 ${min}）"
      [ "${n:-0}" -ge "${min:-1}" ] 2>/dev/null && return 0
      return 1 ;;
    docs_scale)
      # 非 .agents/notes/ 的 *.md 计数；.git / .scratch / node_modules 是噪声面，排除。
      n=$(find . -type f -name '*.md' -not -path './.git/*' -not -path './.agents/notes/*' \
            -not -path './.scratch/*' -not -path '*/node_modules/*' 2>/dev/null | wc -l | tr -d ' ')
      SK_EV_TEXT="notes 之外的文档 ${n} 篇（阈值 ${min}）"
      [ "${n:-0}" -ge "${min:-1}" ] 2>/dev/null && return 0
      return 1 ;;
    web_dirs)
      for d in src app web ui packages/client; do [ -e "$d" ] && { hit="$d"; break; }; done
      SK_EV_TEXT="Web 面目录 ${hit:-无}"
      [ -n "$hit" ] && return 0
      return 1 ;;
    test_dirs)
      for d in tests test spec __tests__; do [ -d "$d" ] && { td="$d"; break; }; done
      for c in .github/workflows .gitlab-ci.yml bitbucket-pipelines.yml azure-pipelines.yml .drone.yml Jenkinsfile ci; do
        [ -e "$c" ] && { ci="$c"; break; }
      done
      SK_EV_TEXT="测试目录 ${td:-无} + CI 配置 ${ci:-无}"
      [ -n "$td" ] && [ -n "$ci" ] && return 0
      return 1 ;;
    release_surface)
      for d in CHANGELOG*; do [ -e "$d" ] && { sr="$d"; break; }; done
      if [ -z "$sr" ] && [ -d bin ]; then sr="bin/"; fi
      if [ -z "$sr" ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        [ -n "$(git tag 2>/dev/null | head -n1)" ] && sr="git tag"
      fi
      SK_EV_TEXT="发布面 ${sr:-无}"
      [ -n "$sr" ] && return 0
      return 1 ;;
    *) SK_EV_TEXT="未知 evidence_kind '${kind}'（catalog 语法违例）"; return 1 ;;
  esac
}

skill_catalog_eval() { # catalog.tsv × evidence → SK_CANDIDATES（未装且达阈值）/ SK_RETIRE（已装但证据消失）
  # 只读、不安装、不计分、不改退出码（spec §5.3）；一行一条技能，禁止刷屏。
  local name="" kind="" arg="" min="" hint="" met=0
  SK_CANDIDATES=""; SK_RETIRE=""
  [ -f "$SKILL_CATALOG" ] || return 0
  while IFS=$'\t' read -r name kind arg min hint; do
    name=$(printf '%s' "$name" | tr -d '[:space:]')
    case "$name" in ''|'#'*) continue ;; esac
    kind=$(printf '%s' "$kind" | tr -d '[:space:]')
    arg=$(printf '%s' "$arg" | tr -d '[:space:]')
    min=$(printf '%s' "$min" | tr -d '[:space:]')
    hint=$(printf '%s' "$hint" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -n "$kind" ] || continue
    case "$arg" in ''|-) arg="-" ;; esac
    case "$min" in ''|*[!0-9]*) min=1 ;; esac
    case "$kind" in
      notes_class|archive_sealed|docs_scale|web_dirs|test_dirs|release_surface|none) ;;
      *) printf 'ponygo: WARN %s：未知 evidence_kind（%s）→ 该行不求值；合法集合见 spec §3.1\n' "$SKILL_CATALOG" "$kind" >&2 ;;
    esac
    if skill_evidence_met "$kind" "$arg" "$min"; then met=1; else met=0; fi
    if [ "$met" = "1" ] && ! skill_copy_exists "$name"; then
      # 第 4 字段 = 可安装性：`ok` = 库模板在场（打印可复制的安装命令）；
      # `template_missing` = catalog 有行但库内 <name>/SKILL.md 不在场 → **禁止**打印
      # `install.sh install <name>`（该调用会 exit 2 且不写盘），改指 'ponygo init --repair-skeleton'。
      if [ -f "$SKILLS_LIBRARY_DIR/$name/SKILL.md" ]; then
        SK_CANDIDATES="${SK_CANDIDATES}${name}"$'\t'"${SK_EV_TEXT}"$'\t'"${hint}"$'\t'ok$'\n'
      else
        SK_CANDIDATES="${SK_CANDIDATES}${name}"$'\t'"${SK_EV_TEXT}"$'\t'"${hint}"$'\t'template_missing$'\n'
      fi
    elif [ "$met" = "0" ] && skill_copy_exists "$name" && [ "$kind" != "none" ]; then
      SK_RETIRE="${SK_RETIRE}${SK_RETIRE:+ }${name}"
    fi
  done < <(sed 's/\r$//' "$SKILL_CATALOG" 2>/dev/null)
  return 0
}

compute_skills_state() { # 一次求值，供 audit 计分面 / status·audit 机读面共用（禁第二份口径）
  # 结果（文件级变量；调用方读）：
  #   SKILLS_JUDGED      1 = 本次**真的判过**（JSON 才允许投影成数组；未判不得投影为 [] 通过）
  #   SK_BASELINE_MISSING 基线缺口（空格分隔路径）；SK_BASELINE_OK = 基线技能三篇在场数
  #   SK_LIB_MISSING     库九文件缺口；SK_LIB_INSTALLED = "name:state" 列表；SK_LIB_INSTALLED_N
  #   SK_INSTANCE_OWNED  实例自有技能名；SK_INSTANCE_N
  #   SKILL_LIB_BAD      非 ok 的已装副本 "name:state"；SK_SKILL_N = 技能总数
  #   SKILL_SHAPE_BAD_33 / SKILL_SHAPE_BAD_34 / SKILL_FAIL_LINES / SKILL_HARD_FAIL
  #   SK_CANDIDATES / SK_RETIRE
  SKILLS_JUDGED=1
  SK_BASELINE_MISSING=""; SK_BASELINE_OK=0; SK_LIB_MISSING=""
  SK_LIB_INSTALLED=""; SK_LIB_INSTALLED_N=0
  SK_INSTANCE_OWNED=""; SK_INSTANCE_N=0
  SKILL_LIB_BAD=""; SK_SKILL_N=0
  SKILL_SHAPE_BAD_33=0; SKILL_SHAPE_BAD_34=0; SKILL_FAIL_LINES=""; SKILL_HARD_FAIL=0
  SK_CANDIDATES=""; SK_RETIRE=""
  local f="" n="" st=""
  # ---- B1-a 基线五文件（UPGRADE_UNIVERSE 内的 .agents/skills/**）：缺 → 硬失败 ----
  for f in $UPGRADE_UNIVERSE; do
    case "$f" in
      .agents/skills/*) [ -f "$f" ] || SK_BASELINE_MISSING="${SK_BASELINE_MISSING}${SK_BASELINE_MISSING:+ }$f" ;;
    esac
  done
  for n in $SKILL_BASELINE_NAMES; do
    [ -f "$SKILLS_DIR/$n/SKILL.md" ] && SK_BASELINE_OK=$((SK_BASELINE_OK + 1))
  done
  # ---- B1-b 库九文件（OPTIONAL_UNIVERSE）：缺 → 仅提示（可选资产）----
  for f in $OPTIONAL_UNIVERSE; do
    [ -f "$f" ] || SK_LIB_MISSING="${SK_LIB_MISSING}${SK_LIB_MISSING:+ }$f"
  done
  # ---- B1-c 已装副本三态 + 三层归属（基线名 / 库副本 / 实例自有）----
  for n in $(skill_names); do
    SK_SKILL_N=$((SK_SKILL_N + 1))
    if skill_marked "$n"; then
      st=$(skill_copy_state "$n")
      SK_LIB_INSTALLED="${SK_LIB_INSTALLED}${SK_LIB_INSTALLED:+ }${n}:${st}"
      SK_LIB_INSTALLED_N=$((SK_LIB_INSTALLED_N + 1))
      case "$st" in ok) : ;; *) SKILL_LIB_BAD="${SKILL_LIB_BAD}${SKILL_LIB_BAD:+ }${n}:${st}" ;; esac
    else
      case " $SKILL_BASELINE_NAMES " in
        *" $n "*) : ;;
        *) SK_INSTANCE_OWNED="${SK_INSTANCE_OWNED}${SK_INSTANCE_OWNED:+ }$n"; SK_INSTANCE_N=$((SK_INSTANCE_N + 1)) ;;
      esac
    fi
  done
  # ---- B2 形状（3.3 / 3.4）；零技能不判（无技能可判 ≠ 通过，评分面另有 SK_SKILL_N 门槛）----
  if [ "$SK_SKILL_N" -gt 0 ]; then skill_shape_audit; fi
  # ---- B3 能力缺口建议（advisory）----
  skill_catalog_eval
  # ---- 硬失败 = 基线缺失 + 形状不齐（库缺失 / 副本非 ok 仅提示，不进退出码）----
  # **作用域门槛**：只有声明了治理根（.meta/ 在场）的实例，才把基线缺失 / 形状不齐当硬失败。
  # 理由（与 audit 既有契约一致）：audit 是「打分 + 缺口」命令，可在任意陌生仓库上跑；
  # 无 .meta/ 的仓库连治理根都没有（meta_yaml_missing 已是 gap、级自洽整体跳过），此时把
  # "框架基线三篇不在场" 判成非零退出，等于要求一个从未 `ponygo init` 的仓库自带框架文件，
  # 与该命令「替代物认可 / 只做机械形状探测」的定位冲突。有 .meta/（= 已声明 ponygo 治理）
  # 时，基线缺失与形状不齐是**实例自身的承诺缺口** → vl_fail + 非零退出（spec §5.1/§5.2、A8/A9）。
  # 提示层（gap / advisory）不受此门槛影响：任何仓库都会照实报出缺口，只是不改退出码。
  if [ -d "$META_DIR" ]; then
    if [ -n "$SK_BASELINE_MISSING" ]; then SKILL_HARD_FAIL=1; fi
    if [ "$SKILL_SHAPE_BAD_33" = "1" ] || [ "$SKILL_SHAPE_BAD_34" = "1" ]; then SKILL_HARD_FAIL=1; fi
  fi
  return 0
}

json_skills() { # skills 块（status / audit **同源**，spec §5.5）
  # 未真判定（提前退出分支）→ judged:false + reason，**不投影成 [] 通过**（沿用 coverage 保守语义）。
  if [ "${SKILLS_JUDGED:-0}" != "1" ]; then
    printf '%s' '"skills":{"judged":false,"reason":"not-run"}'
    return 0
  fi
  local x="" n="" st="" inst="" cand="" nm="" ev="" hint=""
  for x in $SK_LIB_INSTALLED; do
    n="${x%:*}"; st="${x##*:}"
    inst="${inst}${inst:+,}{\"name\":\"$(json_escape "$n")\",\"state\":\"${st}\"}"
  done
  while IFS=$'\t' read -r nm ev hint flag; do
    [ -n "$nm" ] || continue
    cand="${cand}${cand:+,}{\"name\":\"$(json_escape "$nm")\",\"evidence\":\"$(json_escape "$ev")\",\"hint\":\"$(json_escape "$hint")\"}"
  done <<< "${SK_CANDIDATES:-}"
  printf '%s' "\"skills\":{\"baseline_missing\":[$(json_path_list "${SK_BASELINE_MISSING:-}")],\"library\":{\"missing\":[$(json_path_list "${SK_LIB_MISSING:-}")],\"installed\":[${inst}]},\"instance_owned\":[$(json_path_list "${SK_INSTANCE_OWNED:-}")],\"candidates\":[${cand}]}"
}

audit_skills_report() { # 人读面（前缀冻结，spec §5.4）+ 缺口 id 登记；advisory 不计分、不改退出码
  local x="" n="" st=""
  echo ""
  echo "===== 技能（三层归属：基线 / 模板库 / 实例自有） ====="
  printf '技能：基线 %s/3 齐；库 %s 安装；实例自有 %s\n' "$SK_BASELINE_OK" "$SK_LIB_INSTALLED_N" "$SK_INSTANCE_N"
  if [ -n "$SK_BASELINE_MISSING" ]; then
    printf '  基线缺失（硬失败——框架必播的三篇技能不在场，缺口 id: skill_baseline_missing）：%s\n' "$SK_BASELINE_MISSING"
    printf '    修法：git checkout 恢复，或跑 '\''ponygo init --repair-skeleton'\'' 只补缺失文件\n'
    AUDIT_GAP_IDS="${AUDIT_GAP_IDS}${AUDIT_GAP_IDS:+ }skill_baseline_missing"
  fi
  if [ -n "$SK_LIB_MISSING" ]; then
    printf '  库缺口（可选资产，仅提示——不计分、不改退出码）：%s\n' "$SK_LIB_MISSING"
    printf '    → 跑 '\''ponygo init --repair-skeleton'\'' 只补缺失的库文件（不覆盖既有文件）\n'
    AUDIT_GAP_IDS="${AUDIT_GAP_IDS}${AUDIT_GAP_IDS:+ }skill_library_missing"
  fi
  for x in $SKILL_LIB_BAD; do
    n="${x%:*}"; st="${x##*:}"
    case "$st" in
      stale)
        printf '  已装副本过期（库已更新，仅提示）：%s\n' "$n"
        printf '    → bash .meta/skills-library/install.sh check；确认后可手删 .agents/skills/%s 再重装（安装永不覆盖）\n' "$n"
        AUDIT_GAP_IDS="${AUDIT_GAP_IDS}${AUDIT_GAP_IDS:+ }skill_library_stale" ;;
      modified)
        printf '  已装副本被本地改造（仅提示，通常正当）：%s\n' "$n"
        printf '    → 本地校准样例是正当改造；若想回到库版本，手删 .agents/skills/%s 再 install\n' "$n"
        AUDIT_GAP_IDS="${AUDIT_GAP_IDS}${AUDIT_GAP_IDS:+ }skill_library_modified" ;;
    esac
  done
  if [ -n "$SKILL_FAIL_LINES" ]; then
    printf '  技能形状判据 FAIL（缺口 id：skill_shape_incomplete；逐技能逐项见下）：\n'
    printf '%s' "$SKILL_FAIL_LINES"
    AUDIT_GAP_IDS="${AUDIT_GAP_IDS}${AUDIT_GAP_IDS:+ }skill_shape_incomplete"
  fi
  if [ -n "$SK_CANDIDATES" ]; then
    echo ""
    echo "能力缺口建议（advisory，靠 review 判定；不计分、不影响退出码）："
    while IFS=$'\t' read -r n st x flag; do
      [ -n "$n" ] || continue
      printf '  - %s：%s（%s）\n' "$n" "$st" "${x:--}"
      if [ "${flag:-ok}" = "ok" ]; then
        printf '    安装：bash .meta/skills-library/install.sh install %s\n' "$n"
      else
        # B3 边界（Lead 裁决）：catalog 有行但库内模板缺失 → 不打印安装命令（该调用会 exit 2），
        # 只打印缺口与补库路径——可复制的命令必须真的能跑通。
        printf '    缺口：库内模板缺 .meta/skills-library/%s/SKILL.md → 跑 '\''ponygo init --repair-skeleton'\'' 只补缺失库文件（模板不在场时 install 会 exit 2，故不给安装命令）\n' "$n"
      fi
    done <<< "$SK_CANDIDATES"
  fi
  if [ -n "$SK_RETIRE" ]; then
    for n in $SK_RETIRE; do printf '退场候选：%s（证据已消失）\n' "$n"; done
  fi
  return 0
}

cmd_audit() {
  # 自适应深度选择：探测重型信号 → M 档；全轻 → S 档
  local heavy=0 reasons="" spec_rc=0
  # F8：--json 机读面。人类报告整体改道 stderr，fd 3 保留原 stdout 只给单行 JSON。
  # W9-8：fd 3 是 JSON 通道，绝不能让**仓库脚本**（*.spec.sh，任意代码执行面）继承——
  # 否则它往 fd3 写一行就会破坏「stdout 恰一行 JSON」；故 run_gate_specs 的每次调用都 `3>&-`。
  AUDIT_JSON="${OBSERVE_JSON:-0}"; AUDIT_GAP_IDS=""; VL_VERDICT=""; VL_FAIL_IDS=""; L1_JUDGED=0
  VL_VERIFIED_LEVEL=0   # P1-1：未跑 ladder 前不得宣称验过任何非 L0 档位（提前退出也照实报 0）
  RESID_PROJ_FILES=""   # P1-10：残留投影 WARN 的机读面（warnings 块）
  AUDIT_DRIFT_FILES=""; AUDIT_DRIFT_COUNT=-1
  # 技能三层归属一次求值（B1 归属完整性 / B2 形状 / B3 advisory 共用一份结果；禁第二份口径）。
  # 只读解析：不执行任何仓库脚本（含 install.sh check）。
  compute_skills_state
  if [ "$AUDIT_JSON" = "1" ]; then exec 3>&1 1>&2; fi
  # 信号1：贡献者数 >= 3（rev-parse 同时支持普通仓与 .git 为文件的 linked worktree）
  local contrib=0
  if [ -e .git ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git rev-parse --verify HEAD >/dev/null 2>&1; then contrib=$(git shortlog -sne HEAD 2>/dev/null | wc -l | tr -d ' '); fi
  [ "${contrib:-0}" -ge 3 ] && { heavy=1; reasons="$reasons 贡献者≥3($contrib)"; }
  # 信号2：多技术栈（多种 manifest 并存）
  local manifests=0
  for f in package.json Cargo.toml go.mod pyproject.toml pom.xml; do [ -e "$f" ] && manifests=$((manifests+1)); done
  [ "$manifests" -ge 2 ] && { heavy=1; reasons="$reasons 多栈manifest×$manifests"; }
  # 信号3：monorepo（packages/ 下多个包）
  local npkgs=0
  [ -d packages ] && npkgs=$(find packages -maxdepth 2 -name package.json 2>/dev/null | wc -l | tr -d ' ')
  [ "${npkgs:-0}" -ge 3 ] && { heavy=1; reasons="$reasons monorepo($npkgs包)"; }
  # 信号4：已有治理痕迹（.github/.githooks 任一已存在 → 值得深查）。
  # 刻意不含 .meta：ponygo init 自己的产物不应把项目自动升 M 档——否则 S 档只剩"零治理"
  # 项目可用，与"S 档=起步/小项目"的口径矛盾（EXTERNAL-001 P1-2）。
  # P1-4（2026-11-11）：同理排除 init 自己写的脚手架——`.githooks/pre-commit`（A3）与
  # `.github/workflows/ponygo-governance.yml`（A5）内容与 init 模板逐字节一致时不计信号；
  # 目录里出现任何**非模板**文件/内容（人接手了）才计。只读判定，不执行仓库脚本。
  local gov=0
  if [ -d .github ] && ! github_only_init_artifacts; then gov=$((gov+1)); fi
  if [ -d .githooks ] && ! githooks_only_init_artifacts; then gov=$((gov+1)); fi
  [ "$gov" -ge 1 ] && { heavy=1; reasons="$reasons 已有治理痕迹×$gov"; }
  # 信号5：强合规（存在认证/合规/追溯相关目录；仅做粗筛，最终靠 review）
  local comp=0
  for g in compliance traceability docs/compliance docs/traceability; do [ -e "$g" ] && comp=$((comp+1)); done
  [ "$comp" -ge 1 ] && { heavy=1; reasons="$reasons 强合规痕迹"; }

  local LEVEL_CHOICE="${LEVEL:-}"
  if [ -n "$LEVEL_CHOICE" ]; then
    LEVEL_CHOICE=$(echo "$LEVEL_CHOICE" | tr 'a-z' 'A-Z')
  elif [ "$heavy" = "1" ]; then
    LEVEL_CHOICE="M"
  else
    LEVEL_CHOICE="S"
  fi

  # F6：帮助文本承诺 S|M，其余显式拒绝
  case "$LEVEL_CHOICE" in
    S|M) ;;
    *) die "审计深度档仅支持 S|M，收到：$LEVEL_CHOICE" ;;
  esac

  AUDIT_TIER="$LEVEL_CHOICE"
  AUDIT_LEVEL_INT="$(level_as_int "$(read_level)")"
  info "审计深度：${LEVEL_CHOICE} 档${reasons:+（触发:$reasons）}"
  [ "${LEVEL_CHOICE}" = "M" ] || { info "S 档——骨架层判定（判「有没有」）。"; }
  [ "${LEVEL_CHOICE}" = "M" ] && { info "M 档——机制层判定（判「对不对」）。"; }

  # ---- 四问打分（S 档查骨架层，M 档追加机制层；每项一条现成命令，命中+1）----
  local hit=0 total=0 hook_ok=0
  # hook 的评分与 gap 共用 2.4 严格探针；同一次审计不另造「目录/文件存在即接线」口径。
  # **有意设计**（勿再报「一处探针服务两个判据 = 重复计分」）：问①里的 hook 项与 2.4 本地层接线
  # 考察的是**同一个物理事实**——core.hooksPath 指向的 pre-commit 里真有一份可执行、位置正确的
  # ADR 门块。一个事实只该有一次判定：两个判据各消费一次结果，拆成两份探针必然漂移（P9）。
  if gate_24_probe; then hook_ok=1; fi

  # 问① 决策记在哪：目录与四态是独立结构项；零真实决策不得拿决策数或 vacuous Status 分。
  n_dec=$(count_decisions)
  total=$((total+1)); [ -d "$DECISIONS_DIR" ] && hit=$((hit+1))
  total=$((total+1))
  found=0; for lc in $LIFECYCLES; do [ -d "$DECISIONS_DIR/$lc" ] && found=$((found+1)); done
  [ "$found" -eq 4 ] && hit=$((hit+1))
  total=$((total+1))
  [ "${n_dec:-0}" -gt 0 ] && hit=$((hit+1))   # 有至少一条决策
  total=$((total+1))
  if [ -d "$DECISIONS_DIR/rejected" ] && [ -n "$(ls -A "$DECISIONS_DIR/rejected" 2>/dev/null | grep -vE '^(README\.md|\.gitkeep)$')" ]; then hit=$((hit+1)); fi  # 被否选项留痕（占位文件不计）
  total=$((total+1))
  # 状态与内容一致：必须有真实决策，且所有决策都有 Status 头（README/AGENTS.md 豁免）。
  bad_status=$(find "$DECISIONS_DIR" -name '*.md' ! -name 'README.md' ! -name 'AGENTS.md' -exec grep -L '^Status:' {} + 2>/dev/null | wc -l | tr -d ' ')
  [ "${n_dec:-0}" -gt 0 ] && [ "${bad_status:-0}" -eq 0 ] && hit=$((hit+1))

  if [ "$LEVEL_CHOICE" = "M" ]; then
    total=$((total+1))
    n_alt=$(grep -rl 'Alternatives' "$DECISIONS_DIR" 2>/dev/null | grep -v '/README\.md$' | wc -l | tr -d ' ')
    [ "${n_alt:-0}" -gt 0 ] && hit=$((hit+1))  # 有 Alternatives 节
    total=$((total+1)); [ "$hook_ok" = "1" ] && hit=$((hit+1))  # 触发条件/门禁痕迹（与 2.4 同口径）
  fi

  # 问② 承诺怎么强制
  local gate_spec_gap_txt="" gate_spec_missing=0 gate_spec_fail=0
  if ! gate_spec_gap_txt=$(check_gate_spec_pairing); then gate_spec_missing=1; gate_spec_fail=1; fi
  # 只有出现真正的实例门才启用配对硬判据；初始化骨架的 A1/A6 仍由各自内置 spec 看守。
  local instance_gate_count=0 igf=""
  while IFS= read -r -d '' igf; do
    is_framework_gate "${igf##*/}" && continue   # 框架门资产不算实例门（名单派生自 UPGRADE_UNIVERSE）
    file_has_content "$igf" && instance_gate_count=$((instance_gate_count+1))
  done < <(find "$META_DIR/gates" -maxdepth 1 -type f \
      \( -name '*.sh' -o -name '*.ps1' \) ! -name '*.spec.*' -print0 2>/dev/null)
  [ "$instance_gate_count" -gt 0 ] || gate_spec_fail=0
  total=$((total+1))
  # gates/ 有实例自己的实质门禁。README/.gitkeep 占位不计分；框架随 `ponygo init` 交付的
  # ADR 门资产（A1/A2/A4：adr-verify.sh / adr-verify.spec.sh / ci-verify.sh）、归档封印门资产
  # （A6/A7：archive-verify.sh / archive-verify.spec.sh）与引用残留门资产
  # （A8/A9：no-residue.sh / no-residue.spec.sh）同样不计分——
  # 那是**框架侧**证据（每个实例都有），计进来等于白送一分，四问分数就失去区分度。
  # W2/W6：无有效内容的文件同样不计分（空白行/# 注释行之外无内容 = 不是门禁，占位即假绿）。
  local g2=0 g2f=""
  while IFS= read -r -d '' g2f; do
    is_framework_gate_asset "${g2f##*/}" && continue   # 框架门资产不计分（名单派生自 UPGRADE_UNIVERSE）
    if file_has_content "$g2f"; then g2=1; break; fi
  done < <(find "$META_DIR/gates" -maxdepth 1 -type f \
      ! -name 'README.md' ! -name '.gitkeep' -print0 2>/dev/null)
  [ "$g2" = "1" ] && hit=$((hit+1))
  total=$((total+1))
  # 本地钩子已挂：复用上方 gate_24_probe 结果，评分与 gap 不可能互相矛盾。
  [ "$hook_ok" = "1" ] && hit=$((hit+1))
  total=$((total+1))
  # CI 存在：跨平台探测（GitHub/GitLab/Bitbucket/Azure/Drone/Jenkins/通用 ci 目录）
  has_ci=0
  for cf in .github/workflows .gitlab-ci.yml bitbucket-pipelines.yml azure-pipelines.yml .drone.yml Jenkinsfile ci; do
    [ -e "$cf" ] && has_ci=1 && break
  done
  [ "$has_ci" = "1" ] && hit=$((hit+1))

  if [ "$LEVEL_CHOICE" = "M" ]; then
    # 已删除的重复计分项：M 档原本额外加一项「[ -d .github/workflows ]」，它与问②上层的跨平台
    # has_ci 探测（.github/workflows / .gitlab-ci.yml / … / ci，用 [ -e ] 已覆盖目录）查的是同一件事，
    # 等于给 GitHub 仓库白送一分。删除后 M 档 total=16（S 档 12 不变）；**不要**再加回来。
    total=$((total+1))
    # 负样本 spec（F5）：只认门禁侧负样本——.meta/gates/ 下的 *.spec.*（与 2.3 同一判定域）。
    # 全仓普通单测（*.spec.ts / *_test.go / test_*.py …）不再计分：它不是「门会拒绝非法样本」
    # 的证据，计进来等于白送一分（P1-6）。总项数不变（仍 14 项）。
    # 框架**随骨架交付**的 spec 资产（A2 adr-verify.spec.sh、A7 archive-verify.spec.sh；
    # 将来随骨架交付的其它 spec 同入此清单）
    # 同样不计分——每个新实例都白有它，计进来四问就失去区分度（与上一条「框架侧证据不计分」同源）。
    # W2/W6：无有效内容的 `*.spec.*` 不计分（`> x.spec.sh` 空文件 / `printf '\n'` / 注释-only
    # 都能过 -s，纯可操纵性——故按有效行判定，与 2.3、run_gate_specs 同一口径）。
    negspec=""
    while IFS= read -r -d '' ns1; do
      is_framework_gate_asset "${ns1##*/}" && continue   # 框架自带 spec 不计分（名单派生自 UPGRADE_UNIVERSE）
      if file_has_content "$ns1" && [ "$gate_spec_missing" = "0" ]; then negspec="$ns1"; break; fi
    done < <(find "$META_DIR/gates" -type f -name '*.spec.*' -print0 2>/dev/null)
    [ -n "$negspec" ] && hit=$((hit+1))
    # 配对分与上方「实例门存在分」成对：合法门+spec 得 2；缺 spec 两者皆失，净差 1。
    # **有意设计**（勿再报「两条判据考察同一组文件 = 重复计分」）：两个分量的语义不同——
    # 「实例门存在分」问『有没有门』，「配对分」问『门有没有负样本证据（会拒绝非法样本）』。
    # 只建门不写 spec 得 1 分而非 2；缺 spec 时存在分不扣（门确实在），故两分净差 1、不会双扣。
    total=$((total+1)); [ "$gate_spec_missing" = "0" ] && [ "$instance_gate_count" -gt 0 ] && hit=$((hit+1))
    if [ "$gate_spec_missing" = "1" ] && [ -z "$negspec" ]; then
      printf 'ponygo: 2.3 gates/ 无负样本 spec（实例门无有效同名配对）\n' >&2
    fi
  fi

  # 问③ 重复劳动怎么复用（spec-ponygo-v2.6 §5.2：1 项 → 3 项，替换原「skills/ 目录非空」）
  #   3.2 实例自有技能 ≥1——排除基线三名与带 `.ponygo-installed` 的库安装副本（归属见
  #       .agents/skills/README.md 三层归属；库安装一条 install 命令即可得，计进来等于白送一分）
  #   3.3 全部技能 frontmatter name 与目录同名（kebab-case）且 description 内联触发词
  #   3.4 全部技能四要素齐（真相源/步骤/校准样例/验证与报告；英文等价允许，围栏内标题不算在场）
  # 零技能不判 3.3/3.4（无技能可判 ≠ 通过）；不齐项另见「技能」段的逐技能修法与 gap id。
  total=$((total+3))
  [ "$SK_INSTANCE_N" -gt 0 ] && hit=$((hit+1))
  [ "${SK_SKILL_N:-0}" -gt 0 ] && [ "$SKILL_SHAPE_BAD_33" = "0" ] && hit=$((hit+1))
  [ "${SK_SKILL_N:-0}" -gt 0 ] && [ "$SKILL_SHAPE_BAD_34" = "0" ] && hit=$((hit+1))

  # 问④ 过时怎么退场：**形态不是证据**——`archived/` 目录存在（init 就预建）证明不了任何东西。
  # 只认「已封印归档件」：`archived/manifest.sha256` 存在且含 ≥1 条非空登记
  # （行格式 `<64hex><空格><空格><仓库相对路径>`，与 A6 seal 写入口径一致）。
  # 空 archived / 有件但未封印（无 manifest 或全空行）一律不计分——否则「建了个空目录」就白送一分。
  # 只读纪律：这里只判 manifest 文件的形状，**不执行** archive-verify.sh（判定优先只读，见文件头）。
  total=$((total+1))
  if [ -f "$DECISIONS_DIR/archived/manifest.sha256" ] \
     && sed 's/\r$//' "$DECISIONS_DIR/archived/manifest.sha256" 2>/dev/null \
        | grep -qE '^[0-9a-f]{64}  .+'; then
    hit=$((hit+1))
  fi

  # ---- 输出 ----
  # 缺配对是明确硬 FAIL：先让机读面、分数与人读缺口完整落盘，再统一非零收口。
  if [ "$gate_spec_fail" = "1" ]; then vl_fail "2.3 gate_spec_missing 实例门缺同名负样本 spec：${gate_spec_gap_txt}"; fi
  AUDIT_HIT="$hit"; AUDIT_TOTAL="$total"
  echo ""
  echo "===== ponygo 审计结果（${LEVEL_CHOICE} 档）====="
  echo "命中 $hit / $total 项"
  info "当前治理级：$(fmt_level "$(read_level)")"
  warn_meta_violations
  warn_governance_hygiene
  warn_adaptation_pending
  # P1-10：与 status **同源同文案**——填槽态 + ai-surface 非 on + 根 AGENTS.md/CLAUDE.md 仍含
  # BEGIN 哨兵块 → WARN（不自动删）。命中项同时进 --json 的 warnings 块（residual_projection:<文件>）。
  warn_residual_projection
  # D5：revisions/ 轨道冻结（只读；WARN-only，不改变 hit 与退出码）
  audit_revisions_report
  # F6b：缺口标题只在**确有**缺口条目时打印（零缺口时不留空标题）
  local gap_txt=""
  if [ ! -f "$META_YAML" ]; then
    gap_txt="${gap_txt}  - 无 .meta/meta.yaml → 跑 'ponygo init' 或手工建 level: 0"$'\n'
    AUDIT_GAP_IDS="${AUDIT_GAP_IDS}${AUDIT_GAP_IDS:+ }meta_yaml_missing"
  fi
  local lv="$(read_level)"
  if [ -d "$DECISIONS_DIR" ] && [ "${n_dec:-0}" -eq 0 ]; then
    gap_txt="${gap_txt}  - notes/ 无任何决策 → 写第一篇 ADR，落 proposed/ 或 implemented/"$'\n'
    AUDIT_GAP_IDS="${AUDIT_GAP_IDS}${AUDIT_GAP_IDS:+ }no_decisions"
  fi
  if [ "$hook_ok" != "1" ]; then
    gap_txt="${gap_txt}  - 本地 ADR 门未接线（${G24_CAUSE:-gate_24_probe 未通过}）→ 这是「强制层」缺口，优先补（放大器）"$'\n'
    AUDIT_GAP_IDS="${AUDIT_GAP_IDS}${AUDIT_GAP_IDS:+ }no_local_hook"
  fi
  if [ "$gate_spec_missing" = "1" ]; then
    gap_txt="${gap_txt}  - gate_spec_missing 实例门缺同名负样本 spec："$'\n'"${gate_spec_gap_txt}"$'\n'
    AUDIT_GAP_IDS="${AUDIT_GAP_IDS}${AUDIT_GAP_IDS:+ }gate_spec_missing"
  fi
  echo ""
  if [ -n "$gap_txt" ]; then
    echo "缺口与最小改进动作（按杠杆排序，优先「强制层」）："
    printf '%s' "$gap_txt"
  fi
  # ---- 技能三层归属（B1 归属完整性 / B2 形状 / B3 advisory；前缀冻结见 spec §5.4）----
  # 只读报告段：基线缺失与形状不齐是硬失败（退出码非零，收口在级自洽验证之后）；
  # 库缺失 / 副本非 ok 是**仅提示**（可选资产，不改退出码）；advisory 段不计分、不改退出码。
  audit_skills_report
  echo ""
  echo "提示：程序只判「有无/对不对」，不判「值不值」——是否值得建某机制，靠 review（P6）。"
  echo ""
  echo "替代物认可：若你用非 ponygo 形态达成同等效果（如 CONTRIBUTING.md + CODEOWNERS + CI，"
  echo "或 docs/adr 而非 .agents/notes），本命令只做机械形状探测、不裁决价值——请按"
  echo "https://github.com/lanhui100/ponygo/blob/main/checklists/audit.md「已认可替代物」条款自评为命中，勿把形状分当价值分。"
  if [ "$comp" -ge 1 ]; then
    echo ""
    echo "合规免责：检测到合规/追溯痕迹（compliance/traceability）。ponygo 是工程化治理脚手架，"
    echo "爬满 L5 不构成任何监管合规背书（FDA、ISO 13485/26262、SOC2、PIPL 等），"
    echo "不替代贵组织的质控与审计流程——合规评判请交由合规流程（P6）。"
  fi
  # ---- 治理门接线现场（ADR 门本地层 + 远端层按 forge 证据报告；报告性，非硬判据） ----
  echo ""
  echo "===== 治理门接线（交付即接线） ====="
  gate_wiring_report
  # ---- 门禁分层报告（P7 时间经济性；报告性，非硬判据） ----
  gate_layers_report
  # ---- 骨架漂移（Wave13 P1-3：观察项，不改退出码）----
  # 与 status **同一判据同源**（同一 UPGRADE_UNIVERSE + 同一模板基准 + 同一个 skeleton_drift），
  # 只读：不写仓库、不执行任何仓库脚本。漂移不是承诺违例（status 管承诺缺口 exit 1），
  # 故此处只报告、绝不改变 audit 的退出码——失败态（判据 FAIL）也照常打印本段，不吞证据。
  echo ""
  echo "===== 骨架漂移（观察项，不改退出码） ====="
  skeleton_drift
  AUDIT_DRIFT_FILES="$SKEL_DRIFT_LIST"
  if [ "${SKEL_CMP_OK:-0}" = "1" ]; then
    AUDIT_DRIFT_COUNT=$(skel_drift_count "$SKEL_DRIFT_LIST")
  else
    AUDIT_DRIFT_COUNT=-1
    AUDIT_DRIFT_FILES=""
  fi
  if [ "${SKEL_CMP_OK:-0}" != "1" ]; then
    echo "漂移未判定（模板基准不可得）——用 'ponygo upgrade' 看漂移"
  elif [ "${AUDIT_DRIFT_COUNT:-0}" -eq 0 ]; then
    echo "漂移 0 处"
  else
    echo "漂移 ${AUDIT_DRIFT_COUNT} 处：${AUDIT_DRIFT_FILES}"
  fi
  # ---- 负样本自检（opt-in：--run-specs；默认不执行仓库脚本，见 run_gate_specs 头注）----
  if [ "$gate_spec_fail" = "1" ]; then audit_done 1; fi
  if [ "$RUN_SPECS" = "1" ]; then
    echo ""
    echo "===== 2.3 执行判据（--run-specs，opt-in） ====="
    if [ "$DRY_RUN" = "1" ]; then
      echo "  [skipped] --dry-run 下不执行任何仓库脚本——SKIPPED 不计入 PASS"
    else
      run_gate_specs; spec_rc=$?
      # F2（fail-closed）：0 = 全部真跑通过；2 = 证据不足（0 spec / 全部自报 SKIPPED / 递归护栏拦截）
      # → 不计入 PASS，整体按 exit 3 结束；其余（1 及意外码）= 硬失败 → exit 1。
      # 判定优先级 FAIL(1) > 未验证(3)：晋级判定放在级自洽验证之后，ladder FAIL 时仍走 exit 1。
      case "$spec_rc" in
        0) SPEC_VERIFIED=1 ;;
        2) SPEC_UNVERIFIED=1
           # W3-C：这里**不得**预先承诺退出码——同屏若有级自洽 FAIL，下面走的是 exit 1（FAIL 优先）。
           printf 'ponygo: 2.3 执行判据 SKIPPED（证据不足——本次未验证门是否仍会拒绝非法样本）；SKIPPED 不计入 PASS，按 fail-closed 处理。\n' >&2 ;;
        *) audit_done 1 ;;
      esac
    fi
  fi
  # ---- 级自洽验证（EXTERNAL-001 P1-1：audit 不再把判据推给 status，直接内嵌）----
  # 有治理根且声明了 level 时，audit 顺手验级：判据不符 → 列 FAIL 项并 exit 1
  # （机器可查缺口 = 非零退出；audit 的"打分"语义不变，只是不再漏掉判据级结论）。
  local ladder_ok=1
  if [ -f "$META_YAML" ]; then
    echo ""
    verify_ladder "$(read_level)" || ladder_ok=0
    # P1-8：声明高于实验时显式点明差额（与 status 同一实现；JSON 侧是 level_declared/level_verified）。
    status_level_gap_line "$AUDIT_LEVEL_INT"
  else
    echo ""
    echo "级自洽验证：跳过（无 .meta/meta.yaml——先 'ponygo init'）。"
  fi
  # ---- 技能硬失败收口（B1 基线缺失 / B2 形状不齐 = 3.2–3.4 的证据缺口）----
  # 必须在 verify_ladder **之后**登记：它在开头清空 VL_FAILS/VL_FAIL_IDS，先登记会被抹掉，
  # JSON 的 ladder.fails 就会丢掉刚判出的 3.x（"判过却报不出来"）。逐项修法已在「技能」段打印。
  if [ "$SKILL_HARD_FAIL" = "1" ]; then
    if [ -n "$SK_BASELINE_MISSING" ]; then
      vl_fail "3.1 技能基线缺失（框架必播三篇不在场）：${SK_BASELINE_MISSING}"
    fi
    if [ "$SKILL_SHAPE_BAD_33" = "1" ]; then
      vl_fail "3.3 技能形状不齐：frontmatter name 未与目录同名或 description 缺触发词（逐技能修法见「技能」段）"
    fi
    if [ "$SKILL_SHAPE_BAD_34" = "1" ]; then
      vl_fail "3.4 技能形状不齐：缺四要素之一（真相源/步骤/校准样例/验证与报告，围栏感知；逐技能修法见「技能」段）"
    fi
    # 人读面：级自洽通过时也要让 FAIL 落屏（否则「级自洽验证：通过」+ 非零退出 = 自相矛盾）。
    # 级自洽已 FAIL 时它的清单已在上方打印，此处不重复。
    if [ "$ladder_ok" = "1" ] && [ -n "$VL_FAILS" ]; then
      echo ""
      echo "技能判据 FAIL（缺口 id：skill_baseline_missing / skill_shape_incomplete；逐技能修法见上「技能」段）："
      printf '%s' "$VL_FAILS"
    fi
    VL_VERDICT="fail"
    audit_done 1
  fi
  if [ "$ladder_ok" != "1" ]; then audit_done 1; fi
  # F2：fail-closed 收口——执行判据证据不足（0 spec / 全 SKIPPED / 护栏拦截）→ exit 3。
  # 走到这里说明级自洽判据无 FAIL（有 FAIL 已在上方 exit 1），故 FAIL(1) > 未验证(3) 成立。
  if [ "${SPEC_UNVERIFIED:-0}" = "1" ]; then
    # W3-C：只有走到这里才真的 exit 3（上方 ladder FAIL 分支已 exit 1）
    printf 'ponygo: 判据证据不足（2.3 执行判据未真正验证）→ exit 3\n' >&2
    audit_done 3
  fi
  audit_done 0
}

# status 模板比对的临时基准树（W7-1）：文件级状态 + 幂等清理，供 EXIT/INT/TERM 三钩共用
STATUS_TMP=""
status_tmp_cleanup() {
  if [ -n "${STATUS_TMP:-}" ]; then rm -rf "${STATUS_TMP}" 2>/dev/null || true; STATUS_TMP=""; fi
  return 0
}

# ---------- 骨架漂移（status 与 audit 的**唯一**口径，Wave13 P1-3） ----------
# 基准 = 同一 UPGRADE_UNIVERSE（十七文件）+ 同一模板基准（write_skeleton 0，mktemp 临时目录）+
# EOL 归一逐字节。只读：不写仓库、不执行任何仓库脚本（GI-4）。
# docs-tier 已激活实例豁免 `.meta/docs-tier/README.md`（激活必改写该文件，比对即恒漂移——与
# cmd_upgrade 的 dt_skip 同口径）。
# 结果（文件级变量，供调用方读）：
#   SKEL_DRIFT_LIST — 漂移文件（空格分隔的仓库相对路径）
#   SKEL_CMP_OK     — 1 = 真的比过；0 = 模板基准不可得（此时漂移"未判定"，不得当 0 报）
SKEL_TMP=""
skel_tmp_cleanup() {
  if [ -n "${SKEL_TMP:-}" ]; then rm -rf "${SKEL_TMP}" 2>/dev/null || true; SKEL_TMP=""; fi
  return 0
}
skeleton_drift() {
  # 可选资产（库九文件）的漂移单独记账，不混进 skeleton.drift（该字段是十七文件口径，W9-B3）；
  # 只比在场的库文件——库文件缺失是「可选资产缺口」（status 单独一行、不计 exit 1），不是漂移。
  SKEL_DRIFT_LIST=""; SKEL_CMP_OK=0; SKEL_OPT_DRIFT_LIST=""; SKEL_OPT_UNDECIDED=0
  # P0-4 结果分类：门资产漂移单独记账（→ vl_fail），其余 universe 漂移留在 SKEL_DRIFT_LIST（观察项）。
  SKEL_GATE_DRIFT_LIST=""
  local st_dt=0 stf cmp_rc=0 t_exit="" t_int="" t_term=""
  # 三钩收口（与既有 status 实现同款）：信号落在基准树生成/比对窗口时不残留临时树
  t_exit=$(trap -p EXIT); t_int=$(trap -p INT); t_term=$(trap -p TERM)
  trap 'skel_tmp_cleanup' EXIT
  trap 'skel_tmp_cleanup; observe_tmp_cleanup; trap - EXIT INT TERM; exit 130' INT
  trap 'skel_tmp_cleanup; observe_tmp_cleanup; trap - EXIT INT TERM; exit 143' TERM
  SKEL_TMP=$(mktemp -d 2>/dev/null) || SKEL_TMP=""
  if [ -n "$SKEL_TMP" ] && ( cd "$SKEL_TMP" && write_skeleton 0 ) >/dev/null 2>&1; then
    SKEL_CMP_OK=1
    if [ -f "$META_DIR/docs-tier/README.md" ] \
       && grep -q '## 已激活文档家清单' "$META_DIR/docs-tier/README.md" 2>/dev/null; then
      st_dt=1
    fi
    for stf in $UPGRADE_UNIVERSE; do
      [ "$st_dt" = "1" ] && [ "$stf" = ".meta/docs-tier/README.md" ] && continue
      [ -f "$SKEL_TMP/$stf" ] || continue
      [ -f "$stf" ] || continue
      cmp -s <(tr -d '\r' < "$stf") <(tr -d '\r' < "$SKEL_TMP/$stf")
      cmp_rc=$?
      if [ "$cmp_rc" -eq 1 ]; then
        SKEL_DRIFT_LIST="${SKEL_DRIFT_LIST}${SKEL_DRIFT_LIST:+ }$stf"
        # 分类（P0-4）：命中框架门资产集合 → 另记一份；status/audit 的级自洽验证据此 vl_fail。
        case " $GATE_ASSET_UNIVERSE " in
          *" $stf "*) SKEL_GATE_DRIFT_LIST="${SKEL_GATE_DRIFT_LIST}${SKEL_GATE_DRIFT_LIST:+ }$stf" ;;
        esac
      elif [ "$cmp_rc" -ge 2 ]; then
        SKEL_CMP_OK=0; SKEL_DRIFT_LIST=""; SKEL_GATE_DRIFT_LIST=""
        break
      fi
    done
    # 可选资产（库文件，模板所有）：只在**两侧都在场**时比对——实例侧缺失 = 可选资产缺口
    # （不计 exit 1，由 status 的「骨架可选资产缺口」行表达）；模板侧缺失 = 未判定，
    # 不得当成"零漂移"（P6 诚实条款：没判过就不许报一致的绿）。
    for stf in $OPTIONAL_UNIVERSE; do
      [ -f "$stf" ] || continue
      if [ ! -f "$SKEL_TMP/$stf" ]; then SKEL_OPT_UNDECIDED=$((SKEL_OPT_UNDECIDED + 1)); continue; fi
      cmp -s <(tr -d '\r' < "$stf") <(tr -d '\r' < "$SKEL_TMP/$stf")
      cmp_rc=$?
      if [ "$cmp_rc" -eq 1 ]; then
        SKEL_OPT_DRIFT_LIST="${SKEL_OPT_DRIFT_LIST}${SKEL_OPT_DRIFT_LIST:+ }$stf"
      elif [ "$cmp_rc" -ge 2 ]; then
        SKEL_CMP_OK=0; SKEL_DRIFT_LIST=""; SKEL_OPT_DRIFT_LIST=""; SKEL_GATE_DRIFT_LIST=""
        break
      fi
    done
  fi
  skel_tmp_cleanup
  if [ -n "$t_exit" ]; then eval "$t_exit"; else trap - EXIT; fi
  if [ -n "$t_int" ]; then eval "$t_int"; else trap - INT; fi
  if [ -n "$t_term" ]; then eval "$t_term"; else trap - TERM; fi
  return 0
}
skel_drift_count() { # <空格分隔列表> → 计数
  local n=0 x
  for x in $1; do n=$((n + 1)); done
  printf '%s' "$n"
}

cmd_status() {
  local lv
  lv=$(read_level)
  # F8：--json 机读面（人类报告改道 stderr；fd 3 只给单行 JSON）
  STATUS_JSON="${OBSERVE_JSON:-0}"; STATUS_LEVEL_INT="$(level_as_int "$lv")"
  # W9-B2/B3：JSON 的 skeleton 与人类清单**同源**——三者都存「仓库相对路径列表」，
  # 计数由列表长度派生（禁两套口径：数组与「骨架文件缺口：N」必须同数）。
  STATUS_MISSING_DIRS=""; STATUS_MISSING_FILES=""; STATUS_DRIFT=""; VL_VERDICT=""; VL_FAIL_IDS=""; L1_JUDGED=0
  VL_VERIFIED_LEVEL=0
  RESID_PROJ_FILES=""
  if [ "$STATUS_JSON" = "1" ]; then exec 3>&1 1>&2; fi
  echo "===== ponygo status ====="
  echo "治理级：$(fmt_level "$lv")"
  # Wave13 P3-6：运行时依赖一行（缺项 ✗），紧跟治理级；零旗标、不改退出码、不写仓库文件。
  status_env_line
  warn_meta_violations
  warn_governance_hygiene
  warn_adaptation_pending
  # P1-7：`retire --level off` 后无需再跑 sync 即可见残留投影告警（与 sync 同一实现同一文案）。
  warn_residual_projection
  echo ""
  echo "骨架完整度："
  local missing=0
  for d in "$META_DIR" "$META_DIR/constitution" "$META_DIR/gates" "$META_DIR/docs-tier" "$AGENTS_RUNTIME_DIR" "$DECISIONS_DIR" "$SKILLS_DIR"; do
    if [ -d "$d" ]; then printf '  [ok]  %s\n' "$d"; else printf '  [缺]  %s\n' "$d"; missing=$((missing+1)); STATUS_MISSING_DIRS="${STATUS_MISSING_DIRS}${STATUS_MISSING_DIRS:+ }$d"; fi
  done
  # meta.yaml 不属 skeleton.missing_files（W9-B3：该字段 = UPGRADE_UNIVERSE 十七文件口径）；
  # 它缺失由「骨架完整度」行 + 级自洽 0.2 判据表达，退出码照旧非零。
  [ -f "$META_YAML" ] && printf '  [ok]  %s\n' "$META_YAML" || { printf '  [缺]  %s\n' "$META_YAML"; missing=$((missing+1)); }

  # ---- 骨架文件口径（F4：与 'ponygo upgrade' 同一 UPGRADE_UNIVERSE 十七文件）----
  # 只判**存在性**（不读模板、不执行任何脚本——只读命令的边界不变）。缺口数必须与 upgrade
  # 的缺口行数逐一相等，否则「status 绿 / upgrade 报缺口」的结论分裂就地复发（P1-4）。
  local sf_n=0 sf_total=0 sf_list="" sf
  for sf in $UPGRADE_UNIVERSE; do
    sf_total=$((sf_total+1))
    [ -f "$sf" ] && continue
    sf_n=$((sf_n+1))
    sf_list="$sf_list $sf"
  done
  STATUS_MISSING_FILES="$sf_list"
  if [ "$sf_n" -gt 0 ]; then
    printf '骨架文件缺口：%s\n' "$sf_n"
    for sf in $sf_list; do printf '  [缺]  %s\n' "$sf"; done
    echo "  → 跑 'ponygo init --repair-skeleton' 只补缺失骨架文件（不覆盖既有文件；--dry-run 先看计划）"
    missing=$((missing+sf_n))
  else
    # W6-4：只判存在性却宣称「与模板一致」= 声明与实现不一致（实测：清空 .meta/gates/ci-verify.sh
    # 后 status 仍 rc=0 且称「一致」，而 upgrade 报 drift）。这里**真的**比：
    # 与 'ponygo upgrade' 同一模板基准 + EOL 归一逐字节——判据实现抽到 skeleton_drift（唯一口径，
    # audit 的骨架漂移段复用同一函数，禁第二份实现）。漂移是**观察**，不改退出码。
    skeleton_drift
    STATUS_DRIFT="$SKEL_DRIFT_LIST"
    local st_drift=0
    st_drift=$(skel_drift_count "$SKEL_DRIFT_LIST")
    if [ "${SKEL_CMP_OK:-0}" != "1" ]; then
      printf '骨架文件齐全（%s 个；内容未比对：模板基准不可得——用 '\''ponygo upgrade'\'' 看漂移）\n' "$sf_total"
    elif [ "$st_drift" -gt 0 ]; then
      printf '骨架文件齐全（%s 个），但内容漂移 %s 处（逐字节比对，见 '\''ponygo upgrade'\''）\n' "$sf_total" "$st_drift"
    else
      printf '骨架文件与模板一致（%s 个骨架文件齐全，逐字节比对）\n' "$sf_total"
    fi
  fi

  # ---- 可选资产口径（OPTIONAL_UNIVERSE = 模板库九文件，spec-ponygo-v2.6 §4）----
  # 语义边界（与十七文件不同）：库是**可选资产**——缺失只提示，**不计 exit 1**，
  # 也不并入 skeleton.missing_files（该字段仍是十七文件口径，W9-B3）；
  # 存在即模板所有，与模板不一致照常报漂移（观察项，同样不改退出码）。
  local of_n=0 of_total=0 of_list="" of=""
  for of in $OPTIONAL_UNIVERSE; do
    of_total=$((of_total+1))
    [ -f "$of" ] && continue
    of_n=$((of_n+1))
    of_list="$of_list $of"
  done
  if [ "$of_n" -gt 0 ]; then
    printf '骨架可选资产缺口：%s\n' "$of_n"
    for of in $of_list; do printf '  [缺]  %s\n' "$of"; done
    echo "  → 跑 'ponygo init --repair-skeleton' 只补缺失的库文件（不覆盖既有文件；缺失属可选资产，不计入 exit 1）"
  else
    local of_drift=0 of_why=""
    of_drift=$(skel_drift_count "${SKEL_OPT_DRIFT_LIST:-}")
    if [ "${SKEL_CMP_OK:-0}" != "1" ]; then
      of_why="；内容未比对：模板基准不可得"
    elif [ "${SKEL_OPT_UNDECIDED:-0}" -gt 0 ]; then
      of_why="；${SKEL_OPT_UNDECIDED} 个未比对（模板基准缺该文件）"
    fi
    if [ "$of_drift" -gt 0 ]; then
      printf '骨架可选资产齐全（%s 个），但内容漂移 %s 处（模板所有，见 '\''ponygo upgrade'\''）：%s\n' "$of_total" "$of_drift" "${SKEL_OPT_DRIFT_LIST}"
    elif [ -n "$of_why" ]; then
      printf '骨架可选资产齐全（%s 个库文件%s）\n' "$of_total" "$of_why"
    else
      printf '骨架可选资产齐全（%s 个库文件，逐字节比对）\n' "$of_total"
    fi
  fi

  # 技能三层归属一次求值——只为 --json 的 skills 块（人读面在 audit；status 不判分）。
  compute_skills_state
  local n_dec=0
  n_dec=$(count_decisions)
  printf '  决策数：%s\n' "$n_dec"
  echo ""
  # 治理门接线现场（本地层 2.4 同口径 + 远端层按 forge 证据报告，§6.3）——报告性，不改退出码
  gate_wiring_report
  echo ""
  if [ "$missing" -gt 0 ]; then
    echo "下一步（去下一级 / 补缺口）："
    [ ! -f "$META_YAML" ] && echo "  - 补 $META_YAML（level: 0）"
    echo "  骨架不完整，exit 1（机器可查的缺口 = 非零退出）。"
    status_done 1
  else
    echo "骨架完整。"
    # 级自洽验证：失败项输出取代"去下一级"建议文本（不叠床架屋）
    if ! verify_ladder "$lv"; then status_level_gap_line "$(level_as_int "$lv")"; status_done 1; fi
    status_level_gap_line "$(level_as_int "$lv")"
    case "$lv" in
      0|1) echo "去 L$((lv+1))：见 https://github.com/lanhui100/ponygo/blob/main/maturity-ladder.md 对应级退出标准与布尔检查项。" ;;
      2)   echo "已达机械判定的上限。L3+ 为「靠 review」的目标画像，按需选装。" ;;
      *)   echo "已声明 $(fmt_level "$lv")，但 L3-L5 属目标画像：请对照 https://github.com/lanhui100/ponygo/blob/main/maturity-ladder.md §2 的依赖清单自证，否则视为散文（P6 诚实条款）。" ;;
    esac
  fi
  status_done 0
}

# ---------- upgrade 漂移报告（v2.4：Q2=A） ----------
# 比对宇宙 = s14 的 10 个文件精确路径（详见 tests/run.sh s14/s31），不另立清单文件（第三副本，slop 第一条）。
# 语义：漂移是**观察**不是承诺（status 管骨架缺口 exit 1，upgrade 管"与模板差多少"）；默认 exit 0，
# --check 漂移非零供 CI。宇宙外文件（根 README / meta.yaml / 已填 constitution / 根 AGENTS.md /
# CLAUDE.md / classes.local / docs-tier/exemptions 等）不判漂移——"无基线"不判定，报告头一句话声明盲区。
# 已激活 docs-tier 实例：`.meta/docs-tier/README.md` 不参与漂移比对（激活必改写该文件，比对即恒漂移、
# --check 恒红）。实例侧口径：生成物仍是模板态（由 write_skeleton 的 heredoc 提供）；s14 用同一判据分支，
# 不再假定"仓库文件 = 模板"——模板仓自身也可以是一个已激活实例。
# 教训归因（假漂移历史）真源：TASK-002 双审，见 docs/dev-team/reviews/——不塞进用户可见输出。
# 门禁资产只登记**不可变**的 A1/A2/A4/A6/A7/A8/A9（§6.3/R8）：A3（.githooks/pre-commit）与 A5（workflow）
# 是实例可编辑文件（有人会追加自己的钩子逻辑、改 CI 触发），进表 = 三仓永久 drift 红。
# 十七文件 = 十文件骨架 + 门禁资产 A1/A2/A4/A6/A7/A8/A9
# （A6/A7 = 归档 SHA-256 封印门与其负样本自检；A8/A9 = 引用残留门与其负样本自检）。
UPGRADE_UNIVERSE=".agents/notes/README.md .agents/skills/README.md .meta/docs-tier/README.md \
.agents/skills/write-adr/SKILL.md .agents/skills/write-adr/verify-note.sh \
.agents/skills/governance-review/SKILL.md .meta/gates/README.md \
.agents/skills/change-review/SKILL.md .agents/notes/AGENTS.md .agents/notes/archived/AGENTS.md \
.meta/gates/adr-verify.sh .meta/gates/adr-verify.spec.sh .meta/gates/ci-verify.sh \
.meta/gates/archive-verify.sh .meta/gates/archive-verify.spec.sh \
.meta/gates/no-residue.sh .meta/gates/no-residue.spec.sh"

# ---------- 框架门资产集合（P0-4，2026-11-11）：UPGRADE_UNIVERSE 的**判定子集** ----------
# 语义：这些文件是框架不可变门资产（A1/A2/A4/A6/A7），实例侧不编辑；它们与模板不一致
# = 门**可能被替换/弱化**（形状判据仍绿，字节已变），故漂移判 vl_fail，而不是观察项。
# 其余 universe 文件（README / AGENTS / SKILL）漂移仍是 WARN 观察项（不改退出码）——
# 那是文档面，实例确实会改，判 FAIL 等于逼人 fork 模板。
# 契约冻结清单（5 文件）；A8/A9（no-residue.*）暂留观察项，扩张需新契约。
GATE_ASSET_UNIVERSE=".meta/gates/adr-verify.sh .meta/gates/adr-verify.spec.sh .meta/gates/ci-verify.sh \
.meta/gates/archive-verify.sh .meta/gates/archive-verify.spec.sh"

# 框架门资产名单（P0-2 的「实例门」排除集）：从 UPGRADE_UNIVERSE 的 .meta/gates/ 子集**派生**，
# 不再手抄文件名。为什么派生：手抄四个名字时，未来新增的框架门（A8/A9 就是这么来的）不会自动进
# 排除集，2.3 会把框架资产误算成「实例自己的门」——判据白送分且无人发现（第二份清单 = 漂移源）。
#   framework_gate_names       → 非 spec 框架门（A1/A4/A6/A8…）：不计入实例门
#   framework_gate_names all   → 含 spec 的框架门资产全集（A1/A2/A4/A6/A7/A8/A9）：不计入「有实质门禁」计分
framework_gate_names() {
  local f
  for f in $UPGRADE_UNIVERSE; do
    case "$f" in
      .meta/gates/*)
        case "${f##*/}" in
          *.spec.*) [ "${1:-}" = "all" ] && printf '%s\n' "${f##*/}" ;;
          *) printf '%s\n' "${f##*/}" ;;
        esac
        ;;
    esac
  done
}
is_framework_gate() { # <文件名> → 0 = 不计入实例门的框架门（非 spec 资产）
  framework_gate_names | grep -qxF -- "$1"
}
is_framework_gate_asset() { # <文件名> → 0 = 框架门资产（含 .spec.*，用于「实质门禁」计分排除）
  framework_gate_names all | grep -qxF -- "$1"
}

# ---------- 可选资产宇宙（OPTIONAL_UNIVERSE：模板库九文件，spec-ponygo-v2.6 §4） ----------
# 与 UPGRADE_UNIVERSE（十七文件，**不变**）并列的第二张宇宙表。语义差别只有一条：
# 库文件是**可选资产**——缺失只提示，不判 drift、不计 exit 1（status 行 / upgrade「缺口（可选资产）」）；
# 存在即模板所有，与模板不一致照常报 drift（库正文由 write_skeleton 的 heredoc 提供，EOL 归一逐字节）。
# 为什么与十七文件分表而不是并表：并表会让每个历史实例的 `status` 在获得库的那一刻之前恒红，
# 与「可选」语义矛盾（决策见 .agents/notes/implemented/process/2026-11-10-skill-tiers-library-and-shape-audit.md）。
OPTIONAL_UNIVERSE=".meta/skills-library/README.md .meta/skills-library/install.sh \
.meta/skills-library/catalog.tsv \
.meta/skills-library/pg-delivery-checks/SKILL.md .meta/skills-library/pg-find-simplifications/SKILL.md \
.meta/skills-library/pg-doc-hygiene/SKILL.md .meta/skills-library/pg-test-reliability/SKILL.md \
.meta/skills-library/pg-upgrade-guide/SKILL.md .meta/skills-library/pg-gc-agent-notes/SKILL.md"

# ---------- 骨架缺口补齐（`ponygo init --repair-skeleton`；F3：并入 init，不新增顶层命令） ----------
# 命令面固定六条（ADR 2026-08-30-six-command-surface）：骨架补缺是 init 的一个旗标，不是新命令。
# 口径与 cmd_upgrade **完全同一**：同一 UPGRADE_UNIVERSE（十七文件）+ 同一模板基准（write_skeleton 0）。
# 铁律：
#   - 只补**缺失**：已存在文件（含内容已漂移的实例文件）一律一字不动，绝不覆盖；
#   - 写入走 write_atomic（同目录 mktemp + mv 原子替换）——中断/并发下不留 0 字节半截文件；
#   - 权限位取自模板（模板里可执行的仍可执行：A1/A2/A4 = 755），不替人改既有文件权限。
# 输出契约：N>0 → 「骨架补齐：N」；N=0 → 「骨架零缺口」。--dry-run 只打印计划、零落盘。
# 返回：0 无写失败；1 有写失败/模板基准不可得（写失败另登记 gate_write_fail，由 init 汇总非零）。
# 骨架补齐的清理状态（文件级：信号 handler 可能在函数返回后触发，故不放 local）
REPAIR_TMP=""; REPAIR_LOCKFILE=""; REPAIR_LOCKDIR=""
# 幂等收口：临时目录 + 持锁 fd + mkdir 降级锁目录；重复调用无害（正常/报错/信号三条路径共用）
repair_skeleton_cleanup() {
  if [ -n "${REPAIR_TMP:-}" ]; then rm -rf "${REPAIR_TMP}" 2>/dev/null || true; REPAIR_TMP=""; fi
  if [ -n "${REPAIR_LOCKFILE:-}" ]; then { exec 8>&-; } 2>/dev/null || true; REPAIR_LOCKFILE=""; fi
  if [ -n "${REPAIR_LOCKDIR:-}" ]; then rmdir "${REPAIR_LOCKDIR}" 2>/dev/null || true; REPAIR_LOCKDIR=""; fi
  return 0
}

repair_skeleton_gaps() { # <dry:0|1>
  local dry="${1:-0}" f mode n=0 fails=0 gd="" w=0
  local lockfile="" lk="" trap_exit="" trap_int="" trap_term=""
  # 失败登记铁律（W3-1）：本函数任何一条失败路径都必须 `gate_write_fail` 登记，由 cmd_init 的
  # gate_assembly_failed 统一打印清单并 exit 1——warn 一句后 return 0 就是「骨架仍缺但机器说成功」。
  # 并发锁（W3-6）：与 ensure_gate_wiring **同一把锁**，路径解析也同一套（git-common-dir + pwd -P；
  # `git rev-parse --git-dir` 在 linked worktree 下会指向 .git/worktrees/<name>，等于第二把锁）。
  # flock 缺失时降级 mkdir 原子锁（与装配同一降级路径）。dry-run 不写盘、不取锁。
  if [ "$dry" != "1" ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    gd=$(git rev-parse --git-common-dir 2>/dev/null || true)
    [ -n "$gd" ] || gd=$(git rev-parse --git-dir 2>/dev/null || true)
    if [ -n "$gd" ]; then
      gd=$(cd "$gd" 2>/dev/null && pwd -P) || gd=""
      if [ -n "$gd" ] && [ -d "$gd" ]; then lockfile="$gd/ponygo-init.lock"; fi
    fi
  fi
  if [ -n "$lockfile" ]; then
    if command -v flock >/dev/null 2>&1; then
      if exec 8>>"$lockfile"; then
        REPAIR_LOCKFILE="$lockfile"
        flock -w 10 8 || warn "骨架补齐锁等待超时（10s，$lockfile）→ 继续；写入仍为 mktemp+mv 原子替换"
      else
        # W6-2：打开锁失败不得静默降级（装配路径同样 WARN）——本次无锁继续，但必须说出来
        warn "无法打开骨架补齐锁文件（$lockfile）→ 本次无锁继续；写入仍为 mktemp+mv 原子替换"
      fi
    else
      lk="$lockfile.d"
      while ! mkdir "$lk" 2>/dev/null; do
        w=$((w+1))
        if [ "$w" -ge 100 ]; then
          warn "骨架补齐锁等待超时（10s，$lk）→ 继续；写入仍为 mktemp+mv 原子替换"
          lk=""
          break
        fi
        sleep 0.1
      done
      if [ -n "$lk" ]; then REPAIR_LOCKDIR="$lk"; fi
    fi
  fi
  # 清理收口（W3-2/W3-3）：EXIT/INT/TERM 三钩（与 cmd_upgrade 同款写法），任何退出路径都释放
  # 临时目录 + 持锁 fd；INT/TERM 保留入口层既有语义（observe 临时文件清理 + 130/143 退出码）。
  trap_exit=$(trap -p EXIT); trap_int=$(trap -p INT); trap_term=$(trap -p TERM)
  trap 'repair_skeleton_cleanup' EXIT
  trap 'repair_skeleton_cleanup; observe_tmp_cleanup; trap - EXIT INT TERM; exit 130' INT
  trap 'repair_skeleton_cleanup; observe_tmp_cleanup; trap - EXIT INT TERM; exit 143' TERM
  if ! REPAIR_TMP=$(mktemp -d 2>/dev/null); then
    REPAIR_TMP=""
    warn "骨架补齐：无法创建临时目录——本次未写任何文件，骨架缺口仍在"
    gate_write_fail "骨架补齐（UPGRADE_UNIVERSE 十七文件）" "mktemp -d 失败——无法生成模板基准，骨架缺口未被补齐"
    repair_skeleton_cleanup
    if [ -n "$trap_exit" ]; then eval "$trap_exit"; else trap - EXIT; fi
    if [ -n "$trap_int" ]; then eval "$trap_int"; else trap - INT; fi
    if [ -n "$trap_term" ]; then eval "$trap_term"; else trap - TERM; fi
    return 1
  fi
  if ! ( cd "$REPAIR_TMP" && write_skeleton 0 ) >/dev/null 2>&1; then
    warn "骨架补齐：无法生成模板基准（write_skeleton 失败）——本次未写任何文件，骨架缺口仍在"
    gate_write_fail "骨架补齐（UPGRADE_UNIVERSE 十七文件）" "模板基准生成失败（write_skeleton 0 非零）——骨架缺口未被补齐"
    fails=1
  else
    for f in $UPGRADE_UNIVERSE; do
      [ -f "$f" ] && continue   # 已存在（含内容漂移）→ 一字不动：只补缺失，绝不覆盖
      if [ ! -f "$REPAIR_TMP/$f" ]; then
        warn "骨架补齐：模板基准缺 $f（UPGRADE_UNIVERSE 与 write_skeleton 生成集漂移）→ 该项仍是缺失态"
        gate_write_fail "$f" "模板基准缺该文件（UPGRADE_UNIVERSE 与 write_skeleton 生成集漂移）——该骨架文件仍是缺失态"
        fails=1
        continue
      fi
      n=$((n+1))
      if [ "$dry" = "1" ]; then
        info "[dry-run] 将补骨架文件 $f（缺失；不覆盖既有文件，权限同模板）"
        continue
      fi
      mode=$(file_mode "$REPAIR_TMP/$f")
      if write_atomic "$f" "$mode" < "$REPAIR_TMP/$f"; then
        info "补骨架文件：$f"
      else
        gate_write_fail "$f" "骨架补齐写入失败（原子替换 mv 失败/目录不可写）——该文件仍是缺失态"
        fails=1
      fi
    done
    # 可选资产（OPTIONAL_UNIVERSE：模板库九文件）——历史项目获得库的唯一路径（spec §4）。
    # 与十七文件的差别只有退出码语义：库是**可选资产**，缺口/写入失败只提示（warn），
    # 不登记 gate_write_fail、不改 exit 1（缺失由 'ponygo status' 的可选资产缺口行 + audit 的
    # skill_library_missing 提示表达）。只补缺失、绝不覆盖的纪律与十七文件完全相同。
    for f in $OPTIONAL_UNIVERSE; do
      [ -f "$f" ] && continue   # 已存在（含内容漂移）→ 一字不动：只补缺失，绝不覆盖
      if [ ! -f "$REPAIR_TMP/$f" ]; then
        warn "骨架补齐：模板基准缺可选资产 $f（OPTIONAL_UNIVERSE 与 write_skeleton 生成集漂移）→ 该项仍是缺失态"
        continue
      fi
      n=$((n+1))
      if [ "$dry" = "1" ]; then
        info "[dry-run] 将补库文件 $f（缺失；可选资产，不覆盖既有文件，权限同模板）"
        continue
      fi
      mode=$(file_mode "$REPAIR_TMP/$f")
      if write_atomic "$f" "$mode" < "$REPAIR_TMP/$f"; then
        info "补库文件（可选资产）：$f"
      else
        warn "骨架补齐：可选资产写入失败 $f（目录不可写 / 原子替换失败）→ 该项仍是缺失态；不计入 exit 1"
      fi
    done
  fi
  repair_skeleton_cleanup
  if [ -n "$trap_exit" ]; then eval "$trap_exit"; else trap - EXIT; fi
  if [ -n "$trap_int" ]; then eval "$trap_int"; else trap - INT; fi
  if [ -n "$trap_term" ]; then eval "$trap_term"; else trap - TERM; fi
  if [ "$fails" -ne 0 ]; then
    warn "骨架补齐未完成——见下方失败清单（本次不打印「骨架零缺口」，也不得报成功）"
    return 1
  fi
  if [ "$n" -eq 0 ]; then
    printf '骨架零缺口（UPGRADE_UNIVERSE 十七文件齐全，未写任何文件）\n'
  else
    printf '骨架补齐：%s\n' "$n"
    info "骨架补齐只补缺失项：既有十七文件一字不动（缺口口径与 'ponygo upgrade' 同一宇宙表）"
  fi
  return 0
}

# ---------- upgrade apply（D4：把宇宙内文件刷新为内嵌模板的**写路径**） ----------
# 为什么是位置子命令而不是旗标：旗标预算受 flag-budget ADR 约束（零新旗标）；语义上 apply 是
# upgrade 的写路径变体，位置词不会被误当"只读检查"。
# 与 --check 的**共同口径**（禁第二份判断）：
#   - 同一宇宙表 UPGRADE_UNIVERSE（十七文件）；
#   - 同一模板基准（write_skeleton 0 到 mktemp 目录）；
#   - 同一 docs-tier 跳过规则（已激活实例的 .meta/docs-tier/README.md 不参与比对/刷新）；
#   - 同一内容比较口径（EOL 归一后 diff）。
# 差别只在**有漂移时做什么**：--check 报 drift 并非零退出；apply 原子写回模板字节。
cmd_upgrade_apply() {
  echo "===== ponygo upgrade apply ====="
  has_meta || die "无 .meta/ 治理根（meta.yaml 缺失）——先 'ponygo init'；apply 只刷新宇宙内十七文件，不播种骨架"
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'ponygo: WARN 不在 git 仓库内——apply 不依赖 git，但无法派生版本/血缘（与 --check 同款 WARN）\n' >&2
  fi
  local tmp="" f="" n=0 fails=0 mode="" dt_skip=0 existed=1
  tmp=$(mktemp -d) || die "无法创建临时目录——apply 未写任何文件"
  trap 'rm -rf "${tmp:-}" 2>/dev/null || true; trap - EXIT INT TERM' EXIT INT TERM
  ( cd "$tmp" && write_skeleton 0 ) >/dev/null 2>&1 \
    || { rm -rf "$tmp"; trap - EXIT INT TERM; die "无法生成模板基准（write_skeleton 0 非零）——apply 未写任何文件"; }
  # docs-tier 已激活实例：该文件跳过（与 --check 完全同一口径）
  if [ -f "$META_DIR/docs-tier/README.md" ] && grep -q '## 已激活文档家清单' "$META_DIR/docs-tier/README.md"; then
    dt_skip=1
    echo "注：docs-tier 已激活实例——.meta/docs-tier/README.md 跳过刷新（与 --check 同口径：激活必改写它，覆盖即抹掉实例申报）；其余十六文件照常处理。"
  fi
  for f in $UPGRADE_UNIVERSE; do
    [ "$dt_skip" = "1" ] && [ "$f" = ".meta/docs-tier/README.md" ] && continue
    if [ ! -f "$tmp/$f" ]; then
      printf '内部不一致: 模板基准缺 %s（UPGRADE_UNIVERSE 与 write_skeleton 生成集漂移）——该项未刷新\n' "$f" >&2
      fails=$((fails+1)); continue
    fi
    mode=$(file_mode "$tmp/$f")
    # 内容一致（EOL 归一后）→ 一字不动。这条是幂等的机械保证：第二次 apply 必报「零变更」。
    if [ -f "$f" ] && diff -q <(tr -d '\r' < "$f") <(tr -d '\r' < "$tmp/$f") >/dev/null 2>&1; then
      continue
    fi
    existed=1
    [ -f "$f" ] || existed=0
    if write_atomic "$f" "$mode" < "$tmp/$f"; then
      n=$((n+1))
      if [ "$existed" = "1" ]; then info "应用（刷新）：$f"; else info "应用（补缺失）：$f"; fi
    else
      printf 'ponygo: WARN 写入失败：%s（目录不可写 / 原子替换失败）→ 该项未刷新\n' "$f" >&2
      fails=$((fails+1))
    fi
  done
  # 可选资产（OPTIONAL_UNIVERSE：模板库九文件）：只刷新**已在场**的库文件——库文件是模板所有，
  # 在场即受模板约束（与 --check 的 drift 口径同源）；**缺失不补**，库文件的缺失由
  # 'ponygo init --repair-skeleton' 只补缺失负责，apply 不越界创建可选资产。
  for f in $OPTIONAL_UNIVERSE; do
    [ -f "$f" ] || continue
    if [ ! -f "$tmp/$f" ]; then
      printf '内部不一致: 模板基准缺可选资产 %s（OPTIONAL_UNIVERSE 与 write_skeleton 生成集漂移）——该项未刷新\n' "$f" >&2
      continue
    fi
    if diff -q <(tr -d '\r' < "$f") <(tr -d '\r' < "$tmp/$f") >/dev/null 2>&1; then
      continue
    fi
    mode=$(file_mode "$tmp/$f")
    if write_atomic "$f" "$mode" < "$tmp/$f"; then
      n=$((n+1)); info "应用（刷新可选资产）：$f"
    else
      printf 'ponygo: WARN 写入失败：%s（可选资产，目录不可写 / 原子替换失败）→ 该项未刷新\n' "$f" >&2
      fails=$((fails+1))
    fi
  done
  rm -rf "$tmp"; trap - EXIT INT TERM
  if [ "$fails" -ne 0 ]; then
    printf 'apply 未完成：%s 项写入失败（见上）；本次成功应用 %s 处\n' "$fails" "$n"
    return 1
  fi
  if [ "$n" -eq 0 ]; then
    printf 'apply 零变更（宇宙内十七文件与在场库文件已与内嵌模板一致，未写任何文件）\n'
  else
    printf '应用 %s 处（宇宙内十七文件与在场库文件已与内嵌模板对齐；跑 ponygo upgrade --check 复核零漂移）\n' "$n"
  fi
  return 0
}

cmd_upgrade() {
  echo "===== ponygo upgrade ====="
  # 升级纪律最先打印（任何分支都可见；s15 空目录用例断言其存在）
  echo "升级纪律（首版不实际执行 diff 合并，那是 v+2 能力）："
  echo "  1) 实例化禁止 cp -r / degit 抹历史——保留 fork 图方可跟随升级。"
  echo "  2) 保留血缘：git remote add upstream <ponygo 模板> && git fetch upstream && git merge upstream/main"
  echo "  3) 已失去血缘（cp 产生）→ 升级退化为人肉对照，漂移自担（诚实声明，勿假装可自动升级）。"
  # donot：无 .meta/ → die 并指引 init（对齐 retire/status）。真·空目录（s15 历史 fixture，仅 .git 也算空）
  # 温和跳过，有实质内容的目录（s31③ fixture：有 README 或任何文件）die——两种 fixture 语义不同（spec §8 s31③ / D2 修法）。
  if ! has_meta; then
    if [ -z "$(ls -A . 2>/dev/null | grep -v '^\.git$')" ]; then
      echo "无 .meta/ 治理根（空目录）——无可漂移基线。先 'ponygo init' 播种，再看本报告。"
      echo "tmpdir 已清理"
      return 0
    fi
    die "无 .meta/ 治理根（meta.yaml 缺失）——先 'ponygo init' 再跟随升级"
  fi
  # donot：非 git → WARN（对齐 status；漂移参照 git 血缘时不可用，退化为纯文件比对）
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'ponygo: WARN 不在 git 仓库内——无法从 git 派生版本/血缘，漂移报告退化为纯文件比对（对齐 status 的 WARN）\n' >&2
  fi
  # donot：无 level → 按 L0 处理（read_level 三态之"缺文件/缺 level 行"；空值/畸形仍走 0.4 FAIL 语义，不走 L0）
  local lv=""
  lv=$(read_level)
  case "$lv" in
    ''|*[!0-9]*) echo "当前 level：缺失/非法（按 L0 处理漂移基线；level 合法性请交给 'ponygo status' 的 0.4 判据）" ;;
    *)            echo "当前 level：$(fmt_level "$lv")" ;;
  esac
  # 报告头：盲区声明（升级纪律已在函数头打印）
  echo "漂移报告：本报告只覆盖 s14 宇宙内十七文件（十文件骨架 + 门禁资产 A1/A2/A4/A6/A7/A8/A9）；宇宙外文件无基线，不判定。漂移=观察，非承诺违例（status 管承诺）。"
  # 已激活 docs-tier 实例：本文件不参与漂移比对（激活必改写该文件，比对即恒漂移、--check 恒红）。
  # 实例侧口径：生成物仍是模板态（由 write_skeleton 的 heredoc 提供）；s14 用同一判据分支，
  # 不再假定"仓库文件 = 模板"——模板仓自身也可以是一个已激活实例。
  local dt_skip=0
  if [ -f "$META_DIR/docs-tier/README.md" ] && grep -q '## 已激活文档家清单' "$META_DIR/docs-tier/README.md"; then
    dt_skip=1
    echo "注：docs-tier 已激活实例——.meta/docs-tier/README.md 不参与漂移比对（本仓该文件是激活版，模板基准仍是 heredoc 提供的模板态）；其余十六文件照常比对（宇宙 17 − 本文件 1）。"
  fi
  # 生成模板基准（临时目录，用 write_skeleton 同源 heredoc；eol 归一后逐字节比对）。
  # write_skeleton 是当前进程内的函数（相对路径常量），在子 shell cd 后调用即生成一套模板骨架。
  local tmp="" f="" drift_n=0 missing_n=0
  tmp=$(mktemp -d) || die "无法创建临时目录"
  trap 'rm -rf "${tmp:-}" 2>/dev/null || true; trap - EXIT INT TERM' EXIT INT TERM
  ( cd "$tmp" && write_skeleton 0 ) >/dev/null 2>&1 || { rm -rf "$tmp"; trap - EXIT INT TERM; die "无法生成模板基准"; }
  for f in $UPGRADE_UNIVERSE; do
    # P2-1：docs-tier 已激活实例跳过该文件比对（激活必改写该文件，比对恒漂移）
    [ "$dt_skip" = "1" ] && [ "$f" = ".meta/docs-tier/README.md" ] && continue
    if [ ! -f "$f" ]; then
      # 缺骨架文件（实例侧缺失）：gates/README 是"仅空目录时生成"的条件写入口——
      # gates 目录已有实质门禁时缺 README 报"缺口"（缺骨架文件）而非"漂移"（D2 边界）
      missing_n=$((missing_n+1))
      # W3-B/W6：同口径——无有效内容的文件不算「已有实质门禁」
      # （否则空文件/注释-only 文件即可把该缺口判成 README 分支）
      local gu=0 guf=""
      if [ "$f" = ".meta/gates/README.md" ] && [ -d "$META_DIR/gates" ]; then
        while IFS= read -r -d '' guf; do
          if file_has_content "$guf"; then gu=1; break; fi
        done < <(find "$META_DIR/gates" -maxdepth 1 -type f \
            ! -name 'README.md' ! -name '.gitkeep' -print0 2>/dev/null)
      fi
      if [ "$f" = ".meta/gates/README.md" ] && [ "$gu" = "1" ]; then
        echo "缺口: $f（gates/ 已有实质门禁但缺 README——跑 'ponygo init --repair-skeleton' 只补缺失，或手建）"
      else
        echo "缺口: $f（缺骨架文件——跑 'ponygo init --repair-skeleton' 补全后再跟随升级）"
      fi
      continue
    fi
    # P3-1：模板侧缺失 = 清单与 write_skeleton 生成集漂移（内部不一致），报内部错误而非误归 drift
    if [ ! -f "$tmp/$f" ]; then
      missing_n=$((missing_n+1))
      echo "内部不一致: 模板基准缺 $f（UPGRADE_UNIVERSE 与 write_skeleton 生成集漂移——联系维护者对齐清单或生成逻辑）"
      continue
    fi
    if ! diff -q <(tr -d '\r' < "$f") <(tr -d '\r' < "$tmp/$f") >/dev/null 2>&1; then
      drift_n=$((drift_n+1))
      echo "drift: $f"
    fi
  done
  # ---- 可选资产（OPTIONAL_UNIVERSE = 模板库九文件；spec §4 语义与十七文件不同）----
  # 缺失 → 打印「缺口（可选资产）」：**不判 drift、不改退出码**（历史实例可暂不装库，
  # 缺失只由 status 的可选资产缺口行 / audit 的 skill_library_missing 提示表达）；
  # 存在但与模板不一致 → 照常报 drift（库文件是模板所有，实例改动即漂移）。
  local opt_missing_n=0 opt_undecided=0
  for f in $OPTIONAL_UNIVERSE; do
    if [ ! -f "$f" ]; then
      opt_missing_n=$((opt_missing_n+1))
      echo "缺口（可选资产）: $f（可选资产缺失——跑 'ponygo init --repair-skeleton' 只补缺失；不计入退出码）"
      continue
    fi
    if [ ! -f "$tmp/$f" ]; then opt_undecided=$((opt_undecided+1)); continue; fi
    if ! diff -q <(tr -d '\r' < "$f") <(tr -d '\r' < "$tmp/$f") >/dev/null 2>&1; then
      drift_n=$((drift_n+1))
      echo "drift: $f"
    fi
  done
  rm -rf "$tmp"
  trap - EXIT INT TERM
  if [ "$drift_n" -eq 0 ] && [ "$missing_n" -eq 0 ]; then
    echo "宇宙内十七文件与模板基准一致，零漂移。"
  else
    echo "发现 $drift_n 处漂移 + $missing_n 处缺口（drift:/缺口: 前缀行）——离线源是模板基准，逐条合入或按升级纪律重建血缘。"
  fi
  if [ "$opt_missing_n" -gt 0 ]; then
    echo "可选资产缺口 $opt_missing_n 处（见上「缺口（可选资产）」行；可选资产缺失不判 drift、不改退出码）"
  elif [ "$opt_undecided" -gt 0 ]; then
    echo "可选资产 $opt_undecided 个未比对（模板基准缺该文件——观察项，不计入漂移）"
  fi
  echo "tmpdir 已清理"
  # exit 语义：默认报告 exit 0（漂移是观察）；--check 漂移**或缺口**非零（供 CI——删骨架文件比内容漂移更严重，CI 应拦住）
  if [ "${UPGRADE_CHECK:-0}" = "1" ]; then
    [ "$drift_n" -eq 0 ] && [ "$missing_n" -eq 0 ] || exit 1
  fi
  return 0
}

# ---------- 退级（停止线执行器） ----------
cmd_retire() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo "用法：ponygo retire --level <N|off>   （注意 off 必须挂在 --level 后：ponygo retire --level off）"
    echo "  N     把 meta.yaml 的 level 改写为目标档（降级，如 2 → 1），并提示移除超档机制"
    echo "  off   整体退场：ai-surface 置 off（不再生成 AI 投影）+ level 归 0（纯 L0 长驻模式）"
    echo "说明：删除是独立工程（P9）——退级须录一条 decision 到 .agents/notes/。"
    return 0
  fi
  has_meta || die "无 .meta/ 治理根（meta.yaml 缺失）——先 'ponygo init' 再退级"
  [ -f "$META_YAML" ] || die "$META_YAML 缺失或不是常规文件——先 'ponygo init' 再退级"
  case "$target" in
    off)
      # wave-5：无交互确认（收到即执行）；--dry-run 仍须零落盘
      if [ "${DRY_RUN:-0}" = "1" ]; then
        info "[dry-run] 把 ai-surface 置 off 且 level 归 0（整体退场到纯 L0 长驻模式）"
        return 0
      fi
      sed -i 's/^level:.*/level: 0/' "$META_YAML"
      grep -qE '^ai-surface:' "$META_YAML" || printf 'ai-surface: off\n' >> "$META_YAML"
      sed -i 's/^ai-surface:.*/ai-surface: off/' "$META_YAML"
      info "已整体退场：level 0 + ai-surface off。勿忘录一条退级 decision。"
      ;;
    [0-5])
      if [ "${DRY_RUN:-0}" = "1" ]; then
        info "[dry-run] 把 level 降级到 $target（并提示移除超档机制）"
        return 0
      fi
      sed -i "s/^level:.*/level: $target/" "$META_YAML"
      # 联动：降到 L0 时应清掉 ai-surface 悬挂（否则 sync 仍会生成投影，与退场语义冲突）
      if [ "$target" = "0" ] && grep -qE '^ai-surface:[[:space:]]*on' "$META_YAML"; then
        info "已降级到 L0，检测到 ai-surface: on —— 若要纯 L0 长驻，请改 'ponygo retire --level off'。"
      fi
      info "level 已降到 $target。超档机制（gates/skills/docs-tier）请按 P9 连根拔并录 decision。"
      ;;
    *) die "retire 目标非法：$target（用 0-5 或 off）" ;;
  esac
}

# ---------- observe（可观测性治理维度） ----------
# W0 契约冻结：此处只暴露**命令面与退出码骨架**，不含任何判定逻辑。
# ob0/ob1/ob2 的判据实现（声明存在/无占位/check-declaration rc 白名单/audit-diff 收口）
# 属 Executor task-3；--json 词表、init 声明模板、upgrade 版本比较同属 task-3。
# EXEC: 完整校验与 --mapping 覆盖见 task-3

# ---------- observe 辅助函数（映射/版本/技能目录/超时/probe） ----------
# PONYGO_SELF：单文件自路径（映射数据块与脚本同文件；取数不依赖调用时 CWD）。
PONYGO_SELF=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/$(basename "${BASH_SOURCE[0]:-$0}")

# 映射文件：--mapping 值 > env PONYGO_OBSERVE_MAPPING > 嵌入数据块（=脚本自身）
observe_mapping_file() {
  if [ -n "${OBSERVE_MAPPING_FILE:-}" ]; then printf '%s\n' "$OBSERVE_MAPPING_FILE"; return 0; fi
  if [ -n "${PONYGO_OBSERVE_MAPPING:-}" ]; then printf '%s\n' "${PONYGO_OBSERVE_MAPPING}"; return 0; fi
  printf '%s\n' "$PONYGO_SELF"
}

# 数据块 fail-closed 校验：必需键各恰好一行且取值非空；mapping_version 必须为 1。
# 首次调用一次即可（OBS_MAP_VERIFIED 防重复）。
observe_require_keys() {
  [ "${OBS_MAP_VERIFIED:-0}" = "1" ] && return 0
  local f k n mv keys bad
  f=$(observe_mapping_file)
  if [ ! -f "$f" ]; then
    printf 'ponygo: 映射文件不存在：%s\n' "$f" >&2
    printf '  排查：改用 --mapping <file> 或 env PONYGO_OBSERVE_MAPPING=<file>\n' >&2
    exit 2
  fi
  keys="mapping_version ob_levels ob_level0_name ob_level1_name ob_level2_name
ob_advisory_name target_level_0 target_level_1 target_level_2 target_level_3
target_level_4 target_level_5 kind_enum contract_version_min declaration_paths
placeholder_token mount_carriers skill_dir_rel external_timeout_seconds
local_timeout_seconds"
  bad=""
  for k in $keys; do
    n=$(grep -E "^${k}:[[:space:]]*[^[:space:]]" "$f" | wc -l)
    n=${n//[!0-9]/}
    if [ "$n" != "1" ]; then
      bad="$bad$k(命中${n:-0}次) "
    fi
  done
  if [ -n "$bad" ]; then
    printf 'ponygo: 映射数据块键异常：\n' >&2
    for k in $bad; do
      printf '  - %s\n' "$k" >&2
    done
    printf '  期望每键恰好一行且取值非空；排查：grep -n "^<key>:" %s\n' "$f" >&2
    exit 2
  fi
  # CRLF 归一改用 bash 参数展开而非 `tr`（CT-10 同源）：tr 缺失/被替换时管道输出为空，
  # 会让版本解析误判「mapping_version 不支持（空）」而 exit 2，把工具缺失伪装成数据块损坏。
  mv=$(sed -n 's/^mapping_version:[[:space:]]*//p' "$f" | head -n1)
  mv=${mv%$'\r'}
  if [ "$mv" != "1" ]; then
    printf 'ponygo: 映射数据块版本不支持：%s（本版本只认 mapping_version: 1）\n' "${mv:-（空）}" >&2
    exit 2
  fi
  OBS_MAP_VERIFIED=1
}

# 取值：键白名单 + 缺失 fail-closed（sed 首命中即停，不依赖管道求首行）
observe_map_get() {
  local key f v
  key=${1:-}
  case "$key" in ''|*[!a-z0-9_]*) die "映射键非法：${key:-（空）}" ;; esac
  observe_require_keys
  f=$(observe_mapping_file)
  v=$(sed -n "/^${key}:[[:space:]]*/{s/^${key}:[[:space:]]*//;s/\r\$//;p;q;}" "$f")
  if [ -z "$v" ]; then
    printf 'ponygo: 映射键缺失：%s\n' "$key" >&2
    printf '  排查：grep -n "^%s:" %s\n' "$key" "$f" >&2
    exit 2
  fi
  printf '%s\n' "$v"
}

# $1 >= $2 → 0（按 . 拆三段整数；缺段按 0；非数字按 0）
observe_version_ge() {
  local v1 v2 i a b
  local -a s1 s2
  v1=${1:-}; v2=${2:-}; s1=(); s2=()
  while [ -n "$v1" ]; do
    s1+=("${v1%%.*}")
    case "$v1" in *.*) v1=${v1#*.} ;; *) v1="" ;; esac
  done
  while [ -n "$v2" ]; do
    s2+=("${v2%%.*}")
    case "$v2" in *.*) v2=${v2#*.} ;; *) v2="" ;; esac
  done
  for i in 0 1 2; do
    a=${s1[$i]:-0}; b=${s2[$i]:-0}
    case "$a" in ''|*[!0-9]*) a=0 ;; esac
    case "$b" in ''|*[!0-9]*) b=0 ;; esac
    a=$((10#$a)); b=$((10#$b))
    [ "$a" -gt "$b" ] && return 0
    [ "$a" -lt "$b" ] && return 1
  done
  return 0
}

# contract_version 进 JSON 前净化（F7）：只认 ^[0-9]+\.[0-9]+\.[0-9]+$，其余一律 unknown
# （版本源是 skill 侧文件，可能含引号/反斜杠——不净化会直接产出非法 JSON）
observe_version_json() {
  local v=${1:-}
  if printf '%s' "$v" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    printf '%s' "$v"
  else
    printf 'unknown'
  fi
}

# skill 目录：--skill-dir > ${PONYGO_SKILL_DIR} > $HOME/<skill_dir_rel>（不校验存在性）
observe_skill_dir_soft() {
  if [ -n "${OBSERVE_SKILL_DIR:-}" ]; then printf '%s\n' "$OBSERVE_SKILL_DIR"; return 0; fi
  if [ -n "${PONYGO_SKILL_DIR:-}" ]; then printf '%s\n' "${PONYGO_SKILL_DIR}"; return 0; fi
  printf '%s/%s\n' "${HOME:-}" "$(observe_map_get skill_dir_rel)"
}

# $1=dir → 打印 references/contract.json 的 contract_version；取不到打印空
observe_skill_version() {
  local d f
  d=${1:-}
  if [ -z "$d" ]; then printf '\n'; return 0; fi
  f="$d/references/contract.json"
  if [ ! -f "$f" ]; then printf '\n'; return 0; fi
  sed -n 's/.*"contract_version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n1 | tr -d '\r'
}

# audit/upgrade 前置：skill 目录或 contract.json 缺失 → exit 2（附安装提示）
observe_skill_require() {
  local d c why
  d=$(observe_skill_dir_soft)
  c="$d/references/contract.json"
  if [ -d "$d" ] && [ -f "$c" ]; then return 0; fi
  if [ -d "$d" ]; then why="缺 references/contract.json"; else why="目录不存在"; fi
  printf 'ponygo: 技能目录不可用：%s（%s）\n' "$d" "$why" >&2
  printf '  安装：从所属 skill 仓把 observability-onboarding 安装到 ~/.agents/skills/observability-onboarding\n' >&2
  printf '  或：ponygo observe <status|audit|upgrade> --skill-dir <dir>（等价 env PONYGO_SKILL_DIR=<dir>）\n' >&2
  exit 2
}

# `timeout` 语义探针（惰性一次；OBS_TIMEOUT_OK=1/0）
# 不可用时一次性 WARN（F4）：外部命令（skill 脚本）将无超时保护，不得静默降级
observe_timeout_ok() {
  if [ -z "${OBS_TIMEOUT_OK:-}" ]; then
    if timeout 1 bash -c 'exit 0' >/dev/null 2>&1; then OBS_TIMEOUT_OK=1; else OBS_TIMEOUT_OK=0; fi
  fi
  if [ "$OBS_TIMEOUT_OK" != "1" ] && [ "${OBS_TIMEOUT_WARNED:-0}" != "1" ]; then
    OBS_TIMEOUT_WARNED=1
    printf 'ponygo: WARN 未找到可用的 timeout，外部命令无超时保护（评审建议：安装 coreutils timeout）\n' >&2
  fi
  [ "$OBS_TIMEOUT_OK" = "1" ]
}

# 超时秒数判据（CT-6，**locale 无关**）：只接受纯 ASCII 十进制数字，且长度 ≤ 6 位。
# 为什么不只靠 `case "$v" in *[!0-9]*)`：UTF-8 locale 下该字符类对**全角数字**（如 ６０）不命中，
# 值会原样透传给 `timeout ６０` → GNU timeout 报 `invalid time interval`、rc=125 → 落回 rc 白名单外
# ⇒ gaps=tool_error ⇒ 假红复活（正是本修复要消灭的形态）。故改用 LC_ALL=C 的 tr 在**字节层**剔除
# ASCII 0-9 后判残渣，与 locale 无关。
# 长度上限同理：GNU timeout 接受 20 位天文数字（rc=0）等于「永不超时」，会破坏 fail-closed 语义。
# CT-10：判据自身也必须 fail-closed——`tr` 缺失/被替换而失败时输出为空，若只看输出就会把**任意值**
# 判成「纯数字」并放行（于是又回到 `timeout abc` → invalid interval → 假红）。故把 tr 的退出码纳入
# 判据：非零即判非法。
observe_timeout_num_ok() {
  local v=${1:-} rest
  [ -n "$v" ] || return 1
  [ "${#v}" -le 6 ] || return 1
  rest=$(printf '%s' "$v" | LC_ALL=C tr -d '0-9') || return 1
  [ -z "$rest" ] || return 1
  return 0
}

# audit-diff 独立超时预算（CT-1/CT-2）：
#   * 取数 = data 块 diff_timeout_seconds（缺省 60 秒）。**不复用** local_timeout_seconds——
#     后者是本地快命令预算（3s），而 audit-diff 要扫描整仓变更（实测大仓 12.1s / 637 文件），
#     3s 会稳定把进程打死成 rc=124，真违规与工具超时因此不可辨（假红淹没真红）。
#   * 覆盖 = env PONYGO_OBS_DIFF_TIMEOUT（正整数）优先。非法值（空/0/负数/非数字/非整数/全角数字/
#     超长数字）一律**忽略并告警**，绝不静默接受——预算漂移必须留痕（0 在 GNU timeout 下等于
#     「不限时」，会把 fail-closed 变成挂死，故 0 与 00 同样判非法）。
#   * $1 = data 块原值（可空：旧 --mapping 覆盖文件没有该键，按可选键软读处理）。
observe_diff_timeout() {
  local base raw bad orig cleaned
  orig=${1:-}
  base=$orig
  # 值清洗与 observe_audit 里 kind 的取数同口径：去行内注释、去首尾空白、去成对引号。
  base=${base%%[[:space:]]#*}
  base=${base#"${base%%[![:space:]]*}"}
  base=${base%"${base##*[![:space:]]}"}
  case "$base" in \"*\") base=${base#\"}; base=${base%\"} ;; esac
  case "$base" in \'*\') base=${base#\'}; base=${base%\'} ;; esac
  cleaned=$base
  bad=0
  if [ -n "$cleaned" ]; then
    observe_timeout_num_ok "$cleaned" || bad=1
    if [ "$bad" = "0" ]; then
      while [ "${base#0}" != "$base" ]; do base=${base#0}; done
      [ -n "$base" ] || bad=1      # 全 0（0/00/000…）：GNU timeout 0 = 不限时，等同 fail-open
    fi
  fi
  if [ "$bad" = "1" ]; then
    # 显式写了却清洗不出来：必须告警，否则与 env 路径「非法必告警」不对称，预算漂移无法追溯。
    printf 'ponygo: WARN 映射键 diff_timeout_seconds 取值非法（须为纯 ASCII 十进制正整数且 ≤6 位，实得 [%s]），已回退缺省 60 秒\n' \
      "$orig" >&2
    base=60
  elif [ -z "$cleaned" ]; then
    # 键缺失（旧 --mapping 覆盖文件没这一行）＝「未声明」，按缺省 60 处理；不算清洗失败，不告警。
    base=60
  fi
  raw=${PONYGO_OBS_DIFF_TIMEOUT:-}
  # 区分「未设置」与「显式设为空串」：后者是非法值（CT-2 明列），必须告警而不是静默沿用缺省。
  [ -n "${PONYGO_OBS_DIFF_TIMEOUT+set}" ] || { printf '%s\n' "$base"; return 0; }
  bad=0
  observe_timeout_num_ok "$raw" || bad=1
  if [ "$bad" = "0" ]; then
    while [ "${raw#0}" != "$raw" ]; do raw=${raw#0}; done
    [ -n "$raw" ] || bad=1         # 全 0：同上，timeout 0 等于不限时
  fi
  if [ "$bad" = "1" ]; then
    printf 'ponygo: WARN 环境变量 PONYGO_OBS_DIFF_TIMEOUT 取值非法（须为纯 ASCII 十进制正整数且 ≤6 位，实得 [%s]），已忽略，沿用 diff_timeout_seconds=%s 秒\n' \
      "${PONYGO_OBS_DIFF_TIMEOUT:-}" "$base" >&2
    printf '%s\n' "$base"
    return 0
  fi
  printf '%s\n' "$raw"
}

# $1=timeout_seconds $2=script 其余=args → 返回 skill 的 rc；skill 原始输出统一走 stderr
# 输出捕获用文件重定向（绝不用 $(...)）：skill 可能输出大/多行/含 NUL 前导空字节，
# 且 --json 时 stdout 必须干净。临时文件路径登记到全局 OBS_TMPFILE：EXIT/INT/TERM trap 兜底 rm
# （F3，防信号打断执行中的 skill 时残留）；正常返回前显式 rm 并置空。
# mktemp 失败 → return 240（哨兵：>=200 一律按「工具错误」，调用方不得读成 skill 的 rc=2）。
observe_run_skill() {
  local tmo script out rc
  tmo=${1:-0}; script=${2:-}
  if [ $# -ge 2 ]; then shift 2; else set --; fi
  out=$(mktemp "${TMPDIR:-/tmp}/ponygo-obs.XXXXXX") || {
    printf 'ponygo: 错误 无法创建临时文件（TMPDIR=%s），skill 输出无法捕获：%s\n' "${TMPDIR:-/tmp}" "$script" >&2
    printf '  排查：TMPDIR 是否可写 / 磁盘是否满；本项按工具错误处理（不是 skill 判定结论）\n' >&2
    return 240
  }
  OBS_TMPFILE=$out
  if observe_timeout_ok; then
    timeout "$tmo" bash "$script" "$@" >"$out" 2>&1; rc=$?
  else
    bash "$script" "$@" >"$out" 2>&1; rc=$?
  fi
  cat "$out" >&2
  rm -f "$out"
  OBS_TMPFILE=""
  return $rc
}

# 声明文件：data 块 declaration_paths 中第一个存在的；都没有 → 打印空
# 含 glob 元字符（* ? [）的项不参与匹配（F7）：先 set -f 关掉路径展开，再按字面路径逐项判存在，
# 否则 'docs/*.yaml' 这类项会被 shell 展开成真实文件、绕过「不参与匹配」。
observe_decl_path() {
  local p found="" glob_on=0
  case "$-" in *f*) : ;; *) set -f; glob_on=1 ;; esac
  for p in $(observe_map_get declaration_paths); do
    case "$p" in *'*'*|*'?'*|*'['*) continue ;; esac
    if [ -f "$p" ]; then found=$p; break; fi
  done
  [ "$glob_on" = "1" ] && set +f
  printf '%s\n' "$found"
}

# 软读映射键：键不存在时返回空串（**不** fail-closed）。只给**可选**键用（如 declaration_extra_dir），
# 避免「新增可选键」把旧的 --mapping 覆盖文件判成坏块。
observe_map_try() {
  local key f
  key=${1:-}
  case "$key" in ''|*[!a-z0-9_]*) return 0 ;; esac
  f=$(observe_mapping_file)
  sed -n "/^${key}:[[:space:]]*/{s/^${key}:[[:space:]]*//;s/\r\$//;p;q;}" "$f" 2>/dev/null
}

# 附加声明目录（同目录多声明，缺陷 E）：默认 docs/observability.d，可由映射键覆盖。
observe_decl_extra_dir() {
  local d
  d="$(observe_map_try declaration_extra_dir)"
  [ -n "$d" ] || d="docs/observability.d"
  printf '%s\n' "$d"
}

# 附加声明清单（排序；不含主声明）。同目录多形态靠它表达：kind 是单值，
# 一份 docs/observability.yaml 无法同时是 k8s-service 和 pipeline。
observe_decl_extra_list() {
  local d
  d="$(observe_decl_extra_dir)"
  [ -d "$d" ] || return 0
  find "$d" -maxdepth 1 -type f \( -name '*.yaml' -o -name '*.yml' \) 2>/dev/null | LC_ALL=C sort
}

# YAML 单引号标量（F1）：值内单引号写成两个；只用于已过 observe_scalar_check 的值
observe_yaml_sq() {
  local v=${1:-}
  printf "'%s'" "${v//\'/\'\'}"
}

# 挂载载体命中判定（缺陷 F：ob2 的 mount 判据曾纯文本 grep，注释里写 audit-diff 就 PASS）。
# 规则：必须有**非注释行**引用 audit-diff。注释前缀覆盖 shell/yaml/py(#)、js/ts(//、/*、*)、md/html(<!--)。
# 局限（如实标注）：这仍是文本判据，不解析 AST，也不验证「该钩子真的会执行」；真执行证据是
# `ponygo observe audit --level ob2` 里 audit-diff 本身的 rc（K7）。
observe_mount_hit() {
  local target=${1:-} hits
  [ -n "$target" ] && [ -e "$target" ] || return 1
  if [ -d "$target" ]; then
    hits=$(grep -rIn --binary-files=without-match -F 'audit-diff' "$target" 2>/dev/null || true)
  else
    hits=$(grep -In --binary-files=without-match -F 'audit-diff' "$target" 2>/dev/null || true)
  fi
  [ -n "$hits" ] || return 1
  printf '%s\n' "$hits" | grep -qvE ':[0-9]+:[[:space:]]*(#|//|/\*|\*|<!--)'
}

# anchor/reason 值的 YAML 标量校验（F1，防 YAML 注入）：$1=值 $2=旗标名
# 空值=未提供（调用方自行处理）；非法 → exit 2（写盘前拦截，绝不写出重复键/非法 YAML/null）
observe_scalar_check() {
  local v flag
  v=${1:-}; flag=${2:-值}
  [ -z "$v" ] && return 0
  case "$v" in
    *[[:cntrl:]]*)
      printf 'ponygo: observe init：%s 含换行/回车/制表符/控制字符，拒绝写入（YAML 标量注入风险）\n' "$flag" >&2
      printf '  改为单行文本；需要多行说明请写进声明文件后手改（init 只写单行标量）\n' >&2
      exit 2 ;;
  esac
  case "$v" in
    '#'*|'&'*|'*'*|'!'*|'|'*|'>'*|'{'*|'['*|'-'*|'?'*|':'*)
      printf 'ponygo: observe init：%s 以 YAML 指示符开头（# & * ! | > { [ - ? :），拒绝写入\n' "$flag" >&2
      exit 2 ;;
  esac
  case "$v" in
    *': '*)
      printf 'ponygo: observe init：%s 含 ": "（会被读成第二个键），拒绝写入：%s\n' "$flag" "$v" >&2
      exit 2 ;;
  esac
  case "$v" in
    *' #'*)
      printf 'ponygo: observe init：%s 含 " #"（YAML 注释起始，值会被截断/成 null），拒绝写入：%s\n' "$flag" "$v" >&2
      exit 2 ;;
  esac
  if [ "${#v}" -gt 500 ]; then
    printf 'ponygo: observe init：%s 长度 %s 超过 500，拒绝写入\n' "$flag" "${#v}" >&2
    exit 2
  fi
  return 0
}

# 目标级：.meta/meta.yaml 的 level 经 target_level_<N> 映射；空/非数字/越界 → 0
observe_target_level() {
  local lv target
  lv=$(read_level)
  case "$lv" in ''|*[!0-9]*) lv=0 ;; esac
  case "$lv" in 0|1|2|3|4|5) : ;; *) printf 'ob0\n'; return 0 ;; esac
  target=$(observe_map_get "target_level_$lv")
  if [ -z "$target" ]; then target=ob0; fi
  printf '%s\n' "$target"
}

# 级别序：ob0<ob1<ob2；未知 → -1
observe_rank() { case "${1:-}" in ob0) echo 0 ;; ob1) echo 1 ;; ob2) echo 2 ;; *) echo -1 ;; esac; }

# 只读静态报告：不调用任何 skill 脚本、不写盘、rc 恒 0（映射数据坏 → 2，由 observe_map_get 抛出）
observe_status() {
  local decl present ph skill_dir ver min target compat kind raw gaps sep sp
  observe_require_keys
  decl=$(observe_decl_path)
  present=false
  if [ -n "$decl" ]; then present=true; fi

  # 占位符：非注释行命中即"有占位"（注释行不算，模板注释可能自带示例 token）
  ph=false
  if [ "$present" = "true" ]; then
    if grep -v '^[[:space:]]*#' "$decl" | grep -q -F "$(observe_map_get placeholder_token)"; then
      ph=true
    fi
  fi

  skill_dir=$(observe_skill_dir_soft)
  ver=$(observe_skill_version "$skill_dir")
  min=$(observe_map_get contract_version_min)
  compat=false
  if [ -n "$ver" ] && observe_version_ge "$ver" "$min"; then compat=true; fi
  target=$(observe_target_level)

  # 声明 kind：净化后仅当匹配 ^[a-z0-9-]+$ 且 ∈ kind_enum 才回显，否则 unknown
  kind=unknown
  if [ -n "$decl" ]; then
    raw=$(sed -n 's/^[[:space:]]*kind:[[:space:]]*//p' "$decl" | head -n1 | tr -d '\r')
    raw=${raw%%[[:space:]]#*}                       # 去行内注释
    while :; do case "$raw" in *[[:space:]]) raw=${raw%?} ;; *) break ;; esac; done
    case "$raw" in \"*\") raw=${raw#\"}; raw=${raw%\"} ;; esac
    case "$raw" in \'*\') raw=${raw#\'}; raw=${raw%\'} ;; esac
    case "$raw" in
      ''|*[!a-z0-9-]*) : ;;
      *) case " $(observe_map_get kind_enum) " in *" $raw "*) kind=$raw ;; esac ;;
    esac
  fi

  # Monorepo 多组件感知（方案 A）：探测当前目录一级子目录中是否存在独立前端工程且未声明
  local unmanaged_sub="" unmanaged_found=0
  local sub cand
  for cand in front_end frontend web client ui app; do
    if [ -d "$cand" ] && [ -f "$cand/package.json" ]; then
      if [ ! -f "$cand/docs/observability.yaml" ] && [ ! -f "$cand/docs/observability.yml" ]; then
        unmanaged_sub="${unmanaged_sub}  - [ ] ${cand}/：Web 前端未接入，请进入该目录执行 ponygo observe init --kind frontend\n"
        unmanaged_found=1
      fi
    fi
  done

  # gaps：本命令产 declaration_missing / placeholder_present / unmanaged_subcomponents
  gaps=""; sep=""
  if [ "$present" != "true" ]; then gaps="\"declaration_missing\""; sep=","; fi
  if [ "$ph" = "true" ]; then gaps="${gaps}${sep}\"placeholder_present\""; sep=","; fi
  if [ "$unmanaged_found" = "1" ]; then gaps="${gaps}${sep}\"unmanaged_subcomponents\""; fi

  if [ "${OBSERVE_JSON:-0}" = "1" ]; then
    sp=false
    if [ -n "$skill_dir" ] && [ -f "$skill_dir/references/contract.json" ]; then sp=true; fi
    local jp jph jc vj
    if [ "$present" = "true" ]; then jp=pass; else jp=fail; fi
    # 无声明 ⇒ 占位符无从判 → skip（与 audit 一致；旧行为误报 pass，ADVISORY-1）
    if [ "$present" = "true" ]; then
      if [ "$ph" = "true" ]; then jph=fail; else jph=pass; fi
    else
      jph=skip
    fi
    if [ "$compat" = "true" ]; then jc=true; else jc=false; fi
    vj=$(observe_version_json "$ver")
    printf '{"schema":"ponygo.observe/1","command":"status","declared_kind":"%s","current":"unknown","target":"%s","skill":{"present":%s,"contract_version":"%s","compatible":%s},"judges":[{"id":"declaration_present","status":"%s"},{"id":"no_placeholder","status":"%s"},{"id":"declaration_consistent","status":"skip"},{"id":"enforcement_mounted","status":"skip"}],"gaps":[%s]}\n' \
      "$kind" "$target" "$sp" "$vj" "$jc" "$jp" "$jph" "$gaps"
    exit 0
  fi

  echo "===== ponygo observe status ====="
  if [ "$unmanaged_found" = "1" ]; then
    printf '[WARN] 发现未纳管的 Monorepo 子组件（存在独立前端工程但未声明）\n'
  fi
  if [ "$present" = "true" ]; then printf '声明: %s\n' "$decl"; else printf '声明: 缺失\n'; fi
  if [ "$ph" = "true" ]; then printf '占位符: 有\n'; else printf '占位符: 无\n'; fi
  if [ "$present" = "true" ]; then
    if grep -q '^[[:space:]]*enforcement_points:' "$decl" 2>/dev/null; then
      printf '收口点: 已配置\n'
      # 提取 enforcement_points 下一级规则及 path
      awk '
        /^[[:space:]]*enforcement_points:[[:space:]]*$/ { in_ep=1; next }
        in_ep && /^[[:alnum:]_]/ { in_ep=0 }
        in_ep && /^[[:space:]]{2}[[:alnum:]_]+:[[:space:]]*$/ {
          gsub(/^[[:space:]]+|:[[:space:]]*$/, "", $0)
          rule=$0; next
        }
        in_ep && rule != "" && /^[[:space:]]{4}path:[[:space:]]*/ {
          val=$0; sub(/^[[:space:]]*path:[[:space:]]*/, "", val)
          gsub(/["'\''\r]/, "", val)
          printf "  - %s -> %s\n", rule, val
          rule=""
        }
      ' "$decl" 2>/dev/null || true
    else
      printf '收口点: 未配置（enforcement_points 缺失，ob2 变更门禁将空转）\n'
      printf '  推荐收口项：http_client（统一网络出口）/ error_boundary（全局异常）/ error_classifier（错误分类）\n'
    fi
  fi
  if [ "$compat" = "true" ]; then
    printf 'skill: %s（contract_version=%s，兼容=yes）\n' "$skill_dir" "$ver"
  else
    printf 'skill: %s（contract_version=%s，兼容=no）\n' "$skill_dir" "${ver:-unknown}"
  fi
  printf '目标级: %s\n' "$target"
  local _extras _ext_n=0
  _extras="$(observe_decl_extra_list)"
  if [ -n "$_extras" ]; then
    _ext_n=$(printf '%s\n' "$_extras" | grep -c . )
    printf '附加声明: %s 份（%s，同目录多形态；本命令只判主声明，audit 会逐份巡检）\n' \
      "$_ext_n" "$(observe_decl_extra_dir)"
  fi
  printf "判定项：需 'ponygo observe audit'（本命令不执行 skill 脚本）\n"
  if [ "$present" != "true" ]; then
    local hint_kind=""
    if [ -f "src-tauri/tauri.conf.json" ] || [ -f "tauri.conf.json" ]; then
      hint_kind="desktop（检测到 Tauri 桌面端配置）"
    elif [ -f "package.json" ] && [ ! -f "go.mod" ] && [ ! -f "Cargo.toml" ]; then
      hint_kind="frontend（检测到 Web 前端配置）"
    elif [ -f "Cargo.toml" ] || [ -f "go.mod" ]; then
      hint_kind="k8s-service（检测到后端微服务工程）"
    elif [ -d ".github/workflows" ] || [ -f ".gitlab-ci.yml" ]; then
      hint_kind="pipeline（检测到 CI/CD 流水线配置）"
    fi
    if [ -n "$hint_kind" ]; then
      printf '建议形态: %s\n' "$hint_kind"
      printf '缺口: declaration_missing —— 未找到可观测性声明；下一步：ponygo observe init --kind <k>（参考上述建议形态）\n'
    else
      printf '缺口: declaration_missing —— 未找到可观测性声明；下一步：ponygo observe init --kind <k>\n'
    fi
  fi
  if [ "$ph" = "true" ]; then
    printf '缺口: placeholder_present —— 声明中占位符未替换；下一步：填实四维归属与落点\n'
  fi

  if [ -n "$unmanaged_sub" ]; then
    printf '未纳管子组件待办（Monorepo 架构治理）：\n'
    printf '%b' "$unmanaged_sub"
  fi

  # CI/CD 流水线工程资产感知：若当前工作区包含流水线且未声明为 pipeline，透出资产信息与治理建议
  if [ "$kind" != "pipeline" ]; then
    local pipe_info=""
    if [ -d ".github/workflows" ]; then
      local n_wf
      n_wf=$(find .github/workflows -maxdepth 1 -name '*.yml' -o -name '*.yaml' 2>/dev/null | wc -l | tr -d ' ')
      if [ "${n_wf:-0}" -gt 0 ]; then
        pipe_info="  - .github/workflows（检测到 ${n_wf} 个 Actions 工作流；治理建议：ponygo observe init --kind pipeline）\n"
      fi
    elif [ -f ".gitlab-ci.yml" ]; then
      pipe_info="  - .gitlab-ci.yml（检测到 GitLab CI 流水线；治理建议：ponygo observe init --kind pipeline）\n"
    fi
    if [ -n "$pipe_info" ]; then
      printf 'CI/CD 流水线工程资产：\n'
      printf '%b' "$pipe_info"
    fi
  fi

  exit 0
}

# observe init：落地四维归属声明（observe 唯一写命令；已存在声明需 --force；--dry-run 零落盘）
observe_init() {
  local kind svc decl target ph skill_rel date_s content dim_block dim d d0 anchor reason usable gaps
  local ph_hit cur tgt lv tmp dir skill_dir skill_ver min_ver
  observe_require_keys

  # 1) kind：必填且在枚举内（枚举来自映射数据块 kind_enum）
  kind=${OBS_KIND:-}
  if [ -z "$kind" ]; then
    printf 'ponygo: observe init：缺必填 --kind（枚举：%s）\n' "$(observe_map_get kind_enum)" >&2
    printf '  例：ponygo observe init --kind cli --dims metrics,logs\n' >&2
    exit 2
  fi
  case "$kind" in
    *[!a-z0-9-]*)
      printf 'ponygo: observe init：--kind 取值非法：%s（枚举：%s）\n' "$kind" "$(observe_map_get kind_enum)" >&2
      exit 2 ;;
  esac
  case " $(observe_map_get kind_enum) " in
    *" $kind "*) : ;;
    *)
      printf 'ponygo: observe init：--kind 不在枚举内：%s（枚举：%s）\n' "$kind" "$(observe_map_get kind_enum)" >&2
      exit 2 ;;
  esac

  # 2) service：--service 优先；否则 $PWD 基线名净化（保留 [A-Za-z0-9._-]，其余换 '-'）
  svc=${OBS_SERVICE:-}
  if [ -z "$svc" ]; then
    svc=$(basename "$PWD" 2>/dev/null)
    svc=$(printf '%s\n' "$svc" | sed 's/[^A-Za-z0-9._-]/-/g' | head -n1)
  fi
  if [ -z "$svc" ]; then
    printf 'ponygo: observe init：service 无法确定（--service 为空且 $PWD 基线名净化后为空）\n' >&2
    printf '  用：ponygo observe init --kind %s --service <name>\n' "$kind" >&2
    exit 2
  fi
  # --service 值只收 YAML 标量安全字符（防 'a: b' 之类注入出第二个键）
  case "$svc" in
    *[!A-Za-z0-9._-]*)
      printf 'ponygo: observe init：--service 取值非法：%s\n' "$svc" >&2
      printf '  只允许 [A-Za-z0-9._-]（YAML 标量安全）；例：--service checkout-api\n' >&2
      exit 2 ;;
  esac

  # 2.4) F1：--anchor-<dim>/--reason-<dim> 写盘前逐个做 YAML 标量校验（防注入出重复键/非法 YAML/null）；
  #      anchor 给了值还必须是真实存在的落点（schema 要求 anchor 指向该维唯一实现落点）→ 否则 exit 2。
  #      先于技能契约门：输入非法先报输入错（与 --kind/--service 校验次序一致），也便于离线自测。
  for d0 in metrics tracing logs issues; do
    case "$d0" in
      metrics) anchor=${OBS_ANCHOR_METRICS:-}; reason=${OBS_REASON_METRICS:-} ;;
      tracing) anchor=${OBS_ANCHOR_TRACING:-}; reason=${OBS_REASON_TRACING:-} ;;
      logs)    anchor=${OBS_ANCHOR_LOGS:-};    reason=${OBS_REASON_LOGS:-} ;;
      issues)  anchor=${OBS_ANCHOR_ISSUES:-};  reason=${OBS_REASON_ISSUES:-} ;;
    esac
    observe_scalar_check "$anchor" "--anchor-$d0"
    observe_scalar_check "$reason" "--reason-$d0"
    if [ -n "$anchor" ] && [ ! -e "$anchor" ]; then
      printf 'ponygo: observe init：--anchor-%s 指向的路径不存在：%s\n' "$d0" "$anchor" >&2
      printf '  schema 要求 anchor 必须是真实落点（相对项目根 %s）；先建好该文件再重试\n' "$PWD" >&2
      exit 2
    fi
  done

  # 2.5) 技能契约门（A8）：<skill>/references/contract.json 是唯一版本源；缺目录/低版本 → exit 2
  observe_skill_require
  skill_dir=$(observe_skill_dir_soft)
  skill_ver=$(observe_skill_version "$skill_dir")
  min_ver=$(observe_map_get contract_version_min)
  if [ -z "$skill_ver" ] || ! observe_version_ge "$skill_ver" "$min_ver"; then
    printf 'ponygo: observe init：skill 契约版本不满足：%s（要求 >= %s）\n' "${skill_ver:-unknown}" "$min_ver" >&2
    printf '  升级 skill 到 >= %s 后重试（版本源：%s/references/contract.json）\n' "$min_ver" "$skill_dir" >&2
    exit 2
  fi

  # 3) 目标路径：目标 = 已存在声明（含 .yml）否则 docs/observability.yaml；已存在且无 --force：
  #    若为 --dry-run 则允许预览（提示覆盖需 --force），真实落盘时无 --force 则 exit 2
  decl=$(observe_decl_path)
  if [ -n "$decl" ] && [ "${OBS_FORCE:-0}" != "1" ]; then
    if [ "${DRY_RUN:-0}" != "1" ]; then
      printf 'ponygo: observe init：声明已存在：%s\n' "$decl" >&2
      printf '  覆盖请加 --force：ponygo observe init --kind %s --force\n' "$kind" >&2
      exit 2
    fi
  fi
  if [ -n "$decl" ]; then
    target=$decl
  elif [ -f "docs/observability.yml" ]; then
    target="docs/observability.yml"
  else
    target="docs/observability.yaml"
  fi

  # 4) 生成声明内容：四维齐全；未给 --dims ⇒ 四维 applicable: true（anchor 缺则占位），
  #    给了 --dims ⇒ 列表内 true（anchor 缺占位），列表外 false（reason 缺占位）。
  #    智能继承（P0-Feedback）：若 decl 存在且目标维在原声明中已配置非占位内容，在用户未显式传参时优先继承原值
  ph=$(observe_map_get placeholder_token)
  skill_rel=$(observe_map_get skill_dir_rel)
  date_s=$(date +%F)
  dim_block=""; gaps=""
  for dim in metrics tracing logs issues; do
    case "$dim" in
      metrics) anchor=${OBS_ANCHOR_METRICS:-}; reason=${OBS_REASON_METRICS:-} ;;
      tracing) anchor=${OBS_ANCHOR_TRACING:-}; reason=${OBS_REASON_TRACING:-} ;;
      logs)    anchor=${OBS_ANCHOR_LOGS:-};    reason=${OBS_REASON_LOGS:-} ;;
      issues)  anchor=${OBS_ANCHOR_ISSUES:-};  reason=${OBS_REASON_ISSUES:-} ;;
    esac
    usable=true
    if [ -n "${OBS_DIMS:-}" ]; then
      usable=false
      for d in $(printf '%s' "$OBS_DIMS" | tr ',' ' '); do
        if [ "$d" = "$dim" ]; then usable=true; fi
      done
    fi
    # 智能继承：原文件存在且当前未提供显式值
    if [ -n "$decl" ] && [ -f "$decl" ]; then
      if [ "$usable" = "true" ] && [ -z "$anchor" ]; then
        local old_anc
        old_anc=$(awk -v d="$dim" '
          $0 ~ "^[[:space:]]*" d ":[[:space:]]*$" { in_d=1; next }
          in_d && /^[[:space:]]{2}[[:alnum:]_]+:[[:space:]]*$/ { in_d=0 }
          in_d && /^[[:space:]]{4}anchor:[[:space:]]*/ {
            val=$0; sub(/^[[:space:]]*anchor:[[:space:]]*/, "", val)
            gsub(/["'\''\r]/, "", val)
            print val; exit
          }
        ' "$decl" 2>/dev/null || true)
        if [ -n "$old_anc" ] && [ "$old_anc" != "$ph" ]; then
          anchor=$old_anc
        fi
      elif [ "$usable" = "false" ] && [ -z "$reason" ]; then
        local old_rsn
        old_rsn=$(awk -v d="$dim" '
          $0 ~ "^[[:space:]]*" d ":[[:space:]]*$" { in_d=1; next }
          in_d && /^[[:space:]]{2}[[:alnum:]_]+:[[:space:]]*$/ { in_d=0 }
          in_d && /^[[:space:]]{4}reason:[[:space:]]*/ {
            val=$0; sub(/^[[:space:]]*reason:[[:space:]]*/, "", val)
            gsub(/^>[[:space:]]*|^-[[:space:]]*|["'\''\r]/, "", val)
            print val; exit
          }
        ' "$decl" 2>/dev/null || true)
        if [ -n "$old_rsn" ] && [ "$old_rsn" != "$ph" ]; then
          reason=$old_rsn
        fi
      fi
    fi
    if [ "$usable" = "true" ]; then
      if [ -z "$anchor" ]; then
        anchor=$ph
        gaps="${gaps}缺口: ${dim}.anchor 仍是占位符（applicable: true）—— 填实：--anchor-${dim} <path> 后 --force 重写\n"
      fi
      dim_block="${dim_block}  ${dim}:
    applicable: true
    anchor: $(observe_yaml_sq "$anchor")
"
    else
      if [ -z "$reason" ]; then
        reason=$ph
        gaps="${gaps}缺口: ${dim}.reason 仍是占位符（applicable: false）—— 填实：--reason-${dim} <结构性理由> 后 --force 重写\n"
      fi
      dim_block="${dim_block}  ${dim}:
    applicable: false
    reason: $(observe_yaml_sq "$reason")
"
    fi
  done

  # 注释行不含占位符字面（占位符判定只扫非注释行，注释里也不埋字面以免误导）
  content=$(cat <<EOF
# ${svc} 的可观测性适用性声明（ponygo observe init 生成）
# 形状契约：${skill_rel}/references/declaration.schema.json；判定口径：${skill_rel}/references/declaration-rubric.md
# 四维必须齐全：省略 != 不适用。applicable: false 必须写结构性 reason（不是排期理由）；
# applicable: true 必须 anchor 指向该维唯一实现落点。
service: ${svc}
kind: ${kind}
dimensions:
${dim_block}reviewed_at: "${date_s}"
EOF
)

  # 5) --dry-run：只打印将写入的完整内容，零落盘
  if [ "${DRY_RUN:-0}" = "1" ]; then
    if [ -n "$decl" ] && [ "${OBS_FORCE:-0}" != "1" ]; then
      warn "[dry-run] 声明已存在（${decl}），真实落盘需加 --force"
    fi
    info "[dry-run] observe init：将写入 ${target}（未落盘）"
    printf '%s\n' "$content"
    exit 0
  fi

  # 6) 落盘（原子）：mkdir -p → 写 <target>.tmp.$$ → mv -f；任一步失败清理临时文件并 exit 2
  dir=$(dirname "$target")
  if [ ! -d "$dir" ]; then
    if ! mkdir -p "$dir"; then
      printf 'ponygo: observe init：目录创建失败：%s\n' "$dir" >&2
      exit 2
    fi
  fi
  tmp="${target}.tmp.$$"
  if ! printf '%s\n' "$content" > "$tmp"; then
    rm -f "$tmp"
    printf 'ponygo: observe init：临时文件写入失败：%s\n' "$tmp" >&2
    exit 2
  fi
  if ! mv -f "$tmp" "$target"; then
    rm -f "$tmp"
    printf 'ponygo: observe init：落盘失败：%s\n' "$target" >&2
    exit 2
  fi

  # 7) 收尾：静态级别（声明存在 + 非注释行无占位符）+ 目标级 + 逐条缺口 + 下一步
  ph_hit=false
  if grep -v '^[[:space:]]*#' "$target" | grep -q -F "$ph"; then ph_hit=true; fi
  cur=达成
  if [ "$ph_hit" = "true" ]; then cur=未达; fi
  lv=$(read_level)
  tgt=$(observe_target_level)

  printf '当前静态级别: ob0 %s\n' "$cur"
  printf '目标级: %s（ponygo level=%s）\n' "$tgt" "${lv:-0}"
  if [ -n "$gaps" ]; then
    printf '%b' "$gaps"
  else
    printf '缺口: 无（ob0 静态判据满足：声明存在且非注释行无占位符）\n'
  fi
  printf '下一步: ponygo observe audit\n'
  exit 0
}
# audit：真判定（会调用 skill 脚本）。退出码优先级 2 > 3 > 1 > 0：
#   2=工具/输入错误（判定中止）；3=证据不足；1=有缺口（含 below_target）；0=达标。
observe_audit() {
  local skill decl present ph rc rd ver min compat sp kind raw target cur
  local ob0 ob1 ob2 s0 s1 s2 jp jph jc jm mounted diff_log diff_tmo diff_ep abort exit2 exit3
  local gap_incon gap_ev gap_ep gap_diff gap_viol gap_mount gap_tool gap_below
  local ids gaps sep g c n0 n1 n2 adv code cr trk dabort glob_on
  local sub_rcs="" sub_bad=0 sub_unknown=0 sub_line sub_dir

  # 映射数据块先做一次 fail-closed 校验：map_get 多在 $(...) 子 shell 里调用，
  # 子 shell 里的 exit 2 拦不住父 shell，故必须在此以普通语句显式校验一次。
  observe_require_keys
  observe_skill_require
  skill=$(observe_skill_dir_soft)
  ver=$(observe_skill_version "$skill")
  min=$(observe_map_get contract_version_min)
  compat=false
  if [ -n "$ver" ] && observe_version_ge "$ver" "$min"; then compat=true; fi
  sp=false
  if [ -f "$skill/references/contract.json" ]; then sp=true; fi

  # 目标级：meta.yaml 的 level 映射；--level obN 作为断言目标覆盖它
  target=$(observe_target_level)
  if [ -n "${OBSERVE_LEVEL:-}" ]; then target="$OBSERVE_LEVEL"; fi

  n0=$(observe_map_get ob_level0_name)
  n1=$(observe_map_get ob_level1_name)
  n2=$(observe_map_get ob_level2_name)
  adv=$(observe_map_get ob_advisory_name)

  # 声明在场 / 占位符（口径与 observe_status 一致：只扫非注释行）
  decl=$(observe_decl_path)
  present=false
  if [ -n "$decl" ]; then present=true; fi
  ph=false
  if [ "$present" = "true" ]; then
    if grep -v '^[[:space:]]*#' "$decl" | grep -q -F "$(observe_map_get placeholder_token)"; then
      ph=true
    fi
  fi

  # declared_kind：净化后仅当匹配 ^[a-z0-9-]+$ 且 ∈ kind_enum 才回显，否则 unknown
  kind=unknown
  if [ -n "$decl" ]; then
    raw=$(sed -n 's/^[[:space:]]*kind:[[:space:]]*//p' "$decl" | head -n1 | tr -d '\r')
    raw=${raw%%[[:space:]]#*}                       # 去行内注释
    while :; do case "$raw" in *[[:space:]]) raw=${raw%?} ;; *) break ;; esac; done
    case "$raw" in \"*\") raw=${raw#\"}; raw=${raw%\"} ;; esac
    case "$raw" in \'*\') raw=${raw#\'}; raw=${raw%\'} ;; esac
    case "$raw" in
      ''|*[!a-z0-9-]*) : ;;
      *) case " $(observe_map_get kind_enum) " in *" $raw "*) kind=$raw ;; esac ;;
    esac
  fi

  # judges 默认值：声明缺失 → declaration_present=fail，占位符与后两项 skip
  if [ "$present" = "true" ]; then jp=pass; else jp=fail; fi
  if [ "$present" = "true" ]; then
    if [ "$ph" = "true" ]; then jph=fail; else jph=pass; fi
  else
    jph=skip
  fi
  jc=skip; jm=skip

  rc="-"; abort=0; exit2=0; exit3=0; dabort=0
  gap_incon=0; gap_ev=0; gap_ep=0; gap_diff=0; gap_viol=0; gap_mount=0; gap_tool=0; gap_below=0

  # 声明层：有声明才跑 check-declaration（无声明时 ob0 直接不成立）
  if [ "$present" = "true" ]; then
    observe_run_skill "$(observe_map_get external_timeout_seconds)" \
      "$skill/scripts/check-declaration.sh" --project "$PWD"
    rc=$?
    case "$rc" in
      0) jc=pass ;;
      2) jc=fail; gap_incon=1 ;;
      3) jc=unknown; gap_ev=1; exit3=1 ;;
      240|2[0-9][0-9])
        # F2 哨兵：observe_run_skill 建不了临时文件 → 工具错误（绝不读成 skill 的 rc=2 声明不一致）
        jc=unknown; abort=1; exit2=1; gap_tool=1
        printf 'ponygo: check-declaration.sh 未能执行（退出码=%s，工具/环境错误）\n' "$rc" >&2
        printf '  排查：TMPDIR 是否可写、磁盘是否满、%s/scripts/check-declaration.sh 是否可读；修好后重跑\n' "$skill" >&2
        ;;
      *)
        # 4 或其它：判定中止（不是「未达标」）
        jc=unknown; abort=1; exit2=1; gap_tool=1
        printf 'ponygo: check-declaration.sh 退出码=%s（不在 0/2/3 白名单内）\n' "$rc" >&2
        printf "声明层不可判定（可能：声明不合规 / 工具与环境错误）；先看上面的 stderr，再跑 'bash %s/scripts/check-declaration.sh --help' 自检\n" "$skill" >&2
        ;;
    esac
  fi

  # ob0 = 声明存在 && 非注释行无占位符 && rc ∈ {0,2,3}；ob1 = ob0 && rc == 0
  ob0=0; ob1=0; ob2=0
  if [ "$abort" = "0" ]; then
    if [ "$present" = "true" ] && [ "$ph" != "true" ]; then
      case "$rc" in 0|2|3) ob0=1 ;; esac
    fi
    if [ "$ob0" = "1" ] && [ "$rc" = "0" ]; then ob1=1; fi
  fi

  # ob1 成立才跑 audit-diff；rc=1 的 gap 需读 skill 输出关键词，故临时文件捕获后原样转发 stderr
  # 预算：独立键 diff_timeout_seconds（缺省 60，可被 PONYGO_OBS_DIFF_TIMEOUT 覆盖），**不得**复用
  # local_timeout_seconds（3s 级快命令预算）——否则大仓 audit-diff 必被 timeout 打死成假红。
  rd="-"; diff_log=""; diff_tmo=""; diff_ep=0; mounted=0
  if [ "$ob1" = "1" ]; then
    diff_tmo=$(observe_diff_timeout "$(observe_map_try diff_timeout_seconds)")
    diff_log=$(mktemp "${TMPDIR:-/tmp}/ponygo-obs-diff.XXXXXX") || diff_log=""
    # 登记到全局供 trap 兜底（CT-9）：预算从 3s 放宽到 60s 后，Ctrl-C 撞上 audit-diff 运行窗口的
    # 概率放大约 20 倍，只清 observe_run_skill 的临时文件会在 /tmp 残留 ponygo-obs-diff.XXXXXXXX。
    OBS_DIFF_TMPFILE=$diff_log
    if [ -n "$diff_log" ]; then
      observe_run_skill "$diff_tmo" \
        "$skill/scripts/audit-diff.sh" --repo "$PWD" --base "${OBSERVE_BASE:-HEAD}" 2>"$diff_log"
      rd=$?
      cat "$diff_log" >&2
      if grep -q -F '收口点' "$diff_log"; then diff_ep=1; fi
    else
      # 建不了临时文件：无法分关键词，rc=1 退化为 diff_warn
      observe_run_skill "$diff_tmo" \
        "$skill/scripts/audit-diff.sh" --repo "$PWD" --base "${OBSERVE_BASE:-HEAD}"
      rd=$?
    fi
    case "$rd" in
      0)
        # 载体发现（缺陷 D）：静态清单 + 动态发现的钩子目录。
        # 静态清单漏了 husky（core.hooksPath=.husky）——实测 job_copilot 的 .husky/pre-push 已接
        # audit-diff，却因为清单里没有 .husky 而拿不到 ob2。现在追加：
        #   ① git config core.hooksPath 指向的目录（唯一权威：git 实际会执行那里的钩子）；
        #   ② 存在 .husky/ 就纳入（husky v9 把 core.hooksPath 写成 .husky/_，钩子本体在 .husky/）。
        # 匹配一律走 observe_mount_hit（缺陷 F：排除纯注释行，堵住「只在注释里提 audit-diff」的假绿）。
        glob_on=0
        case "$-" in *f*) : ;; *) set -f; glob_on=1 ;; esac
        local carriers c hp
        carriers="$(observe_map_get mount_carriers)"
        hp="$(git config --get core.hooksPath 2>/dev/null || true)"
        [ -n "$hp" ] && carriers="$carriers $hp ${hp%/}/_"
        [ -d ".husky" ] && carriers="$carriers .husky"
        for c in $carriers; do
          case "$c" in *'*'*|*'?'*|*'['*) continue ;; esac
          if observe_mount_hit "$c"; then mounted=1; break; fi
        done
        [ "$glob_on" = "1" ] && set +f
        if [ "$mounted" = "1" ]; then jm=pass; ob2=1; else jm=fail; gap_mount=1; fi
        ;;
      1) jm=fail; if [ "$diff_ep" = "1" ]; then gap_ep=1; else gap_diff=1; fi ;;
      2) jm=fail; gap_viol=1 ;;
      # F7：rc=3 是「证据不可得」（与 check-declaration rc=3 同义），不是工具错误；exit 仍 3、current 仍 unknown
      3) jm=fail; gap_ev=1; exit3=1; dabort=1 ;;
      # CT-3/CT-8 超时专支（timeout 默认 124；--preserve-status 或子进程自行处理 SIGTERM 时为 143）：
      # 仍然 fail-closed（exit 2 + gaps 含 tool_error），但诊断必须点名「超时」与「audit-diff」，
      # 否则与检查器自身崩溃混为一谈，假红淹没真红。绝不并进 240/2xx 哨兵分支——哨兵语义是
      # 「临时文件建不了」，与「预算用尽/被杀」是两种不同故障，处置动作也不同。
      # 文案纪律（CT-8）：143 只说明「进程死于 SIGTERM」，**不等于**「预算内没跑完」（瞬时崩溃也会
      # 是 143），故不得写「N 秒内未跑完」这类断言，否则会给出「加预算」这种错误处置建议。
      124|143)
        jm=fail; gap_tool=1; exit2=1; dabort=1
        printf 'ponygo: audit-diff（变更级收口门禁）疑似超时或进程被 SIGTERM 终止：退出码=%s，预算 diff_timeout_seconds=%s 秒\n' "$rd" "$diff_tmo" >&2
        printf '  退出码 124 = 预算用尽被 timeout 杀掉；143 = 进程死于 SIGTERM（可能是超时，也可能是 skill 自身崩溃/被外部信号打断）\n' >&2
        printf '  这意味着「未判定」，不是「无违规」；ob2 按 fail-closed 处理（exit 2）\n' >&2
        printf '  处置：大仓且确为预算不足 → 抬高 data 块 diff_timeout_seconds 或 env PONYGO_OBS_DIFF_TIMEOUT=<正整数>；瞬时 143 → 先修 skill 自身，别只加预算\n' >&2
        ;;
      240|2[0-9][0-9]) jm=fail; gap_tool=1; exit2=1; dabort=1 ;;
      *) jm=fail; gap_tool=1; exit2=1; dabort=1 ;;
    esac
    if [ -n "$diff_log" ]; then rm -f "$diff_log"; fi
    OBS_DIFF_TMPFILE=""
  fi

  cur=unknown
  if [ "$ob2" = "1" ]; then cur=ob2
  elif [ "$ob1" = "1" ]; then cur=ob1
  elif [ "$ob0" = "1" ]; then cur=ob0
  fi
  # audit-diff 判定中止（rc ∉ {0,1,2}）时没有可信的当前级
  if [ "$dabort" = "1" ]; then cur=unknown; fi

  # 目标断言（--level obN 覆盖 meta 级）：只在 current ∈ {ob0,ob1,ob2} 时判 below_target。
  # F6a：below_target 是「用户显式断言的目标级没达到」这一事实，**只有显式 --level 才成立**——
  # 体检模式（目标级取自 meta.yaml）下不打 below_target，否则 gap 文案会谎称用户传了 --level。
  cr=$(observe_rank "$cur"); trk=$(observe_rank "$target")
  if [ -n "${OBSERVE_LEVEL:-}" ] && [ "$cr" -ge 0 ] && [ "$trk" -ge 0 ] && [ "$cr" -lt "$trk" ]; then gap_below=1; fi

  # gaps 顺序固定（见施工单 §8 词表）
  ids=""
  if [ "$present" != "true" ]; then ids="$ids declaration_missing"; fi
  if [ "$ph" = "true" ]; then ids="$ids placeholder_present"; fi
  if [ "$gap_incon" = "1" ]; then ids="$ids declaration_inconsistent"; fi
  if [ "$gap_ev" = "1" ]; then ids="$ids evidence_insufficient"; fi
  if [ "$gap_ep" = "1" ]; then ids="$ids enforcement_points_missing"; fi
  if [ "$gap_diff" = "1" ]; then ids="$ids diff_warn"; fi
  if [ "$gap_viol" = "1" ]; then ids="$ids enforcement_violation"; fi
  if [ "$gap_mount" = "1" ]; then ids="$ids mount_missing"; fi
  if [ "$gap_tool" = "1" ]; then ids="$ids tool_error"; fi
  if [ "$gap_below" = "1" ]; then ids="$ids below_target"; fi

  # 子组件声明巡检（缺陷 E）：observe status 会推荐「进入 front_end/ 执行 ponygo observe init」，
  # 但旧版 observe audit 只判根声明，从不巡检子组件 —— 等于推荐了一个自己无法验收的动作。
  # 现在逐份巡检已探测到的子组件声明（front_end/ web/ client/ ... 下的 docs/observability.*），
  # 并把结果作为独立缺口暴露。缺口语义与既有一致：默认只进 backlog，`--strict` 才影响退出码。
  for sub_dir in front_end frontend web client ui app; do
    [ -d "$sub_dir" ] || continue
    [ -f "$sub_dir/docs/observability.yaml" ] || [ -f "$sub_dir/docs/observability.yml" ] || continue
    ( cd "$sub_dir" && observe_run_skill "$(observe_map_get external_timeout_seconds)" \
        "$skill/scripts/check-declaration.sh" --project "$PWD" ) >/dev/null 2>&1
    sub_rcs="${sub_rcs}${sub_rcs:+ }${sub_dir}:$?"
  done
  if [ -n "$sub_rcs" ]; then
    for sub_line in $sub_rcs; do
      case "${sub_line##*:}" in
        0) : ;;
        2) sub_bad=1 ;;
        3) sub_unknown=1 ;;
        *) sub_bad=1 ;;
      esac
    done
    if [ "$sub_bad" = "1" ]; then ids="$ids subcomponent_inconsistent"; fi
    if [ "$sub_unknown" = "1" ] && [ "$sub_bad" = "0" ]; then ids="$ids subcomponent_evidence_insufficient"; fi
  fi

  # 同目录多声明（缺陷 E 剩余部分）：`docs/observability.d/*.yaml` 里每份都是独立形态声明
  # （典型：根声明 k8s-service + docs/observability.d/pipeline.yaml）。逐份跑 check-declaration，
  # 结果并入 backlog。主声明（docs/observability.yaml）仍独占 ob0/ob1/ob2 的判定权——
  # 附加声明改变的是「覆盖范围」，不是「主形态的达标线」。
  local extra_rcs="" extra_f extra_bad=0 extra_rc=0
  while IFS= read -r extra_f; do
    [ -n "$extra_f" ] || continue
    observe_run_skill "$(observe_map_get external_timeout_seconds)" \
      "$skill/scripts/check-declaration.sh" --declaration "$extra_f" >/dev/null 2>&1
    extra_rc=$?
    extra_rcs="${extra_rcs}${extra_rcs:+ }${extra_f##*/}:${extra_rc}"
  done <<EOF
$(observe_decl_extra_list)
EOF
  if [ -n "$extra_rcs" ]; then
    for sub_line in $extra_rcs; do
      case "${sub_line##*:}" in 0) : ;; *) extra_bad=1 ;; esac
    done
    if [ "$extra_bad" = "1" ]; then ids="$ids extra_declaration_inconsistent"; fi
  fi

  if [ "$abort" = "1" ]; then
    s0=SKIP; s1=SKIP; s2=SKIP
  else
    if [ "$ob0" = "1" ]; then s0=PASS; else s0=FAIL; fi
    if [ "$ob1" = "1" ]; then s1=PASS; elif [ "$ob0" = "1" ]; then s1=FAIL; else s1=SKIP; fi
    if [ "$ob2" = "1" ]; then s2=PASS; elif [ "$ob1" = "1" ]; then s2=FAIL; else s2=SKIP; fi
  fi

  # 退出码优先级：2（工具/输入错误）> 3（证据不可得）> 1（未达目标级）> 0（已达目标级）。
  # 目标级来源：显式 --level obN，否则 .meta/meta.yaml 的 level 经映射表求得。
  # 缺口列表是「距下一级的 backlog」，默认不直接决定退出码（否则目标已达仍会 exit 1，CI 无法分档推进）。
  # --strict 模式下：任一缺口均非零退出（保持最硬门禁，供全量绿门禁使用）。
  if [ "$exit2" = "1" ]; then code=2
  elif [ "$exit3" = "1" ]; then code=3
  elif [ "${OBSERVE_STRICT:-0}" = "1" ] && [ -n "$ids" ]; then code=1
  elif [ "$cr" -ge 0 ] && [ "$cr" -ge "$trk" ]; then code=0
  else code=1
  fi

  # 人读报告（--json 时整体走 stderr，stdout 只留一行 JSON）
  observe_audit_report() {
    printf '===== ponygo observe audit =====\n'
    printf '[%s] ob0 %s\n' "$s0" "$n0"
    printf '[%s] ob1 %s\n' "$s1" "$n1"
    printf '[%s] ob2 %s\n' "$s2" "$n2"
    printf '当前级: %s\n' "$cur"
    printf '目标级: %s\n' "$target"
    if [ "${OBSERVE_STRICT:-0}" = "1" ]; then
      if [ -n "${OBSERVE_LEVEL:-}" ]; then
        printf '模式: 断言 ob%s [strict]（任一缺口 exit 非零）\n' "$(observe_rank "$OBSERVE_LEVEL")"
      else
        printf '模式: 体检 [strict]（目标级取自 meta.yaml；任一缺口 exit 非零）\n'
      fi
    elif [ -n "${OBSERVE_LEVEL:-}" ]; then
      printf '模式: 断言 ob%s（判据：当前级 ≥ 目标级；缺口列表为 backlog）\n' "$(observe_rank "$OBSERVE_LEVEL")"
    else
      printf '模式: 体检（目标级取自 meta.yaml；判据：当前级 ≥ 目标级；缺口列表为 backlog）\n'
    fi
    if [ "$code" = "0" ]; then
      printf '结论: PASS（当前级 %s 已达目标级 %s，exit=0）\n' "$cur" "$target"
      if [ -n "$ids" ]; then
        printf '后续升级建议（下一级待办 / Backlog）：\n'
      fi
    else
      # 结论行必须说实话：--strict 下即使已达标也会 exit 非零（缺口强制），
      # 旧文案会打成「未达目标级」——那是假陈述，会误导排障方向。
      if [ "$cr" -ge 0 ] && [ "$cr" -ge "$trk" ]; then
        printf '结论: FAIL（当前级 %s 已达目标级 %s，但 --strict 下存在缺口故 exit=%s）\n' "$cur" "$target" "$code"
      else
        printf '结论: FAIL（当前级 %s 未达目标级 %s，exit=%s）\n' "$cur" "$target" "$code"
      fi
    fi
    if [ -n "$sub_rcs" ]; then
      printf '子组件声明巡检（逐份判定，rc=0 一致 / 2 不一致 / 3 证据不可得）：%s\n' "$sub_rcs"
    fi
    if [ -n "$extra_rcs" ]; then
      printf '附加声明巡检（docs/observability.d/，逐份判定）：%s\n' "$extra_rcs"
    fi
    for g in $ids; do
      case "$g" in
        declaration_missing) printf '  - [ ] declaration_missing: 未找到可观测性声明（查找路径：%s）；下一步：ponygo observe init --kind <k>\n' "$(observe_map_get declaration_paths)" ;;
        placeholder_present) printf '  - [ ] placeholder_present: 声明中占位符未替换；下一步：填实四维归属与落点\n' ;;
        declaration_inconsistent) printf '  - [ ] declaration_inconsistent: 声明与巡检结果不一致（check-declaration rc=2）；下一步：按上面 stderr 修正声明\n' ;;
        evidence_insufficient) printf '  - [ ] evidence_insufficient: 证据不可得（check-declaration 或 audit-diff rc=3，不是「未达标」，也不是声明本身错）；补证据后重跑\n' ;;
        enforcement_points_missing) printf '  - [ ] enforcement_points_missing: 变更门禁里没有 audit-diff 收口点；下一步：挂到 pre-commit / CI\n' ;;
        diff_warn) printf '  - [ ] diff_warn: 变更门禁（enforcement points）有非阻断告警（见上面 stderr）\n' ;;
        enforcement_violation) printf '  - [ ] enforcement_violation: 变更门禁判定不通过（见上面 stderr）\n' ;;
        mount_missing) printf '  - [ ] mount_missing: 未在挂载载体（mount_carriers）发现 audit-diff 调用\n' ;;
        tool_error) printf '  - [ ] tool_error: 工具或环境错误，本次判定不可信（见上面 stderr）\n' ;;
        below_target) printf '  - [ ] below_target: 当前级低于 --level 断言的目标级\n' ;;
        subcomponent_inconsistent) printf '  - [ ] subcomponent_inconsistent: 子组件声明与实测不一致（%s）；下一步：进入对应子目录按 stderr 修正声明\n' "${sub_rcs:-?}" ;;
        subcomponent_evidence_insufficient) printf '  - [ ] subcomponent_evidence_insufficient: 子组件证据不可得（%s）；补证据后重跑\n' "${sub_rcs:-?}" ;;
        extra_declaration_inconsistent) printf '  - [ ] extra_declaration_inconsistent: 同目录附加声明与实测不一致（%s）；下一步：按对应声明的 stderr 修正\n' "${extra_rcs:-?}" ;;
      esac
    done
    if [ -z "$ids" ]; then printf '缺口: 无\n'; fi
    printf '%s：\n' "$adv"
    printf '  - 采样策略：按流量与成本定采样率（head-based，必要时 tail 兜底），别默认全采\n'
    printf '  - gen_ai.* 成本归因：LLM/Agent 调用的 token 与成本标到 gen_ai.* 语义约定\n'
    printf '  - SLI 告警组：每个 SLI 建告警组与 burn-rate 阈值，而非单点阈值\n'
    printf '判定口径见 %s/references/declaration-rubric.md §6.6\n' "$skill"
  }

  if [ "${OBSERVE_JSON:-0}" = "1" ]; then
    observe_audit_report >&2
    gaps=""; sep=""
    for g in $ids; do gaps="$gaps$sep\"$g\""; sep=","; done
    local vj
    vj=$(observe_version_json "$ver")
    printf '{"schema":"ponygo.observe/1","command":"audit","declared_kind":"%s","current":"%s","target":"%s","skill":{"present":%s,"contract_version":"%s","compatible":%s},"judges":[{"id":"declaration_present","status":"%s"},{"id":"no_placeholder","status":"%s"},{"id":"declaration_consistent","status":"%s"},{"id":"enforcement_mounted","status":"%s"}],"gaps":[%s]}\n' \
      "$kind" "$cur" "$target" "$sp" "$vj" "$compat" "$jp" "$jph" "$jc" "$jm" "$gaps"
    exit "$code"
  fi

  observe_audit_report
  exit "$code"
}

# 本地版本兼容门：不联网、不调集群、不调 check-drift；--check 时兼容=0/不兼容=2，否则恒 0
# ---------- F10：受控探针（ponygo observe probe） ----------
# 由 ponygo 自己投递一个带 provenance 的 OTLP/HTTP span，用来证明「链路真的通」而不是「声明看起来对」。
# 三条硬约束：
#   1) 凭证只从 env 读（PONYGO_OTEL_TOKEN），**永不回显明文**；凭据仅经 `0600` 临时配置文件传给
#      curl（-K），用后即删；**不出现在 argv / 日志**；dry-run 与错误信息一律 <redacted>；
#   2) endpoint/服务名可显式给，但都不写进任何文件（本命令只读）；
#   3) 探针不是判定：成功只说明「管道可达」，判定仍由 'ponygo observe audit' 做（输出指引等待窗口）。
# 退出码：0 = 投递成功；1 = 用法/缺参；2 = 工具或网络/HTTP 非 2xx（含超时）——不复用 3（证据不足属 audit）。
# probe 的 curl 配置文件（含 Authorization 头）——token 严禁进 argv；文件级状态 + 三钩清理
PROBE_CURL_CONF=""; PROBE_ERR_FILE=""
probe_conf_cleanup() {
  if [ -n "${PROBE_CURL_CONF:-}" ]; then rm -f "${PROBE_CURL_CONF}" 2>/dev/null || true; PROBE_CURL_CONF=""; fi
  if [ -n "${PROBE_ERR_FILE:-}" ]; then rm -f "${PROBE_ERR_FILE}" 2>/dev/null || true; PROBE_ERR_FILE=""; fi
  return 0
}

observe_probe() {
  local dry="${DRY_RUN:-0}" endpoint="" tok="" svc="" envn="" tos="" decl="" url="" code="" payload="" now_ns="" tid="" sid=""
  local req_rc=0 tok_conf="" trap_exit="" trap_int="" trap_term="" old_umask="" why="" errtxt=""
  endpoint="${OBS_ENDPOINT:-}"
  [ -n "$endpoint" ] || endpoint="${PONYGO_OTEL_ENDPOINT:-}"
  tok="${PONYGO_OTEL_TOKEN:-}"
  envn="${OBS_ENV:-local}"
  # W9-B5：--timeout 只接受**正整数**（0 等于取消预算，与「有上限」的声明矛盾）；默认 10s（OPEN-D2）。
  tos="${OBS_TIMEOUT:-10}"
  case "$tos" in
    ''|*[!0-9]*) printf 'ponygo: observe probe：--timeout 只接受正整数秒（收到：%s，0 等于取消预算）\n' "$tos" >&2; return 1 ;;
  esac
  [ "$tos" -gt 0 ] 2>/dev/null || { printf 'ponygo: observe probe：--timeout 只接受正整数秒（收到：%s，0 等于取消预算）\n' "$tos" >&2; return 1; }
  # 服务名：--service > 声明的 service（W9-B4：两者皆缺 → 用法错 exit 1，不再静默兜底 unknown_service）
  svc="${OBS_SERVICE:-}"
  if [ -z "$svc" ]; then
    decl=$(observe_decl_path)
    if [ -n "$decl" ] && [ -f "$decl" ]; then
      svc=$(sed -n 's/^service:[[:space:]]*//p' "$decl" 2>/dev/null | head -n1 | tr -d '\r' | sed 's/[[:space:]]*$//')
    fi
  fi
  # W10-2：纯空白不算给了 service——trim 后再判空（与「缺 service」同一文案）
  case "$svc" in
    *[![:space:]]*) : ;;
    *) svc="" ;;
  esac
  if [ -z "$svc" ]; then
    printf 'ponygo: observe probe：缺 service——用 --service <name> 指定，或先跑 ponygo observe init 声明（--kind/--service）\n' >&2
    return 1
  fi
  if [ -z "$endpoint" ]; then
    printf 'ponygo: observe probe：缺 endpoint——用 --endpoint <url> 或 env PONYGO_OTEL_ENDPOINT\n' >&2
    return 1
  fi
  # W9-A1：endpoint 形状校验（用法错 → exit 1，不是网络错 2）
  case "$endpoint" in
    http://?*|https://?*) : ;;
    *) printf 'ponygo: observe probe：--endpoint 必须以 http:// 或 https:// 开头（收到：%s）\n' "$endpoint" >&2; return 1 ;;
  esac
  if [ -z "$tok" ]; then
    printf 'ponygo: observe probe：缺 token——只从 env PONYGO_OTEL_TOKEN 读取（不回显明文）\n' >&2
    return 1
  fi
  # W10-1：token 必须是**单行可打印**——含 CR/LF/NUL/其它控制字符时，`header = "…"` 会被截断、
  # 甚至折行注入下一条 curl 配置指令（实测服务端只会收到 "Bearer ab"）。直接判用法错，
  # 绝不把这类 token 写进配置文件，也不发起任何请求。
  case "$tok" in
    *[[:cntrl:]]*)
      printf 'ponygo: observe probe：token 含非法控制字符（换行/回车/制表符或其它不可打印字节）——只接受单行可打印 token（未写入文件、未发送请求）\n' >&2
      return 1 ;;
  esac
  url="${endpoint%/}/v1/traces"
  # OTLP/HTTP JSON：resource attrs 必须自证来源（ponygo.probe / version），span 名固定 ponygo.probe。
  # W9-B7：进入 JSON 的字符串一律 json_escape（`"`、`\`、控制字符严格转义，非 ASCII 原样保留）。
  now_ns=$(date +%s 2>/dev/null || echo 0)000000000
  tid=$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n'); [ -n "$tid" ] || tid="00000000000000000000000000000000"
  sid=$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n');  [ -n "$sid" ] || sid="0000000000000000"
  payload=$(printf '{"resourceSpans":[{"resource":{"attributes":[{"key":"service.name","value":{"stringValue":"%s"}},{"key":"deployment.environment","value":{"stringValue":"%s"}},{"key":"ponygo.probe","value":{"boolValue":true}},{"key":"ponygo.probe.version","value":{"intValue":"1"}}]},"scopeSpans":[{"scope":{"name":"ponygo.probe"},"spans":[{"traceId":"%s","spanId":"%s","name":"ponygo.probe","kind":1,"startTimeUnixNano":"%s","endTimeUnixNano":"%s","status":{"code":1}}]}]}]}' \
    "$(json_escape "$svc")" "$(json_escape "$envn")" "$tid" "$sid" "$now_ns" "$now_ns")
  if [ "$dry" = "1" ]; then
    info "[dry-run] 目标 endpoint：$url（AUTHORIZATION: Bearer <redacted>）"
    info "[dry-run] service.name=$svc deployment.environment=$envn ponygo.probe=true ponygo.probe.version=1 span=ponygo.probe"
    info "[dry-run] 未发送任何请求（零网络，超时预算 ${tos}s）——去掉 --dry-run 才投递"
    info "探针之后：等待 10 秒后执行 ponygo observe audit（判定仍由 audit 做）"
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    printf 'ponygo: observe probe：本环境无 curl，无法投递 OTLP/HTTP（工具缺失，未发送任何请求）\n' >&2
    return 2
  fi
  # W9-B6：token 严禁出现在 argv（/proc/<pid>/cmdline 对同用户可读）——写 600 权限的 curl 配置文件、
  # 用 `curl -K <file>` 读入 `header = "Authorization: Bearer …"`；文件用 mktemp 生成，EXIT/INT/TERM 三钩清理。
  # （若某平台 curl 不支持 -K 内 header 行，等价手段是 `--header @file`；此处按 -K 实现并显式声明。）
  trap_exit=$(trap -p EXIT); trap_int=$(trap -p INT); trap_term=$(trap -p TERM)
  trap 'probe_conf_cleanup' EXIT
  trap 'probe_conf_cleanup; observe_tmp_cleanup; trap - EXIT INT TERM; exit 130' INT
  trap 'probe_conf_cleanup; observe_tmp_cleanup; trap - EXIT INT TERM; exit 143' TERM
  old_umask=$(umask); umask 077
  PROBE_CURL_CONF=$(mktemp "${TMPDIR:-/tmp}/.ponygo-probe.XXXXXX" 2>/dev/null) || PROBE_CURL_CONF=""
  umask "$old_umask"
  if [ -z "$PROBE_CURL_CONF" ]; then
    printf 'ponygo: observe probe：无法创建 curl 配置文件（凭证不得进 argv，故不降级发送）\n' >&2
    probe_conf_cleanup
    if [ -n "$trap_exit" ]; then eval "$trap_exit"; else trap - EXIT; fi
    if [ -n "$trap_int" ]; then eval "$trap_int"; else trap - INT; fi
    if [ -n "$trap_term" ]; then eval "$trap_term"; else trap - TERM; fi
    return 2
  fi
  chmod 600 "$PROBE_CURL_CONF" 2>/dev/null || true
  # 配置文件只接受**单行** token（上面已拒绝含控制字符的 token）；此处只转义 `\` 与 `"`。
  tok_conf="${tok//\\/\\\\}"; tok_conf="${tok_conf//\"/\\\"}"
  {
    printf 'header = "Content-Type: application/json"\n'
    printf 'header = "Authorization: Bearer %s"\n' "$tok_conf"
  } > "$PROBE_CURL_CONF"
  # W9-9：curl 的 stderr 不能吞——连接被拒/超时/TLS 失败都要给一行可读诊断（仍 exit 2）；
  # 诊断文本先脱敏（token 字面 → <redacted>），且 URL 不含凭据（token 只在 -K 配置文件里）。
  PROBE_ERR_FILE=$(mktemp "${TMPDIR:-/tmp}/.ponygo-probe-err.XXXXXX" 2>/dev/null) || PROBE_ERR_FILE=""
  code=$(printf '%s' "$payload" | curl -sS -K "$PROBE_CURL_CONF" -o /dev/null -w '%{http_code}' \
    --max-time "$tos" -X POST --data-binary @- "$url" 2>"${PROBE_ERR_FILE:-/dev/null}")
  req_rc=$?
  errtxt=$(head -n 2 "${PROBE_ERR_FILE:-/dev/null}" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//')
  # 脱敏（防御纵深）：curl 的诊断不回显 header 值，这里只对**足够长**的 token 做逐字替换——
  # 过短的 token（如 1-2 字符）会把诊断文本打成马赛克，反而毁掉可读性。
  if [ "${#tok}" -ge 8 ]; then errtxt=${errtxt//"$tok"/<redacted>}; fi
  probe_conf_cleanup
  if [ -n "$trap_exit" ]; then eval "$trap_exit"; else trap - EXIT; fi
  if [ -n "$trap_int" ]; then eval "$trap_int"; else trap - INT; fi
  if [ -n "$trap_term" ]; then eval "$trap_term"; else trap - TERM; fi
  if [ "$req_rc" -ne 0 ] || [ -z "$code" ] || [ "$code" = "000" ]; then
    case "$req_rc" in
      0)  why="接收端无 HTTP 应答" ;;
      6)  why="DNS 解析失败" ;;
      7)  why="连接被拒或不可达" ;;
      28) why="超时（--max-time ${tos}s 用尽）" ;;
      35|51|53|54|58|59|60|64|66|77|80|83|90|91)
          why="TLS/证书校验失败（curl=$req_rc）" ;;
      52) why="接收端空响应" ;;
      55) why="发送失败（连接被对端重置）" ;;
      56) why="接收数据失败（连接被重置）" ;;
      *)  why="curl 退出码 $req_rc" ;;
    esac
    printf 'ponygo: observe probe：投递失败（%s）→ %s%s\n' "$why" "$url" \
      "${errtxt:+（$errtxt）}" >&2
    printf 'ponygo: 排查：① endpoint 是否可达/端口是否正确 ② 是否需要出网代理 ③ 加大 --timeout（当前 %ss）；凭证始终 <redacted>\n' "$tos" >&2
    return 2
  fi
  case "$code" in
    2[0-9][0-9]) : ;;
    *) printf 'ponygo: observe probe：OTLP 接收端返回 HTTP %s（非 2xx = 投递失败）→ %s（凭证 <redacted>）\n' "$code" "$url" >&2
       return 2 ;;
  esac
  info "已投递探针 span：service.name=$svc deployment.environment=$envn span=ponygo.probe → HTTP $code"
  info "等待 10 秒后执行 ponygo observe audit（判定仍由 audit 做；探针只证明管道可达）"
  return 0
}


observe_upgrade() {
  local d ver min compat
  observe_require_keys
  observe_skill_require
  d=$(observe_skill_dir_soft)
  ver=$(observe_skill_version "$d")
  min=$(observe_map_get contract_version_min)
  compat=no
  if [ -n "$ver" ] && observe_version_ge "$ver" "$min"; then compat=yes; fi

  echo "===== ponygo observe upgrade ====="
  printf 'skill: %s\n' "$d"
  printf 'contract_version: %s\n' "${ver:-unknown}"
  printf '要求: >= %s\n' "$min"
  if [ "$compat" = "yes" ]; then printf '结论: 兼容\n'; else printf '结论: 不兼容（需升级 skill）\n'; fi

  if [ "${UPGRADE_CHECK:-0}" = "1" ] && [ "$compat" != "yes" ]; then
    printf 'ponygo: skill 契约版本不满足：%s（要求 >= %s）；升级 skill 后重试\n' "${ver:-unknown}" "$min" >&2
    exit 2
  fi
  exit 0
}

# observe 段帮助：usage() 与 'ponygo observe --help' 共用同一份文案（单一真源，防双源漂移）
usage_observe() {
  cat <<'EOF'
observe —— 可观测性治理维度（判定 ob0/ob1/ob2；ob3 仅为目标画像，不参与判定）
  ponygo observe status                           静态报告（不判定）：声明在场/占位残留/skill 在场与版本；只读，exit 0
  ponygo observe init   --kind <k> [--service <s>] [--dims a,b] [--anchor-<dim> <path>]
                        [--reason-<dim> <text>] [--force] [--dry-run]
                                                  落地四维归属声明（唯一写命令；已存在声明需 --force）
  ponygo observe audit  [--level ob0|ob1|ob2] [--base <rev>] [--strict] [--json]
                                                  判定是否达到目标级（缺口仅作 backlog；--strict 时任一缺口非零）
  ponygo observe upgrade [--check]                与技能契约的版本兼容门（CI 用 --check）
  ponygo observe probe [--dry-run] [--endpoint <url>] [--service <s>] [--env <e>] [--timeout <s>]
                                                  受控探针：投递带 provenance 的 OTLP span（凭证只读 env
                                                  PONYGO_OTEL_TOKEN，永不回显；--dry-run 零网络）
  ponygo observe --help | -h                      本段帮助

observe 选项（仅 observe 接受，其余命令拒绝）：
  --level ob0|ob1|ob2  判定目标档（ob3 是成本与 SLO 的目标画像，不参与判定，显式拒绝）
  --strict             严格模式：存在任一缺口均非零退出（audit 专用）
  --json               固定词表 JSON 输出（仅 observe status|audit；顶层 audit/status 同样接受；供 CI 解析）
  --skill-dir <dir>    skill 安装目录（等价 env PONYGO_SKILL_DIR）
  --mapping <file>     覆盖嵌入映射数据块（等价 env PONYGO_OBSERVE_MAPPING）

示例：
  # 1. 前端 SPA 项目（接 tracing 与 issues，免除 metrics 与 logs）
  ponygo observe init --kind frontend --dims tracing,issues \
    --anchor-tracing src/api/client.ts --anchor-issues src/main.ts \
    --reason-metrics "前端静态页面无常驻端口" --reason-logs "不走容器日志采集"

  # 2. 桌面端全栈应用（Tauri）
  ponygo observe init --kind desktop --dims tracing,issues \
    --anchor-tracing crates/core/src/otel.rs --anchor-issues crates/core/src/sentry.rs

  # 3. 门禁达标自检与 CI 阻断
  ponygo observe audit --level ob1                  # 体检：缺口=backlog，已达目标级即 exit 0
  ponygo observe audit --level ob1 --strict --json  # CI：任一缺口（含子组件/附加声明不一致）即 exit 1

阻断语义（唯一的两个维度，按需组合，无第三个 scope 维度）：
  默认      → 缺口只进 backlog，退出码只由「当前级 ≥ 目标级」决定
  --strict  → 任一缺口即非零；这是「全仓一票否决」的开关（子组件/附加声明的不一致也走这条）

退出码白话：0=已达目标级/兼容；1=未达目标级或用法错；2=工具或输入错误（不是"未达标"）；3=证据不足。

已知局限：ob1 只判「声明与巡检一致」；四维全 false 的声明同样 PASS（识别谎言是非机械项，见 revisions/accepted/2026-10-25-observe-dimension.md K4；revisions/ 轨道已冻结，仅作历史只读）。
已知局限：ob2 的挂载证据是形状判据（grep 载体，**已排除纯注释行**；仍不解析 AST，也不验证钩子是否真被执行），真执行证据是 audit-diff 本身（K7）。
已知局限：kind 是单值。同目录多形态靠附加声明 docs/observability.d/*.yaml（主声明 docs/observability.yaml 定 ob 级；附加声明只扩覆盖，逐份巡检后不一致进 backlog，--strict 才影响退出码）；多组件仓仍按项目根拆目录，audit 会逐份巡检子组件声明（front_end/ web/ client/ …）并列出各自 rc。
EOF
}

# ---------- 帮助 ----------
# upgrade 的独立用法段（D4：位置子命令 apply 的写路径语义与边界）。
usage_upgrade() {
  cat <<'EOF'
ponygo upgrade —— 骨架漂移报告 / 宇宙内文件刷新

用法：
  ponygo upgrade              漂移报告（只读；宇宙 = UPGRADE_UNIVERSE 十七文件；默认 exit 0）
  ponygo upgrade --check      同报告，但存在漂移/缺口 → exit 非零（供 CI；与 --dry-run 互斥）
  ponygo upgrade apply        把宇宙内十七文件刷新为内嵌模板（写路径；仅内容不同才写）

apply 的边界（诚实条款）：
  - 只处理 UPGRADE_UNIVERSE 十七文件；宇宙外文件（根 README / meta.yaml / 已填 constitution /
    根 AGENTS.md / CLAUDE.md / classes.local / docs-tier 激活版等）无模板基线，一概不动；
  - docs-tier「已激活实例」（.meta/docs-tier/README.md 含「## 已激活文档家清单」）跳过该文件——
    与 --check 同口径：激活必改写它，覆盖即抹掉实例申报；
  - 写入走原子替换（同目录临时文件 + mv），权限位取模板（A1/A2/A4 = 755）；
  - 幂等：第二次 apply 报「零变更」；无参 upgrade 与 --check 的语义一字不变。
EOF
}

usage() {
  cat <<'EOF'
ponygo —— 项目工程化治理元框架命令行（单文件、零依赖）

用法：
  ponygo init     [--dry-run] [--repair-skeleton]  建立/注入 .agents/ + .meta/ 治理骨架（自判新/旧项目；既有 .meta 下按 UPGRADE_UNIVERSE 只补缺失骨架文件）
  ponygo audit    [--level S|M] [--run-specs] [--json]  自适应体检：打分 + 缺口 + 最小改进动作（判据不符 exit 1）
  ponygo status   [--json]               查看成熟度级与骨架完整度（骨架缺口或声明级判据不符 exit 1）
  ponygo upgrade  [--check] [apply]      骨架漂移报告（宇宙=UPGRADE_UNIVERSE 十七文件；默认 exit 0；--check 漂移非零供 CI；apply 刷新为内嵌模板）
  ponygo sync                            把 constitution 投影到 AGENTS.md / CLAUDE.md（模板态投影初始引导）
  ponygo retire   --level <N|off>        退级 / 整体退场（停止线执行器）
  ponygo observe  status|init|audit|upgrade|probe  可观测性治理维度（ob0/ob1/ob2 判定；详见 'ponygo observe --help'）

选项：
  --dry-run   只打印将执行的动作，不落盘（唯一预览手段）
  --level S|M 强制指定审计深度档（默认按项目特征自适应）
  --run-specs 执行 gates/ 下 *.spec.sh 负样本自检（opt-in；默认不执行仓库脚本）
  --json      固定词表单行 JSON（接受面：audit / status / observe status|audit；其余命令拒绝）
              人类报告改走 stderr，stdout 只留一行 JSON；exit 字段 == 真实退出码
  --repair-skeleton  ponygo init 专用：按 UPGRADE_UNIVERSE 十七文件只补缺失骨架文件
              （绝不覆盖既有文件；配 --dry-run 只打印计划、零落盘）
  --check     ponygo upgrade 专用：存在漂移 → exit 非零（供 CI；与 --dry-run 互斥）

确认语义：所有命令**无交互确认**（init / sync / retire 收到即执行，无需也无法确认）；
          预览与试跑只用 `--dry-run`（零落盘）；`--yes` 已彻底移除，传入即为未知选项。
EOF
  usage_observe
}

# ---------- 入口 ----------
DRY_RUN=0; LEVEL=""; CMD=""; RETIRE_LEVEL=""; RUN_SPECS=0; UPGRADE_CHECK=0; REPAIR_SKELETON=0
# D4：upgrade 的位置子命令（零新旗标——flag-budget ADR 约束）。空 = 只读报告（既有语义）。
UPGRADE_SUB=""
# observe 独立变量族：OBSERVE_SUB 承载子命令（与顶层 CMD 分离，防 'observe audit' 被
# 'audit)' 分支二次覆盖），OBSERVE_LEVEL 只收 ob0|ob1|ob2（不复用 LEVEL 的 S|M 值域）。
OBSERVE_SUB=""; OBSERVE_LEVEL=""; OBSERVE_JSON=0; OBSERVE_SKILL_DIR=""; OBSERVE_MAPPING_FILE=""; OBSERVE_STRICT=0
# observe init/audit 旗标族（值型：--kind/--service/--dims/--anchor-<dim>/--reason-<dim>/--base）
OBS_KIND=""; OBS_SERVICE=""; OBS_DIMS=""; OBS_FORCE=0; OBSERVE_BASE=""
# F10 observe probe 旗标族（endpoint 只进内存，不落盘；token 只从 env 读）
OBS_ENDPOINT=""; OBS_ENV=""; OBS_TIMEOUT=""
OBS_ANCHOR_METRICS=""; OBS_ANCHOR_TRACING=""; OBS_ANCHOR_LOGS=""; OBS_ANCHOR_ISSUES=""
OBS_REASON_METRICS=""; OBS_REASON_TRACING=""; OBS_REASON_LOGS=""; OBS_REASON_ISSUES=""
# 惰性求值的探测缓存（映射数据块校验 / `timeout` 语义探针 + 一次性 WARN 旗标）
OBS_MAP_VERIFIED=0; OBS_TIMEOUT_OK=""; OBS_TIMEOUT_WARNED=0
# observe 外部命令临时文件（F3）：路径登记到全局，EXIT 兜底 rm，防信号打断执行中的 skill 时残留。
# INT/TERM 单独处理：清理后按默认信号语义退出（若只 rm 不退出，Ctrl-C/TERM 会被吞掉、进程继续跑）。
# CT-9：需同时覆盖两个临时文件——observe_run_skill 的输出捕获与 audit-diff 的 stderr 捕获；
# 原实现的 trap 只删单个路径，预算放宽到 60s 后 audit-diff 运行窗口变长，残留概率显著上升。
OBS_TMPFILE=""; OBS_DIFF_TMPFILE=""
# W3-5：spec 执行的输出捕获临时文件也进同一个收口（异常/信号退出时不得残留）
SPEC_TMPFILE=""
observe_tmp_cleanup() {
  local f
  for f in "${OBS_TMPFILE:-}" "${OBS_DIFF_TMPFILE:-}" "${SPEC_TMPFILE:-}"; do
    [ -n "$f" ] && rm -f "$f" 2>/dev/null
  done
  return 0
}
trap 'observe_tmp_cleanup' EXIT
trap 'observe_tmp_cleanup; trap - EXIT INT TERM; exit 130' INT
trap 'observe_tmp_cleanup; trap - EXIT INT TERM; exit 143' TERM
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --run-specs) RUN_SPECS=1 ;;
    --repair-skeleton) REPAIR_SKELETON=1 ;;
    --check) UPGRADE_CHECK=1 ;;
    --strict) OBSERVE_STRICT=1 ;;
    --json) OBSERVE_JSON=1 ;;
    --force) OBS_FORCE=1 ;;
    --skill-dir) [ $# -ge 2 ] || die "--skill-dir 需要目录取值（如 --skill-dir .agents/skills/observability-onboarding）"; shift; OBSERVE_SKILL_DIR="$1" ;;
    --mapping) [ $# -ge 2 ] || die "--mapping 需要文件取值（如 --mapping ./observe-mapping.txt）"; shift; OBSERVE_MAPPING_FILE="$1" ;;
    --base) [ $# -ge 2 ] || die "--base 需要取值（如 --base origin/main）"; shift; OBSERVE_BASE="$1" ;;
    --kind) [ $# -ge 2 ] || die "--kind 需要取值（如 --kind desktop；枚举见映射 kind_enum）"; shift; OBS_KIND="$1" ;;
    --service) [ $# -ge 2 ] || die "--service 需要取值（如 --service checkout-api）"; shift; OBS_SERVICE="$1" ;;
    --dims) [ $# -ge 2 ] || die "--dims 需要取值（如 --dims metrics,tracing）"; shift; OBS_DIMS="$1" ;;
    --endpoint) [ $# -ge 2 ] || die "--endpoint 需要取值（如 --endpoint http://127.0.0.1:4318）"; shift; OBS_ENDPOINT="$1" ;;
    --env) [ $# -ge 2 ] || die "--env 需要取值（如 --env staging；缺省 local）"; shift; OBS_ENV="$1" ;;
    --timeout) [ $# -ge 2 ] || die "--timeout 需要正整数秒（如 --timeout 5）"; shift; OBS_TIMEOUT="$1" ;;
    --anchor-metrics) [ $# -ge 2 ] || die "--anchor-metrics 需要取值（如 --anchor-metrics src/metrics.ts）"; shift; OBS_ANCHOR_METRICS="$1" ;;
    --anchor-tracing) [ $# -ge 2 ] || die "--anchor-tracing 需要取值（如 --anchor-tracing src/tracing.ts）"; shift; OBS_ANCHOR_TRACING="$1" ;;
    --anchor-logs) [ $# -ge 2 ] || die "--anchor-logs 需要取值（如 --anchor-logs src/log.ts）"; shift; OBS_ANCHOR_LOGS="$1" ;;
    --anchor-issues) [ $# -ge 2 ] || die "--anchor-issues 需要取值（如 --anchor-issues src/sentry.ts）"; shift; OBS_ANCHOR_ISSUES="$1" ;;
    --reason-metrics) [ $# -ge 2 ] || die "--reason-metrics 需要取值（结构性理由，不是排期理由）"; shift; OBS_REASON_METRICS="$1" ;;
    --reason-tracing) [ $# -ge 2 ] || die "--reason-tracing 需要取值（结构性理由，不是排期理由）"; shift; OBS_REASON_TRACING="$1" ;;
    --reason-logs) [ $# -ge 2 ] || die "--reason-logs 需要取值（结构性理由，不是排期理由）"; shift; OBS_REASON_LOGS="$1" ;;
    --reason-issues) [ $# -ge 2 ] || die "--reason-issues 需要取值（结构性理由，不是排期理由）"; shift; OBS_REASON_ISSUES="$1" ;;
    --level) [ $# -ge 2 ] || die "--level 需要取值（如 --level S / --level off）"; shift; LEVEL="$1" ;;
    -h|--help)
      # 'ponygo observe --help' 与本段帮助同源（usage_observe 是 usage 的子集文案）
      if [ "${CMD:-}" = "observe" ]; then usage_observe; exit 0; fi
      # D4：'ponygo upgrade --help' 给 upgrade 专用段（含 apply 的写路径边界）
      if [ "${CMD:-}" = "upgrade" ]; then usage_upgrade; exit 0; fi
      usage; exit 0 ;;
    observe)
      # 不盲取下一词：子命令词交给下面的 'init|audit|status|upgrade' 分支（A1 守卫）认领，
      # 旗标仍由本循环正常解析（'observe --skill-dir /x audit' 不得被吞掉或串味）。
      # F6 顶层路由守卫：'ponygo init observe ...' 不得改跑 observe（否则 init 被顶替、还真的写盘）
      if [ -n "${CMD:-}" ] && [ "${CMD:-}" != "observe" ]; then
        die "子命令位置非法：'$CMD' 后不接受 'observe'（见 'ponygo --help'）"
      fi
      CMD=observe
      ;;
    probe)
      # F10：probe 只作 observe 的子命令存在——命令面固定六条，不得新增顶层命令词
      if [ "${CMD:-}" = "observe" ]; then
        if [ -n "${OBSERVE_SUB:-}" ]; then die "observe 后不接受第二个子命令词：$1（见 'ponygo observe --help'）"; fi
        OBSERVE_SUB=probe
      else
        die "未知参数或子命令：$1（probe 是 'ponygo observe probe' 的子命令，见 'ponygo --help'）"
      fi
      ;;
    init|audit|status|upgrade|sync|retire)
      # A1 守卫：observe 已占 CMD 时，紧随的第二个子命令词不得覆盖它（'observe status init' 不得变成 init）；
      # 但 'observe --skill-dir /x audit' 这类旗标前置后出现的子命令词仍归 observe。
      if [ "${CMD:-}" = "observe" ]; then
        if [ -n "${OBSERVE_SUB:-}" ]; then
          die "observe 后不接受第二个子命令词：$1（见 'ponygo observe --help'）"
        fi
        OBSERVE_SUB="$1"
      else
        CMD="$1"
      fi
      ;;
    apply)
      # D4：upgrade 的**位置子命令**（不新增旗标——flag-budget ADR）。其它命令收到 'apply' 仍是未知参数。
      if [ "${CMD:-}" = "upgrade" ]; then
        UPGRADE_SUB=apply
      else
        die "未知参数或子命令：apply（位置子命令 apply 仅适用于 'ponygo upgrade'；见 'ponygo --help'）"
      fi
      ;;
    *)
      # wave-5：`--yes` 已彻底移除（无兼容分支、无交互确认）——按未知选项报错并给替代指引
      if [ "$1" = "--yes" ]; then
        die "未知选项：--yes（已彻底移除，无兼容开关）：已移除交互确认——init/sync/retire 已无交互确认，直接运行 ponygo init；预览用 --dry-run"
      fi
      # observe 上下文里的裸词：不是第二个子命令词就是未知子命令，绝不落到顶层未知参数
      if [ "${CMD:-}" = "observe" ] && [ "${1#-}" = "$1" ]; then
        if [ -n "${OBSERVE_SUB:-}" ]; then
          die "observe 不接受第二个子命令词：$1（见 'ponygo observe --help'）"
        fi
        die "未知 observe 子命令：$1（用 status|init|audit|upgrade，见 'ponygo observe --help'）"
      fi
      # D4：upgrade 的**未识别位置参数**（如 'upgrade bogus'）→ 直接打印 upgrade 用法并 exit 1
      # （契约要求：不能只指向 'ponygo --help'，必须把「用法」摆在面前）
      if [ "${CMD:-}" = "upgrade" ] && [ "${1#-}" = "$1" ]; then
        usage_upgrade >&2
        printf 'ponygo: 未知位置参数：%s（upgrade 只接受位置子命令 apply，或不带位置参数）\n' "$1" >&2
        exit 1
      fi
      die "未知参数或子命令：$1（见 'ponygo --help'）"
      ;;
  esac
  shift
done

# B2 归一（解析循环结束后、守卫之前）：'--level obN' 写在 observe 之前时先落进 LEVEL，
# 必须在此归一到 OBSERVE_LEVEL 再清空，否则会被后面的守卫当「非 observe 的 --level」丢掉。
if [ "${CMD:-}" = "observe" ]; then
  case "${LEVEL:-}" in
    ob0|ob1|ob2) OBSERVE_LEVEL="$LEVEL"; LEVEL="" ;;
    ob3) die "--level ob3 不可用于判定：ob3 是成本与 SLO 的目标画像，不参与判定；判定档用 ob0|ob1|ob2" ;;
    "") : ;;
    *) die "observe 侧 --level 只收 ob0|ob1|ob2（收到：${LEVEL}）" ;;
  esac
fi
# obN 值域只属 observe；非 observe 命令不得静默接收（LEVEL 的 S|M|off 值域另属 legacy 分支）
if [ "${CMD:-}" != "observe" ] && [ -n "${OBSERVE_LEVEL:-}" ]; then
  die "--level obN 仅适用于 'ponygo observe audit'"
fi
# F5 CONTRACT：--level 的判定目标档只属 'observe audit'；init/status/upgrade 收到即拒绝（不静默忽略）
if [ "${CMD:-}" = "observe" ] && [ -n "${OBSERVE_LEVEL:-}" ]; then
  case "${OBSERVE_SUB:-}" in
    audit|"") : ;;
    *) die "observe 侧 --level 只属 audit（${OBSERVE_SUB} 不接受 --level ${OBSERVE_LEVEL}）" ;;
  esac
fi

# --repair-skeleton 只属于 init（骨架补缺是 init 的旗标，不是新命令：命令面固定六条）；其余命令拒绝
if [ "${REPAIR_SKELETON:-0}" = "1" ] && [ "${CMD:-}" != "init" ]; then
  die "--repair-skeleton 仅适用于 'ponygo init'（按 UPGRADE_UNIVERSE 只补缺失骨架文件）"
fi
# --run-specs 只属于 audit（执行仓库脚本的 opt-in 入口）；其余命令一律拒绝，避免静默忽略
if [ "$RUN_SPECS" = "1" ] && [ "${CMD:-}" != "audit" ]; then
  die "--run-specs 仅适用于 'ponygo audit'（只读命令不执行仓库脚本）"
fi
# --check 只属于 upgrade 与 'observe upgrade'（漂移/版本兼容门）；其余命令一律拒绝（对齐 --run-specs 互斥守卫）
if [ "$UPGRADE_CHECK" = "1" ] && [ "${CMD:-}" != "upgrade" ] \
   && ! { [ "${CMD:-}" = "observe" ] && [ "${OBSERVE_SUB:-}" = "upgrade" ]; }; then
  die "--check 仅适用于 'ponygo upgrade'（骨架漂移检查；其余命令无此语义）"
fi
# --check 必须读真实文件：与 --dry-run 互斥（--check --dry-run → die）
if [ "$UPGRADE_CHECK" = "1" ] && [ "$DRY_RUN" = "1" ]; then
  die "--check 与 --dry-run 互斥——检查必须读真实文件，dry-run 只打印不落盘"
fi
# D4：apply 是写路径，与 --check（只读检查）/ --dry-run（预览）组合一律 usage + exit 1
if [ "${UPGRADE_SUB:-}" = "apply" ] && { [ "$UPGRADE_CHECK" = "1" ] || [ "$DRY_RUN" = "1" ]; }; then
  usage_upgrade >&2
  printf 'ponygo: apply 是写路径，不与 --check / --dry-run 组合（先跑 ponygo upgrade 看 drift 列表即可预览）\n' >&2
  exit 1
fi
# --strict 只属于 'observe audit'（严格门禁：任一缺口非零退出）；其余命令拒绝，避免静默忽略
if [ "$OBSERVE_STRICT" = "1" ] \
   && ! { [ "${CMD:-}" = "observe" ] && [ "${OBSERVE_SUB:-}" = "audit" ]; }; then
  die "--strict 仅适用于 'ponygo observe audit'（严格门禁：任一缺口均非零退出）"
fi
# --json 只属于 'audit' / 'status' 与 'observe status|audit'（固定词表 JSON 供 CI）；其余命令拒绝，避免静默忽略
if [ "$OBSERVE_JSON" = "1" ] \
   && ! { [ "${CMD:-}" = "observe" ] && { [ "${OBSERVE_SUB:-}" = "status" ] || [ "${OBSERVE_SUB:-}" = "audit" ]; }; } \
   && ! { [ "${CMD:-}" = "audit" ] || [ "${CMD:-}" = "status" ]; }; then
  die "--json 仅适用于 'ponygo audit' / 'ponygo status' / 'ponygo observe status|audit'（固定词表输出，供 CI 解析）"
fi
# --skill-dir / --mapping 只属于 observe（其余命令拒绝，避免静默忽略）
if [ -n "$OBSERVE_SKILL_DIR" ] && [ "${CMD:-}" != "observe" ]; then
  die "--skill-dir 仅适用于 'ponygo observe'（技能安装目录）"
fi
if [ -n "$OBSERVE_MAPPING_FILE" ] && [ "${CMD:-}" != "observe" ]; then
  die "--mapping 仅适用于 'ponygo observe'（嵌入映射数据块的覆盖文件）"
fi
# --kind/--service/--dims/--anchor-<dim>/--reason-<dim>/--force 只属 observe init（唯一写命令）；
# --base 只属 observe audit（audit-diff 比较基线）。其余命令一律拒绝，避免静默忽略。
if [ "${CMD:-}" != "observe" ]; then
  if [ -n "${OBS_KIND:-}" ]; then die "--kind 仅适用于 'ponygo observe init'（可观测性声明种类）"; fi
  if [ -n "${OBS_SERVICE:-}" ]; then
    if ! { [ "${CMD:-}" = "observe" ] && { [ "${OBSERVE_SUB:-}" = "init" ] || [ "${OBSERVE_SUB:-}" = "probe" ]; }; }; then
      die "--service 仅适用于 'ponygo observe init' 或 'ponygo observe probe'（服务名）"
    fi
  fi
  if [ -n "${OBS_DIMS:-}" ]; then die "--dims 仅适用于 'ponygo observe init'（四维适用性列表）"; fi
  if [ -n "${OBS_ANCHOR_METRICS:-}${OBS_ANCHOR_TRACING:-}${OBS_ANCHOR_LOGS:-}${OBS_ANCHOR_ISSUES:-}" ]; then
    die "--anchor-<dim> 仅适用于 'ponygo observe init'（该维唯一实现落点）"
  fi
  if [ -n "${OBS_REASON_METRICS:-}${OBS_REASON_TRACING:-}${OBS_REASON_LOGS:-}${OBS_REASON_ISSUES:-}" ]; then
    die "--reason-<dim> 仅适用于 'ponygo observe init'（不适用维的结构性理由）"
  fi
  if [ "${OBS_FORCE:-0}" = "1" ]; then die "--force 仅适用于 'ponygo observe init'（覆盖已存在声明）"; fi
fi
# F10：probe 专用旗标（endpoint/env/timeout）——其余命令一律拒绝，避免静默忽略
if [ -n "${OBS_ENDPOINT:-}${OBS_ENV:-}${OBS_TIMEOUT:-}" ] \
   && ! { [ "${CMD:-}" = "observe" ] && [ "${OBSERVE_SUB:-}" = "probe" ]; }; then
  die "--endpoint / --env / --timeout 仅适用于 'ponygo observe probe'（受控探针）"
fi
if [ -n "${OBSERVE_BASE:-}" ] \
   && ! { [ "${CMD:-}" = "observe" ] && [ "${OBSERVE_SUB:-}" = "audit" ]; }; then
  die "--base 仅适用于 'ponygo observe audit'（audit-diff 比较基线）"
fi

case "${CMD:-}" in
  init) cmd_init ;;
  audit) cmd_audit ;;
  status) cmd_status ;;
  upgrade) if [ "${UPGRADE_SUB:-}" = "apply" ]; then cmd_upgrade_apply || exit 1; else cmd_upgrade; fi ;;
  sync) do_sync ;;
  retire) cmd_retire "${LEVEL:-}" ;;
  observe)
    case "${OBSERVE_SUB:-}" in
      status) observe_status ;;
      init) observe_init ;;
      audit) observe_audit ;;
      upgrade) observe_upgrade ;;
      probe) observe_probe ;;
      *) die "未知 observe 子命令：${OBSERVE_SUB:-（缺）}（见 'ponygo observe --help'）" ;;
    esac
    ;;
  "") usage; exit 0 ;;
esac

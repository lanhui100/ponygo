reason_body_of() {
  printf '%s' "$1" | tr -d '[:space:][:punct:]' \
    | sed -e 's/—//g' -e 's/　//g' \
          -e 's/，//g' -e 's/。//g' -e 's/、//g' -e 's/；//g' -e 's/：//g' \
          -e 's/！//g' -e 's/？//g' -e 's/「//g' -e 's/」//g' -e 's/『//g' -e 's/』//g' \
          -e 's/（//g' -e 's/）//g' -e 's/【//g' -e 's/】//g' -e 's/《//g' -e 's/》//g' \
          -e 's/…//g' -e 's/～//g' -e 's/·//g' -e 's/﹁//g' -e 's/﹂//g' \
          -e 's/“//g' -e 's/”//g' -e 's/‘//g' -e 's/’//g'

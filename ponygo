# （\n、\t、\\ 等被吃掉，PF-18 字节不保真——spec-ponygo-v0-v1.1.md P2-4 已知缺陷）。
projection_write() {
  local target="$1" body="$2"
  local begin="$SYNC_BEGIN" end="$SYNC_END"
  if [ ! -f "$target" ]; then
    canonical_block "$body" > "$target"
    return $?
  fi
  local b_cnt e_cnt b_ln e_ln sync_tmp
  b_cnt=$(projection_marker_count "$target" "$begin")
  e_cnt=$(projection_marker_count "$target" "$end")
  if [ "$b_cnt" = "0" ] && [ "$e_cnt" = "0" ]; then
    [ -n "$(tail -c 1 "$target" 2>/dev/null)" ] && printf '\n' >> "$target"
    { canonical_block "$body"; printf '\n'; } >> "$target"
    return 0
  fi
  if [ "$b_cnt" != "1" ] || [ "$e_cnt" != "1" ]; then
    printf 'ponygo: %s 的标记区结构损坏（BEGIN %s 个 / END %s 个——须各恰 1 个）；投影不修结构，未写入 → 手工清理：只保留一对 BEGIN/END 后重跑 sync\n' \
      "$target" "$b_cnt" "$e_cnt" >&2
    return 1
  fi
  b_ln=$(projection_marker_line "$target" "$begin")
  e_ln=$(projection_marker_line "$target" "$end")
  if [ "$e_ln" -le "$b_ln" ]; then
    printf 'ponygo: %s 的标记区结构损坏（END 行 %s 在 BEGIN 行 %s 之前）；投影不修结构，未写入 → 手工清理：把 END 移到 BEGIN 之后后重跑 sync\n' \
      "$target" "$e_ln" "$b_ln" >&2
    return 1
  fi
  sync_tmp=$(mktemp "${target}.tmp.XXXXXX" 2>/dev/null || echo "${target}.tmp.$$")
  if printf '%s\n' "$body" | awk -v b="$begin" -v e="$end" '
    FILENAME == "-" { bodytext = bodytext $0 "\n"; next }
    {
      line = $0; cmp = line; sub(/\r$/, "", cmp)
      if (cmp == b) { print line; printf "%s", bodytext; inblk = 1; next }
      if (cmp == e) { print line; inblk = 0; next }
      if (inblk) next
      print
    }
  ' - "$target" > "$sync_tmp"; then
    mv -f "$sync_tmp" "$target" || { rm -f "$sync_tmp"; return 1; }
  else
    rm -f "$sync_tmp"
    return 1
  fi
  return 0
}

# ---------- 残留投影 WARN（sync 侧 P0-1 + status 侧 P1-7：同一实现、同一文案） ----------
# 命中条件三件同时成立：① 宪法已填槽（模板态不判定——模板态的 BEGIN 块本就是 bootstrap 应投影
# 的内容）② ai-surface 未开启（off / 值非法 / 未声明）③ 根 AGENTS.md / CLAUDE.md 仍含 BEGIN 哨兵块。
# 为什么必须喊：投影开关关了但旧哨兵块还在 = AI 工具仍载入陈旧常载命约，声明与事实双面。
# 为什么也挂在 status（P1-7，2026-11-11）：`retire --level off` 只改声明，若只有 sync 报警，
# 人得先想起来跑一次 sync 才见告警——等于把「发现残留」依赖在「记得跑 sync」上。
# 不自动删：静默改用户文件比留下显式指引更糟（清理是人的决定）。
# 机读面（P1-10）：命中的文件名进 RESID_PROJ_FILES（空格分隔），由 JSON 的 warnings 块消费。
RESID_PROJ_FILES=""
warn_residual_projection() {
  local res_f=""
  if [ -f "$CONSTITUTION" ] && projection_is_bootstrap; then return 0; fi
  case "$(ai_surface_state)" in on) return 0 ;; esac   # 声明 on = 投影是承诺，不属残留
  for res_f in AGENTS.md CLAUDE.md; do
    [ -f "$res_f" ] || continue
    grep -qF -- "$SYNC_BEGIN" "$res_f" 2>/dev/null || continue
    case " ${RESID_PROJ_FILES} " in
      *" $res_f "*) : ;;
      *) RESID_PROJ_FILES="${RESID_PROJ_FILES}${RESID_PROJ_FILES:+ }$res_f" ;;
    esac
    warn "WARN 残留投影：$res_f 仍含 '$SYNC_BEGIN' … '$SYNC_END' 哨兵块，但投影已关闭（ai-surface 未开启）→ 旧常载命约仍会被 AI 工具载入；请**手工删除**该文件里的这段标记区（或整文件），sync 不会替你删。"
  done
  return 0
}

do_sync() {
  # 投影体门控（P0-1，2026-11-11）：两种宪法形态两套语义——
  #   模板态（宪法含 `TODO:`）→ **永远**投影 bootstrap 引导：onboarding 是填槽的前置，与 AI 开关无关
  #     （否则新实例连「请先填槽」的指引都拿不到，引导链在第一跳就断）。
  #   填槽态 → 常载命约属 AI 适配载荷，**默认关**（命约 5）：仅显式 `ai-surface: on` 才投影；
  #     缺键 / off / 值非法 → 不投影 + 一行说明；若根文件仍留 BEGIN constitution 哨兵块 → WARN 残留
  #     （不自动删：静默改用户文件比留下显式指引更糟）。
  # 开关读取走 ai_surface_state（与 1.9b/2.6 同一真源），归一规则见其注释；不得出现
  # 「status 说 off、sync 照投影」的双面。
  local as_state=""
  as_state=$(ai_surface_state)
  if [ -f "$CONSTITUTION" ] && projection_is_bootstrap; then
    : # 模板态：bootstrap 引导照常投影（下方 info 会说明形态）
  elif [ "$as_state" != "on" ]; then
    case "$as_state" in
      off)     info "ai-surface: off（显式 opt-out）→ 跳过 AGENTS.md / CLAUDE.md 投影（未生成任何 AI 投影文件；要启用写 ai-surface: on）。" ;;
      invalid) info "ai-surface 值非法（仅 on|off，按未声明处理）→ 视为关闭，跳过投影（要启用写 ai-surface: on）。" ;;
      *)       info "ai-surface 未声明 → 视为关闭，跳过投影（要启用写 ai-surface: on）。" ;;
    esac
    # 残留投影 WARN：判定与文案全在 warn_residual_projection（status 侧 P1-7 复用同一份，
    # 禁第二处字面量——两处各写一份文案，迟早一处改了另一处没改）。
    warn_residual_projection
    return 0
  fi
  [ -f "$CONSTITUTION" ] || die "无 $CONSTITUTION，无法投影"
  local body=""
  body=$(projection_body) || die "constitution 缺投影体锚点（<!-- sync-body --> 或「## 常载命约」节）或投影体为空，无法投影"
  if projection_is_bootstrap; then
    info "宪法槽位未填（模板态）：投影初始引导（bootstrap）。槽位填妥后重跑 'ponygo sync' 自动替换为常载命约。"
  fi
  local target
  for target in AGENTS.md CLAUDE.md; do
    if ! projection_write "$target" "$body"; then
      return 1
    fi
    info "已投影 → $target"
  done
}

# ---------- 治理卫生 WARN（status 与 audit 双挂；形状可查、价值靠 review，不改退出码） ----------
# 五条机械 WARN：非 git 仓库 / 根目录游离计划文档 / git 仓库内无 .gitignore /
# 文档新鲜度启发式（v2.1）/ 未来日期决策文件（v2.1）。

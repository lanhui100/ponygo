# ---------- D5：revisions/ 轨道冻结守卫（只读报告；WARN-only，不改退出码/不进 hit） ----------
# 语义（Wave-2 契约 §D5）：框架轨道 `revisions/` 自冻结提交起不得再变——新决策一律落
# `.agents/notes/`。守卫只回答一个问题：冻结提交之后，`revisions/` 的**决策记录**有没有变。
# 判定对象 = `revisions/**/*.md`，但**排除 `revisions/README.md`**：README 是轨道契约载体
# （豁免口径/读法），补文档口径不属于"重开轨道"——与 A1 对 notes 的 README/AGENTS 豁免同源；
# 不排除的话，任何一次口径维护都会让守卫永久 WARN（假报警，噪音把真变更淹掉）。
# 判据：`git log <冻结提交>..HEAD --name-only -- 'revisions/**/*.md' ':(exclude)revisions/README.md'`
#   为空 → 冻结成立；非空 → WARN 并逐条列出（含「轨道已冻结，新决策请落 .agents/notes/」）。
# 环境不可判定（非 git 仓 / 冻结提交不在历史 / git 查询失败）→ SKIPPED：**不计入 PASS**，
#   不冒充 PASS、也不判 FAIL（退出码不受影响）。
# 只读纪律：只跑 git 只读查询（log/cat-file/rev-parse），不执行任何仓库脚本；零新旗标。
REVISIONS_FREEZE_COMMIT="cbc6f15"
REV_STATUS=""; REV_DETAIL=""
audit_revisions_frozen() { # 0=PASS 1=WARN 2=SKIPPED；结果写 REV_STATUS/REV_DETAIL
  REV_STATUS=""; REV_DETAIL=""
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    REV_STATUS="skipped"; REV_DETAIL="非 git 仓库"; return 2
  fi
  if ! git cat-file -e "${REVISIONS_FREEZE_COMMIT}^{commit}" 2>/dev/null; then
    REV_STATUS="skipped"; REV_DETAIL="冻结提交 ${REVISIONS_FREEZE_COMMIT} 不在当前历史（浅克隆或历史被重写）"; return 2
  fi
  local out="" rc=0
  out=$(git log "${REVISIONS_FREEZE_COMMIT}..HEAD" --name-only --pretty=format: \
          -- 'revisions/**/*.md' ':(exclude)revisions/README.md' 2>/dev/null) || rc=$?
  if [ "${rc:-0}" -ne 0 ]; then
    REV_STATUS="skipped"; REV_DETAIL="git log 查询失败（rc=$rc）"; return 2
  fi
  out=$(printf '%s\n' "$out" | sed '/^[[:space:]]*$/d' | sort -u)
  if [ -z "$out" ]; then REV_STATUS="pass"; return 0; fi
  REV_STATUS="warn"; REV_DETAIL="$out"; return 1
}

# 打印 D5 守卫结果（audit 报告段调用；PASS 一行、WARN 逐条、SKIPPED 明说不计入 PASS）
audit_revisions_report() {
  [ -d revisions ] || return 0
  audit_revisions_frozen || true
  case "$REV_STATUS" in
    pass)
      echo "revisions/ 轨道冻结：自冻结提交 ${REVISIONS_FREEZE_COMMIT} 起无新增/改动"
      ;;
    warn)
      printf 'ponygo: WARN revisions/ 轨道已冻结，新决策请落 .agents/notes/ —— 自 %s 起仍有变更：\n' "$REVISIONS_FREEZE_COMMIT" >&2
      printf '%s\n' "$REV_DETAIL" | sed 's/^/ponygo: WARN   /' >&2
      ;;
    *)
      printf 'ponygo: WARN revisions/ 轨道冻结检查 SKIPPED（%s）——不计入 PASS\n' "${REV_DETAIL:-不可判定}" >&2
      ;;
  esac
  return 0
}

warn_governance_hygiene() {
  # 1. 治理根已建但不在 git 仓库内（版本派生/提交边界/钩子挂载全部悬空）
  if { [ -d "$META_DIR" ] || [ -d "$AGENTS_RUNTIME_DIR" ]; } && \
     ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'ponygo: WARN 治理根已建但不在 git 仓库内——版本派生/提交边界/钩子挂载全部悬空 → git init（bootstrap 第 0 步）\n' >&2
  fi
  # 2. 根目录游离计划文档（实施计划的家是 .agents/notes/proposed/）
  local p
  for p in *.md; do
    [ -e "$p" ] || continue
    case "$p" in
      plan.md|Plan.md|PLAN.md|plan-*.md|plan_*.md|*-plan.md|*_plan.md|PLAN*.md|Implementation*.md|IMPLEMENTATION*.md|ROADMAP*.md|Roadmap*.md|roadmap*.md)
        printf 'ponygo: WARN 根目录游离计划文档：%s → 实施计划的家是 .agents/notes/proposed/（## Proposal + ## Acceptance criteria），迁移后删除游离件\n' "$p" >&2 ;;
    esac
  done
  # 3. git 仓库内无 .gitignore
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && [ ! -f .gitignore ]; then
    printf 'ponygo: WARN git 仓库内无 .gitignore——构建产物/编辑器噪声将裸放进版本库 → 建 .gitignore\n' >&2
  fi
  # 4. 文档新鲜度启发式（v2.1）：近 5 提交大改代码而非-notes 文档零动 → 提示跑文档面复检。
  # 计数排除 `.agents/notes/`——ADR 不算"文档更新"，否则"代码+ADR、无用户文档"永远静默
  # （实证：ponyllm 8f37827 类提交）。纯重构/内部改动误报可忽略；只 WARN 不改退出码（P6）。
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git rev-parse --verify HEAD >/dev/null 2>&1; then
    local recent_src="" recent_doc=""
    recent_src=$(git log --format= --name-only -5 HEAD 2>/dev/null | grep -E '\.(rs|ts|py|go|java|cs|rb|php)$' | head -1 || true)
    recent_doc=$(git log --format= --name-only -5 HEAD 2>/dev/null | grep -E '(\.md$|AGENTS\.md$)' | grep -v '^\.agents/notes/' | head -1 || true)
    if [ -n "$recent_src" ] && [ -z "$recent_doc" ]; then
      printf 'ponygo: WARN 近 5 提交有代码变更但无（非-notes）文档更新——改了用户可见行为/契约请同步对应文档的家（same-commit）；纯重构忽略（启发式，非门禁）\n' >&2
    fi
  fi
  # 5. 未来日期决策文件（v2.1）：文件名日期晚于今天 → 提示核对（笔误或计划前置）。
  # `date -d` 可用才判（与 1.6 同款诚实条款）；只 WARN 不 FAIL。
  if [ -d "$DECISIONS_DIR" ] && date -d @0 '+%Y' >/dev/null 2>&1; then
    local today f b d8 future_n=0 future_names=""
    today=$(date '+%F')
    while IFS= read -r -d '' f; do
      b="${f##*/}"
      [ "$b" = "README.md" ] || [ "$b" = "AGENTS.md" ] && continue
      d8="${b:0:10}"
      if printf '%s\n' "$d8" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' && [[ "$d8" > "$today" ]]; then
        future_n=$((future_n+1)); [ "$future_n" -le 3 ] && future_names="${future_names}${b}；"
      fi
    done < <(find "$DECISIONS_DIR" -type f -name '*.md' -print0 2>/dev/null)
    if [ "$future_n" -gt 0 ]; then
      printf 'ponygo: WARN 有 %s 个决策文件日期晚于今天（如：%s）→ 核对是笔误还是计划前置；前者改名，后者无妨（启发式，非门禁）\n' "$future_n" "${future_names%;}" >&2
    fi
  fi
}

# ---------- 门禁分层报告（P7 分层强制原理操作化；audit 调用，报告性非硬判据） ----------
# dsh 实证：pre-commit（秒级）→ pre-push（10秒级）→ CI（分钟级）三层各抓各的；
# 本地窄、CI 全，两层跑同样检查 = 白付延迟。时间经济性是"值不值"（P6），只报告不 FAIL。
gate_layers_report() {
  local local_layer=0 med_layer=0 remote_layer=0
  local hp="" cf="" f
  # 远端层（分钟级 CI）：跨平台探测
  for cf in .github/workflows .gitlab-ci.yml bitbucket-pipelines.yml azure-pipelines.yml .drone.yml Jenkinsfile ci; do
    [ -e "$cf" ] && remote_layer=1 && break
  done
  # 本地层（秒级 pre-commit）：hooksPath 非空钩子 / lefthook / pre-commit / husky
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    hp=$(git config core.hooksPath 2>/dev/null)
  fi
  if { [ -n "$hp" ] && [ -d "$hp" ] && [ -n "$(ls -A "$hp" 2>/dev/null)" ]; } || \
     [ -e lefthook.yml ] || [ -e .pre-commit-config.yaml ] || [ -e .husky ]; then
    local_layer=1
  fi
  # 中继层（10秒级 pre-push）：hooksPath 下有 pre-push / lefthook 声明 pre-push
  if { [ -n "$hp" ] && [ -f "$hp/pre-push" ]; } || \
     { [ -e lefthook.yml ] && grep -q 'pre-push' lefthook.yml; }; then
    med_layer=1
  fi
  echo ""
  echo "===== 门禁分层参考（P7 时间经济性，dsh 实证） ====="
  printf '  本地层 pre-commit（秒级）：%s\n' "$([ "$local_layer" = "1" ] && echo 有 || echo 无)"
  printf '  中继层 pre-push（10秒级）：%s\n' "$([ "$med_layer" = "1" ] && echo 有 || echo 无)"
  printf '  远端层 CI（分钟级）：%s\n' "$([ "$remote_layer" = "1" ] && echo 有 || echo 无)"
  echo "  每层只抓该层性价比最高的缺陷：本地窄、CI 全，两层跑同样检查 = 白付延迟（P7）。"
  [ "$local_layer" = "0" ] && echo "  → 缺本地层：建议补秒级 pre-commit（格式/空白/快速 lint 子集），让高频问题提交时就拦住，而非等 CI 跑分钟级。"
  [ "$med_layer" = "0" ] && echo "  → 缺中继层：按需补 10 秒级 pre-push（如 typecheck/全量 lint），作为推送前的次级过滤。"
  [ "$remote_layer" = "0" ] && echo "  → 缺远端层：建议加最小 CI（聚合门），守住跨提交的全仓质量矩阵。"
  echo "  注：分层是「值不值」的价值判断（P6）——小项目只上 CI 也合法；本表仅机械探测形状、供 review 参考。"
}

# ---------- meta.yaml 违例键告警（合法键仅 level / ai-surface / docs-tier；status 与 audit 双挂同一函数） ----------
warn_meta_violations() {
  [ -f "$META_YAML" ] || return 0
  local bad
  # 判定前剥 \r：CRLF 环境下合法键不得被误报（V2 的 \r 防御）
  # docs-tier 只在值为小写 on/off 时合法（新键从严，不继承 ai-surface 的 Off 大小写先例；
  # 引号/非法值/空值 → 违例键 WARN，不新增解析分支）。
  bad=$(sed 's/\r$//' "$META_YAML" | grep -vE '^[[:space:]]*(#|$)' | grep -vE '^(level|ai-surface):|^docs-tier:[[:space:]]*(on|off)$')
  [ -n "$bad" ] || return 0
  printf 'ponygo: WARN meta.yaml 含非法键（合法键仅 level / ai-surface / docs-tier(值仅小写 on|off)，且须顶格无缩进）：\n' >&2
  printf '%s\n' "$bad" | sed 's/^/ponygo: WARN   /' >&2
}

# 投影哨兵（单一真值，F9）：do_sync 写入/替换标记区、verify_ladder 的 2.6 判据、observe 的替代形态
# 文案共用同一对常量——**禁止**在别处重抄字面量（第二真值 = 判据与实现漂移的源头）。
SYNC_BEGIN='<!-- BEGIN constitution -->'
SYNC_END='<!-- END constitution -->'

# ---------- 级自洽验证（status 调用；判据唯一真源：maturity-ladder.md §5） ----------
# 验级基准：无条件验 min(声明级,2) 及以下全部判据；声明 L3+ 的自证提示由 cmd_status 保留输出。
VL_FAILS=""
# F8：JSON 只收**稳定 id**（判据号，如 2.4 / 1.10），不收自由文本；无编号的老文案归 "other"。
VL_FAIL_IDS=""
vl_fail() { # <文案>
  VL_FAILS="${VL_FAILS}  - $1"$'\n'
  local _id=""
  _id=$(printf '%s' "$1" | sed -n 's/^\([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n1)
  [ -n "$_id" ] || _id="other"
  case " ${VL_FAIL_IDS} " in
    *" $_id "*) : ;;                        # 去重：同一判据号只出现一次
    *) VL_FAIL_IDS="${VL_FAIL_IDS}${VL_FAIL_IDS:+ }$_id" ;;
  esac
}

verify_ladder() {
  local lv="$1"
  VL_FAILS=""
  VL_FAIL_IDS=""
  L1_JUDGED=0
  # 2.5 条件判据状态（Q1=A）：DT_OFF=1 → 结论行改写为"2.1–2.4 PASS；2.5 未启用"；
  # DT_SKIP=1 → 未声明 docs-tier（2.5 不计入 PASS，WARN 催声明）。
  DT_OFF=0; DT_SKIP=0
  # 2.6 条件判据状态（F9，完全仿 2.5）：AS_OFF=1 → 显式 opt-out（结论禁写「全部 PASS」）；
  # AS_SKIP=1 → 未声明 ai-surface（2.6 不计入 PASS，WARN 催声明）。
  AS_OFF=0; AS_SKIP=0; AS_WHY=""
  # 1.9b 条件子项状态（C3，与 2.6 同一开关 ai-surface）：AS19_SKIP=1 → off 或未声明 →
  # 根 AGENTS.md 索引链不计入 PASS，结论行把 "1.1–1.9 PASS" 改写为 "1.1–1.8 PASS；1.9b SKIPPED…"。
  AS19_SKIP=0; AS19_WHY=""; AS19_JUDGED=0
  # 归一后不匹配 ^[0-5]$ → 只验 L0、报 0.4 FAIL、跳过 L1/L2（不对未验证值做算术比较）
  local validated=0
  case "$lv" in
    0|1|2|3|4|5) validated=1 ;;
  esac
  # 日期合法性探测：GNU date 可用才机械判 1.6 日期，否则降级"靠 review"（P6 诚实条款）
  local DATE_OK=0
  date -d @0 '+%Y' >/dev/null 2>&1 && DATE_OK=1
  local verified_range="L0"
  local f rel slashes b d8 st stline rest sep reason_body lc d

  # ---- L0（0.1-0.5）----
  [ -d "$META_DIR" ] || vl_fail "0.1 .meta/ 缺失 → 跑 'ponygo init'"
  [ -f "$META_YAML" ] || vl_fail "0.2 .meta/meta.yaml 缺失 → 跑 'ponygo init' 或手工建"
  grep -q '^level:' "$META_YAML" 2>/dev/null || vl_fail "0.3 meta.yaml 缺 level 字段 → 补一行 'level: 0'"
  [ "$validated" = "1" ] || vl_fail "0.4 level 取值非法（归一后：${lv:-空}）→ meta.yaml 的 level 改为 0-5 单个整数（不支持行内注释/缩进/其它形态）"
  # 0.5 最小文档家播种（v2.0）：docs/AGENTS.md 是文档标准的家（agent 自动加载）
  [ -f "docs/AGENTS.md" ] || vl_fail "0.5 缺最小文档家 docs/AGENTS.md（文档标准的家，agent 自动加载）→ 跑 'ponygo init' 生成，或手工建（tier 分类 + 写作规则 + slop checklist）"

  if [ "$validated" = "1" ]; then

    # ---- L1（1.1-1.9，声明级 ≥1 时验；决策计数排除集 {README.md, AGENTS.md, *.zh.md}）----
    # 判据范围诚实条款：本命令的机械影子覆盖 1.1–1.9；1.10（必含 ## Alternatives considered）
    # 由判定真源 .agents/skills/write-adr/verify-note.sh 判定，本命令不重复实现（P9）。
    if [ "$lv" -ge 1 ]; then
      L1_JUDGED=1
      verified_range="L0-L1"
      [ -d "$DECISIONS_DIR" ] || vl_fail "1.1 .agents/notes/ 缺失 → 建 notes/ 与四态子目录"
      local n_dec=0
      n_dec=$(count_decisions)
      [ "${n_dec:-0}" -gt 0 ] || vl_fail "1.2 无决策记录（排除 README.md / AGENTS.md / *.zh.md）→ 写第一篇 ADR 落 proposed/ 或 implemented/"
      # 1.3 顶层目录 ⊆ 四态封闭集（路径即标签，杂项目录即违例）
      while IFS= read -r d; do
        case " $LIFECYCLES " in *" $d "*) ;; *)
          vl_fail "1.3 notes/ 顶层目录越界：$d → 只允许 proposed/implemented/rejected/archived（移走或改名）"
        ;; esac
      done < <(find "$DECISIONS_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null)
      # 1.4 二级目录 ⊆ 六类封闭集 ∪ classes.local 实例扩展
      local classes_all="$CLASSES $(extra_classes | tr '\n' ' ')"
      while IFS= read -r d; do
        case " $classes_all " in *" $d "*) ;; *)
          vl_fail "1.4 二级目录越界：$d → 只允许 feature/bug-fix/simplification/architecture/process/testing（领域扩展请写入 notes/classes.local）"
        ;; esac
      done < <(find "$DECISIONS_DIR" -mindepth 2 -maxdepth 2 -type d -printf '%f\n' 2>/dev/null)
      # 1.5 每个决策 .md 恰好位于 {lifecycle}/{class}/ 两级（深度 1-2 与 ≥4 均违例；README 豁免）
      local n15=0 names15=""
      while IFS= read -r -d '' f; do
        rel="${f#"$DECISIONS_DIR"/}"
        slashes="${rel//[!\/]/}"
        if [ "${#slashes}" -ne 2 ]; then
          n15=$((n15+1)); [ "$n15" -le 3 ] && names15="${names15}${rel}；"
        fi
      done < <(find "$DECISIONS_DIR" -type f -name '*.md' ! -name 'README.md' ! -name 'AGENTS.md' -print0 2>/dev/null)
      [ "$n15" -eq 0 ] || vl_fail "1.5 有决策文件未恰好位于 {lifecycle}/{class}/ 两级（如：${names15%;}）→ 移到 {lifecycle}/{class}/ 下"
      # 1.6 文件名格式 + 日期合法性（README 豁免；date 不可用时在结论行降级标注）
      local n16=0 names16="" n16d=0 names16d=""
      while IFS= read -r -d '' f; do
        b="${f##*/}"
        [ "$b" = "README.md" ] || [ "$b" = "AGENTS.md" ] && continue
        if ! printf '%s\n' "$b" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}-.+\.md$'; then
          n16=$((n16+1)); [ "$n16" -le 3 ] && names16="${names16}${b}；"
        elif [ "$DATE_OK" = "1" ]; then
          d8="${b:0:10}"
          date -d "$d8" >/dev/null 2>&1 || { n16d=$((n16d+1)); [ "$n16d" -le 3 ] && names16d="${names16d}${b}；"; }
        fi
      done < <(find "$DECISIONS_DIR" -type f -name '*.md' -print0 2>/dev/null)
      [ "$n16" -eq 0 ] || vl_fail "1.6 文件名不符合 yyyy-mm-dd-topic.md（如：${names16%;}）→ 按日期前缀规范改名"
      [ "$n16d" -eq 0 ] || vl_fail "1.6 日期不合法（如：${names16d%;}）→ 改为真实存在的 yyyy-mm-dd"
      # 1.7 Status 首词（trim、剥 \r、区分大小写）与所在 lifecycle 一致；archived/ 下 implemented/archived 均判过；README 豁免
      # 1.7b（与判定真源 verify-note.sh 同步，2026-11-09）：rejected 必须带一行理由——
      #   `rejected` 之后跟分隔符（— / - / : 任一），且**剥掉分隔符与空白后**剩余正文 ≥2 字节
      #   （纯分隔符 / 纯 ASCII 标点 = 没有理由，如 `Status: rejected ——`）。豁免口径同真源：
      #   archived/（冻结）、README.md/AGENTS.md（循环内已跳过）、*.zh.md（双语配对，不独立判）。
      # 为什么影子必须跟：1.10 当年的事故形态就是「真源判、CLI 不判」→ status 打全绿而 A1/A4 红，
      #   报告面与判据面错位（同一仓两个结论）。故两道面共用同一批关键字（缺一行理由 / 缺 ## Decision）。
      local n17=0 n17r=0 names17="" names17r=""
      while IFS= read -r -d '' f; do
        b="${f##*/}"
        [ "$b" = "README.md" ] || [ "$b" = "AGENTS.md" ] && continue
        rel="${f#"$DECISIONS_DIR"/}"
        lc="${rel%%/*}"
        stline=$(sed -n 's/\r$//;s/^Status:[[:space:]]*//p' "$f" 2>/dev/null | head -n1)
        st=$(printf '%s\n' "$stline" | awk '{print $1}')
        st="${st%:}"   # 粘写冒号分隔符（Status: rejected: 理由）剥尾随冒号再比目录，与真源同口径
        if [ -z "$st" ]; then
          n17=$((n17+1)); [ "$n17" -le 3 ] && names17="${names17}${b}(缺 Status:行)；"
        elif [ "$lc" = "archived" ]; then
          if [ "$st" != "implemented" ] && [ "$st" != "archived" ]; then
            n17=$((n17+1)); [ "$n17" -le 3 ] && names17="${names17}${b}(Status: $st)；"
          fi
        elif [ "$st" != "$lc" ]; then
          n17=$((n17+1)); [ "$n17" -le 3 ] && names17="${names17}${b}(Status: $st)；"
        fi
        # 1.7b rejected 理由（计数独立：与 1.7 的 Status 漂移是不同成因，合并会丢掉补救动作）
        if [ "$st" = "rejected" ] && [ "$lc" != "archived" ]; then
          case "$b" in
            *.zh.md) ;;
            *)
              rest="${stline#"$st"}"
              rest="${rest#"${rest%%[![:space:]]*}"}"   # 剥前导空白（纯字节操作，不依赖 locale）
              sep=0
              case "$rest" in
                —*|--*|-*|:*) sep=1 ;;
              esac
              if [ "$sep" = "1" ]; then
                case "$rest" in
                  —*) rest="${rest#—}" ;;
                  -*) rest="${rest#-}"; rest="${rest#-}" ;;
                  :*) rest="${rest#:}" ;;
                esac
              fi
              # 正文 = 剥掉 ASCII 空白/标点（含 - 与 :）与 em dash 后的剩余字节（与真源同一口径）：
              # `Status: rejected ——` / `--` / `:` 这类纯分隔符必须归零，分隔符本身不是理由。
              reason_body=$(reason_body_of "$rest")
              if [ "$sep" != "1" ] || [ "$(printf '%s' "$reason_body" | wc -c | tr -d ' ')" -lt 2 ]; then
                n17r=$((n17r+1)); [ "$n17r" -le 3 ] && names17r="${names17r}${b}；"
              fi
              ;;
          esac
        fi
      done < <(find "$DECISIONS_DIR" -type f -name '*.md' -print0 2>/dev/null)
      [ "$n17" -eq 0 ] || vl_fail "1.7 Status 首词与所在目录不符（如：${names17%;}）→ 改 Status 首词与所在 lifecycle 一致（archived/ 允许 implemented 或 archived）"
      [ "$n17r" -eq 0 ] || vl_fail "1.7 rejected 缺一行理由（如：${names17r%;}）→ Status 行补「rejected — <为何否决>」（剥掉分隔符 —/-/: 与空白后剩余正文 ≥2 字节；纯分隔符/纯标点不算理由；判据与 verify-note.sh 同源）"
      # 1.8 正文骨架与 lifecycle 匹配（README 豁免；archived 冻结豁免）：
      # proposed/rejected 必须含 ## Proposal 且无现在时 ## Decision；
      # implemented 必须含现在时 ## Decision（迁移即改写），且禁止提案时代标题
      #   （英文 ## Proposal/## Plan/## Migration plan/## Acceptance criteria 按边界匹配；
      #    中文 提案/计划/迁移计划/验收标准/验收/风险/待办 按**前缀**匹配——中文标题无词间空格，
      #    边界匹配会让 `## 验收清单`/`## 风险与缓解`/`## 待办事项` 等复合词全部放行，等于开个洞）。
      # 围栏口径（Wave-2 §D2）：全部标题判定走 heading_outside_fence——**围栏内的标题不算在场**，
      # 否则把 `## Decision` 塞进示例代码块即可骗过影子（与真源同一实现口径）。
      # 与真源 verify-note.sh 同文案关键字：「缺 ## Decision」「提案时代标题」。
      local n18=0 n18d=0 names18="" names18d=""
      while IFS= read -r -d '' f; do
        b="${f##*/}"
        [ "$b" = "README.md" ] || [ "$b" = "AGENTS.md" ] && continue
        rel="${f#"$DECISIONS_DIR"/}"
        lc="${rel%%/*}"
        case "$lc" in
          implemented)
            if ! heading_outside_fence "$f" '## Decision([[:space:]]|$)'; then
              n18d=$((n18d+1)); [ "$n18d" -le 3 ] && names18d="${names18d}${b}；"
            fi
            if heading_outside_fence "$f" '## (Proposal|Plan|Migration plan|Acceptance criteria)([[:space:]]|$)' \
               || heading_outside_fence "$f" '## (提案|计划|迁移计划|验收标准|验收|风险|待办)'; then
              n18=$((n18+1)); [ "$n18" -le 3 ] && names18="${names18}${b}(implemented 含提案时代标题)；"
            fi ;;
          proposed|rejected)
            if ! heading_outside_fence "$f" '## Proposal([[:space:]]|$)'; then
              n18=$((n18+1)); [ "$n18" -le 3 ] && names18="${names18}${b}($lc 缺 ## Proposal)；"
            elif heading_outside_fence "$f" '## Decision([[:space:]]|$)'; then
              n18=$((n18+1)); [ "$n18" -le 3 ] && names18="${names18}${b}($lc 含现在时 ## Decision)；"
            fi ;;
        esac
      done < <(find "$DECISIONS_DIR" -type f -name '*.md' ! -name 'README.md' -print0 2>/dev/null)
      [ "$n18d" -eq 0 ] || vl_fail "1.8 implemented 缺 ## Decision（迁移即改写：现在时 Decision 必须在场，如：${names18d%;}）→ proposed→implemented 迁移时把 ## Proposal 改写为 ## Decision"
      [ "$n18" -eq 0 ] || vl_fail "1.8 正文骨架与 lifecycle 不匹配（如：${names18%;}）→ proposed/rejected 用 ## Proposal（将来时），implemented 用现在时 ## Decision；implemented 含提案时代标题（英文或中文等价）即 FAIL"
      # 1.9 文档有家（v2.0）：docs/AGENTS.md 存在（文档标准的家）+ 根 AGENTS.md 含 docs/AGENTS.md 索引链
      # + 包/模块文档覆盖（每个包目录有 AGENTS.md 或 README.md，或列入 .meta/docs-tier/exemptions 豁免）
      [ -f "docs/AGENTS.md" ] || vl_fail "1.9 缺文档标准家 docs/AGENTS.md（agent 自动加载）→ 补 docs/AGENTS.md（tier 分类 + 写作规则 + slop checklist）"
      # 1.9b 根 AGENTS.md 索引链 = **条件子项**（C3：fail-closed 仅当声明 ai-surface，与 2.6 同一开关）：
      #   ai-surface: on          → 声明即承诺：根 AGENTS.md 缺失或无 docs/AGENTS.md 字面链 = 1.9 FAIL；
      #   ai-surface: off / 未声明 → 1.9b SKIPPED（不计入 PASS；WARN 催声明，结论行由 AS19_SKIP 改写）。
      # 为什么挂开关而不是无条件判：不生成 AI 投影的实例（off/未声明）没有「常载入口」这个对象，
      # 无条件判等于要求一个不存在的载体；但一旦声明 on（承诺有 AI 常载面），缺文件静默 PASS 就是假绿
      # ——旧实现 `[ -f ] && ! grep -q` 恰是这个漏洞（缺文件 → 条件为假 → 不报错 → 静默通过）。
      # 判定面（勿低估）：1.9b 由**本函数**判——`ponygo status` 与 `ponygo audit` 共用 verify_ladder，
      # 两者都会报 1.9 FAIL；不是"只有 status 才判"。
      local ai19_state=""
      ai19_state=$(ai_surface_state)
      case "$ai19_state" in
        on)
          AS19_JUDGED=1   # 1.9b 真被判过（判成 FAIL 也算判过）→ JSON coverage 才可写 verified 1.1-1.9
          if [ ! -f "AGENTS.md" ]; then
            vl_fail "1.9 已声明 ai-surface: on 但根 AGENTS.md 不存在（声明即承诺：AI 常载入口缺位，docs/AGENTS.md 索引链无处安放）→ 补救：跑 'ponygo sync' 生成根 AGENTS.md 与 CLAUDE.md"
          elif ! grep -q 'docs/AGENTS.md' "AGENTS.md"; then
            vl_fail "1.9 根 AGENTS.md 未链到文档标准家 docs/AGENTS.md → 加一行索引（'文档标准 → docs/AGENTS.md'，重跑 'ponygo sync' 自动带）"
          fi
          ;;
        off)
          AS19_SKIP=1; AS19_WHY="ai-surface: off（显式 opt-out）"
          printf 'ponygo: WARN ai-surface: off（显式 opt-out）→ 1.9b SKIPPED——根 AGENTS.md 索引链不计入 PASS；想启用 AI 常载面请把 meta.yaml 改为 ai-surface: on\n' >&2
          ;;
        invalid)
          # 有值但归一后不是 on|off（如 `ai-surface: yes`）：不得静默当"没写"——旧文案说"缺 ai-surface"
          # 而文件里明明有值，属误导（且静默失去 fail-closed）。按未声明处理 + 明说值非法。
          AS19_SKIP=1; AS19_WHY="ai-surface 值非法（仅 on|off）"
          printf 'ponygo: WARN ai-surface 值非法（仅 on|off，收到：%s）→ 按未声明处理，1.9b SKIPPED——根 AGENTS.md 索引链不计入 PASS；改为 ai-surface: on|off\n' \
            "$(sed -n 's/^ai-surface:[[:space:]]*//p' "$META_YAML" 2>/dev/null | head -n1 | tr -d '\r' | tr -d '[:space:]')" >&2
          ;;
        *)
          AS19_SKIP=1; AS19_WHY="未声明 ai-surface"
          printf 'ponygo: WARN 未声明 ai-surface（meta.yaml 缺 ai-surface: on|off）→ 1.9b SKIPPED——根 AGENTS.md 索引链不计入 PASS；想启用 AI 常载面请加 ai-surface: on\n' >&2
          ;;
      esac
      # 1.9c 包文档覆盖：探测常见包根（packages/crates/src 的直接子目录），每个须有 AGENTS.md 或 README.md 或入豁免清单
      local pkg_root="" pkg_d="" pkg_missing=0 pkg_names="" exempt_file=".meta/docs-tier/exemptions"
      for pkg_root in packages crates src; do
        [ -d "$pkg_root" ] || continue
        while IFS= read -r pkg_d; do
          b="${pkg_d##*/}"
          # 豁免清单：每行一个包名，# 起注释
          if [ -f "$exempt_file" ] && grep -qx "$b" <(sed 's/\r$//' "$exempt_file" | grep -vE '^[[:space:]]*(#|$)'); then
            continue
          fi
          if [ ! -f "$pkg_d/AGENTS.md" ] && [ ! -f "$pkg_d/README.md" ]; then
            pkg_missing=$((pkg_missing+1))
            [ "$pkg_missing" -le 3 ] && pkg_names="${pkg_names}${pkg_d}；"
          fi
        done < <(find "$pkg_root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
      done
      [ "$pkg_missing" -eq 0 ] || vl_fail "1.9 包文档缺失（如：${pkg_names%;}）→ 每包补 AGENTS.md 或 README.md（config/semantics/limitations），或列入 .meta/docs-tier/exemptions 豁免"
    fi

    # ---- L2（2.1-2.4，声明级 ≥2 时验；声明 L2 即视为已承诺钩子）----
    if [ "$lv" -ge 2 ]; then
      verified_range="L0-L2"
      # 2.1 gates/ 有实质文件（README/.gitkeep 占位不计分）
      # W3-B/W6：无有效内容（空白行/# 注释行之外无内容）的文件不算实质门禁
      local g21=0 g21f=""
      while IFS= read -r -d '' g21f; do
        if file_has_content "$g21f"; then g21=1; break; fi
      done < <(find "$META_DIR/gates" -type f ! -name 'README.md' ! -name '.gitkeep' -print0 2>/dev/null)
      [ "$g21" = "1" ] || vl_fail "2.1 gates/ 无实质门禁文件（README/.gitkeep 与空文件不计）→ 放第一个非零退出的门禁脚本"
      # 2.2 代理判据：*.sh 过 bash -n；真判据（--help / 空样本非零拒绝）靠人工补验
      local sh_bad=0 shf=""
      while IFS= read -r -d '' f; do
        bash -n "$f" 2>/dev/null || { sh_bad=1; [ -z "$shf" ] && shf="$f"; }
      done < <(find "$META_DIR/gates" -type f -name '*.sh' -print0 2>/dev/null)
      [ "$sh_bad" = "0" ] || vl_fail "2.2 门禁脚本语法错误：$shf → 修语法；并人工补真判据（'<gate> --help' / 空样本须非零拒绝）"
      # 2.3 负样本 spec（*.spec.*）：存在性判据（形状，靠 review）。
      # 执行判据是 opt-in 的 `ponygo audit --run-specs`——只读命令不执行仓库脚本
      # （设计约束"判定优先只读"，见文件头）。
      # W2/W6：无有效内容的 `*.spec.*` 不计入（README/.gitkeep 的既有排除口径扩到「空文件」，
      # 且「空」按**有效行**判定：空白行与 # 注释行不算内容——空 spec 证明不了任何拒绝语义）。
      local sp23=0 sp23f=""
      while IFS= read -r -d '' sp23f; do
        if file_has_content "$sp23f"; then sp23=1; break; fi
      done < <(find "$META_DIR/gates" -type f -name '*.spec.*' -print0 2>/dev/null)
      [ "$sp23" = "1" ] || vl_fail "2.3 gates/ 无负样本 spec（*.spec.*）→ 配一个证明门会拒绝非法样本的 spec（推荐 *.spec.sh 自检脚本，用 'ponygo audit --run-specs' 验证）"
      # 2.4 「本地层已接 ADR 门」六条 AND（§6.6 / §7 F1+F3+F5 / maturity-ladder.md §2.4）：
      #   ① hooksPath 已设 ② 归一化目录可达（F6：~ 展开）③ 该目录内 pre-commit 存在且可执行
      #   ④ 哨兵区间逐字节等于规范块（EOL 归一，F3）⑤ 块起始行 < 首个顶层 exit/exec 行
      #   （位置判据：块在 exit/exec 之后 = 永不执行 = 假绿）⑥ <root>/.meta/gates/adr-verify.sh 存在
      # 实现只在 gate_24_probe 一处（status 的接线报告复用同一口径）；失败文案按因分支（F5）。
      # 仅在 git 仓库内判定——非 git 目录读到的全局配置与本项目无关，视为未设（防假 PASS）。
      # 判据加强的缘由（R3/R5/F3）：非可执行钩子被 git 静默忽略；一行注释/`echo`/`|| true`/
      # `if false; then … fi`/注释掉调用行都能骗过「有调用行即可」的旧判据——故改为逐字节比对规范块。
      if ! gate_24_probe; then
        vl_fail "2.4 本地层未接 ADR 门：${G24_CAUSE} → 补救：${G24_FIX}"
      fi
      # 2.5 文档分层激活（v2.4 起为条件判据，Q1=A）：docs-tier: on|off 显式声明；未声明=SKIP+WARN 催声明。
      # 状态机：undeclared=SKIP+WARN；off=显式 opt-out（结论禁写"全部 PASS"）；on+TODO 残留=FAIL；
      #        off+已激活=矛盾 WARN；undeclared+已激活=PASS（实际做到优先于声明）。
      # 声明载体：meta.yaml 的 docs-tier: 键（顶格，值仅小写 on/off；引号/非法值走 warn_meta_violations
      #       白名单告警，且**不得激活状态机**——值读取只剥 \r，不剥引号/空白，严格匹配 on|off）。
      local docs_tier="" dt_state="undeclared" dt_active=0 dt_todo=0
      # 只剥 \r（CRLF 防御，与 warn_meta_violations 同）；值前空白已由 sed 的 [[:space:]]* 吃掉，
      # 值内/尾部空白、引号**全部保留** → case 严格 on|off，任何变体落默认支走未声明，
      # 与白名单"引号/非法值=非法键 WARN"一致（P1-1：引号/空白变体不得兑现 on/off 语义）。
      docs_tier=$(sed -n 's/^docs-tier:[[:space:]]*//p' "$META_YAML" 2>/dev/null | head -n1 | tr -d '\r')
      case "$docs_tier" in
        on)  dt_state="on" ;;
        off) dt_state="off" ;;
        *)   dt_state="undeclared" ;;  # 缺键/空/畸形值（含引号/空白变体）——已由 warn_meta_violations 白名单 WARN，这里按未声明处理
      esac
      if [ -f "$META_DIR/docs-tier/README.md" ] && grep -q '## 已激活文档家清单' "$META_DIR/docs-tier/README.md"; then
        dt_active=1
      fi
      if [ -f "$META_DIR/docs-tier/README.md" ] && grep -q '【TODO】' "$META_DIR/docs-tier/README.md"; then
        dt_todo=1
      fi
      case "$dt_state" in
        on)
          # 已声明 on：文档分层必须已激活且无 TODO 残留，否则 FAIL（声明即承诺，不得空心）
          if [ "$dt_active" = "0" ]; then
            vl_fail "2.5 已声明 docs-tier: on 但文档分层未激活：.meta/docs-tier/README.md 仍是模板态 → 把标题改为 '## 已激活文档家清单' 并填写本项目的 tier 家清单"
          elif [ "$dt_todo" = "1" ]; then
            vl_fail "2.5 已声明 docs-tier: on 但家清单仍含 【TODO】 残留 → 填完各 tier 的家再判定已激活（TODO 残留=声明空心）"
          fi
          ;;
        off)
          # 显式 opt-out：2.5 不判 FAIL；结论行由 DT_OFF 改写为"2.1–2.4 PASS；2.5 未启用"。
          # 与事实矛盾（实际已激活）时 WARN 催对齐，不判 FAIL。
          # spec §3.3：off 是显式 opt-out，须录一条 decision（对齐 retire 的"退级须录 decision"指引式，非硬校验）
          DT_OFF=1
          # wave-5：假提示修复——已登记 `*docs-tier*` decision 时静默（提示的目的已达成）
          if ! docs_tier_decision_exists; then
            printf 'ponygo: 提示 docs-tier: off 是显式 opt-out——建议录一条 decision（.agents/notes/implemented/process/）说明为何不上文档分层（对齐 retire 的退级须录 decision 纪律）\n' >&2
          fi
          if [ "$dt_active" = "1" ]; then
            printf 'ponygo: WARN docs-tier: off 但 .meta/docs-tier/README.md 已含「已激活文档家清单」——声明与事实矛盾，请对齐（去掉 off 或退回模板态）\n' >&2
          fi
          ;;
        *)
          # 未声明：SKIP + WARN 催声明；实际已激活则 PASS（做到优先于声明），不 WARN。
          if [ "$dt_active" = "1" ]; then
            : # 实际做到优先于声明 → PASS，且不 WARN
          else
            printf 'ponygo: WARN 未声明 docs-tier（meta.yaml 缺 docs-tier: on|off）→ 2.5 SKIPPED 不计入 PASS；想启用文档分层请加 docs-tier: on\n' >&2
            DT_SKIP=1
          fi
          ;;
      esac

      # 2.6 AI 常载命约已投影（F9；完全仿 2.5 的三态条件判据）：
      #   undeclared → SKIP + WARN（不计入 PASS，退出码不变——既有实例不得转红）
      #   off        → 显式 opt-out（结论行禁写「全部 PASS」）
      #   on         → 校验根 AGENTS.md 含**成对**投影哨兵块；常量共用 SYNC_BEGIN/SYNC_END
      #                （= do_sync 写标记区用的同一真值，禁第二副本）。本判据只读、不投影。
      local ai_state="" ai_proj=0
      # 开关值读取收敛到 ai_surface_state（与 1.9b 同一读取真源，禁第二副本）
      ai_state=$(ai_surface_state)
      case "$ai_state" in
        on)
          # W9-A2：成对性严格判定——恰一个 BEGIN、恰一个 END、BEGIN 行号 < END 行号、块内非空；
          # 任一不满足即 FAIL（残缺/重复/倒序/空块都不得算「已投影」）。
          local ab_cnt=0 ae_cnt=0 ab_ln=0 ae_ln=0 abody=""
          if [ -f "AGENTS.md" ]; then
            ab_cnt=$(grep -cxF "$SYNC_BEGIN" "AGENTS.md" 2>/dev/null || true)
            ae_cnt=$(grep -cxF "$SYNC_END" "AGENTS.md" 2>/dev/null || true)
            ab_ln=$(grep -nxF "$SYNC_BEGIN" "AGENTS.md" 2>/dev/null | head -n1 | cut -d: -f1)
            ae_ln=$(grep -nxF "$SYNC_END" "AGENTS.md" 2>/dev/null | head -n1 | cut -d: -f1)
          fi
          if [ "${ab_cnt:-0}" = "1" ] && [ "${ae_cnt:-0}" = "1" ] \
             && [ "${ab_ln:-0}" -gt 0 ] && [ "${ae_ln:-0}" -gt "${ab_ln:-0}" ]; then
            # 注意：numeric 区间 start>end 时 GNU sed 会把 start 行**单独打印**（不是空输出），
            # 所以「BEGIN/END 相邻 = 空块」必须先显式判区间长度，否则会把 END 行本身当成块内容。
            if [ "$((ae_ln - ab_ln))" -ge 2 ]; then
              abody=$(sed -n "$((ab_ln+1)),$((ae_ln-1))p" "AGENTS.md" 2>/dev/null | tr -d '[:space:]')
            fi
            [ -n "$abody" ] && ai_proj=1
          fi
          if [ "$ai_proj" = "1" ]; then :; elif [ ! -f "AGENTS.md" ]; then
            vl_fail "2.6 已声明 ai-surface: on 但根 AGENTS.md 不存在（无 AI 常载命约投影）→ 补救：bash ponygo sync"
          elif [ "${ab_cnt:-0}" = "0" ] || [ "${ae_cnt:-0}" = "0" ]; then
            vl_fail "2.6 已声明 ai-surface: on 但根 AGENTS.md 缺投影哨兵块（BEGIN $ab_cnt 个 / END $ae_cnt 个——未投影或哨兵被删）→ 补救：bash ponygo sync"
          elif [ "${ab_cnt:-0}" != "1" ] || [ "${ae_cnt:-0}" != "1" ]; then
            vl_fail "2.6 已声明 ai-surface: on 但根 AGENTS.md 哨兵块不成对（BEGIN $ab_cnt 个 / END $ae_cnt 个——须各恰 1 个）→ 补救：bash ponygo sync"
          elif [ "${ae_ln:-0}" -le "${ab_ln:-0}" ]; then
            vl_fail "2.6 已声明 ai-surface: on 但根 AGENTS.md 哨兵块顺序颠倒（BEGIN 行 $ab_ln / END 行 $ae_ln）→ 补救：bash ponygo sync"
          else
            vl_fail "2.6 已声明 ai-surface: on 但投影区为空（BEGIN…END 之间无内容）→ 补救：bash ponygo sync"
          fi
          ;;
        off)
          # 显式 opt-out：不判 FAIL；结论行由 AS_OFF 改写（不得出现「全部 PASS」）
          AS_OFF=1
          ;;
        invalid)
          # 值非法已在 L1 段（1.9b）打过「值非法」WARN——这里只记 SKIP，不重复误导文案
          AS_SKIP=1; AS_WHY="ai-surface 值非法（仅 on|off）"
          ;;
        *)
          printf 'ponygo: WARN 未声明 ai-surface（meta.yaml 缺 ai-surface: on|off）→ 2.6 SKIPPED 不计入 PASS；想启用 AI 常载命约请加 ai-surface: on\n' >&2
          AS_SKIP=1; AS_WHY="未声明 ai-surface"
          ;;
      esac
    fi

  fi

  if [ -n "$VL_FAILS" ]; then
    VL_VERDICT="fail"
    echo ""
    echo "级自洽验证：未通过（声明 $(fmt_level "$lv")）——以下判据 FAIL："
    printf '%s' "$VL_FAILS"
    return 1
  fi

  # F2 fail-closed：--run-specs 的两态必须体现在结论行上——「真跑通过」与「证据不足」不得同文案。
  # 证据不足（0 spec / 全部自报 SKIPPED / 递归护栏拦截）时，结论行**不得**出现「机械判据全部 PASS」
  # （SKIPPED 不计入 PASS 是硬契约），故整行改为「未判定」并显式标注未验证（调用方据此 exit 3）。
  if [ "${SPEC_UNVERIFIED:-0}" = "1" ]; then
    VL_VERDICT="unverified"
    echo ""
    # A：有 spec 自报 SKIPPED 时必须显式给「N 真跑通过 / M 未验证（SKIPPED）」；
    # 只有全部 spec 都真跑通过（SPEC_VERIFIED=1）时结论行才可写「已真跑并通过」。
    if [ "${SPEC_RUN_SKIP:-0}" -gt 0 ]; then
      echo "级自洽验证：未判定（机械判据无 FAIL 项；2.3 执行判据 ${SPEC_RUN_PASS:-0} 真跑通过 / ${SPEC_RUN_SKIP} 未验证（SKIPPED），不计入 PASS；证据不足 → exit 3）"
    elif [ "$lv" = "0" ]; then
      VL_VERDICT="unverified"
      echo "级自洽验证：未判定（纯 L0 长驻；机械判据无 FAIL 项；2.3 执行判据 SKIPPED——本次未验证，不计入 PASS；证据不足 → exit 3）"
    else
      echo "级自洽验证：未判定（机械判据无 FAIL 项；2.3 执行判据 SKIPPED——本次未验证，不计入 PASS；证据不足 → exit 3）"
    fi
    return 0
  fi
  local spec_note=""
  # F2：全部 spec 真跑通过 → 结论行显式声明执行判据已跑（不得含 SKIPPED / 未验证）
  if [ "${SPEC_VERIFIED:-0}" = "1" ]; then
    spec_note="；2.3 执行判据 已真跑并通过"
  fi
  # 2.5/2.6 条件判据结论行（Q1=A + F9）：
  #   任一条件判据 off（显式 opt-out）→ 基线改写为"2.1–2.4 PASS"并逐条列「未启用」，**禁写「全部 PASS」**；
  #   任一未声明 → 该判据 SKIPPED 不计入 PASS（WARN 已在对应分支输出）；
  #   两者皆无 → 基线 =「${verified_range} 判据 1.1–1.9 PASS」+ 覆盖边界声明。
  # 1.9b 条件子项（C3）：off / 未声明 ai-surface → 该子项 SKIPPED，L1 基线必须从
  #   「1.1–1.9 PASS」改写为「1.1–1.8 PASS」并附「1.9b SKIPPED……不计入 PASS」——
  #   只加一行 SKIP 不改基线，等于让"1.9 PASS"字样冒充一个未判的子项（假绿）。
  #
  # 判据覆盖声明（Wave13 P0-2）：本命令的机械影子只覆盖 1.1–1.9；1.10（必含
  # `## Alternatives considered`）由判定真源 verify-note.sh / A1 / A4 判定，**本命令不执行仓库脚本**
  # 故无法验证它。未验证不得计为 PASS——结论行必须点明这条边界，且整行禁用「全部 PASS」。
  # 无门禁**接线**载体（无可执行 pre-commit、无 CI 适配器）时改称「无门禁载体」，并单独打一行 + WARN；
  # 载体是接线点而非资产存在性（A1/A4 文件在场但没人跑它，等于 1.10 无人验证）。
  local base_txt="" cond_txt="" cond_off="" cond_skip="" b19="" l1_range="1.1–1.9"
  if [ "${AS19_SKIP:-0}" = "1" ]; then
    l1_range="1.1–1.8"
    b19="；1.9b SKIPPED——根 AGENTS.md 索引链未判定（${AS19_WHY:-未声明 ai-surface}），不计入 PASS"
  fi
  if [ "${DT_OFF:-0}" = "1" ]; then cond_off="${cond_off}；2.5 未启用"; fi
  if [ "${AS_OFF:-0}" = "1" ]; then cond_off="${cond_off}；2.6 未启用"; fi
  if [ "${DT_SKIP:-0}" = "1" ]; then cond_skip="${cond_skip}；2.5 SKIPPED——未声明 docs-tier，不计入 PASS"; fi
  if [ "${AS_SKIP:-0}" = "1" ]; then cond_skip="${cond_skip}；2.6 SKIPPED——${AS_WHY:-未声明 ai-surface}，不计入 PASS"; fi
  local cover_txt="" carrier=0
  if lv110_carrier; then carrier=1; fi
  if [ "$carrier" = "1" ]; then
    cover_txt="；1.10 未由本命令验证——由 A1/A4 门把关"
  else
    cover_txt="；1.10 未由本命令验证——无门禁载体"
  fi
  local pass_txt=""
  VL_VERDICT="pass"
  if [ -n "$cond_off" ]; then
    # 显式 opt-out 分支：基线必须仍是「2.1–2.4 PASS；<判据> 未启用」（既有断言逐字节不变），
    # 1.9b 子句紧跟基线（它也是子项状态，不是覆盖声明），覆盖声明与 SKIPPED 子句排在其后。
    pass_txt="级自洽验证：通过（2.1–2.4 PASS${cond_off}${b19}${cond_skip}${cover_txt}${spec_note}）"
  else
    # 覆盖声明紧跟「1.1–1.9 PASS」（1.9b 未判定时退为「1.1–1.8 PASS」+ 紧随的 1.9b SKIPPED 子句）；
    # 其余条件子句（若有）排在覆盖声明之后。
    pass_txt="级自洽验证：通过（${verified_range} 判据 ${l1_range} PASS${b19}${cover_txt}${cond_skip}${spec_note}）"
  fi
  echo ""
  if [ "$lv" = "0" ]; then
    echo "级自洽验证：通过（纯 L0 长驻：合法终态）"
  else
    if [ "$DATE_OK" != "1" ]; then
      echo "${pass_txt}；日期合法性：靠 review"
    else
      echo "$pass_txt"
    fi
    if [ "$carrier" != "1" ]; then
      printf 'ponygo: WARN 无门禁接线载体（无可执行 pre-commit / CI 适配器）→ 1.10（必含 ## Alternatives considered）当前无任何门验证，不计入 PASS\n' >&2
      echo "1.10 无门禁载体（见接线）"
    fi
  fi
  [ "$verified_range" = "L0-L2" ] && \
    echo "  注：2.2 与 2.3 均为代理判据——2.2 查 bash -n 语法、2.3 查 *.spec.* 存在性（只读命令不执行仓库脚本）。" && \
    echo "      执行判据是 opt-in 的 'ponygo audit --run-specs'（跑 *.spec.sh 并断言 exit 0）；" && \
    echo "      真判据的人工补验：'<gate> --help' / 空样本须非零拒绝。"
  return 0
}

# ---------- 门禁负样本自检（opt-in：ponygo audit --run-specs） ----------
# 判据 2.3 的执行侧：跑 gates/ 下全部 *.spec.sh，断言各自 exit 0
# （exit 0 = 该 spec 已证明"门会拒绝非法样本"）。
#
# 为什么默认不跑：本 CLI 的设计约束是"判定优先只读"——status/audit 不得执行仓库里的
# 任意脚本（对陌生遗留仓库执行脚本 = 任意代码执行）。故执行需显式 opt-in。
#
# 护栏（F1：护栏只对**嵌套层**生效——第一层必须真跑）：
#   - 旧入口：环境已有 PONYGO_IN_SPEC=1（外部预置 / 框架 A2 自身识别的旧语义）→ SKIPPED（exit 2）；
#   - 新入口：PONYGO_AUDIT_SPEC_DEPTH ≥ 1（本次执行由 spec 内层发起）→ 拒绝再跑，打印护栏后 exit 2。
#     第一层**不再**向 spec 注入 PONYGO_IN_SPEC=1，只把深度 +1 传下去——故框架自带 spec（A2）
#     在第一层是真跑，不会被自己的护栏吞成 SKIPPED（P0-1 缺陷）；
#   - 超时：有 timeout 时软 25s + KILL 兜底 5s（最坏 30s；无视 TERM 的挂死 spec 会被强杀）；
#   - 聚合：报告**全部**失败 spec（不只最后一个）。
# 返回：0 全过 / 1 有失败 / 2 跳过（无 *.spec.sh 或有护栏命中）
run_gate_specs() {
  local n=0 bad=0 skip=0 f out rc tail_ outfile spec_depth=0
  # A：结论行要能说清「N 真跑通过 / M 未验证（SKIPPED）」——计数用文件级变量（verify_ladder 读）
  SPEC_RUN_PASS=0; SPEC_RUN_SKIP=0
  if [ "${PONYGO_IN_SPEC:-0}" = "1" ]; then
    echo "  [skipped] 2.3 执行判据：检测到 PONYGO_IN_SPEC=1（递归护栏）——SKIPPED 不计入 PASS"
    echo "            注：该变量若由外部预置，执行判据同样被跳过，且**不视为验证通过**。"
    return 2
  fi
  # 嵌套深度护栏：第一层 depth=0 真跑；spec 内再触发 audit --run-specs 时 depth≥1 → 拒绝（防无限递归）。
  # W3-7：严格校验——只接受纯十进制且 ≤6 位。超 int64 的数字会让 `[ -ge ]` 报
  # "integer expression expected"（判定被打成假 → 护栏被绕过，且 stderr 混入 bash 报错）；
  # 任何非法取值一律按护栏拒绝（不得真跑 spec）。
  local depth_raw="${PONYGO_AUDIT_SPEC_DEPTH:-0}" depth_bad=0
  case "$depth_raw" in
    *[!0-9]*) depth_bad=1 ;;
    *) [ "${#depth_raw}" -le 6 ] || depth_bad=1 ;;
  esac
  if [ "$depth_bad" = "1" ]; then
    echo "  [skipped] 2.3 执行判据：PONYGO_AUDIT_SPEC_DEPTH 非法（只接受十进制且 ≤6 位，收到：${PONYGO_AUDIT_SPEC_DEPTH:-空}）——按递归护栏拒绝执行；SKIPPED 不计入 PASS"
    return 2
  fi
  spec_depth=$depth_raw
  if [ "$spec_depth" -ge 1 ]; then
    echo "  [skipped] 2.3 执行判据：检测到嵌套执行（PONYGO_AUDIT_SPEC_DEPTH=$spec_depth，递归护栏）——拒绝在 spec 内再跑门禁 spec；SKIPPED 不计入 PASS"
    echo "            注：护栏只拦嵌套层，第一层真跑不受影响；本层未执行任何 spec，不得计为 PASS。"
    return 2
  fi
  spec_depth=$((spec_depth+1))
  if ! command -v timeout >/dev/null 2>&1; then
    echo "  [warn]   本环境无 timeout：spec 自检**无时间上限**（挂死的 spec 会拖住体检）——如实披露，不假装有护栏。"
  fi
  # W3-5：走 SPEC_TMPFILE（文件级）+ 入口层 EXIT/INT/TERM 清理收口，异常退出也不残留
  SPEC_TMPFILE=$(mktemp 2>/dev/null) || SPEC_TMPFILE=""
  outfile="$SPEC_TMPFILE"
  while IFS= read -r -d '' f; do
    n=$((n+1))
    # W2/W6：空 spec 不得真空通过——无有效内容的文件不执行任何断言，`bash 空文件`（或只有
    # 空白行/# 注释行）恒 exit 0，会被洗成「[ok] 全部自检通过」。直接判 FAIL（硬失败 → exit 1）。
    if ! file_has_content "$f"; then
      bad=$((bad+1))
      printf '  [FAIL] 2.3 spec 自检失败：%s（无有效内容：去掉空白行与 # 注释行后为空——证明不了任何拒绝语义，不得计为通过）\n' "$f"
      continue
    fi
    # 输出重定向到临时文件而非命令替换：命令替换会等管道写端关闭，
    # 后台进程 + 立即退出的 spec 能拖住 timeout（实证）。
    if [ -n "$outfile" ]; then
      if command -v timeout >/dev/null 2>&1; then
        PONYGO_AUDIT_SPEC_DEPTH=$spec_depth timeout -k 5 25 bash "$f" >"$outfile" 2>&1 3>&-; rc=$?
      else
        PONYGO_AUDIT_SPEC_DEPTH=$spec_depth bash "$f" >"$outfile" 2>&1 3>&-; rc=$?
      fi
      tail_=$(tail -n 3 "$outfile" 2>/dev/null | tr '\n' ' ')
    else
      if command -v timeout >/dev/null 2>&1; then
        out=$(PONYGO_AUDIT_SPEC_DEPTH=$spec_depth timeout -k 5 25 bash "$f" 2>&1 3>&-); rc=$?
      else
        out=$(PONYGO_AUDIT_SPEC_DEPTH=$spec_depth bash "$f" 2>&1 3>&-); rc=$?
      fi
      tail_=$(printf '%s\n' "$out" | tail -n 3 | tr '\n' ' ')
    fi
    if [ "$rc" -ne 0 ]; then
      bad=$((bad+1))
      printf '  [FAIL] 2.3 spec 自检失败：%s（exit %s；输出尾部：%s）\n' \
        "$f" "$rc" "${tail_:-（无输出）}"
    elif { [ -n "$outfile" ] && grep -q 'SKIPPED' "$outfile" 2>/dev/null; } \
      || { [ -z "$outfile" ] && printf '%s' "$out" | grep -q 'SKIPPED'; }; then
      # 契约：spec 自报 SKIPPED（如 A2 命中 PONYGO_IN_SPEC=1 的递归护栏）= **不计入 PASS**。
      # 把「自报跳过」当「通过」就是假绿——门没跑，就没证明它还会拒绝非法样本。
      skip=$((skip+1))
      printf '  [skipped] 2.3 spec 自检：%s 自报 SKIPPED（不计入 PASS）\n' "$f"
    else
      printf '  [ok]   2.3 spec 自检：%s\n' "$f"
    fi
  done < <(find "$META_DIR/gates" -type f -name '*.spec.sh' -print0 2>/dev/null)
  if [ -n "$SPEC_TMPFILE" ]; then rm -f "$SPEC_TMPFILE"; SPEC_TMPFILE=""; fi

  if [ "$n" -eq 0 ] || [ "$skip" -eq "$n" ]; then
    if [ "$n" -eq 0 ]; then
      echo "  [skipped] 2.3 执行判据：gates/ 下无 *.spec.sh——SKIPPED 不计入 PASS（2.3 仍是形状判据）"
    else
      # A（契约演进 #5）：存在 skipped 时必须显式给出「N 真跑通过 / M 未验证（SKIPPED）」计数
      SPEC_RUN_PASS=$((n-skip)); SPEC_RUN_SKIP="$skip"
      echo "  [skipped] 2.3 执行判据：$((n-skip)) 真跑通过 / $n 未验证（SKIPPED）——$n 个 *.spec.sh 全部自报 SKIPPED，SKIPPED 不计入 PASS（本次未真正跑门）"
    fi
    return 2
  fi
  if [ "$bad" -ne 0 ]; then
    printf 'ponygo: 2.3 执行判据未通过：%s/%s 个 spec 自检失败（门可能已失效）\n' "$bad" "$n" >&2
    return 1
  fi
  if [ "$skip" -gt 0 ]; then
    # A（契约演进 #5）：**部分** spec 自报 SKIPPED = 那些门没跑 → 未验证，不得计入 PASS。
    # 按 fail-closed 返回 2（上层 → exit 3；若同屏还有 FAIL 则 FAIL 优先 exit 1）。
    SPEC_RUN_PASS=$((n-skip)); SPEC_RUN_SKIP="$skip"
    printf '  [skipped] 2.3 执行判据：%s 真跑通过 / %s 未验证（SKIPPED）——SKIPPED 不计入 PASS（未真正验证的门不算通过）\n' \
      "$((n-skip))" "$skip"
    return 2
  fi
  printf '  [ok]   2.3 执行判据：%s 个 spec 全部自检通过\n' "$n"
  return 0
}

# ---------- 「交付即接线」门禁资产（plan-freeze §2/§6.1/§6.3） ----------
# 双写纪律（§2）：下列 heredoc 与仓库模板文件 EOL 归一后**逐字节一致**：
#   A1 .meta/gates/adr-verify.sh / A2 .meta/gates/adr-verify.spec.sh / A4 .meta/gates/ci-verify.sh
#   A3 .githooks/pre-commit（落点由 core.hooksPath 决定，见 ensure_gate_wiring）
#   A5 .github/workflows/ponygo-governance.yml（仅检出厂 github 证据时才落地，§6.3）
# 只写**缺失**项；A1/A2/A4 例外——它们是框架不可变资产，内容与内置规范不一致时
# **自愈覆盖**（F10，gate_asset_put），管线归「实例可编辑」的 A3/A5 才只补缺失。
# 写后 chmod +x：git 会静默忽略不可执行的钩子，判据会假达标（R3）。
# 铁律（R2）：本函数与 write_skeleton 内**严禁**出现 `git config`——cmd_upgrade 在非 git 的
#            mktemp 目录里调用 write_skeleton 造漂移基准，git config 会 die。
write_gate_assets() {
  mkdir -p "$META_DIR/gates" || gate_write_fail "$META_DIR/gates" "写入失败（目录不可写）——门禁资产无落点"
  gate_asset_put "$META_DIR/gates/adr-verify.sh" 755 "A1 adr-verify.sh" <<'PONYGO_EOF'
#!/usr/bin/env bash
# ============================================================
# adr-verify.sh —— 暂存区 ADR 格式门（门禁资产 A1）
#
# 用法：
#   bash .meta/gates/adr-verify.sh            # 无参 = 校验「暂存区里改动的 ADR」
#   bash .meta/gates/adr-verify.sh <rel>...   # 带参 = 校验指定相对路径（相对仓库根）
#
# 退出码：0 = 放行；非零 = 拒绝（pre-commit 会把非零翻译成"提交被拒"）。
#
# 语义边界（P6 诚实条款）：本门**不自己判** ADR 格式——判定真源是
# `.agents/skills/write-adr/verify-note.sh`（maturity-ladder §5 的 1.1–1.10 机械影子）。
# 本门只多做三件它做不到的事：
#   1) R6 TOCTOU：verify-note 读**工作区**，而 pre-commit 的输入是**暂存区文件名**。
#      两者不一致时（staged 后又在工作区改过），校验的就不是将要提交的那份字节。
#      故先做「暂存区 blob vs 工作区」比对，不一致 → 直接拒绝，要求先 git add。
#   2) R7 覆盖面：用 `--diff-filter=ACMR`（含 R 重命名，`git mv` 不能绕过），
#      并豁免 README.md / AGENTS.md（治理契约载体，非决策记录）。
#   3) F9 非普通文件：symlink（120000）/ gitlink（160000）ADR 一律拒绝——否则"被校验的字节"
#      可以指向工作区外内容，判定面被换掉。此检查必须排在 EOL 归一兜底之前（见 §4a 注释）。
# 为什么不在本门里重写 1.1–1.10：一份判据两份实现必然漂移（P9），
# 且 `ponygo gate adr` 子命令已按同一理由被否决（见 ADR 的 Alternatives R-新子命令）。
#
# 只读纪律：本脚本**不写仓库任何文件**。临时文件一律 `mktemp -d`，`trap` 清理。
# 空场景一律放行（exit 0）：非 git 仓 / 无 .agents/notes / 无暂存 ADR 改动——
# 门禁只对"真的落了 ADR"这一事实负责，不替实例决定要不要写 ADR。
# ============================================================
set -u

PROG=adr-verify
MARK='ADR 有未暂存改动，请先 git add'

note() { printf '[%s] %s\n' "$PROG" "$*"; }
die() {
  printf '[%s] FAIL：%s\n' "$PROG" "$*" >&2
  exit 1
}
# 归档封印的评估结果（在**任何 skip 之前**算好；输出留到 ADR 段之后打印，见 archive_finish）
ARCHIVE_GATE=".meta/gates/archive-verify.sh"
ARCHIVE_DONE=0
ARCHIVE_RC=0
ARCHIVE_OUT=""

# 收口：打印归档段 → 归档未通过则拒绝（fail-closed），否则按调用方的退出码走。
# 顺序语义：ADR 段永远在前、归档段永远在后（本地层两段既有顺序不变）；但**判定**发生在
# 早期（archive_probe），所以"这次没有暂存 ADR"不能成为绕过封印的门。
archive_finish() {
  if [ "${ARCHIVE_DONE:-0}" = "1" ] && [ -n "${ARCHIVE_OUT:-}" ]; then
    printf '%s\n' "$ARCHIVE_OUT"
  fi
  if [ "${ARCHIVE_DONE:-0}" = "1" ] && [ "${ARCHIVE_RC:-0}" -ne 0 ]; then
    printf '[%s] 拒绝：归档封印未通过（见上：归档件被改动或未封印）→ 恢复原字节，或追加封印（bash .meta/gates/archive-verify.sh seal）后再提交\n' "$PROG" >&2
    exit 1
  fi
  return 0
}

# 归档封印探测（A6 存在时无条件跑；缺失则优雅回退，不改变 ADR 判定）
archive_probe() {
  [ -f "$ARCHIVE_GATE" ] || return 0
  ARCHIVE_OUT=$(bash "$ARCHIVE_GATE" check 2>&1)
  ARCHIVE_RC=$?
  ARCHIVE_DONE=1
  return 0
}

skip() {
  printf '[%s] 跳过：%s\n' "$PROG" "$*"
  archive_finish
  exit 0
}

# 1) 非 git 仓 → 无暂存区可言，放行（2.4 会另行判"钩子无从挂载"）
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || skip "非 git 仓库"
[ -n "$ROOT" ] || skip "非 git 仓库"
cd "$ROOT" || die "无法进入仓库根：$ROOT"

# 1b) 归档封印（A6）在**任何 skip 之前**评估：删除/移出归档件不产生暂存 ADR 变更，
#     若把 A6 留在末尾（旧实现），"本次没有暂存 ADR" 就成了绕过封印的门（实测缺陷）。
archive_probe

# 2) 无 .agents/notes → 该实例没有决策记录制度，本门不越权造制度
[ -d .agents/notes ] || skip "无 .agents/notes 决策记录目录"

# 3) 判定真源必须在位；缺失 = 安装损坏，fail-closed（不得静默放行）
VERIFY=".agents/skills/write-adr/verify-note.sh"
[ -f "$VERIFY" ] || die "缺判定真源 $VERIFY → 恢复该文件后重跑（ponygo init，或 git checkout -- $VERIFY）"

# README.md / AGENTS.md 是治理契约载体，不是决策记录（同 verify-note 1.5/1.6 豁免）
is_adr() {
  case "$1" in
    *.md) ;;
    *) return 1 ;;
  esac
  case "${1##*/}" in
    README.md | AGENTS.md) return 1 ;;
  esac
  return 0
}

PATHS=()
if [ "$#" -gt 0 ]; then
  # 带参模式：只接受 .agents/notes/ 下的相对路径；其余跳过（避免误伤调用者的宽参）
  for p in "$@"; do
    p=${p#./}
    case "$p" in
      .agents/notes/*) ;;
      *)
        note "忽略非 ADR 路径：$p"
        continue
        ;;
    esac
    is_adr "$p" || {
      note "忽略豁免文件：$p"
      continue
    }
    [ -f "$p" ] || die "指定路径不存在：$p（带参校验要求工作区可见该文件）"
    PATHS+=("$p")
  done
else
  # 无参模式：暂存区改动的 ADR（ACMR = 新增/复制/修改/重命名；R7）
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    is_adr "$p" || continue
    PATHS+=("$p")
  done < <(git diff --cached --name-only --diff-filter=ACMR -- '.agents/notes/*.md' 2>/dev/null)
fi

[ "${#PATHS[@]}" -gt 0 ] || skip "无暂存 ADR 变更"

# 4) R6 TOCTOU：暂存字节 vs 工作区字节。不一致 = 校验对象不是将要提交的内容。
TMP=$(mktemp -d) || die "mktemp -d 失败"
trap 'rm -rf "$TMP"' EXIT

drift=0
bad_mode=0
for p in ${PATHS[@]+"${PATHS[@]}"}; do
  if ! git cat-file -e ":$p" 2>/dev/null; then
    printf '[%s] %s：%s（暂存区无该文件；只自查未暂存的新 ADR 请直接跑 bash %s）\n' \
      "$PROG" "$MARK" "$p" "$VERIFY" >&2
    drift=1
    continue
  fi
  git show ":$p" >"$TMP/staged" 2>/dev/null || die "读取暂存区内容失败：$p"
  # 4a) F9：ADR 必须是普通文件（symlink 120000 / gitlink 160000 一律拒绝）。
  # 位置是判据本身的部分：必须早于 cmp 与下面的 EOL 归一兜底——
  # symlink 暂存时 blob = 链接文本、cmp 读工作区 = 目标内容，两者必然不同，
  # 而 `git diff --quiet` 对 symlink 只说"链接自身没改"（无差异）→ 会被兜底当假阳性放过。
  # 实测根因即此，故模式检查排在兜底之前。
  mode=$(git ls-files -s -- "$p" 2>/dev/null | awk '{print $1}' | head -1)
  case "$mode" in
    120000 | 160000)
      printf '[%s] 拒绝：%s 不是普通文件（mode=%s；ADR 必须是普通文件）\n' "$PROG" "$p" "$mode" >&2
      bad_mode=1
      continue
      ;;
  esac
  if cmp -s "$TMP/staged" "$p"; then
    continue
  fi
  # 字节不同还要排除一种假阳性：属性层 EOL 归一（.gitattributes `* text=auto eol=lf`）。
  # `git diff --quiet` 按 clean filter 比较索引与工作区——它说"无差异"，
  # 说明差异只来自归一化而非未暂存编辑。
  if git diff --quiet -- "$p" 2>/dev/null; then
    continue
  fi
  printf '[%s] %s：%s\n' "$PROG" "$MARK" "$p" >&2
  drift=1
done

if [ "$bad_mode" -ne 0 ] || [ "$drift" -ne 0 ]; then
  # 按因给补救（不给一条万能命令）：两类成因的修法完全不同。
  if [ "$bad_mode" -ne 0 ]; then
    printf '[%s] 拒绝：ADR 必须是普通文件（符号链接/gitlink 会让被校验的字节指向工作区外）→ 用普通文件重写该 ADR 后 git add\n' "$PROG" >&2
  fi
  if [ "$drift" -ne 0 ]; then
    printf '[%s] 拒绝：暂存区与工作区不一致（verify-note 读工作区，会校验错字节）→ 先 git add 再提交\n' "$PROG" >&2
  fi
  exit 1
fi

# 5) 交给判定真源（唯一真值，不在本门复刻 1.1–1.10）
bash "$VERIFY" ${PATHS[@]+"${PATHS[@]}"} || exit 1

printf '[%s] 通过：%d 条 ADR 经 %s 校验（暂存区与工作区一致）\n' "$PROG" "${#PATHS[@]}" "$VERIFY"

# 5) 归档 SHA-256 封印（A6 check）：**判定**已在步骤 1b 完成，这里只打印其输出并收口——
#    归档件被改一字节、或归档件未封印，都拒绝提交。A6 缺失时优雅回退（步骤 1b 直接返回）。
archive_finish
exit 0
PONYGO_EOF
  # 已有但丢执行位（如经 Windows/zip 转手）→ 补回；A1/A2/A4 是框架不可变资产，改权限不改字节
  [ -x "$META_DIR/gates/adr-verify.sh" ] || chmod +x "$META_DIR/gates/adr-verify.sh" 2>/dev/null || true
  gate_asset_put "$META_DIR/gates/adr-verify.spec.sh" 755 "A2 adr-verify.spec.sh" <<'PONYGO_EOF'
#!/usr/bin/env bash
# ============================================================
# adr-verify.spec.sh —— 暂存区 ADR 格式门的负样本执行判据（门禁资产 A2）
#
# 契约（.meta/gates/README.md「负样本 spec 的两种形态」）：
#   - 自包含：从自身路径解析仓库根，不依赖调用者 cwd；
#   - 只读仓库：样本一律建在 `mktemp -d` 临时目录，退出时清理；不改仓库任何文件；
#   - 秒级：自包裹 `timeout 30`（有 timeout 时）；
#   - 防递归：环境里已有 `PONYGO_IN_SPEC=1` → 打印 SKIPPED 并 exit 0（不计入 PASS）；
#   - exit 0 = 自检通过（"门确实会拒绝非法样本，且会放行合法样本"）。
#
# 本 spec 证明的是 A1 的**拒绝语义**，不是"格式判据本身对不对"——后者是
# `.agents/skills/write-adr/verify-note.sh` 的自检范围（诚实条款：执行判据只证明
# 门会响，证明不了抽样无偏；抽样设计靠 review）。
# ============================================================
set -u

SPEC=adr-verify.spec

# --- 防递归：被 audit --run-specs / CI 以 PONYGO_IN_SPEC=1 调用 → SKIPPED ---
if [ "${PONYGO_IN_SPEC:-0}" = "1" ] && [ "${PONYGO_SPEC_SELFRUN:-0}" != "1" ]; then
  printf '[%s] SKIPPED（PONYGO_IN_SPEC=1，不计入 PASS）\n' "$SPEC"
  exit 0
fi

# --- 秒级上限：自包裹 timeout 30，避免挂死拖死体检 ---
if [ "${PONYGO_SPEC_SELFRUN:-0}" != "1" ] && command -v timeout >/dev/null 2>&1; then
  export PONYGO_SPEC_SELFRUN=1
  exec timeout 30 bash "$0" "$@"
fi

ROOT=$(cd "$(dirname "$0")/../.." && pwd) || {
  printf '[%s] FAIL：无法解析仓库根\n' "$SPEC" >&2
  exit 1
}
GATE="$ROOT/.meta/gates/adr-verify.sh"
VERIFY="$ROOT/.agents/skills/write-adr/verify-note.sh"
for f in "$GATE" "$VERIFY"; do
  [ -f "$f" ] || {
    printf '[%s] FAIL：缺被测资产 %s\n' "$SPEC" "$f" >&2
    exit 1
  }
done

TMP=$(mktemp -d) || {
  printf '[%s] FAIL：mktemp -d 失败\n' "$SPEC" >&2
  exit 1
}
trap 'rm -rf "$TMP"' EXIT

FAIL=0
fail() {
  printf 'FAIL  %s\n' "$*" >&2
  FAIL=1
}

# 造一个"已安装接线"的最小 git 仓：A1 + 判定真源 + 四态 notes 目录
new_repo() { # $1 = 目录名（在 $TMP 下）
  local d="$TMP/$1"
  mkdir -p "$d/.meta/gates" "$d/.agents/skills/write-adr" \
    "$d/.agents/notes/proposed/process" "$d/.agents/notes/implemented/process" \
    "$d/.agents/notes/rejected" "$d/.agents/notes/archived"
  cp "$GATE" "$d/.meta/gates/adr-verify.sh"
  cp "$VERIFY" "$d/.agents/skills/write-adr/verify-note.sh"
  git -C "$d" -c init.defaultBranch=main init -q
  git -C "$d" config user.email spec@example.invalid
  git -C "$d" config user.name spec
  printf '%s\n' "$d"
}

# 写一个 ADR 样本（$1=仓 $2=相对路径 $3=正文）
write_adr() {
  mkdir -p "$1/$(dirname "$2")"
  printf '%s\n' "$3" >"$1/$2"
}

# 跑门：cwd 必须在被检仓内（A1 自行 cd 到 toplevel）
run_gate() { # $1=仓，余下=透传参数
  local d="$1"
  shift
  ( cd "$d" && bash .meta/gates/adr-verify.sh "$@" ) 2>&1
}

expect_accept() { # $1=用例名 $2=仓 [extra args]
  local name="$1" d="$2" out rc
  shift 2
  out=$(run_gate "$d" "$@") && rc=0 || rc=$?
  if [ "$rc" -ne 0 ]; then
    fail "$name：门应放行，实得 exit $rc"
    printf '%s\n' "$out" | tail -n 3 | sed 's/^/      /' >&2
    return
  fi
  printf 'PASS  %s（exit 0）\n' "$name"
}

expect_reject() { # $1=用例名 $2=仓 [extra args]
  local name="$1" d="$2" out rc
  shift 2
  out=$(run_gate "$d" "$@") && rc=0 || rc=$?
  if [ "$rc" -eq 0 ]; then
    fail "$name：门应拒绝，实得 exit 0"
    printf '%s\n' "$out" | tail -n 3 | sed 's/^/      /' >&2
    return
  fi
  printf 'PASS  %s（exit %d）\n' "$name" "$rc"
}

expect_reject_with() { # $1=用例名 $2=仓 $3=拒绝文案正则（补救必须可执行）
  local name="$1" d="$2" pat="$3" out rc
  out=$(run_gate "$d") && rc=0 || rc=$?
  if [ "$rc" -eq 0 ]; then
    fail "$name：门应拒绝，实得 exit 0"
    printf '%s\n' "$out" | tail -n 3 | sed 's/^/      /' >&2
    return
  fi
  if ! printf '%s' "$out" | grep -qE "$pat"; then
    fail "$name：拒绝文案不含 /$pat/ → 补救不可执行"
    printf '%s\n' "$out" | tail -n 3 | sed 's/^/      /' >&2
    return
  fi
  printf 'PASS  %s（exit %d）\n' "$name" "$rc"
}


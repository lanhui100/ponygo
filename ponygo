# marker 单行读取：`<key>=<value>`；找不到输出空串（调用方按"不可校验"处理）。
marker_field() {
  awk -v want="$2" '
    { sub(/\r$/, "") }
    index($0, want "=") == 1 { print substr($0, length(want) + 2); exit }

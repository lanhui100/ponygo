    fail "1.6 $f：文件名不符 yyyy-mm-dd-topic.md"
    return 0
  fi
  if [ "$DATE_OK" = "1" ]; then
    d8="${b:0:10}"
    date -d "$d8" >/dev/null 2>&1 || fail "1.6 $f：日期不合法（$d8）"

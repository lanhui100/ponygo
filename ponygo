bash "$VERIFY" ${PATHS[@]+"${PATHS[@]}"} || exit 1

printf '[%s] 通过：%d 条 ADR 经 %s 校验（暂存区与工作区一致）\n' "$PROG" "${#PATHS[@]}" "$VERIFY"


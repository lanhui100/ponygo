# ---------- 「交付即接线」装配（plan-freeze §6.1–6.5；幂等、非破坏） ----------
# 哨兵/标记常量（§6.5 逐字形态）：marker 行与哨兵同文，供 2.4 机器识别。
GATE_SENT_BEGIN='# >>> ponygo-gate: adr-verify v1 >>>'
GATE_SENT_END='# <<< ponygo-gate: adr-verify v1 <<<'
GATE_MARKER='# ponygo-gate: adr-verify v1'

# 规范哨兵块（F3 唯一真值）：gate_hook_bytes_ok（接线判据的字节原子）与它做「EOL 归一后逐字节」比较。
# 末行/首行哨兵标记与测试夹具（tests/run.sh append_gate_block）逐字同款。
# 任何变体（echo adr-verify.sh / || true / if false; then … fi / 注释掉调用行）都不相等 → 未接线。
GATE_BLOCK_CANONICAL='# >>> ponygo-gate: adr-verify v1 >>>
if [ -f "$(git rev-parse --show-toplevel)/.meta/gates/adr-verify.sh" ]; then
  bash "$(git rev-parse --show-toplevel)/.meta/gates/adr-verify.sh" || exit 1
fi
# <<< ponygo-gate: adr-verify v1 <<<'

# 取哨兵区间（BEGIN..END，含两行）。锚定口径与 maturity-ladder §2.4 / 测试夹具一致。
gate_hook_block() { # <hook 文件>
  sed -n '/>>> ponygo-gate: adr-verify v1 >>>/,/<<< ponygo-gate: adr-verify v1 <</p' "$1" 2>/dev/null
}

# 块必须位于首个顶层 exit/exec **之前**（F1）：末尾追加在 `exit 0` / `exec 他脚本` 钩子里
# 永不执行，而旧判据仍报「已接线」= 假绿。
gate_hook_block_before_exit() { # <hook 文件> → 0 = 位置安全
  local f="$1" bs="" es=""
  bs=$(grep -nF -m1 "$GATE_SENT_BEGIN" "$f" 2>/dev/null | head -n1 | cut -d: -f1)
  [ -n "$bs" ] || return 1
  es=$(grep -nE '^[[:space:]]*(exit|exec)[[:space:]]' "$f" 2>/dev/null | head -n1 | cut -d: -f1)
  [ -n "$es" ] || return 0
  [ "$bs" -lt "$es" ]
}

# 哨兵块结构是否完整（BEGIN 与 END 两行都在）——半截块（写中断残留）不完整，须整块重建
gate_hook_block_complete() { # <hook 文件> → 0 = 两个哨兵行都在
  local f="$1"
  grep -qxF "$GATE_SENT_BEGIN" "$f" 2>/dev/null || return 1
  grep -qxF "$GATE_SENT_END" "$f" 2>/dev/null || return 1
  return 0
}

# 已接线 = 哨兵区间逐字节等于规范块（EOL 归一，F3）。**只回答问题「字节对不对」**，
# 不回答「这段字节会不会被执行」——后者是 gate_hook_block_before_exit（F1）。
# 两者由 gate_hook_wired 合成唯一对外口径，本函数仅是它的原子谓词之一，勿单独作为接线判据。
gate_hook_bytes_ok() { # <hook 文件> → 0 = 哨兵区间逐字节等于规范块
  local f="$1" got=""
  [ -f "$f" ] || return 1
  grep -qxF "$GATE_SENT_END" "$f" 2>/dev/null || return 1
  got=$(gate_hook_block "$f" | tr -d '\r')
  [ "$got" = "$GATE_BLOCK_CANONICAL" ] || return 1
  return 0
}

# 接线判据的**唯一单点**（F1 + F3 合流）：字节等于规范块（F3）∧ 块在首个顶层 exit/exec
# 之前（F1：位置在后 = 永不执行 = 假绿）。init 侧（已接线则不动 / 未接线则迁移）、
# verify_ladder 2.4、status 的接线报告**全部**只走这一个函数——否则会出现
# 「init 认为已接线、status 认为未接线」的双口径（L3-B 指出的正是这种不一致）。
gate_hook_wired() { # <hook 文件> → 0 = 已接线（字节规范 + 位置可执行）
  gate_hook_bytes_ok "$1" || return 1
  gate_hook_block_before_exit "$1" || return 1
  return 0
}

# 文件权限（八进制；GNU/BSD stat 双兼容）
file_mode() { # <文件> → 如 755
  if stat -c %a "$1" >/dev/null 2>&1; then stat -c %a "$1"; else stat -f %Lp "$1" 2>/dev/null; fi
}

# F4 写失败必须响亮：装配期写入失败一律登记到本清单，由 cmd_init 汇总成
# 「[WARN] + 失败清单 + 可执行补救」并**返回非零**。绝不允许把 mv/mktemp 的
# `Permission denied` 裸泄漏成一行噪声后 rc=0（那等于「装配没做成但机器说成功」）。
GATE_WRITE_FAILS=""
gate_write_fail() { # <目标> <因由>
  GATE_WRITE_FAILS="${GATE_WRITE_FAILS}${1} — ${2}"$'\n'
}

# 汇总打印失败清单 + 补救；返回 0 表示「确实有失败」（调用方据此非零退出）
gate_assembly_failed() {
  [ -n "$GATE_WRITE_FAILS" ] || return 1
  local n=0 ln=""
  n=$(printf '%s' "$GATE_WRITE_FAILS" | grep -c . 2>/dev/null || true)
  warn "[WARN] 门禁装配写入失败 ${n:-1} 项——写入失败 = 装配不完整（本次不会假装成功）："
  printf '%s' "$GATE_WRITE_FAILS" | while IFS= read -r ln; do
    [ -n "$ln" ] && warn "  - $ln"
  done
  warn "补救：按上面清单逐项修——① 目录不可写 → chmod u+w <该目录>（钩子落点 = core.hooksPath 目录，资产 = .meta/gates/）；② 目标文件只读/被占用 → chmod u+w <该文件>；③ 磁盘满/只读挂载 → 换可写盘。修完重跑 ponygo init（幂等装配：资产按规范内容自愈 + 钩子重建）。"
  return 0
}

# F2 原子写：同目录 mktemp → 写入（内容走 stdin）→ chmod → mv -f 原子替换。
# 禁止 `>>` 追加直写目标文件与多次 printf 直写（半截内容会被 git 当成有效钩子执行）。
write_atomic() { # <目标路径> <权限，空=不改> ；内容走 stdin
  local dst="$1" mode="$2" dir="" tmp=""
  dir=$(dirname "$dst")
  mkdir -p "$dir" || return 1
  tmp=$(mktemp "$dir/.ponygo.tmp.XXXXXX" 2>/dev/null) || return 1
  if ! cat > "$tmp"; then rm -f "$tmp"; return 1; fi
  if [ -n "$mode" ]; then
    chmod "$mode" "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  mv -f "$tmp" "$dst" || { rm -f "$tmp"; return 1; }
  return 0
}

# F10 资产自愈：A1/A2/A4 是**框架不可变**资产（宇宙表成员）。规范内容走 stdin。
#   缺失                                  → 原子写入（755）
#   存在但与内置规范不一致（半截/被改）    → 用规范内容原子覆盖 + 一行 WARN
#   一致                                  → 一字不动（幂等：重复 init 的字节/mtime 不变）
# A3（钩子）/A5（workflow）是实例可编辑文件 → **不做**内容自愈，只补接线与缺失。
gate_asset_put() { # <目标路径> <权限> <资产名>；规范内容走 stdin
  local dst="$1" mode="$2" name="$3" canon="" same=0
  canon=$(mktemp) || { gate_write_fail "$dst" "$name 自愈失败：无法创建比对临时文件"; return 1; }
  if ! cat > "$canon"; then rm -f "$canon"; gate_write_fail "$dst" "$name 自愈失败：无法读取内置规范内容"; return 1; fi
  if [ -f "$dst" ]; then
    cmp -s <(tr -d '\r' < "$dst") <(tr -d '\r' < "$canon") && same=1
    if [ "$same" = "0" ]; then
      if write_atomic "$dst" "$mode" < "$canon"; then
        warn "[WARN] $name 与内置规范不一致（半截/被改）→ 已按规范内容原子覆盖（F10 资产自愈）：$dst"
      else
        rm -f "$canon"; gate_write_fail "$dst" "写入失败（原子替换 mv 失败/目录不可写）——$name 未能自愈"; return 1
      fi
    fi
  else
    if ! write_atomic "$dst" "$mode" < "$canon"; then
      rm -f "$canon"; gate_write_fail "$dst" "写入失败（原子替换 mv 失败/目录不可写）——$name 未能生成"; return 1
    fi
  fi
  rm -f "$canon"
  return 0
}

# F1+F2：把规范块前置到 shebang 行之后（无 #! 首行 → 文件最前），一次原子替换。
# 既有字节顺序/内容零改动、权限不动；旧块（规范与否）与半截块（有 BEGIN 无 END）先整段摘除
# 再前置重建——单次 awk 产出完整新内容，杜绝「半截钩子」跨写窗口。
gate_hook_write_block() { # <hook 文件> → 0 = 已写
  local f="$1" dir="" tmp="" mode="" blk=""
  [ -f "$f" ] || return 1
  dir=$(dirname "$f")
  mode=$(file_mode "$f" 2>/dev/null || true)
  tmp=$(mktemp "$dir/.ponygo.hook.XXXXXX" 2>/dev/null) || return 1
  blk="$GATE_BLOCK_CANONICAL"
  # CRLF 钩子在 bash 下本就不可执行（`then\r` 不是关键字）——整体归一为 LF（一次原子替换），
  # 既避免同一文件内 EOL 混排，也让既有钩子第一次真正可跑；EOL 归一后判据口径不变（F3）。
  if grep -q $'\r' "$f" 2>/dev/null; then
    warn "既有钩子为 CRLF 行尾（bash 下 then\r 非法）→ 已统一归一为 LF 后前置规范块"
  fi
  if ! PONYGO_BLK="$blk" awk -v b="$GATE_SENT_BEGIN" -v e="$GATE_SENT_END" '
      BEGIN { blk = ENVIRON["PONYGO_BLK"]; if (blk != "") blk = blk "\n" }
      { line = $0; sub(/\r$/, "", line) }
      line == b { inblk = 1; next }
      inblk && line == e { inblk = 0; next }
      inblk { next }
      !placed {
        placed = 1
        if (line ~ /^#!/) { print line; printf "%s", blk; next }
        printf "%s", blk
      }
      { print line }
    ' "$f" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if [ -n "$mode" ]; then
    chmod "$mode" "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  mv -f "$tmp" "$f" || { rm -f "$tmp"; return 1; }
  return 0
}

# CI provider 探测（§6.3：只按证据说话）。github 优先——A5 是 GitHub 专属薄壳。
# F11：判 github 的证据收窄为「remote URL 含 github」**或**「.github/workflows/ 目录存在」。
# 仅 .github/ 存在（ISSUE_TEMPLATE、CODEOWNERS、dependabot 等）与 Actions 无关，
# 拿它当证据会在 GitLab 项目里凭空生成一个永不运行的 GitHub 适配器，并让 status 误报「已生成」。
ci_provider() { # → github|gitlab|jenkins|azure|drone|bitbucket|none
  local remote=""
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    remote=$(git remote get-url origin 2>/dev/null || true)
  fi
  case "$remote" in *github*) printf 'github'; return 0 ;; esac
  if [ -d .github/workflows ]; then printf 'github'; return 0; fi
  if [ -f .gitlab-ci.yml ]; then printf 'gitlab'; return 0; fi
  if [ -f Jenkinsfile ]; then printf 'jenkins'; return 0; fi
  if [ -f azure-pipelines.yml ]; then printf 'azure'; return 0; fi
  if [ -f .drone.yml ]; then printf 'drone'; return 0; fi
  if [ -f bitbucket-pipelines.yml ]; then printf 'bitbucket'; return 0; fi
  printf 'none'
}

# hooksPath → 归一化绝对目录（R9：相对/绝对/符号链接同一口径；不可达 → 空串）
# F6：git 对 core.hooksPath 的 `~` / `~/` 按 $HOME 展开，判定侧必须同口径展开——
# 否则 `core.hooksPath='~/hk'` 会被当成仓内相对路径 `./~/hk`（既假 FAIL，又诱导人在仓里
# 造一个叫 `~` 的目录）。只展开「首个路径段就是 ~」的两种合法形态，其余一律不动。
hook_dir_resolved() { # <repo root> <hooksPath>
  local root="$1" hp="$2" d="" home="${HOME:-}"
  case "$hp" in
    '~')   [ -n "$home" ] && hp="$home" ;;
    '~/'*) [ -n "$home" ] && hp="$home/${hp#\~/}" ;;
  esac
  case "$hp" in
    /*) d=$(cd "$hp" 2>/dev/null && pwd -P) ;;
    *)  d=$(cd "$root/$hp" 2>/dev/null && pwd -P) ;;
  esac
  printf '%s' "${d:-}"
}

# 2.4「本地层已接 ADR 门」判据的**唯一实现**（verify_ladder 2.4 与 status 的
# gate_wiring_report 共用一处口径——两处各写一份必然漂移，F5 的按因补救会有一处退回统一文案）。
# 判据 = ① hooksPath 已设 ② 归一化目录可达 ③ pre-commit 存在且可执行
# ④ 哨兵区间逐字节等于规范块（F3）⑤ 块起始行 < 首个顶层 exit/exec 行（位置判据：
# 块落在 exit/exec 之后 = 永不执行 = 假绿）⑥ <root>/.meta/gates/adr-verify.sh 存在。
# F5：失败**按因**给补救——非 git / 目录不可达 / 钩子不可执行三类给统一「bash ponygo init」
# 是缺陷（对它们无效），各自需要 git init / git config / chmod +x。
# 输出（全局）：G24_OK=1 通过；G24_CAUSE 失败因由；G24_FIX 可执行补救命令。
gate_24_probe() {
  G24_OK=0; G24_CAUSE=""; G24_FIX=""
  local root="" hp="" dir="" hook=""
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    G24_CAUSE="不在 git 仓库内，本地钩子无从挂载"
    G24_FIX="git init（本目录还不是仓库）后重跑 ponygo init 装配本地层"
    return 1
  fi
  hp=$(git config core.hooksPath 2>/dev/null)
  if [ -z "$hp" ]; then
    G24_CAUSE="core.hooksPath 未设（本地层没有落点）"
    G24_FIX="bash ponygo init（设 core.hooksPath=.githooks + 生成 A3 钩子 + chmod +x）"
    return 1
  fi
  root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  dir=$(hook_dir_resolved "${root:-.}" "$hp")
  if [ -z "$dir" ]; then
    G24_CAUSE="core.hooksPath 指向的目录不可达：$hp"
    G24_FIX="git config core.hooksPath .githooks（把落点改回仓内目录）后重跑 ponygo init 装配"
    return 1
  fi
  hook="$dir/pre-commit"
  if [ ! -f "$hook" ]; then
    G24_CAUSE="钩子缺失：$hp/pre-commit"
    G24_FIX="bash ponygo init（生成 A3：marker + 规范哨兵块 + chmod +x）"
    return 1
  fi
  if [ ! -x "$hook" ]; then
    G24_CAUSE="钩子不可执行（git 会静默忽略）：$hp/pre-commit"
    G24_FIX="chmod +x $hp/pre-commit（init 不会替你激活沉睡钩子——执行位是人的决定）"
    return 1
  fi
  if ! grep -qxF "$GATE_SENT_END" "$hook" 2>/dev/null; then
    G24_CAUSE="钩子未接 ADR 门（缺哨兵尾行 $GATE_SENT_END）：$hp/pre-commit"
    G24_FIX="bash ponygo init（按规范块重建哨兵块并前置到 shebang 之后）"
    return 1
  fi
  # 判定单点：接线与否只由 gate_hook_wired 裁决（字节 F3 ∧ 位置 F1）。
  # 下面两个原子谓词**只用于分因**给对症补救，不参与裁决——避免双口径。
  if ! gate_hook_wired "$hook"; then
    if ! gate_hook_bytes_ok "$hook"; then
      G24_CAUSE="钩子哨兵块与规范块不逐字节一致（echo/|| true/if false/注释掉调用行等变体一律不算接线）：$hp/pre-commit"
      G24_FIX="bash ponygo init（删旧块 + 前置规范块为一次原子替换）"
    else
      G24_CAUSE="哨兵块位于首个顶层 exit/exec 之后（该块永不执行）：$hp/pre-commit"
      G24_FIX="bash ponygo init（删旧块并把规范块前置到 shebang 之后）"
    fi
    return 1
  fi
  if [ ! -f "$META_DIR/gates/adr-verify.sh" ]; then
    G24_CAUSE="缺门禁本体 $META_DIR/gates/adr-verify.sh"
    G24_FIX="bash ponygo init（A1 资产按规范内容自愈重建）"
    return 1
  fi
  G24_OK=1
  return 0
}

# ensure_gate_wiring —— 「交付即接线」装配入口（cmd_init 调用；.meta 已存在也照跑，§6.2）。
# 幂等装配：缺失才补；hooksPath 已设一律不动（§6.1）。既有钩子只在「未接线」时被重写，
# 而重写只做两件事——摘除旧哨兵块 + 把规范块前置到 shebang 之后（原字节顺序与权限不动）。
# F2：整个「读-判-写」段在 .git/ponygo-init.lock 上持 flock（无 flock 命令降级 mkdir 原子锁），
#      获锁后重新读取 hooksPath / 钩子内容再判定，并发 init 不可能写出两块。
# 正常装配路径不返回非零（唯一非零 = R15 的非 TTY 未确认，在 cmd_init 里）——
# C2 由「恒定装配」满足，而非由「失败报错」满足。
ensure_gate_wiring() {
  local provid="" fresh="${GATE_FRESH_SEED:-0}"
  provid=$(ci_provider)

  # --dry-run：只打印计划，不落盘、不动 git config（§4 矩阵）
  if [ "${DRY_RUN:-0}" = "1" ]; then
    local a
    for a in adr-verify.sh adr-verify.spec.sh ci-verify.sh; do
      [ -f "$META_DIR/gates/$a" ] || info "[dry-run] 将生成 $META_DIR/gates/$a（缺失）+ chmod +x"
    done
    if [ "$provid" = "github" ]; then
      [ -f .github/workflows/ponygo-governance.yml ] || info "[dry-run] 将生成 .github/workflows/ponygo-governance.yml（A5 薄适配器）"
    else
      info "[dry-run] 远端层：未检出 GitHub（provider=$provid）→ 不生成 A5，需在你的 CI 里加 bash .meta/gates/ci-verify.sh"
    fi
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      info "[dry-run] 非 git 仓库：不设 core.hooksPath（git init 后重跑 ponygo init 才挂载本地层）"
      return 0
    fi
    local hp="" root="" dir=""
    hp=$(git config core.hooksPath 2>/dev/null || true)
    root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [ -z "$hp" ]; then
      info "[dry-run] 将设 core.hooksPath=.githooks（回读校验）+ 创建 .githooks/pre-commit（A3，chmod +x）"
      return 0
    fi
    info "[dry-run] 既有 core.hooksPath=$hp —— 不动，只在其中补/前置 pre-commit 哨兵块"
    dir=$(hook_dir_resolved "$root" "$hp")
    if [ -z "$dir" ]; then
      info "[dry-run] hooksPath 目录不可达：$hp（2.4 会 FAIL）"
    elif [ ! -f "$dir/pre-commit" ]; then
      info "[dry-run] 将新建 $hp/pre-commit（A3）+ chmod +x"
    elif gate_hook_wired "$dir/pre-commit"; then
      info "[dry-run] $hp/pre-commit 已接线（规范块 + 前置位置）—— 不动"
    elif [ -x "$dir/pre-commit" ]; then
      info "[dry-run] 将把规范哨兵块前置到 shebang 之后（原字节顺序与权限不动；旧块/半截块一并重建）"
    else
      info "[dry-run] $hp/pre-commit 存在但不可执行 —— 不动权限（需人 chmod +x 后重跑）"
    fi
    return 0
  fi

  # F2 锁：写段一律在 git 目录的 ponygo-init.lock 上持锁；非 git / 无 git 目录 → 无共享写目标，直跑
  local lockfile="" gd="" lk="" n=0
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    gd=$(git rev-parse --git-common-dir 2>/dev/null || true)
    [ -n "$gd" ] || gd=$(git rev-parse --git-dir 2>/dev/null || true)
    if [ -n "$gd" ]; then
      gd=$(cd "$gd" 2>/dev/null && pwd -P) || gd=""
      if [ -n "$gd" ] && [ -d "$gd" ]; then lockfile="$gd/ponygo-init.lock"; fi
    fi
  fi
  if [ -z "$lockfile" ]; then
    ensure_gate_wiring_locked
    return 0
  fi
  if command -v flock >/dev/null 2>&1; then
    # 注意：**不使用子 shell**（`( … ) 9>>lock`）——F4 的失败清单是 shell 变量，
    # 在子 shell 里登记的失败会随子 shell 退出一起消失（写失败就又被吞成 rc=0）。
    # 这里用 `exec 9>>` 在同一 shell 内持锁，装配结束后显式关闭 fd。
    if ! exec 9>>"$lockfile"; then
      warn "无法打开装配锁文件（$lockfile）→ 无锁继续；写入仍为 mktemp+mv 原子替换"
      ensure_gate_wiring_locked
      return 0
    fi
    flock -w 10 9 || warn "装配锁等待超时（10s，$lockfile）→ 继续；写入仍为 mktemp+mv 原子替换"
    ensure_gate_wiring_locked
    exec 9>&-
    return 0
  fi
  # 降级：mkdir 原子锁（无 flock 命令时；最多等 10s，超时也继续——原子替换仍保证不写出半截块）
  lk="$lockfile.d"
  while ! mkdir "$lk" 2>/dev/null; do
    n=$((n+1))
    if [ "$n" -ge 100 ]; then
      warn "装配锁等待超时（10s，$lk）→ 继续；写入仍为 mktemp+mv 原子替换"
      lk=""
      break
    fi
    sleep 0.1
  done
  ensure_gate_wiring_locked
  [ -n "$lk" ] && rmdir "$lk" 2>/dev/null
  return 0
}

# 装配主体（持锁调用；F2 要求获锁后**重新读取**再判定，故一切读操作都在这里）
ensure_gate_wiring_locked() {
  local root="" hp="" dir="" hook="" provid=""
  provid=$(ci_provider)

  # 1) A1/A2/A4：缺失才写 + 内容与规范不一致则自愈覆盖（F10）+ chmod +x
  write_gate_assets

  # 2) A5：只按 forge 证据生成（§6.3）；非 GitHub 不生成，由 status/audit 给可执行指引（不静默）
  if [ "$provid" = "github" ]; then
    if write_ci_adapter; then
      info "远端层：检出 GitHub → 生成 .github/workflows/ponygo-governance.yml（A5 薄壳，调 .meta/gates/ci-verify.sh）"
    else
      gate_write_fail ".github/workflows/ponygo-governance.yml" "写入失败（目录不可写/原子替换失败）——A5 薄适配器未能生成"
    fi
  else
    info "远端层：未检出 GitHub（provider=$provid）→ 不生成 A5；在你的 CI 里加一步 bash .meta/gates/ci-verify.sh（A4 门禁本体已就位）"
  fi

  # 3) 非 git：不设 hooksPath（R14），保持 exit 0，但必须明说补救路径（C2：不得静默缺席）
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    info "非 git 仓库：本地层钩子无从挂载——先 git init，再重跑 ponygo init（届时自动 git config core.hooksPath .githooks）"
    return 0
  fi
  root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [ -z "$root" ]; then
    warn "无法解析仓库根（git rev-parse --show-toplevel 为空）→ 跳过本地层装配"
    return 0
  fi

  # 4) hooksPath：未设 → 设为 .githooks 并回读校验（R13）；已设 → 一律不动（husky 绝对路径同，§6.1）
  local hp_self_set=0
  hp=$(git config core.hooksPath 2>/dev/null || true)
  if [ -z "$hp" ]; then
    git config core.hooksPath .githooks
    hp_self_set=1
    hp=$(git config core.hooksPath 2>/dev/null || true)
    if [ "$hp" = ".githooks" ]; then
      info "已设 core.hooksPath=.githooks（回读校验通过）"
    else
      warn "core.hooksPath 写入后回读不一致（期望 .githooks，实得 ${hp:-空}）→ 手工执行：git config core.hooksPath .githooks"
      return 0
    fi
  else
    info "既有 core.hooksPath=$hp —— 一律不动（改它会静默停用 husky 等既有装配），直接对该目录的 pre-commit 动手"
  fi

  # 5) 归一化钩子目录（R9）；目录不存在时只有「本函数刚设的 hooksPath」才代建——
  #    已设 hooksPath 指向不可达目录属实例配置错误，框架不替它猜（打印指引，2.4 会 FAIL）
  dir=$(hook_dir_resolved "$root" "$hp")
  if [ -z "$dir" ] && [ "$hp_self_set" = "1" ]; then
    mkdir -p "$root/$hp" && dir=$(hook_dir_resolved "$root" "$hp")
  fi
  if [ -z "$dir" ]; then
    warn "core.hooksPath 指向的目录不可达：$hp → 建该目录或改指 .githooks 后重跑 ponygo init（2.4 会 FAIL）"
    return 0
  fi
  hook="$dir/pre-commit"

  # 6) A3（F1/F2/F3）：
  #    已接线（逐字节等于规范块）且块前置于首个顶层 exit/exec → 一字不动；
  #    无块 / 半截块 / 块在 exit·exec 之后 → 一次原子替换重写为「shebang 之后前置的规范块」；
  #    首次播种（本函数由 cmd_init 的全新骨架分支调用，fresh=1）对「结构完整但内容非规范」的块
  #    只 WARN 不动字节——首次播种不得销毁既有钩子内容，合规性交给 2.4；再跑一次 init
  #    （has_meta 幂等装配分支）即按规范块重建，与 2.4 的补救指令一致。
  #    权限永不由框架改（沉睡钩子是人的决定，2.4 会因缺执行位 FAIL 并给出 chmod +x）。
  if [ ! -f "$hook" ]; then
    write_gate_hook "$hook" && info "新建 $hp/pre-commit（A3：marker + 规范哨兵块 + 非注释调用行）并 chmod +x"
  elif gate_hook_wired "$hook"; then
    if [ -x "$hook" ]; then
      info "$hp/pre-commit 已接线（规范哨兵块 + 前置位置 + 执行位）——不覆盖、不重复写"
    else
      info "$hp/pre-commit 已接线但缺执行位（git 会静默忽略）——不改权限：chmod +x $hp/pre-commit"
    fi
  elif [ "$fresh" = "1" ] && gate_hook_block_complete "$hook"; then
    warn "$hp/pre-commit 哨兵块非规范或位置在 exit/exec 之后（首次播种不改写既有块）→ 再跑一次 ponygo init 将按规范块重建（2.4 现报未接线）"
  elif gate_hook_write_block "$hook"; then
    warn "$hp/pre-commit 哨兵块非规范或位置在 exit/exec 之后 → 已重写为规范块并前置到 shebang 之后（原字节顺序与权限不动）"
    [ -x "$hook" ] || info "提示：该钩子不可执行（沉睡钩子）——框架不改权限：chmod +x $hp/pre-commit"
  else
    gate_write_fail "$hp/pre-commit" "写入失败（原子替换/grep 失败，目录不可写？）——哨兵块未能重建"
  fi
  return 0
}

# 治理门接线现场（status / audit 双挂；报告性输出，不改退出码——硬判据在 verify_ladder 2.4）
# 本地层结论**复用 gate_24_probe**（与 2.4 同一口径）；F5：未接线时按因给补救，
# 三类「装配前提未满足」（非 git / 目录不可达 / 钩子不可执行）不得给统一「bash ponygo init」。
gate_wiring_report() {
  local provid="" state="" hp=""
  provid=$(ci_provider)
  hp=$(git config core.hooksPath 2>/dev/null || true)
  if gate_24_probe; then
    state="已接线（${hp}/pre-commit → .meta/gates/adr-verify.sh，暂存区 ADR 门生效）"
  else
    state="未接线（本地层不拦截暂存区 ADR）——因由：${G24_CAUSE}；补救：${G24_FIX}"
  fi
  printf '治理门接线：%s\n' "$state"
  case "$provid" in
    github)
      if [ -f .github/workflows/ponygo-governance.yml ]; then
        printf '远端层：GitHub Actions 薄适配器已生成（.github/workflows/ponygo-governance.yml → bash .meta/gates/ci-verify.sh）\n'
      else
        printf '远端层：GitHub 证据在但适配器缺失 → 补 bash ponygo init（会生成 .github/workflows/ponygo-governance.yml）\n'
      fi
      ;;
    none)
      printf '远端层：无 CI（本地层已强制）→ 远端层未生效；补 .github/workflows/ponygo-governance.yml 或自有 CI 调 bash .meta/gates/ci-verify.sh\n'
      ;;
    *)
      printf '远端层：检出 %s 但未接门 → 在你的 CI 里加一步 bash .meta/gates/ci-verify.sh（A4 门禁本体已就位）\n' "$provid"
      ;;
  esac
  return 0
}

# ---------- 命令实现 ----------
# 探测既有治理形态（"已认可替代物"条款，见 checklists/audit.md）——init 前提示，防盲目双轨
detect_alt_gov() {
  local hits="" d
  for d in docs/adr docs/decisions docs/architecture/decisions; do
    [ -d "$d" ] && hits="$hits $d(决策载体)"
  done
  # [ -e ] 同时覆盖文件与目录（.github/workflows 是目录，其余是文件）
  for d in CONTRIBUTING.md CODEOWNERS .pre-commit-config.yaml lefthook.yml .github/workflows .gitlab-ci.yml Jenkinsfile azure-pipelines.yml; do
    [ -e "$d" ] && hits="$hits $d(强制/流程)"
  done
  printf '%s' "$hits"
}

cmd_init() {
  local dry=0
  [ "${DRY_RUN:-0}" = "1" ] && dry=1
  # R15：非 TTY 且未显式 --yes → 明确拒绝。旧实现在空 stdin 下 read 失败即「已取消」→
  # exit 0 静默 no-op（等于没装配），与 C2「不得静默缺席」矛盾。
  # F8：--dry-run 豁免本判据——dry-run 不落盘、只打印计划，无需确认；若也被 die 拦住，
  #     非交互环境（CI / 管道 / </dev/null）就永远看不到装配预览。R15 的本意是「不让
  #     破坏性动作在无人确认时静默发生」，dry-run 不具破坏性，不在其射程内。
  if [ "${YES:-0}" != "1" ] && [ "$dry" = "0" ] && [ ! -t 0 ]; then
    die "非交互环境（stdin 非 TTY）无法确认——请显式加 --yes，例如：ponygo init --yes"
  fi

  if has_meta; then
    info "已存在 .meta/ 治理根（level=$(read_level)）。"
    info "不重铺骨架；执行「交付即接线」幂等装配（缺什么补什么，既有文件一字不动）。"
    GATE_FRESH_SEED=0
    ensure_gate_wiring
    # F4：写入失败必须响亮——WARN + 失败清单 + 可执行补救，然后非零退出
    # （禁止裸 `Permission denied` 一行噪声 + rc=0：那等于「装配没做成但机器说成功」）
    gate_assembly_failed && exit 1
    info "完成（幂等装配）。下一步：ponygo status 看级自洽与门禁接线，ponygo audit 体检。"
    exit 0
  fi

  if looks_empty; then
    info "探测：空项目 / 新项目 → 全新铺骨架"
    confirm_or_skip "在新项目根建立 .agents/ + .meta/ 治理骨架（level: 0）" || [ "$dry" = "1" ] || exit 0
    [ "$dry" = "1" ] || write_skeleton 0
  else
    local alt
    alt=$(detect_alt_gov)
    if [ -n "$alt" ]; then
      info "探测：有代码，且发现既有治理形态（已认可替代物候选）：$alt"
      info "  同等治理效果可用别的形态达成——不建议盲目注入，制造两套并行体系。"
      info "  建议：先 'ponygo audit' 体检对照 checklists/audit.md「已认可替代物」条款，再决定迁移。"
    else
      info "探测：有代码但无治理 → 注入骨架（不碰业务代码）"
    fi
    confirm_or_skip "注入 .agents/ + .meta/ 治理骨架到既有代码仓库（只增不改业务文件）" || [ "$dry" = "1" ] || exit 0
    [ "$dry" = "1" ] || write_skeleton 0
  fi

  # 「交付即接线」：A1/A2/A4 已随骨架落地，这里补本地层（hooksPath + A3 钩子）并按 forge 生成 A5。
  # 与 has_meta 分支共用同一函数——两个入口的装配语义必须一致（否则既有实例永远收不到改造）；
  # 唯一差别：首次播种（fresh=1）不重写「结构完整但内容非规范」的既有块，交给下一次 init 重建。
  # F8：fresh 路径在 --dry-run 下也必须走到这里——ensure_gate_wiring 的 dry-run 分支打印
  #     装配计划（hooksPath/A3/A5 的去向）后返回，全程零落盘、零 git config 改动。
  GATE_FRESH_SEED=1
  ensure_gate_wiring
  # F4：同 has_meta 分支——写失败一律非零退出
  gate_assembly_failed && exit 1

  # 铺完骨架后始终投影：模板态投初始引导（bootstrap），已填槽投常载命约
  confirm_or_skip "把 constitution 投影到根 AGENTS.md / CLAUDE.md（模板态投影初始引导）" && do_sync
  info "完成。当前 level=$(read_level)。下一步：ponygo status 查看骨架完整度。"
}

cmd_audit() {
  # 自适应深度选择：探测重型信号 → M 档；全轻 → S 档
  local heavy=0 reasons="" spec_rc=0
  # 信号1：贡献者数 >= 3
  local contrib=0
  if [ -d .git ] && git rev-parse --verify HEAD >/dev/null 2>&1; then contrib=$(git shortlog -sne HEAD 2>/dev/null | wc -l | tr -d ' '); fi
  [ "${contrib:-0}" -ge 3 ] && { heavy=1; reasons="$reasons 贡献者≥3($contrib)"; }
  # 信号2：多技术栈（多种 manifest 并存）
  local manifests=0
  for f in package.json Cargo.toml go.mod pyproject.toml pom.xml; do [ -e "$f" ] && manifests=$((manifests+1)); done
  [ "$manifests" -ge 2 ] && { heavy=1; reasons="$reasons 多栈manifest×$manifests"; }
  # 信号3：monorepo（packages/ 下多个包）
  local npkgs=0
  [ -d packages ] && npkgs=$(find packages -maxdepth 2 -name package.json 2>/dev/null | wc -l | tr -d ' ')
  [ "${npkgs:-0}" -ge 3 ] && { heavy=1; reasons="$reasons monorepo($npkgs包)"; }
  # 信号4：已有治理痕迹（.github/.githooks 任一已存在 → 值得深查）。
  # 刻意不含 .meta：ponygo init 自己的产物不应把项目自动升 M 档——否则 S 档只剩"零治理"
  # 项目可用，与"S 档=起步/小项目"的口径矛盾（EXTERNAL-001 P1-2）。
  local gov=0
  for g in .github .githooks; do [ -e "$g" ] && gov=$((gov+1)); done
  [ "$gov" -ge 1 ] && { heavy=1; reasons="$reasons 已有治理痕迹×$gov"; }
  # 信号5：强合规（存在认证/合规/追溯相关目录；仅做粗筛，最终靠 review）
  local comp=0
  for g in compliance traceability docs/compliance docs/traceability; do [ -e "$g" ] && comp=$((comp+1)); done
  [ "$comp" -ge 1 ] && { heavy=1; reasons="$reasons 强合规痕迹"; }

  local LEVEL_CHOICE="${LEVEL:-}"
  if [ -n "$LEVEL_CHOICE" ]; then
    LEVEL_CHOICE=$(echo "$LEVEL_CHOICE" | tr 'a-z' 'A-Z')
  elif [ "$heavy" = "1" ]; then
    LEVEL_CHOICE="M"
  else
    LEVEL_CHOICE="S"
  fi

  # F6：帮助文本承诺 S|M，其余显式拒绝
  case "$LEVEL_CHOICE" in
    S|M) ;;
    *) die "审计深度档仅支持 S|M，收到：$LEVEL_CHOICE" ;;
  esac

  info "审计深度：${LEVEL_CHOICE} 档${reasons:+（触发:$reasons）}"
  [ "${LEVEL_CHOICE}" = "M" ] || { info "S 档——骨架层判定（判「有没有」）。"; }
  [ "${LEVEL_CHOICE}" = "M" ] && { info "M 档——机制层判定（判「对不对」）。"; }

  # ---- 四问打分（S 档查骨架层，M 档追加机制层；每项一条现成命令，命中+1）----
  local hit=0 total=0

  # 问① 决策记在哪
  total=$((total+1)); [ -d "$DECISIONS_DIR" ] && hit=$((hit+1))
  total=$((total+1))
  found=0; for lc in $LIFECYCLES; do [ -d "$DECISIONS_DIR/$lc" ] && found=1; done
  [ "$found" = "1" ] && hit=$((hit+1))
  total=$((total+1))
  n_dec=$(count_decisions)
  [ "${n_dec:-0}" -gt 0 ] && hit=$((hit+1))   # 有至少一条决策
  total=$((total+1))
  if [ -d "$DECISIONS_DIR/rejected" ] && [ -n "$(ls -A "$DECISIONS_DIR/rejected" 2>/dev/null | grep -vE '^(README\.md|\.gitkeep)$')" ]; then hit=$((hit+1)); fi  # 被否选项留痕（占位文件不计）
  total=$((total+1))
  # 状态与内容一致：反向查缺 Status 头的 md（允许义务外的 README/AGENTS.md 豁免）
  bad_status=$(find "$DECISIONS_DIR" -name '*.md' ! -name 'README.md' ! -name 'AGENTS.md' -exec grep -L '^Status:' {} + 2>/dev/null | wc -l | tr -d ' ')
  [ "${bad_status:-0}" -eq 0 ] && hit=$((hit+1))

  if [ "$LEVEL_CHOICE" = "M" ]; then
    total=$((total+1))
    n_alt=$(grep -rl 'Alternatives' "$DECISIONS_DIR" 2>/dev/null | grep -v '/README\.md$' | wc -l | tr -d ' ')
    [ "${n_alt:-0}" -gt 0 ] && hit=$((hit+1))  # 有 Alternatives 节
    total=$((total+1)); [ -f .git/hooks/pre-commit ] || [ -f .githooks/pre-commit ] && hit=$((hit+1))  # 触发条件/门禁痕迹
  fi

  # 问② 承诺怎么强制
  total=$((total+1))
  # gates/ 有实例自己的实质门禁。README/.gitkeep 占位不计分；框架随 `ponygo init` 交付的
  # ADR 门资产（A1/A2/A4：adr-verify.sh / adr-verify.spec.sh / ci-verify.sh）同样不计分——
  # 那是**框架侧**证据（每个实例都有），计进来等于白送一分，四问分数就失去区分度。
  if [ -d "$META_DIR/gates" ] && [ -n "$(find "$META_DIR/gates" -maxdepth 1 -type f \
        ! -name 'README.md' ! -name '.gitkeep' \
        ! -name 'adr-verify.sh' ! -name 'adr-verify.spec.sh' ! -name 'ci-verify.sh' \
        -print -quit 2>/dev/null)" ]; then hit=$((hit+1)); fi
  total=$((total+1))
  # 本地钩子已挂：仅在 git 仓库内判定（非 git 目录读到的全局配置与本项目无关）
  hook_path=""
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    hook_path=$(git config core.hooksPath 2>/dev/null)
  fi
  if [ -n "$hook_path" ] && [ -d "$hook_path" ]; then hit=$((hit+1)); fi  # 本地钩子已挂
  total=$((total+1))
  # CI 存在：跨平台探测（GitHub/GitLab/Bitbucket/Azure/Drone/Jenkins/通用 ci 目录）
  has_ci=0
  for cf in .github/workflows .gitlab-ci.yml bitbucket-pipelines.yml azure-pipelines.yml .drone.yml Jenkinsfile ci; do
    [ -e "$cf" ] && has_ci=1 && break
  done
  [ "$has_ci" = "1" ] && hit=$((hit+1))

  if [ "$LEVEL_CHOICE" = "M" ]; then
    total=$((total+1)); [ -d .github/workflows ] && hit=$((hit+1))
    total=$((total+1))
    # 负样本 spec：语言无关后缀探测（按项目栈自适应，仅给常见样例）
    negspec=$(find . -path ./node_modules -prune -o \( -name '*_test.go' -o -name '*_test.rs' -o -name 'test_*.py' -o -name '*_test.py' -o -name '*.spec.ts' -o -name '*.spec.js' -o -name '*.Spec.cs' \) -print 2>/dev/null | head -1)
    [ -n "$negspec" ] && hit=$((hit+1))
  fi

  # 问③ 重复劳动怎么复用
  total=$((total+1))
  [ -d "$SKILLS_DIR" ] && [ -n "$(ls -A "$SKILLS_DIR" 2>/dev/null | grep -vE '^(README\.md|\.gitkeep)$')" ] && hit=$((hit+1))

  # 问④ 过时怎么退场
  total=$((total+1))
  [ -d "$DECISIONS_DIR/archived" ] && hit=$((hit+1))

  # ---- 输出 ----
  echo ""
  echo "===== ponygo 审计结果（${LEVEL_CHOICE} 档）====="
  echo "命中 $hit / $total 项"
  info "当前治理级：$(fmt_level "$(read_level)")"
  warn_meta_violations
  warn_governance_hygiene
  echo ""
  echo "缺口与最小改进动作（按杠杆排序，优先「强制层」）："
  if [ ! -f "$META_YAML" ]; then
    echo "  - 无 .meta/meta.yaml → 跑 'ponygo init' 或手工建 level: 0"
  fi
  local lv="$(read_level)"
  if [ -d "$DECISIONS_DIR" ] && [ "${n_dec:-0}" -eq 0 ]; then
    echo "  - notes/ 无任何决策 → 写第一篇 ADR，落 proposed/ 或 implemented/"
  fi
  if [ -z "${hook_path:-}" ] && [ ! -f .githooks/pre-commit ]; then
    echo "  - 无本地钩子（core.hooksPath 未设）→ 这是「强制层」缺口，优先补（放大器）"
  fi
  echo ""
  echo "提示：程序只判「有无/对不对」，不判「值不值」——是否值得建某机制，靠 review（P6）。"
  echo ""
  echo "替代物认可：若你用非 ponygo 形态达成同等效果（如 CONTRIBUTING.md + CODEOWNERS + CI，"
  echo "或 docs/adr 而非 .agents/notes），本命令只做机械形状探测、不裁决价值——请按"
  echo "checklists/audit.md「已认可替代物」条款自评为命中，勿把形状分当价值分。"
  if [ "$comp" -ge 1 ]; then
    echo ""
    echo "合规免责：检测到合规/追溯痕迹（compliance/traceability）。ponygo 是工程化治理脚手架，"
    echo "爬满 L5 不构成任何监管合规背书（FDA、ISO 13485/26262、SOC2、PIPL 等），"
    echo "不替代贵组织的质控与审计流程——合规评判请交由合规流程（P6）。"
  fi
  # ---- 治理门接线现场（ADR 门本地层 + 远端层按 forge 证据报告；报告性，非硬判据） ----
  echo ""
  echo "===== 治理门接线（交付即接线） ====="
  gate_wiring_report
  # ---- 门禁分层报告（P7 时间经济性；报告性，非硬判据） ----
  gate_layers_report
  # ---- 负样本自检（opt-in：--run-specs；默认不执行仓库脚本，见 run_gate_specs 头注）----
  if [ "$RUN_SPECS" = "1" ]; then
    echo ""
    echo "===== 2.3 执行判据（--run-specs，opt-in） ====="
    if [ "$DRY_RUN" = "1" ]; then
      echo "  [skipped] --dry-run 下不执行任何仓库脚本——SKIPPED 不计入 PASS"
    else
      run_gate_specs; spec_rc=$?
      # 0 = 全过；2 = SKIPPED（不计入 PASS，也不判 FAIL）；其余（含 1 与意外码）= 拒绝
      case "$spec_rc" in
        0) ;;
        2) SPEC_SKIPPED=1
           echo "  注：执行判据 SKIPPED——**不计入 PASS**（本次未验证门是否仍会拒绝非法样本）。" ;;
        *) exit 1 ;;
      esac
    fi
  fi
  # ---- 级自洽验证（EXTERNAL-001 P1-1：audit 不再把判据推给 status，直接内嵌）----
  # 有治理根且声明了 level 时，audit 顺手验级：判据不符 → 列 FAIL 项并 exit 1
  # （机器可查缺口 = 非零退出；audit 的"打分"语义不变，只是不再漏掉判据级结论）。
  if [ -f "$META_YAML" ]; then
    echo ""
    if ! verify_ladder "$(read_level)"; then
      exit 1
    fi
  else
    echo ""
    echo "级自洽验证：跳过（无 .meta/meta.yaml——先 'ponygo init'）。"
  fi
}

cmd_status() {
  local lv
  lv=$(read_level)
  echo "===== ponygo status ====="
  echo "治理级：$(fmt_level "$lv")"
  warn_meta_violations
  warn_governance_hygiene
  echo ""
  echo "骨架完整度："
  local missing=0
  for d in "$META_DIR" "$META_DIR/constitution" "$META_DIR/gates" "$META_DIR/docs-tier" "$AGENTS_RUNTIME_DIR" "$DECISIONS_DIR" "$SKILLS_DIR"; do
    if [ -d "$d" ]; then printf '  [ok]  %s\n' "$d"; else printf '  [缺]  %s\n' "$d"; missing=$((missing+1)); fi
  done
  [ -f "$META_YAML" ] && printf '  [ok]  %s\n' "$META_YAML" || { printf '  [缺]  %s\n' "$META_YAML"; missing=$((missing+1)); }

  local n_dec=0
  n_dec=$(count_decisions)
  printf '  决策数：%s\n' "$n_dec"
  echo ""
  # 治理门接线现场（本地层 2.4 同口径 + 远端层按 forge 证据报告，§6.3）——报告性，不改退出码
  gate_wiring_report
  echo ""
  if [ "$missing" -gt 0 ]; then
    echo "下一步（去下一级 / 补缺口）："
    [ ! -f "$META_YAML" ] && echo "  - 补 $META_YAML（level: 0）"
    echo "  骨架不完整，exit 1（机器可查的缺口 = 非零退出）。"
    exit 1
  else
    echo "骨架完整。"
    # 级自洽验证：失败项输出取代"去下一级"建议文本（不叠床架屋）
    if ! verify_ladder "$lv"; then exit 1; fi
    case "$lv" in
      0|1) echo "去 L$((lv+1))：见 maturity-ladder.md（仓库根）对应级退出标准与布尔检查项。" ;;
      2)   echo "已达机械判定的上限。L3+ 为「靠 review」的目标画像，按需选装。" ;;
      *)   echo "已声明 $(fmt_level "$lv")，但 L3-L5 属目标画像：请对照 maturity-ladder.md §2 的依赖清单自证，否则视为散文（P6 诚实条款）。" ;;
    esac
  fi
}

# ---------- upgrade 漂移报告（v2.4：Q2=A） ----------
# 比对宇宙 = s14 的 10 个文件精确路径（详见 tests/run.sh s14/s31），不另立清单文件（第三副本，slop 第一条）。
# 语义：漂移是**观察**不是承诺（status 管骨架缺口 exit 1，upgrade 管"与模板差多少"）；默认 exit 0，
# --check 漂移非零供 CI。宇宙外文件（根 README / meta.yaml / 已填 constitution / 根 AGENTS.md /
# CLAUDE.md / classes.local / docs-tier/exemptions 等）不判漂移——"无基线"不判定，报告头一句话声明盲区。
# 已激活 docs-tier 实例**不支持**漂移报告（s14 契约锁模板态，激活即破 s14——不发明新激活机制）。
# 教训归因（假漂移历史）真源：TASK-002 双审，见 docs/dev-team/reviews/——不塞进用户可见输出。
# 门禁资产只登记**不可变**的 A1/A2/A4（§6.3/R8）：A3（.githooks/pre-commit）与 A5（workflow）
# 是实例可编辑文件（有人会追加自己的钩子逻辑、改 CI 触发），进表 = 三仓永久 drift 红。
UPGRADE_UNIVERSE=".agents/notes/README.md .agents/skills/README.md .meta/docs-tier/README.md \
.agents/skills/write-adr/SKILL.md .agents/skills/write-adr/verify-note.sh \
.agents/skills/governance-review/SKILL.md .meta/gates/README.md \
.agents/skills/change-review/SKILL.md .agents/notes/AGENTS.md .agents/notes/archived/AGENTS.md \
.meta/gates/adr-verify.sh .meta/gates/adr-verify.spec.sh .meta/gates/ci-verify.sh"

cmd_upgrade() {
  echo "===== ponygo upgrade ====="
  # 升级纪律最先打印（任何分支都可见；s15 空目录用例断言其存在）
  echo "升级纪律（首版不实际执行 diff 合并，那是 v+2 能力）："
  echo "  1) 实例化禁止 cp -r / degit 抹历史——保留 fork 图方可跟随升级。"
  echo "  2) 保留血缘：git remote add upstream <ponygo 模板> && git fetch upstream && git merge upstream/main"
  echo "  3) 已失去血缘（cp 产生）→ 升级退化为人肉对照，漂移自担（诚实声明，勿假装可自动升级）。"
  # donot：无 .meta/ → die 并指引 init（对齐 retire/status）。真·空目录（s15 历史 fixture，仅 .git 也算空）
  # 温和跳过，有实质内容的目录（s31③ fixture：有 README 或任何文件）die——两种 fixture 语义不同（spec §8 s31③ / D2 修法）。
  if ! has_meta; then
    if [ -z "$(ls -A . 2>/dev/null | grep -v '^\.git$')" ]; then
      echo "无 .meta/ 治理根（空目录）——无可漂移基线。先 'ponygo init' 播种，再看本报告。"
      echo "tmpdir 已清理"
      return 0
    fi
    die "无 .meta/ 治理根（meta.yaml 缺失）——先 'ponygo init' 再跟随升级"
  fi
  # donot：非 git → WARN（对齐 status；漂移参照 git 血缘时不可用，退化为纯文件比对）
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'ponygo: WARN 不在 git 仓库内——无法从 git 派生版本/血缘，漂移报告退化为纯文件比对（对齐 status 的 WARN）\n' >&2
  fi
  # donot：无 level → 按 L0 处理（read_level 三态之"缺文件/缺 level 行"；空值/畸形仍走 0.4 FAIL 语义，不走 L0）
  local lv=""
  lv=$(read_level)
  case "$lv" in
    ''|*[!0-9]*) echo "当前 level：缺失/非法（按 L0 处理漂移基线；level 合法性请交给 'ponygo status' 的 0.4 判据）" ;;
    *)            echo "当前 level：$(fmt_level "$lv")" ;;
  esac
  # 报告头：盲区声明（升级纪律已在函数头打印）
  echo "漂移报告：本报告只覆盖 s14 宇宙内十三文件（十文件骨架 + 门禁资产 A1/A2/A4）；宇宙外文件无基线，不判定。漂移=观察，非承诺违例（status 管承诺）。"
  # 已激活 docs-tier 实例：诚实声明不支持（s14 契约锁模板态）——本文件不参与比对，
  # 其余九文件照常比对（P2-1：激活必改写该文件，比对即恒漂移、--check 恒红，违反"漂移=观察"与"不支持"双重语义）
  local dt_skip=0
  if [ -f "$META_DIR/docs-tier/README.md" ] && grep -q '## 已激活文档家清单' "$META_DIR/docs-tier/README.md"; then
    dt_skip=1
    echo "注：docs-tier 已激活实例——.meta/docs-tier/README.md 不参与漂移比对（s14 契约锁模板态，激活即破 s14，按 P0-1(a) 诚实声明不支持）；其余九文件照常比对。"
  fi
  # 生成模板基准（临时目录，用 write_skeleton 同源 heredoc；eol 归一后逐字节比对）。
  # write_skeleton 是当前进程内的函数（相对路径常量），在子 shell cd 后调用即生成一套模板骨架。
  local tmp="" f="" drift_n=0 missing_n=0
  tmp=$(mktemp -d) || die "无法创建临时目录"
  trap 'rm -rf "${tmp:-}" 2>/dev/null || true; trap - EXIT INT TERM' EXIT INT TERM
  ( cd "$tmp" && write_skeleton 0 ) >/dev/null 2>&1 || { rm -rf "$tmp"; trap - EXIT INT TERM; die "无法生成模板基准"; }
  for f in $UPGRADE_UNIVERSE; do
    # P2-1：docs-tier 已激活实例跳过该文件比对（s14 锁模板态）
    [ "$dt_skip" = "1" ] && [ "$f" = ".meta/docs-tier/README.md" ] && continue
    if [ ! -f "$f" ]; then
      # 缺骨架文件（实例侧缺失）：gates/README 是"仅空目录时生成"的条件写入口——
      # gates 目录已有实质门禁时缺 README 报"缺口"（缺骨架文件）而非"漂移"（D2 边界）
      missing_n=$((missing_n+1))
      if [ "$f" = ".meta/gates/README.md" ] && [ -d "$META_DIR/gates" ] \
         && [ -n "$(ls -A "$META_DIR/gates" 2>/dev/null | grep -vE '^(README\.md|\.gitkeep)$')" ]; then
        echo "缺口: $f（gates/ 已有实质门禁但缺 README——补 'ponygo init' 生成或手建）"
      else
        echo "缺口: $f（缺骨架文件——跑 'ponygo init' 补全后再跟随升级）"
      fi
      continue
    fi
    # P3-1：模板侧缺失 = 清单与 write_skeleton 生成集漂移（内部不一致），报内部错误而非误归 drift
    if [ ! -f "$tmp/$f" ]; then
      missing_n=$((missing_n+1))
      echo "内部不一致: 模板基准缺 $f（UPGRADE_UNIVERSE 与 write_skeleton 生成集漂移——联系维护者对齐清单或生成逻辑）"
      continue
    fi
    if ! diff -q <(tr -d '\r' < "$f") <(tr -d '\r' < "$tmp/$f") >/dev/null 2>&1; then
      drift_n=$((drift_n+1))
      echo "drift: $f"
    fi
  done
  rm -rf "$tmp"
  trap - EXIT INT TERM
  if [ "$drift_n" -eq 0 ] && [ "$missing_n" -eq 0 ]; then
    echo "宇宙内十三文件与模板基准一致，零漂移。"
  else
    echo "发现 $drift_n 处漂移 + $missing_n 处缺口（drift:/缺口: 前缀行）——离线源是模板基准，逐条合入或按升级纪律重建血缘。"
  fi
  echo "tmpdir 已清理"
  # exit 语义：默认报告 exit 0（漂移是观察）；--check 漂移**或缺口**非零（供 CI——删骨架文件比内容漂移更严重，CI 应拦住）
  if [ "${UPGRADE_CHECK:-0}" = "1" ]; then
    [ "$drift_n" -eq 0 ] && [ "$missing_n" -eq 0 ] || exit 1
  fi
  return 0
}

# ---------- 退级（停止线执行器） ----------
cmd_retire() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo "用法：ponygo retire --level <N|off>   （注意 off 必须挂在 --level 后：ponygo retire --level off）"
    echo "  N     把 meta.yaml 的 level 改写为目标档（降级，如 2 → 1），并提示移除超档机制"
    echo "  off   整体退场：ai-surface 置 off（不再生成 AI 投影）+ level 归 0（纯 L0 长驻模式）"
    echo "说明：删除是独立工程（P9）——退级须录一条 decision 到 .agents/notes/。"
    return 0
  fi
  has_meta || die "无 .meta/ 治理根（meta.yaml 缺失）——先 'ponygo init' 再退级"
  [ -f "$META_YAML" ] || die "$META_YAML 缺失或不是常规文件——先 'ponygo init' 再退级"
  case "$target" in
    off)
      confirm_or_skip "把 ai-surface 置 off 且 level 归 0（整体退场到纯 L0 长驻模式）" || return 0
      sed -i 's/^level:.*/level: 0/' "$META_YAML"
      grep -qE '^ai-surface:' "$META_YAML" || printf 'ai-surface: off\n' >> "$META_YAML"
      sed -i 's/^ai-surface:.*/ai-surface: off/' "$META_YAML"
      info "已整体退场：level 0 + ai-surface off。勿忘录一条退级 decision。"
      ;;
    [0-5])
      confirm_or_skip "把 level 降级到 $target（并提示移除超档机制）" || return 0
      sed -i "s/^level:.*/level: $target/" "$META_YAML"
      # 联动：降到 L0 时应清掉 ai-surface 悬挂（否则 sync 仍会生成投影，与退场语义冲突）
      if [ "$target" = "0" ] && grep -qE '^ai-surface:[[:space:]]*on' "$META_YAML"; then
        info "已降级到 L0，检测到 ai-surface: on —— 若要纯 L0 长驻，请改 'ponygo retire --level off'。"
      fi
      info "level 已降到 $target。超档机制（gates/skills/docs-tier）请按 P9 连根拔并录 decision。"
      ;;
    *) die "retire 目标非法：$target（用 0-5 或 off）" ;;
  esac
}

# ---------- observe（可观测性治理维度） ----------
# W0 契约冻结：此处只暴露**命令面与退出码骨架**，不含任何判定逻辑。
# ob0/ob1/ob2 的判据实现（声明存在/无占位/check-declaration rc 白名单/audit-diff 收口）
# 属 Executor task-3；--json 词表、init 声明模板、upgrade 版本比较同属 task-3。
# EXEC: 完整校验与 --mapping 覆盖见 task-3

# ---------- observe 辅助函数（映射/版本/技能目录/超时/probe） ----------
# PONYGO_SELF：单文件自路径（映射数据块与脚本同文件；取数不依赖调用时 CWD）。
PONYGO_SELF=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/$(basename "${BASH_SOURCE[0]:-$0}")

# 映射文件：--mapping 值 > env PONYGO_OBSERVE_MAPPING > 嵌入数据块（=脚本自身）
observe_mapping_file() {
  if [ -n "${OBSERVE_MAPPING_FILE:-}" ]; then printf '%s\n' "$OBSERVE_MAPPING_FILE"; return 0; fi
  if [ -n "${PONYGO_OBSERVE_MAPPING:-}" ]; then printf '%s\n' "${PONYGO_OBSERVE_MAPPING}"; return 0; fi
  printf '%s\n' "$PONYGO_SELF"
}

# 数据块 fail-closed 校验：必需键各恰好一行且取值非空；mapping_version 必须为 1。
# 首次调用一次即可（OBS_MAP_VERIFIED 防重复）。
observe_require_keys() {
  [ "${OBS_MAP_VERIFIED:-0}" = "1" ] && return 0
  local f k n mv keys bad
  f=$(observe_mapping_file)
  if [ ! -f "$f" ]; then
    printf 'ponygo: 映射文件不存在：%s\n' "$f" >&2
    printf '  排查：改用 --mapping <file> 或 env PONYGO_OBSERVE_MAPPING=<file>\n' >&2
    exit 2
  fi
  keys="mapping_version ob_levels ob_level0_name ob_level1_name ob_level2_name
ob_advisory_name target_level_0 target_level_1 target_level_2 target_level_3
target_level_4 target_level_5 kind_enum contract_version_min declaration_paths
placeholder_token mount_carriers skill_dir_rel external_timeout_seconds
local_timeout_seconds"
  bad=""
  for k in $keys; do
    n=$(grep -E "^${k}:[[:space:]]*[^[:space:]]" "$f" | wc -l)
    n=${n//[!0-9]/}
    if [ "$n" != "1" ]; then
      bad="$bad$k(命中${n:-0}次) "
    fi
  done
  if [ -n "$bad" ]; then
    printf 'ponygo: 映射数据块键异常：\n' >&2
    for k in $bad; do
      printf '  - %s\n' "$k" >&2
    done
    printf '  期望每键恰好一行且取值非空；排查：grep -n "^<key>:" %s\n' "$f" >&2
    exit 2
  fi
  # CRLF 归一改用 bash 参数展开而非 `tr`（CT-10 同源）：tr 缺失/被替换时管道输出为空，
  # 会让版本解析误判「mapping_version 不支持（空）」而 exit 2，把工具缺失伪装成数据块损坏。
  mv=$(sed -n 's/^mapping_version:[[:space:]]*//p' "$f" | head -n1)
  mv=${mv%$'\r'}
  if [ "$mv" != "1" ]; then
    printf 'ponygo: 映射数据块版本不支持：%s（本版本只认 mapping_version: 1）\n' "${mv:-（空）}" >&2
    exit 2
  fi
  OBS_MAP_VERIFIED=1
}

# 取值：键白名单 + 缺失 fail-closed（sed 首命中即停，不依赖管道求首行）
observe_map_get() {
  local key f v
  key=${1:-}
  case "$key" in ''|*[!a-z0-9_]*) die "映射键非法：${key:-（空）}" ;; esac
  observe_require_keys
  f=$(observe_mapping_file)
  v=$(sed -n "/^${key}:[[:space:]]*/{s/^${key}:[[:space:]]*//;s/\r\$//;p;q;}" "$f")
  if [ -z "$v" ]; then
    printf 'ponygo: 映射键缺失：%s\n' "$key" >&2
    printf '  排查：grep -n "^%s:" %s\n' "$key" "$f" >&2
    exit 2
  fi
  printf '%s\n' "$v"
}

# $1 >= $2 → 0（按 . 拆三段整数；缺段按 0；非数字按 0）
observe_version_ge() {
  local v1 v2 i a b
  local -a s1 s2
  v1=${1:-}; v2=${2:-}; s1=(); s2=()
  while [ -n "$v1" ]; do
    s1+=("${v1%%.*}")
    case "$v1" in *.*) v1=${v1#*.} ;; *) v1="" ;; esac
  done
  while [ -n "$v2" ]; do
    s2+=("${v2%%.*}")
    case "$v2" in *.*) v2=${v2#*.} ;; *) v2="" ;; esac
  done
  for i in 0 1 2; do
    a=${s1[$i]:-0}; b=${s2[$i]:-0}
    case "$a" in ''|*[!0-9]*) a=0 ;; esac
    case "$b" in ''|*[!0-9]*) b=0 ;; esac
    a=$((10#$a)); b=$((10#$b))
    [ "$a" -gt "$b" ] && return 0
    [ "$a" -lt "$b" ] && return 1
  done
  return 0
}

# contract_version 进 JSON 前净化（F7）：只认 ^[0-9]+\.[0-9]+\.[0-9]+$，其余一律 unknown
# （版本源是 skill 侧文件，可能含引号/反斜杠——不净化会直接产出非法 JSON）
observe_version_json() {
  local v=${1:-}
  if printf '%s' "$v" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    printf '%s' "$v"
  else
    printf 'unknown'
  fi
}

# skill 目录：--skill-dir > ${PONYGO_SKILL_DIR} > $HOME/<skill_dir_rel>（不校验存在性）
observe_skill_dir_soft() {
  if [ -n "${OBSERVE_SKILL_DIR:-}" ]; then printf '%s\n' "$OBSERVE_SKILL_DIR"; return 0; fi
  if [ -n "${PONYGO_SKILL_DIR:-}" ]; then printf '%s\n' "${PONYGO_SKILL_DIR}"; return 0; fi
  printf '%s/%s\n' "${HOME:-}" "$(observe_map_get skill_dir_rel)"
}

# $1=dir → 打印 references/contract.json 的 contract_version；取不到打印空
observe_skill_version() {
  local d f
  d=${1:-}
  if [ -z "$d" ]; then printf '\n'; return 0; fi
  f="$d/references/contract.json"
  if [ ! -f "$f" ]; then printf '\n'; return 0; fi
  sed -n 's/.*"contract_version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n1 | tr -d '\r'
}

# audit/upgrade 前置：skill 目录或 contract.json 缺失 → exit 2（附安装提示）
observe_skill_require() {
  local d c why
  d=$(observe_skill_dir_soft)
  c="$d/references/contract.json"
  if [ -d "$d" ] && [ -f "$c" ]; then return 0; fi
  if [ -d "$d" ]; then why="缺 references/contract.json"; else why="目录不存在"; fi
  printf 'ponygo: 技能目录不可用：%s（%s）\n' "$d" "$why" >&2
  printf '  安装：从所属 skill 仓把 observability-onboarding 安装到 ~/.agents/skills/observability-onboarding\n' >&2
  printf '  或：ponygo observe <status|audit|upgrade> --skill-dir <dir>（等价 env PONYGO_SKILL_DIR=<dir>）\n' >&2
  exit 2
}

# `timeout` 语义探针（惰性一次；OBS_TIMEOUT_OK=1/0）
# 不可用时一次性 WARN（F4）：外部命令（skill 脚本）将无超时保护，不得静默降级
observe_timeout_ok() {
  if [ -z "${OBS_TIMEOUT_OK:-}" ]; then
    if timeout 1 bash -c 'exit 0' >/dev/null 2>&1; then OBS_TIMEOUT_OK=1; else OBS_TIMEOUT_OK=0; fi
  fi
  if [ "$OBS_TIMEOUT_OK" != "1" ] && [ "${OBS_TIMEOUT_WARNED:-0}" != "1" ]; then
    OBS_TIMEOUT_WARNED=1
    printf 'ponygo: WARN 未找到可用的 timeout，外部命令无超时保护（评审建议：安装 coreutils timeout）\n' >&2
  fi
  [ "$OBS_TIMEOUT_OK" = "1" ]
}

# 超时秒数判据（CT-6，**locale 无关**）：只接受纯 ASCII 十进制数字，且长度 ≤ 6 位。
# 为什么不只靠 `case "$v" in *[!0-9]*)`：UTF-8 locale 下该字符类对**全角数字**（如 ６０）不命中，
# 值会原样透传给 `timeout ６０` → GNU timeout 报 `invalid time interval`、rc=125 → 落回 rc 白名单外
# ⇒ gaps=tool_error ⇒ 假红复活（正是本修复要消灭的形态）。故改用 LC_ALL=C 的 tr 在**字节层**剔除
# ASCII 0-9 后判残渣，与 locale 无关。
# 长度上限同理：GNU timeout 接受 20 位天文数字（rc=0）等于「永不超时」，会破坏 fail-closed 语义。
# CT-10：判据自身也必须 fail-closed——`tr` 缺失/被替换而失败时输出为空，若只看输出就会把**任意值**
# 判成「纯数字」并放行（于是又回到 `timeout abc` → invalid interval → 假红）。故把 tr 的退出码纳入
# 判据：非零即判非法。
observe_timeout_num_ok() {
  local v=${1:-} rest
  [ -n "$v" ] || return 1
  [ "${#v}" -le 6 ] || return 1
  rest=$(printf '%s' "$v" | LC_ALL=C tr -d '0-9') || return 1
  [ -z "$rest" ] || return 1
  return 0
}

# audit-diff 独立超时预算（CT-1/CT-2）：
#   * 取数 = data 块 diff_timeout_seconds（缺省 60 秒）。**不复用** local_timeout_seconds——
#     后者是本地快命令预算（3s），而 audit-diff 要扫描整仓变更（实测大仓 12.1s / 637 文件），
#     3s 会稳定把进程打死成 rc=124，真违规与工具超时因此不可辨（假红淹没真红）。
#   * 覆盖 = env PONYGO_OBS_DIFF_TIMEOUT（正整数）优先。非法值（空/0/负数/非数字/非整数/全角数字/
#     超长数字）一律**忽略并告警**，绝不静默接受——预算漂移必须留痕（0 在 GNU timeout 下等于
#     「不限时」，会把 fail-closed 变成挂死，故 0 与 00 同样判非法）。
#   * $1 = data 块原值（可空：旧 --mapping 覆盖文件没有该键，按可选键软读处理）。
observe_diff_timeout() {
  local base raw bad orig cleaned
  orig=${1:-}
  base=$orig
  # 值清洗与 observe_audit 里 kind 的取数同口径：去行内注释、去首尾空白、去成对引号。
  base=${base%%[[:space:]]#*}
  base=${base#"${base%%[![:space:]]*}"}
  base=${base%"${base##*[![:space:]]}"}
  case "$base" in \"*\") base=${base#\"}; base=${base%\"} ;; esac
  case "$base" in \'*\') base=${base#\'}; base=${base%\'} ;; esac
  cleaned=$base
  bad=0
  if [ -n "$cleaned" ]; then
    observe_timeout_num_ok "$cleaned" || bad=1
    if [ "$bad" = "0" ]; then
      while [ "${base#0}" != "$base" ]; do base=${base#0}; done
      [ -n "$base" ] || bad=1      # 全 0（0/00/000…）：GNU timeout 0 = 不限时，等同 fail-open
    fi
  fi
  if [ "$bad" = "1" ]; then
    # 显式写了却清洗不出来：必须告警，否则与 env 路径「非法必告警」不对称，预算漂移无法追溯。
    printf 'ponygo: WARN 映射键 diff_timeout_seconds 取值非法（须为纯 ASCII 十进制正整数且 ≤6 位，实得 [%s]），已回退缺省 60 秒\n' \
      "$orig" >&2
    base=60
  elif [ -z "$cleaned" ]; then
    # 键缺失（旧 --mapping 覆盖文件没这一行）＝「未声明」，按缺省 60 处理；不算清洗失败，不告警。
    base=60
  fi
  raw=${PONYGO_OBS_DIFF_TIMEOUT:-}
  # 区分「未设置」与「显式设为空串」：后者是非法值（CT-2 明列），必须告警而不是静默沿用缺省。
  [ -n "${PONYGO_OBS_DIFF_TIMEOUT+set}" ] || { printf '%s\n' "$base"; return 0; }
  bad=0
  observe_timeout_num_ok "$raw" || bad=1
  if [ "$bad" = "0" ]; then
    while [ "${raw#0}" != "$raw" ]; do raw=${raw#0}; done
    [ -n "$raw" ] || bad=1         # 全 0：同上，timeout 0 等于不限时
  fi
  if [ "$bad" = "1" ]; then
    printf 'ponygo: WARN 环境变量 PONYGO_OBS_DIFF_TIMEOUT 取值非法（须为纯 ASCII 十进制正整数且 ≤6 位，实得 [%s]），已忽略，沿用 diff_timeout_seconds=%s 秒\n' \
      "${PONYGO_OBS_DIFF_TIMEOUT:-}" "$base" >&2
    printf '%s\n' "$base"
    return 0
  fi
  printf '%s\n' "$raw"
}

# $1=timeout_seconds $2=script 其余=args → 返回 skill 的 rc；skill 原始输出统一走 stderr
# 输出捕获用文件重定向（绝不用 $(...)）：skill 可能输出大/多行/含 NUL 前导空字节，
# 且 --json 时 stdout 必须干净。临时文件路径登记到全局 OBS_TMPFILE：EXIT/INT/TERM trap 兜底 rm
# （F3，防信号打断执行中的 skill 时残留）；正常返回前显式 rm 并置空。
# mktemp 失败 → return 240（哨兵：>=200 一律按「工具错误」，调用方不得读成 skill 的 rc=2）。
observe_run_skill() {
  local tmo script out rc
  tmo=${1:-0}; script=${2:-}
  if [ $# -ge 2 ]; then shift 2; else set --; fi
  out=$(mktemp "${TMPDIR:-/tmp}/ponygo-obs.XXXXXX") || {
    printf 'ponygo: 错误 无法创建临时文件（TMPDIR=%s），skill 输出无法捕获：%s\n' "${TMPDIR:-/tmp}" "$script" >&2
    printf '  排查：TMPDIR 是否可写 / 磁盘是否满；本项按工具错误处理（不是 skill 判定结论）\n' >&2
    return 240
  }
  OBS_TMPFILE=$out
  if observe_timeout_ok; then
    timeout "$tmo" bash "$script" "$@" >"$out" 2>&1; rc=$?
  else
    bash "$script" "$@" >"$out" 2>&1; rc=$?
  fi
  cat "$out" >&2
  rm -f "$out"
  OBS_TMPFILE=""
  return $rc
}

# 声明文件：data 块 declaration_paths 中第一个存在的；都没有 → 打印空
# 含 glob 元字符（* ? [）的项不参与匹配（F7）：先 set -f 关掉路径展开，再按字面路径逐项判存在，
# 否则 'docs/*.yaml' 这类项会被 shell 展开成真实文件、绕过「不参与匹配」。
observe_decl_path() {
  local p found="" glob_on=0
  case "$-" in *f*) : ;; *) set -f; glob_on=1 ;; esac
  for p in $(observe_map_get declaration_paths); do
    case "$p" in *'*'*|*'?'*|*'['*) continue ;; esac
    if [ -f "$p" ]; then found=$p; break; fi
  done
  [ "$glob_on" = "1" ] && set +f
  printf '%s\n' "$found"
}

# 软读映射键：键不存在时返回空串（**不** fail-closed）。只给**可选**键用（如 declaration_extra_dir），
# 避免「新增可选键」把旧的 --mapping 覆盖文件判成坏块。
observe_map_try() {
  local key f
  key=${1:-}
  case "$key" in ''|*[!a-z0-9_]*) return 0 ;; esac
  f=$(observe_mapping_file)
  sed -n "/^${key}:[[:space:]]*/{s/^${key}:[[:space:]]*//;s/\r\$//;p;q;}" "$f" 2>/dev/null
}

# 附加声明目录（同目录多声明，缺陷 E）：默认 docs/observability.d，可由映射键覆盖。
observe_decl_extra_dir() {
  local d
  d="$(observe_map_try declaration_extra_dir)"
  [ -n "$d" ] || d="docs/observability.d"
  printf '%s\n' "$d"
}

# 附加声明清单（排序；不含主声明）。同目录多形态靠它表达：kind 是单值，
# 一份 docs/observability.yaml 无法同时是 k8s-service 和 pipeline。
observe_decl_extra_list() {
  local d
  d="$(observe_decl_extra_dir)"
  [ -d "$d" ] || return 0
  find "$d" -maxdepth 1 -type f \( -name '*.yaml' -o -name '*.yml' \) 2>/dev/null | LC_ALL=C sort
}

# YAML 单引号标量（F1）：值内单引号写成两个；只用于已过 observe_scalar_check 的值
observe_yaml_sq() {
  local v=${1:-}
  printf "'%s'" "${v//\'/\'\'}"
}

# 挂载载体命中判定（缺陷 F：ob2 的 mount 判据曾纯文本 grep，注释里写 audit-diff 就 PASS）。
# 规则：必须有**非注释行**引用 audit-diff。注释前缀覆盖 shell/yaml/py(#)、js/ts(//、/*、*)、md/html(<!--)。
# 局限（如实标注）：这仍是文本判据，不解析 AST，也不验证「该钩子真的会执行」；真执行证据是
# `ponygo observe audit --level ob2` 里 audit-diff 本身的 rc（K7）。
observe_mount_hit() {
  local target=${1:-} hits
  [ -n "$target" ] && [ -e "$target" ] || return 1
  if [ -d "$target" ]; then
    hits=$(grep -rIn --binary-files=without-match -F 'audit-diff' "$target" 2>/dev/null || true)
  else
    hits=$(grep -In --binary-files=without-match -F 'audit-diff' "$target" 2>/dev/null || true)
  fi
  [ -n "$hits" ] || return 1
  printf '%s\n' "$hits" | grep -qvE ':[0-9]+:[[:space:]]*(#|//|/\*|\*|<!--)'
}

# anchor/reason 值的 YAML 标量校验（F1，防 YAML 注入）：$1=值 $2=旗标名
# 空值=未提供（调用方自行处理）；非法 → exit 2（写盘前拦截，绝不写出重复键/非法 YAML/null）
observe_scalar_check() {
  local v flag
  v=${1:-}; flag=${2:-值}
  [ -z "$v" ] && return 0
  case "$v" in
    *[[:cntrl:]]*)
      printf 'ponygo: observe init：%s 含换行/回车/制表符/控制字符，拒绝写入（YAML 标量注入风险）\n' "$flag" >&2
      printf '  改为单行文本；需要多行说明请写进声明文件后手改（init 只写单行标量）\n' >&2
      exit 2 ;;
  esac
  case "$v" in
    '#'*|'&'*|'*'*|'!'*|'|'*|'>'*|'{'*|'['*|'-'*|'?'*|':'*)
      printf 'ponygo: observe init：%s 以 YAML 指示符开头（# & * ! | > { [ - ? :），拒绝写入\n' "$flag" >&2
      exit 2 ;;
  esac
  case "$v" in
    *': '*)
      printf 'ponygo: observe init：%s 含 ": "（会被读成第二个键），拒绝写入：%s\n' "$flag" "$v" >&2
      exit 2 ;;
  esac
  case "$v" in
    *' #'*)
      printf 'ponygo: observe init：%s 含 " #"（YAML 注释起始，值会被截断/成 null），拒绝写入：%s\n' "$flag" "$v" >&2
      exit 2 ;;
  esac
  if [ "${#v}" -gt 500 ]; then
    printf 'ponygo: observe init：%s 长度 %s 超过 500，拒绝写入\n' "$flag" "${#v}" >&2
    exit 2
  fi
  return 0
}

# 目标级：.meta/meta.yaml 的 level 经 target_level_<N> 映射；空/非数字/越界 → 0
observe_target_level() {
  local lv target
  lv=$(read_level)
  case "$lv" in ''|*[!0-9]*) lv=0 ;; esac
  case "$lv" in 0|1|2|3|4|5) : ;; *) printf 'ob0\n'; return 0 ;; esac
  target=$(observe_map_get "target_level_$lv")
  if [ -z "$target" ]; then target=ob0; fi
  printf '%s\n' "$target"
}

# 级别序：ob0<ob1<ob2；未知 → -1
observe_rank() { case "${1:-}" in ob0) echo 0 ;; ob1) echo 1 ;; ob2) echo 2 ;; *) echo -1 ;; esac; }

# 只读静态报告：不调用任何 skill 脚本、不写盘、rc 恒 0（映射数据坏 → 2，由 observe_map_get 抛出）
observe_status() {
  local decl present ph skill_dir ver min target compat kind raw gaps sep sp
  observe_require_keys
  decl=$(observe_decl_path)
  present=false
  if [ -n "$decl" ]; then present=true; fi

  # 占位符：非注释行命中即"有占位"（注释行不算，模板注释可能自带示例 token）
  ph=false
  if [ "$present" = "true" ]; then
    if grep -v '^[[:space:]]*#' "$decl" | grep -q -F "$(observe_map_get placeholder_token)"; then
      ph=true
    fi
  fi

  skill_dir=$(observe_skill_dir_soft)
  ver=$(observe_skill_version "$skill_dir")
  min=$(observe_map_get contract_version_min)
  compat=false
  if [ -n "$ver" ] && observe_version_ge "$ver" "$min"; then compat=true; fi
  target=$(observe_target_level)

  # 声明 kind：净化后仅当匹配 ^[a-z0-9-]+$ 且 ∈ kind_enum 才回显，否则 unknown
  kind=unknown
  if [ -n "$decl" ]; then
    raw=$(sed -n 's/^[[:space:]]*kind:[[:space:]]*//p' "$decl" | head -n1 | tr -d '\r')
    raw=${raw%%[[:space:]]#*}                       # 去行内注释
    while :; do case "$raw" in *[[:space:]]) raw=${raw%?} ;; *) break ;; esac; done
    case "$raw" in \"*\") raw=${raw#\"}; raw=${raw%\"} ;; esac
    case "$raw" in \'*\') raw=${raw#\'}; raw=${raw%\'} ;; esac
    case "$raw" in
      ''|*[!a-z0-9-]*) : ;;
      *) case " $(observe_map_get kind_enum) " in *" $raw "*) kind=$raw ;; esac ;;
    esac
  fi

  # Monorepo 多组件感知（方案 A）：探测当前目录一级子目录中是否存在独立前端工程且未声明
  local unmanaged_sub="" unmanaged_found=0
  local sub cand
  for cand in front_end frontend web client ui app; do
    if [ -d "$cand" ] && [ -f "$cand/package.json" ]; then
      if [ ! -f "$cand/docs/observability.yaml" ] && [ ! -f "$cand/docs/observability.yml" ]; then
        unmanaged_sub="${unmanaged_sub}  - [ ] ${cand}/：Web 前端未接入，请进入该目录执行 ponygo observe init --kind frontend\n"
        unmanaged_found=1
      fi
    fi
  done

  # gaps：本命令产 declaration_missing / placeholder_present / unmanaged_subcomponents
  gaps=""; sep=""
  if [ "$present" != "true" ]; then gaps="\"declaration_missing\""; sep=","; fi
  if [ "$ph" = "true" ]; then gaps="${gaps}${sep}\"placeholder_present\""; sep=","; fi
  if [ "$unmanaged_found" = "1" ]; then gaps="${gaps}${sep}\"unmanaged_subcomponents\""; fi

  if [ "${OBSERVE_JSON:-0}" = "1" ]; then
    sp=false
    if [ -n "$skill_dir" ] && [ -f "$skill_dir/references/contract.json" ]; then sp=true; fi
    local jp jph jc vj
    if [ "$present" = "true" ]; then jp=pass; else jp=fail; fi
    # 无声明 ⇒ 占位符无从判 → skip（与 audit 一致；旧行为误报 pass，ADVISORY-1）
    if [ "$present" = "true" ]; then
      if [ "$ph" = "true" ]; then jph=fail; else jph=pass; fi
    else
      jph=skip
    fi
    if [ "$compat" = "true" ]; then jc=true; else jc=false; fi
    vj=$(observe_version_json "$ver")
    printf '{"schema":"ponygo.observe/1","command":"status","declared_kind":"%s","current":"unknown","target":"%s","skill":{"present":%s,"contract_version":"%s","compatible":%s},"judges":[{"id":"declaration_present","status":"%s"},{"id":"no_placeholder","status":"%s"},{"id":"declaration_consistent","status":"skip"},{"id":"enforcement_mounted","status":"skip"}],"gaps":[%s]}\n' \
      "$kind" "$target" "$sp" "$vj" "$jc" "$jp" "$jph" "$gaps"
    exit 0
  fi

  echo "===== ponygo observe status ====="
  if [ "$unmanaged_found" = "1" ]; then
    printf '[WARN] 发现未纳管的 Monorepo 子组件（存在独立前端工程但未声明）\n'
  fi
  if [ "$present" = "true" ]; then printf '声明: %s\n' "$decl"; else printf '声明: 缺失\n'; fi
  if [ "$ph" = "true" ]; then printf '占位符: 有\n'; else printf '占位符: 无\n'; fi
  if [ "$present" = "true" ]; then
    if grep -q '^[[:space:]]*enforcement_points:' "$decl" 2>/dev/null; then
      printf '收口点: 已配置\n'
      # 提取 enforcement_points 下一级规则及 path
      awk '
        /^[[:space:]]*enforcement_points:[[:space:]]*$/ { in_ep=1; next }
        in_ep && /^[[:alnum:]_]/ { in_ep=0 }
        in_ep && /^[[:space:]]{2}[[:alnum:]_]+:[[:space:]]*$/ {
          gsub(/^[[:space:]]+|:[[:space:]]*$/, "", $0)
          rule=$0; next
        }
        in_ep && rule != "" && /^[[:space:]]{4}path:[[:space:]]*/ {
          val=$0; sub(/^[[:space:]]*path:[[:space:]]*/, "", val)
          gsub(/["'\''\r]/, "", val)
          printf "  - %s -> %s\n", rule, val
          rule=""
        }
      ' "$decl" 2>/dev/null || true
    else
      printf '收口点: 未配置（enforcement_points 缺失，ob2 变更门禁将空转）\n'
      printf '  推荐收口项：http_client（统一网络出口）/ error_boundary（全局异常）/ error_classifier（错误分类）\n'
    fi
  fi
  if [ "$compat" = "true" ]; then
    printf 'skill: %s（contract_version=%s，兼容=yes）\n' "$skill_dir" "$ver"
  else
    printf 'skill: %s（contract_version=%s，兼容=no）\n' "$skill_dir" "${ver:-unknown}"
  fi
  printf '目标级: %s\n' "$target"
  local _extras _ext_n=0
  _extras="$(observe_decl_extra_list)"
  if [ -n "$_extras" ]; then
    _ext_n=$(printf '%s\n' "$_extras" | grep -c . )
    printf '附加声明: %s 份（%s，同目录多形态；本命令只判主声明，audit 会逐份巡检）\n' \
      "$_ext_n" "$(observe_decl_extra_dir)"
  fi
  printf "判定项：需 'ponygo observe audit'（本命令不执行 skill 脚本）\n"
  if [ "$present" != "true" ]; then
    local hint_kind=""
    if [ -f "src-tauri/tauri.conf.json" ] || [ -f "tauri.conf.json" ]; then
      hint_kind="desktop（检测到 Tauri 桌面端配置）"
    elif [ -f "package.json" ] && [ ! -f "go.mod" ] && [ ! -f "Cargo.toml" ]; then
      hint_kind="frontend（检测到 Web 前端配置）"
    elif [ -f "Cargo.toml" ] || [ -f "go.mod" ]; then
      hint_kind="k8s-service（检测到后端微服务工程）"
    elif [ -d ".github/workflows" ] || [ -f ".gitlab-ci.yml" ]; then
      hint_kind="pipeline（检测到 CI/CD 流水线配置）"
    fi
    if [ -n "$hint_kind" ]; then
      printf '建议形态: %s\n' "$hint_kind"
      printf '缺口: declaration_missing —— 未找到可观测性声明；下一步：ponygo observe init --kind <k>（参考上述建议形态）\n'
    else
      printf '缺口: declaration_missing —— 未找到可观测性声明；下一步：ponygo observe init --kind <k>\n'
    fi
  fi
  if [ "$ph" = "true" ]; then
    printf '缺口: placeholder_present —— 声明中占位符未替换；下一步：填实四维归属与落点\n'
  fi

  if [ -n "$unmanaged_sub" ]; then
    printf '未纳管子组件待办（Monorepo 架构治理）：\n'
    printf '%b' "$unmanaged_sub"
  fi

  # CI/CD 流水线工程资产感知：若当前工作区包含流水线且未声明为 pipeline，透出资产信息与治理建议
  if [ "$kind" != "pipeline" ]; then
    local pipe_info=""
    if [ -d ".github/workflows" ]; then
      local n_wf
      n_wf=$(find .github/workflows -maxdepth 1 -name '*.yml' -o -name '*.yaml' 2>/dev/null | wc -l | tr -d ' ')
      if [ "${n_wf:-0}" -gt 0 ]; then
        pipe_info="  - .github/workflows（检测到 ${n_wf} 个 Actions 工作流；治理建议：ponygo observe init --kind pipeline）\n"
      fi
    elif [ -f ".gitlab-ci.yml" ]; then
      pipe_info="  - .gitlab-ci.yml（检测到 GitLab CI 流水线；治理建议：ponygo observe init --kind pipeline）\n"
    fi
    if [ -n "$pipe_info" ]; then
      printf 'CI/CD 流水线工程资产：\n'
      printf '%b' "$pipe_info"
    fi
  fi

  exit 0
}

# observe init：落地四维归属声明（observe 唯一写命令；已存在声明需 --force；--dry-run 零落盘）
observe_init() {
  local kind svc decl target ph skill_rel date_s content dim_block dim d d0 anchor reason usable gaps
  local ph_hit cur tgt lv tmp dir skill_dir skill_ver min_ver
  observe_require_keys

  # 1) kind：必填且在枚举内（枚举来自映射数据块 kind_enum）
  kind=${OBS_KIND:-}
  if [ -z "$kind" ]; then
    printf 'ponygo: observe init：缺必填 --kind（枚举：%s）\n' "$(observe_map_get kind_enum)" >&2
    printf '  例：ponygo observe init --kind cli --dims metrics,logs\n' >&2
    exit 2
  fi
  case "$kind" in
    *[!a-z0-9-]*)
      printf 'ponygo: observe init：--kind 取值非法：%s（枚举：%s）\n' "$kind" "$(observe_map_get kind_enum)" >&2
      exit 2 ;;
  esac
  case " $(observe_map_get kind_enum) " in
    *" $kind "*) : ;;
    *)
      printf 'ponygo: observe init：--kind 不在枚举内：%s（枚举：%s）\n' "$kind" "$(observe_map_get kind_enum)" >&2
      exit 2 ;;
  esac

  # 2) service：--service 优先；否则 $PWD 基线名净化（保留 [A-Za-z0-9._-]，其余换 '-'）
  svc=${OBS_SERVICE:-}
  if [ -z "$svc" ]; then
    svc=$(basename "$PWD" 2>/dev/null)
    svc=$(printf '%s\n' "$svc" | sed 's/[^A-Za-z0-9._-]/-/g' | head -n1)
  fi
  if [ -z "$svc" ]; then
    printf 'ponygo: observe init：service 无法确定（--service 为空且 $PWD 基线名净化后为空）\n' >&2
    printf '  用：ponygo observe init --kind %s --service <name>\n' "$kind" >&2
    exit 2
  fi
  # --service 值只收 YAML 标量安全字符（防 'a: b' 之类注入出第二个键）
  case "$svc" in
    *[!A-Za-z0-9._-]*)
      printf 'ponygo: observe init：--service 取值非法：%s\n' "$svc" >&2
      printf '  只允许 [A-Za-z0-9._-]（YAML 标量安全）；例：--service checkout-api\n' >&2
      exit 2 ;;
  esac

  # 2.4) F1：--anchor-<dim>/--reason-<dim> 写盘前逐个做 YAML 标量校验（防注入出重复键/非法 YAML/null）；
  #      anchor 给了值还必须是真实存在的落点（schema 要求 anchor 指向该维唯一实现落点）→ 否则 exit 2。
  #      先于技能契约门：输入非法先报输入错（与 --kind/--service 校验次序一致），也便于离线自测。
  for d0 in metrics tracing logs issues; do
    case "$d0" in
      metrics) anchor=${OBS_ANCHOR_METRICS:-}; reason=${OBS_REASON_METRICS:-} ;;
      tracing) anchor=${OBS_ANCHOR_TRACING:-}; reason=${OBS_REASON_TRACING:-} ;;
      logs)    anchor=${OBS_ANCHOR_LOGS:-};    reason=${OBS_REASON_LOGS:-} ;;
      issues)  anchor=${OBS_ANCHOR_ISSUES:-};  reason=${OBS_REASON_ISSUES:-} ;;
    esac
    observe_scalar_check "$anchor" "--anchor-$d0"
    observe_scalar_check "$reason" "--reason-$d0"
    if [ -n "$anchor" ] && [ ! -e "$anchor" ]; then
      printf 'ponygo: observe init：--anchor-%s 指向的路径不存在：%s\n' "$d0" "$anchor" >&2
      printf '  schema 要求 anchor 必须是真实落点（相对项目根 %s）；先建好该文件再重试\n' "$PWD" >&2
      exit 2
    fi
  done

  # 2.5) 技能契约门（A8）：<skill>/references/contract.json 是唯一版本源；缺目录/低版本 → exit 2
  observe_skill_require
  skill_dir=$(observe_skill_dir_soft)
  skill_ver=$(observe_skill_version "$skill_dir")
  min_ver=$(observe_map_get contract_version_min)
  if [ -z "$skill_ver" ] || ! observe_version_ge "$skill_ver" "$min_ver"; then
    printf 'ponygo: observe init：skill 契约版本不满足：%s（要求 >= %s）\n' "${skill_ver:-unknown}" "$min_ver" >&2
    printf '  升级 skill 到 >= %s 后重试（版本源：%s/references/contract.json）\n' "$min_ver" "$skill_dir" >&2
    exit 2
  fi

  # 3) 目标路径：目标 = 已存在声明（含 .yml）否则 docs/observability.yaml；已存在且无 --force：
  #    若为 --dry-run 则允许预览（提示覆盖需 --force），真实落盘时无 --force 则 exit 2
  decl=$(observe_decl_path)
  if [ -n "$decl" ] && [ "${OBS_FORCE:-0}" != "1" ]; then
    if [ "${DRY_RUN:-0}" != "1" ]; then
      printf 'ponygo: observe init：声明已存在：%s\n' "$decl" >&2
      printf '  覆盖请加 --force：ponygo observe init --kind %s --force\n' "$kind" >&2
      exit 2
    fi
  fi
  if [ -n "$decl" ]; then
    target=$decl
  elif [ -f "docs/observability.yml" ]; then
    target="docs/observability.yml"
  else
    target="docs/observability.yaml"
  fi

  # 4) 生成声明内容：四维齐全；未给 --dims ⇒ 四维 applicable: true（anchor 缺则占位），
  #    给了 --dims ⇒ 列表内 true（anchor 缺占位），列表外 false（reason 缺占位）。
  #    智能继承（P0-Feedback）：若 decl 存在且目标维在原声明中已配置非占位内容，在用户未显式传参时优先继承原值
  ph=$(observe_map_get placeholder_token)
  skill_rel=$(observe_map_get skill_dir_rel)
  date_s=$(date +%F)
  dim_block=""; gaps=""
  for dim in metrics tracing logs issues; do
    case "$dim" in
      metrics) anchor=${OBS_ANCHOR_METRICS:-}; reason=${OBS_REASON_METRICS:-} ;;
      tracing) anchor=${OBS_ANCHOR_TRACING:-}; reason=${OBS_REASON_TRACING:-} ;;
      logs)    anchor=${OBS_ANCHOR_LOGS:-};    reason=${OBS_REASON_LOGS:-} ;;
      issues)  anchor=${OBS_ANCHOR_ISSUES:-};  reason=${OBS_REASON_ISSUES:-} ;;
    esac
    usable=true
    if [ -n "${OBS_DIMS:-}" ]; then
      usable=false
      for d in $(printf '%s' "$OBS_DIMS" | tr ',' ' '); do
        if [ "$d" = "$dim" ]; then usable=true; fi
      done
    fi
    # 智能继承：原文件存在且当前未提供显式值
    if [ -n "$decl" ] && [ -f "$decl" ]; then
      if [ "$usable" = "true" ] && [ -z "$anchor" ]; then
        local old_anc
        old_anc=$(awk -v d="$dim" '
          $0 ~ "^[[:space:]]*" d ":[[:space:]]*$" { in_d=1; next }
          in_d && /^[[:space:]]{2}[[:alnum:]_]+:[[:space:]]*$/ { in_d=0 }
          in_d && /^[[:space:]]{4}anchor:[[:space:]]*/ {
            val=$0; sub(/^[[:space:]]*anchor:[[:space:]]*/, "", val)
            gsub(/["'\''\r]/, "", val)
            print val; exit
          }
        ' "$decl" 2>/dev/null || true)
        if [ -n "$old_anc" ] && [ "$old_anc" != "$ph" ]; then
          anchor=$old_anc
        fi
      elif [ "$usable" = "false" ] && [ -z "$reason" ]; then
        local old_rsn
        old_rsn=$(awk -v d="$dim" '
          $0 ~ "^[[:space:]]*" d ":[[:space:]]*$" { in_d=1; next }
          in_d && /^[[:space:]]{2}[[:alnum:]_]+:[[:space:]]*$/ { in_d=0 }
          in_d && /^[[:space:]]{4}reason:[[:space:]]*/ {
            val=$0; sub(/^[[:space:]]*reason:[[:space:]]*/, "", val)
            gsub(/^>[[:space:]]*|^-[[:space:]]*|["'\''\r]/, "", val)
            print val; exit
          }
        ' "$decl" 2>/dev/null || true)
        if [ -n "$old_rsn" ] && [ "$old_rsn" != "$ph" ]; then
          reason=$old_rsn
        fi
      fi
    fi
    if [ "$usable" = "true" ]; then
      if [ -z "$anchor" ]; then
        anchor=$ph
        gaps="${gaps}缺口: ${dim}.anchor 仍是占位符（applicable: true）—— 填实：--anchor-${dim} <path> 后 --force 重写\n"
      fi
      dim_block="${dim_block}  ${dim}:
    applicable: true
    anchor: $(observe_yaml_sq "$anchor")
"
    else
      if [ -z "$reason" ]; then
        reason=$ph
        gaps="${gaps}缺口: ${dim}.reason 仍是占位符（applicable: false）—— 填实：--reason-${dim} <结构性理由> 后 --force 重写\n"
      fi
      dim_block="${dim_block}  ${dim}:
    applicable: false
    reason: $(observe_yaml_sq "$reason")
"
    fi
  done

  # 注释行不含占位符字面（占位符判定只扫非注释行，注释里也不埋字面以免误导）
  content=$(cat <<EOF
# ${svc} 的可观测性适用性声明（ponygo observe init 生成）
# 形状契约：${skill_rel}/references/declaration.schema.json；判定口径：${skill_rel}/references/declaration-rubric.md
# 四维必须齐全：省略 != 不适用。applicable: false 必须写结构性 reason（不是排期理由）；
# applicable: true 必须 anchor 指向该维唯一实现落点。
service: ${svc}
kind: ${kind}
dimensions:
${dim_block}reviewed_at: "${date_s}"
EOF
)

  # 5) --dry-run：只打印将写入的完整内容，零落盘
  if [ "${DRY_RUN:-0}" = "1" ]; then
    if [ -n "$decl" ] && [ "${OBS_FORCE:-0}" != "1" ]; then
      warn "[dry-run] 声明已存在（${decl}），真实落盘需加 --force"
    fi
    info "[dry-run] observe init：将写入 ${target}（未落盘）"
    printf '%s\n' "$content"
    exit 0
  fi

  # 6) 落盘（原子）：mkdir -p → 写 <target>.tmp.$$ → mv -f；任一步失败清理临时文件并 exit 2
  dir=$(dirname "$target")
  if [ ! -d "$dir" ]; then
    if ! mkdir -p "$dir"; then
      printf 'ponygo: observe init：目录创建失败：%s\n' "$dir" >&2
      exit 2
    fi
  fi
  tmp="${target}.tmp.$$"
  if ! printf '%s\n' "$content" > "$tmp"; then
    rm -f "$tmp"
    printf 'ponygo: observe init：临时文件写入失败：%s\n' "$tmp" >&2
    exit 2
  fi
  if ! mv -f "$tmp" "$target"; then
    rm -f "$tmp"
    printf 'ponygo: observe init：落盘失败：%s\n' "$target" >&2
    exit 2
  fi

  # 7) 收尾：静态级别（声明存在 + 非注释行无占位符）+ 目标级 + 逐条缺口 + 下一步
  ph_hit=false
  if grep -v '^[[:space:]]*#' "$target" | grep -q -F "$ph"; then ph_hit=true; fi
  cur=达成
  if [ "$ph_hit" = "true" ]; then cur=未达; fi
  lv=$(read_level)
  tgt=$(observe_target_level)

  printf '当前静态级别: ob0 %s\n' "$cur"
  printf '目标级: %s（ponygo level=%s）\n' "$tgt" "${lv:-0}"
  if [ -n "$gaps" ]; then
    printf '%b' "$gaps"
  else
    printf '缺口: 无（ob0 静态判据满足：声明存在且非注释行无占位符）\n'
  fi
  printf '下一步: ponygo observe audit\n'
  exit 0
}
# audit：真判定（会调用 skill 脚本）。退出码优先级 2 > 3 > 1 > 0：
#   2=工具/输入错误（判定中止）；3=证据不足；1=有缺口（含 below_target）；0=达标。
observe_audit() {
  local skill decl present ph rc rd ver min compat sp kind raw target cur
  local ob0 ob1 ob2 s0 s1 s2 jp jph jc jm mounted diff_log diff_tmo diff_ep abort exit2 exit3
  local gap_incon gap_ev gap_ep gap_diff gap_viol gap_mount gap_tool gap_below
  local ids gaps sep g c n0 n1 n2 adv code cr trk dabort glob_on
  local sub_rcs="" sub_bad=0 sub_unknown=0 sub_line sub_dir

  # 映射数据块先做一次 fail-closed 校验：map_get 多在 $(...) 子 shell 里调用，
  # 子 shell 里的 exit 2 拦不住父 shell，故必须在此以普通语句显式校验一次。
  observe_require_keys
  observe_skill_require
  skill=$(observe_skill_dir_soft)
  ver=$(observe_skill_version "$skill")
  min=$(observe_map_get contract_version_min)
  compat=false
  if [ -n "$ver" ] && observe_version_ge "$ver" "$min"; then compat=true; fi
  sp=false
  if [ -f "$skill/references/contract.json" ]; then sp=true; fi

  # 目标级：meta.yaml 的 level 映射；--level obN 作为断言目标覆盖它
  target=$(observe_target_level)
  if [ -n "${OBSERVE_LEVEL:-}" ]; then target="$OBSERVE_LEVEL"; fi

  n0=$(observe_map_get ob_level0_name)
  n1=$(observe_map_get ob_level1_name)
  n2=$(observe_map_get ob_level2_name)
  adv=$(observe_map_get ob_advisory_name)

  # 声明在场 / 占位符（口径与 observe_status 一致：只扫非注释行）
  decl=$(observe_decl_path)
  present=false
  if [ -n "$decl" ]; then present=true; fi
  ph=false
  if [ "$present" = "true" ]; then
    if grep -v '^[[:space:]]*#' "$decl" | grep -q -F "$(observe_map_get placeholder_token)"; then
      ph=true
    fi
  fi

  # declared_kind：净化后仅当匹配 ^[a-z0-9-]+$ 且 ∈ kind_enum 才回显，否则 unknown
  kind=unknown
  if [ -n "$decl" ]; then
    raw=$(sed -n 's/^[[:space:]]*kind:[[:space:]]*//p' "$decl" | head -n1 | tr -d '\r')
    raw=${raw%%[[:space:]]#*}                       # 去行内注释
    while :; do case "$raw" in *[[:space:]]) raw=${raw%?} ;; *) break ;; esac; done
    case "$raw" in \"*\") raw=${raw#\"}; raw=${raw%\"} ;; esac
    case "$raw" in \'*\') raw=${raw#\'}; raw=${raw%\'} ;; esac
    case "$raw" in
      ''|*[!a-z0-9-]*) : ;;
      *) case " $(observe_map_get kind_enum) " in *" $raw "*) kind=$raw ;; esac ;;
    esac
  fi

  # judges 默认值：声明缺失 → declaration_present=fail，占位符与后两项 skip
  if [ "$present" = "true" ]; then jp=pass; else jp=fail; fi
  if [ "$present" = "true" ]; then
    if [ "$ph" = "true" ]; then jph=fail; else jph=pass; fi
  else
    jph=skip
  fi
  jc=skip; jm=skip

  rc="-"; abort=0; exit2=0; exit3=0; dabort=0
  gap_incon=0; gap_ev=0; gap_ep=0; gap_diff=0; gap_viol=0; gap_mount=0; gap_tool=0; gap_below=0

  # 声明层：有声明才跑 check-declaration（无声明时 ob0 直接不成立）
  if [ "$present" = "true" ]; then
    observe_run_skill "$(observe_map_get external_timeout_seconds)" \
      "$skill/scripts/check-declaration.sh" --project "$PWD"
    rc=$?
    case "$rc" in
      0) jc=pass ;;
      2) jc=fail; gap_incon=1 ;;
      3) jc=unknown; gap_ev=1; exit3=1 ;;
      240|2[0-9][0-9])
        # F2 哨兵：observe_run_skill 建不了临时文件 → 工具错误（绝不读成 skill 的 rc=2 声明不一致）
        jc=unknown; abort=1; exit2=1; gap_tool=1
        printf 'ponygo: check-declaration.sh 未能执行（退出码=%s，工具/环境错误）\n' "$rc" >&2
        printf '  排查：TMPDIR 是否可写、磁盘是否满、%s/scripts/check-declaration.sh 是否可读；修好后重跑\n' "$skill" >&2
        ;;
      *)
        # 4 或其它：判定中止（不是「未达标」）
        jc=unknown; abort=1; exit2=1; gap_tool=1
        printf 'ponygo: check-declaration.sh 退出码=%s（不在 0/2/3 白名单内）\n' "$rc" >&2
        printf "声明层不可判定（可能：声明不合规 / 工具与环境错误）；先看上面的 stderr，再跑 'bash %s/scripts/check-declaration.sh --help' 自检\n" "$skill" >&2
        ;;
    esac
  fi

  # ob0 = 声明存在 && 非注释行无占位符 && rc ∈ {0,2,3}；ob1 = ob0 && rc == 0
  ob0=0; ob1=0; ob2=0
  if [ "$abort" = "0" ]; then
    if [ "$present" = "true" ] && [ "$ph" != "true" ]; then
      case "$rc" in 0|2|3) ob0=1 ;; esac
    fi
    if [ "$ob0" = "1" ] && [ "$rc" = "0" ]; then ob1=1; fi
  fi

  # ob1 成立才跑 audit-diff；rc=1 的 gap 需读 skill 输出关键词，故临时文件捕获后原样转发 stderr
  # 预算：独立键 diff_timeout_seconds（缺省 60，可被 PONYGO_OBS_DIFF_TIMEOUT 覆盖），**不得**复用
  # local_timeout_seconds（3s 级快命令预算）——否则大仓 audit-diff 必被 timeout 打死成假红。
  rd="-"; diff_log=""; diff_tmo=""; diff_ep=0; mounted=0
  if [ "$ob1" = "1" ]; then
    diff_tmo=$(observe_diff_timeout "$(observe_map_try diff_timeout_seconds)")
    diff_log=$(mktemp "${TMPDIR:-/tmp}/ponygo-obs-diff.XXXXXX") || diff_log=""
    # 登记到全局供 trap 兜底（CT-9）：预算从 3s 放宽到 60s 后，Ctrl-C 撞上 audit-diff 运行窗口的
    # 概率放大约 20 倍，只清 observe_run_skill 的临时文件会在 /tmp 残留 ponygo-obs-diff.XXXXXXXX。
    OBS_DIFF_TMPFILE=$diff_log
    if [ -n "$diff_log" ]; then
      observe_run_skill "$diff_tmo" \
        "$skill/scripts/audit-diff.sh" --repo "$PWD" --base "${OBSERVE_BASE:-HEAD}" 2>"$diff_log"
      rd=$?
      cat "$diff_log" >&2
      if grep -q -F '收口点' "$diff_log"; then diff_ep=1; fi
    else
      # 建不了临时文件：无法分关键词，rc=1 退化为 diff_warn
      observe_run_skill "$diff_tmo" \
        "$skill/scripts/audit-diff.sh" --repo "$PWD" --base "${OBSERVE_BASE:-HEAD}"
      rd=$?
    fi
    case "$rd" in
      0)
        # 载体发现（缺陷 D）：静态清单 + 动态发现的钩子目录。
        # 静态清单漏了 husky（core.hooksPath=.husky）——实测 job_copilot 的 .husky/pre-push 已接
        # audit-diff，却因为清单里没有 .husky 而拿不到 ob2。现在追加：
        #   ① git config core.hooksPath 指向的目录（唯一权威：git 实际会执行那里的钩子）；
        #   ② 存在 .husky/ 就纳入（husky v9 把 core.hooksPath 写成 .husky/_，钩子本体在 .husky/）。
        # 匹配一律走 observe_mount_hit（缺陷 F：排除纯注释行，堵住「只在注释里提 audit-diff」的假绿）。
        glob_on=0
        case "$-" in *f*) : ;; *) set -f; glob_on=1 ;; esac
        local carriers c hp
        carriers="$(observe_map_get mount_carriers)"
        hp="$(git config --get core.hooksPath 2>/dev/null || true)"
        [ -n "$hp" ] && carriers="$carriers $hp ${hp%/}/_"
        [ -d ".husky" ] && carriers="$carriers .husky"
        for c in $carriers; do
          case "$c" in *'*'*|*'?'*|*'['*) continue ;; esac
          if observe_mount_hit "$c"; then mounted=1; break; fi
        done
        [ "$glob_on" = "1" ] && set +f
        if [ "$mounted" = "1" ]; then jm=pass; ob2=1; else jm=fail; gap_mount=1; fi
        ;;
      1) jm=fail; if [ "$diff_ep" = "1" ]; then gap_ep=1; else gap_diff=1; fi ;;
      2) jm=fail; gap_viol=1 ;;
      # F7：rc=3 是「证据不可得」（与 check-declaration rc=3 同义），不是工具错误；exit 仍 3、current 仍 unknown
      3) jm=fail; gap_ev=1; exit3=1; dabort=1 ;;
      # CT-3/CT-8 超时专支（timeout 默认 124；--preserve-status 或子进程自行处理 SIGTERM 时为 143）：
      # 仍然 fail-closed（exit 2 + gaps 含 tool_error），但诊断必须点名「超时」与「audit-diff」，
      # 否则与检查器自身崩溃混为一谈，假红淹没真红。绝不并进 240/2xx 哨兵分支——哨兵语义是
      # 「临时文件建不了」，与「预算用尽/被杀」是两种不同故障，处置动作也不同。
      # 文案纪律（CT-8）：143 只说明「进程死于 SIGTERM」，**不等于**「预算内没跑完」（瞬时崩溃也会
      # 是 143），故不得写「N 秒内未跑完」这类断言，否则会给出「加预算」这种错误处置建议。
      124|143)
        jm=fail; gap_tool=1; exit2=1; dabort=1
        printf 'ponygo: audit-diff（变更级收口门禁）疑似超时或进程被 SIGTERM 终止：退出码=%s，预算 diff_timeout_seconds=%s 秒\n' "$rd" "$diff_tmo" >&2
        printf '  退出码 124 = 预算用尽被 timeout 杀掉；143 = 进程死于 SIGTERM（可能是超时，也可能是 skill 自身崩溃/被外部信号打断）\n' >&2
        printf '  这意味着「未判定」，不是「无违规」；ob2 按 fail-closed 处理（exit 2）\n' >&2
        printf '  处置：大仓且确为预算不足 → 抬高 data 块 diff_timeout_seconds 或 env PONYGO_OBS_DIFF_TIMEOUT=<正整数>；瞬时 143 → 先修 skill 自身，别只加预算\n' >&2
        ;;
      240|2[0-9][0-9]) jm=fail; gap_tool=1; exit2=1; dabort=1 ;;
      *) jm=fail; gap_tool=1; exit2=1; dabort=1 ;;
    esac
    if [ -n "$diff_log" ]; then rm -f "$diff_log"; fi
    OBS_DIFF_TMPFILE=""
  fi

  cur=unknown
  if [ "$ob2" = "1" ]; then cur=ob2
  elif [ "$ob1" = "1" ]; then cur=ob1
  elif [ "$ob0" = "1" ]; then cur=ob0
  fi
  # audit-diff 判定中止（rc ∉ {0,1,2}）时没有可信的当前级
  if [ "$dabort" = "1" ]; then cur=unknown; fi

  # 目标断言（--level obN 覆盖 meta 级）：只在 current ∈ {ob0,ob1,ob2} 时判 below_target
  cr=$(observe_rank "$cur"); trk=$(observe_rank "$target")
  if [ "$cr" -ge 0 ] && [ "$trk" -ge 0 ] && [ "$cr" -lt "$trk" ]; then gap_below=1; fi

  # gaps 顺序固定（见施工单 §8 词表）
  ids=""
  if [ "$present" != "true" ]; then ids="$ids declaration_missing"; fi
  if [ "$ph" = "true" ]; then ids="$ids placeholder_present"; fi
  if [ "$gap_incon" = "1" ]; then ids="$ids declaration_inconsistent"; fi
  if [ "$gap_ev" = "1" ]; then ids="$ids evidence_insufficient"; fi
  if [ "$gap_ep" = "1" ]; then ids="$ids enforcement_points_missing"; fi
  if [ "$gap_diff" = "1" ]; then ids="$ids diff_warn"; fi
  if [ "$gap_viol" = "1" ]; then ids="$ids enforcement_violation"; fi
  if [ "$gap_mount" = "1" ]; then ids="$ids mount_missing"; fi
  if [ "$gap_tool" = "1" ]; then ids="$ids tool_error"; fi
  if [ "$gap_below" = "1" ]; then ids="$ids below_target"; fi

  # 子组件声明巡检（缺陷 E）：observe status 会推荐「进入 front_end/ 执行 ponygo observe init」，
  # 但旧版 observe audit 只判根声明，从不巡检子组件 —— 等于推荐了一个自己无法验收的动作。
  # 现在逐份巡检已探测到的子组件声明（front_end/ web/ client/ ... 下的 docs/observability.*），
  # 并把结果作为独立缺口暴露。缺口语义与既有一致：默认只进 backlog，`--strict` 才影响退出码。
  for sub_dir in front_end frontend web client ui app; do
    [ -d "$sub_dir" ] || continue
    [ -f "$sub_dir/docs/observability.yaml" ] || [ -f "$sub_dir/docs/observability.yml" ] || continue
    ( cd "$sub_dir" && observe_run_skill "$(observe_map_get external_timeout_seconds)" \
        "$skill/scripts/check-declaration.sh" --project "$PWD" ) >/dev/null 2>&1
    sub_rcs="${sub_rcs}${sub_rcs:+ }${sub_dir}:$?"
  done
  if [ -n "$sub_rcs" ]; then
    for sub_line in $sub_rcs; do
      case "${sub_line##*:}" in
        0) : ;;
        2) sub_bad=1 ;;
        3) sub_unknown=1 ;;
        *) sub_bad=1 ;;
      esac
    done
    if [ "$sub_bad" = "1" ]; then ids="$ids subcomponent_inconsistent"; fi
    if [ "$sub_unknown" = "1" ] && [ "$sub_bad" = "0" ]; then ids="$ids subcomponent_evidence_insufficient"; fi
  fi

  # 同目录多声明（缺陷 E 剩余部分）：`docs/observability.d/*.yaml` 里每份都是独立形态声明
  # （典型：根声明 k8s-service + docs/observability.d/pipeline.yaml）。逐份跑 check-declaration，
  # 结果并入 backlog。主声明（docs/observability.yaml）仍独占 ob0/ob1/ob2 的判定权——
  # 附加声明改变的是「覆盖范围」，不是「主形态的达标线」。
  local extra_rcs="" extra_f extra_bad=0 extra_rc=0
  while IFS= read -r extra_f; do
    [ -n "$extra_f" ] || continue
    observe_run_skill "$(observe_map_get external_timeout_seconds)" \
      "$skill/scripts/check-declaration.sh" --declaration "$extra_f" >/dev/null 2>&1
    extra_rc=$?
    extra_rcs="${extra_rcs}${extra_rcs:+ }${extra_f##*/}:${extra_rc}"
  done <<EOF
$(observe_decl_extra_list)
EOF
  if [ -n "$extra_rcs" ]; then
    for sub_line in $extra_rcs; do
      case "${sub_line##*:}" in 0) : ;; *) extra_bad=1 ;; esac
    done
    if [ "$extra_bad" = "1" ]; then ids="$ids extra_declaration_inconsistent"; fi
  fi

  if [ "$abort" = "1" ]; then
    s0=SKIP; s1=SKIP; s2=SKIP
  else
    if [ "$ob0" = "1" ]; then s0=PASS; else s0=FAIL; fi
    if [ "$ob1" = "1" ]; then s1=PASS; elif [ "$ob0" = "1" ]; then s1=FAIL; else s1=SKIP; fi
    if [ "$ob2" = "1" ]; then s2=PASS; elif [ "$ob1" = "1" ]; then s2=FAIL; else s2=SKIP; fi
  fi

  # 退出码优先级：2（工具/输入错误）> 3（证据不可得）> 1（未达目标级）> 0（已达目标级）。
  # 目标级来源：显式 --level obN，否则 .meta/meta.yaml 的 level 经映射表求得。
  # 缺口列表是「距下一级的 backlog」，默认不直接决定退出码（否则目标已达仍会 exit 1，CI 无法分档推进）。
  # --strict 模式下：任一缺口均非零退出（保持最硬门禁，供全量绿门禁使用）。
  if [ "$exit2" = "1" ]; then code=2
  elif [ "$exit3" = "1" ]; then code=3
  elif [ "${OBSERVE_STRICT:-0}" = "1" ] && [ -n "$ids" ]; then code=1
  elif [ "$cr" -ge 0 ] && [ "$cr" -ge "$trk" ]; then code=0
  else code=1
  fi

  # 人读报告（--json 时整体走 stderr，stdout 只留一行 JSON）
  observe_audit_report() {
    printf '===== ponygo observe audit =====\n'
    printf '[%s] ob0 %s\n' "$s0" "$n0"
    printf '[%s] ob1 %s\n' "$s1" "$n1"
    printf '[%s] ob2 %s\n' "$s2" "$n2"
    printf '当前级: %s\n' "$cur"
    printf '目标级: %s\n' "$target"
    if [ "${OBSERVE_STRICT:-0}" = "1" ]; then
      if [ -n "${OBSERVE_LEVEL:-}" ]; then
        printf '模式: 断言 ob%s [strict]（任一缺口 exit 非零）\n' "$(observe_rank "$OBSERVE_LEVEL")"
      else
        printf '模式: 体检 [strict]（目标级取自 meta.yaml；任一缺口 exit 非零）\n'
      fi
    elif [ -n "${OBSERVE_LEVEL:-}" ]; then
      printf '模式: 断言 ob%s（判据：当前级 ≥ 目标级；缺口列表为 backlog）\n' "$(observe_rank "$OBSERVE_LEVEL")"
    else
      printf '模式: 体检（目标级取自 meta.yaml；判据：当前级 ≥ 目标级；缺口列表为 backlog）\n'
    fi
    if [ "$code" = "0" ]; then
      printf '结论: PASS（当前级 %s 已达目标级 %s，exit=0）\n' "$cur" "$target"
      if [ -n "$ids" ]; then
        printf '后续升级建议（下一级待办 / Backlog）：\n'
      fi
    else
      # 结论行必须说实话：--strict 下即使已达标也会 exit 非零（缺口强制），
      # 旧文案会打成「未达目标级」——那是假陈述，会误导排障方向。
      if [ "$cr" -ge 0 ] && [ "$cr" -ge "$trk" ]; then
        printf '结论: FAIL（当前级 %s 已达目标级 %s，但 --strict 下存在缺口故 exit=%s）\n' "$cur" "$target" "$code"
      else
        printf '结论: FAIL（当前级 %s 未达目标级 %s，exit=%s）\n' "$cur" "$target" "$code"
      fi
    fi
    if [ -n "$sub_rcs" ]; then
      printf '子组件声明巡检（逐份判定，rc=0 一致 / 2 不一致 / 3 证据不可得）：%s\n' "$sub_rcs"
    fi
    if [ -n "$extra_rcs" ]; then
      printf '附加声明巡检（docs/observability.d/，逐份判定）：%s\n' "$extra_rcs"
    fi
    for g in $ids; do
      case "$g" in
        declaration_missing) printf '  - [ ] declaration_missing: 未找到可观测性声明（查找路径：%s）；下一步：ponygo observe init --kind <k>\n' "$(observe_map_get declaration_paths)" ;;
        placeholder_present) printf '  - [ ] placeholder_present: 声明中占位符未替换；下一步：填实四维归属与落点\n' ;;
        declaration_inconsistent) printf '  - [ ] declaration_inconsistent: 声明与巡检结果不一致（check-declaration rc=2）；下一步：按上面 stderr 修正声明\n' ;;
        evidence_insufficient) printf '  - [ ] evidence_insufficient: 证据不可得（check-declaration 或 audit-diff rc=3，不是「未达标」，也不是声明本身错）；补证据后重跑\n' ;;
        enforcement_points_missing) printf '  - [ ] enforcement_points_missing: 变更门禁里没有 audit-diff 收口点；下一步：挂到 pre-commit / CI\n' ;;
        diff_warn) printf '  - [ ] diff_warn: 变更门禁（enforcement points）有非阻断告警（见上面 stderr）\n' ;;
        enforcement_violation) printf '  - [ ] enforcement_violation: 变更门禁判定不通过（见上面 stderr）\n' ;;
        mount_missing) printf '  - [ ] mount_missing: 未在挂载载体（mount_carriers）发现 audit-diff 调用\n' ;;
        tool_error) printf '  - [ ] tool_error: 工具或环境错误，本次判定不可信（见上面 stderr）\n' ;;
        below_target) printf '  - [ ] below_target: 当前级低于 --level 断言的目标级\n' ;;
        subcomponent_inconsistent) printf '  - [ ] subcomponent_inconsistent: 子组件声明与实测不一致（%s）；下一步：进入对应子目录按 stderr 修正声明\n' "${sub_rcs:-?}" ;;
        subcomponent_evidence_insufficient) printf '  - [ ] subcomponent_evidence_insufficient: 子组件证据不可得（%s）；补证据后重跑\n' "${sub_rcs:-?}" ;;
        extra_declaration_inconsistent) printf '  - [ ] extra_declaration_inconsistent: 同目录附加声明与实测不一致（%s）；下一步：按对应声明的 stderr 修正\n' "${extra_rcs:-?}" ;;
      esac
    done
    if [ -z "$ids" ]; then printf '缺口: 无\n'; fi
    printf '%s：\n' "$adv"
    printf '  - 采样策略：按流量与成本定采样率（head-based，必要时 tail 兜底），别默认全采\n'
    printf '  - gen_ai.* 成本归因：LLM/Agent 调用的 token 与成本标到 gen_ai.* 语义约定\n'
    printf '  - SLI 告警组：每个 SLI 建告警组与 burn-rate 阈值，而非单点阈值\n'
    printf '判定口径见 %s/references/declaration-rubric.md §6.6\n' "$skill"
  }

  if [ "${OBSERVE_JSON:-0}" = "1" ]; then
    observe_audit_report >&2
    gaps=""; sep=""
    for g in $ids; do gaps="$gaps$sep\"$g\""; sep=","; done
    local vj
    vj=$(observe_version_json "$ver")
    printf '{"schema":"ponygo.observe/1","command":"audit","declared_kind":"%s","current":"%s","target":"%s","skill":{"present":%s,"contract_version":"%s","compatible":%s},"judges":[{"id":"declaration_present","status":"%s"},{"id":"no_placeholder","status":"%s"},{"id":"declaration_consistent","status":"%s"},{"id":"enforcement_mounted","status":"%s"}],"gaps":[%s]}\n' \
      "$kind" "$cur" "$target" "$sp" "$vj" "$compat" "$jp" "$jph" "$jc" "$jm" "$gaps"
    exit "$code"
  fi

  observe_audit_report
  exit "$code"
}

# 本地版本兼容门：不联网、不调集群、不调 check-drift；--check 时兼容=0/不兼容=2，否则恒 0
observe_upgrade() {
  local d ver min compat
  observe_require_keys
  observe_skill_require
  d=$(observe_skill_dir_soft)
  ver=$(observe_skill_version "$d")
  min=$(observe_map_get contract_version_min)
  compat=no
  if [ -n "$ver" ] && observe_version_ge "$ver" "$min"; then compat=yes; fi

  echo "===== ponygo observe upgrade ====="
  printf 'skill: %s\n' "$d"
  printf 'contract_version: %s\n' "${ver:-unknown}"
  printf '要求: >= %s\n' "$min"
  if [ "$compat" = "yes" ]; then printf '结论: 兼容\n'; else printf '结论: 不兼容（需升级 skill）\n'; fi

  if [ "${UPGRADE_CHECK:-0}" = "1" ] && [ "$compat" != "yes" ]; then
    printf 'ponygo: skill 契约版本不满足：%s（要求 >= %s）；升级 skill 后重试\n' "${ver:-unknown}" "$min" >&2
    exit 2
  fi
  exit 0
}

# observe 段帮助：usage() 与 'ponygo observe --help' 共用同一份文案（单一真源，防双源漂移）
usage_observe() {
  cat <<'EOF'
observe —— 可观测性治理维度（判定 ob0/ob1/ob2；ob3 仅为目标画像，不参与判定）
  ponygo observe status                           静态报告（不判定）：声明在场/占位残留/skill 在场与版本；只读，exit 0
  ponygo observe init   --kind <k> [--service <s>] [--dims a,b] [--anchor-<dim> <path>]
                        [--reason-<dim> <text>] [--force] [--dry-run] [--yes]
                                                  落地四维归属声明（唯一写命令；已存在声明需 --force）
  ponygo observe audit  [--level ob0|ob1|ob2] [--base <rev>] [--strict] [--json]
                                                  判定是否达到目标级（缺口仅作 backlog；--strict 时任一缺口非零）
  ponygo observe upgrade [--check]                与技能契约的版本兼容门（CI 用 --check）
  ponygo observe --help | -h                      本段帮助

observe 选项（仅 observe 接受，其余命令拒绝）：
  --level ob0|ob1|ob2  判定目标档（ob3 是成本与 SLO 的目标画像，不参与判定，显式拒绝）
  --strict             严格模式：存在任一缺口均非零退出（audit 专用）
  --json               固定词表 JSON 输出（仅 status|audit；供 CI 解析，不含自由文本）
  --skill-dir <dir>    skill 安装目录（等价 env PONYGO_SKILL_DIR）
  --mapping <file>     覆盖嵌入映射数据块（等价 env PONYGO_OBSERVE_MAPPING）

示例：
  # 1. 前端 SPA 项目（接 tracing 与 issues，免除 metrics 与 logs）
  ponygo observe init --kind frontend --dims tracing,issues \
    --anchor-tracing src/api/client.ts --anchor-issues src/main.ts \
    --reason-metrics "前端静态页面无常驻端口" --reason-logs "不走容器日志采集"

  # 2. 桌面端全栈应用（Tauri）
  ponygo observe init --kind desktop --dims tracing,issues \
    --anchor-tracing crates/core/src/otel.rs --anchor-issues crates/core/src/sentry.rs

  # 3. 门禁达标自检与 CI 阻断
  ponygo observe audit --level ob1                  # 体检：缺口=backlog，已达目标级即 exit 0
  ponygo observe audit --level ob1 --strict --json  # CI：任一缺口（含子组件/附加声明不一致）即 exit 1

阻断语义（唯一的两个维度，按需组合，无第三个 scope 维度）：
  默认      → 缺口只进 backlog，退出码只由「当前级 ≥ 目标级」决定
  --strict  → 任一缺口即非零；这是「全仓一票否决」的开关（子组件/附加声明的不一致也走这条）

退出码白话：0=已达目标级/兼容；1=未达目标级或用法错；2=工具或输入错误（不是"未达标"）；3=证据不足。

已知局限：ob1 只判「声明与巡检一致」；四维全 false 的声明同样 PASS（识别谎言是非机械项，见 revisions/proposed/2026-10-25-observe-dimension.md K4）。
已知局限：ob2 的挂载证据是形状判据（grep 载体，**已排除纯注释行**；仍不解析 AST，也不验证钩子是否真被执行），真执行证据是 audit-diff 本身（K7）。
已知局限：kind 是单值。同目录多形态靠附加声明 docs/observability.d/*.yaml（主声明 docs/observability.yaml 定 ob 级；附加声明只扩覆盖，逐份巡检后不一致进 backlog，--strict 才影响退出码）；多组件仓仍按项目根拆目录，audit 会逐份巡检子组件声明（front_end/ web/ client/ …）并列出各自 rc。
EOF
}

# ---------- 帮助 ----------
usage() {
  cat <<'EOF'
ponygo —— 项目工程化治理元框架命令行（单文件、零依赖）

用法：
  ponygo init     [--yes] [--dry-run]    建立/注入 .agents/ + .meta/ 治理骨架（自判新/旧项目）
  ponygo audit    [--level S|M] [--run-specs]  自适应体检：打分 + 缺口 + 最小改进动作（判据不符 exit 1）
  ponygo status                          查看成熟度级与骨架完整度（骨架缺口或声明级判据不符 exit 1）
  ponygo upgrade  [--check]              骨架漂移报告（宇宙=s14 十文件；默认 exit 0；--check 漂移非零供 CI）
  ponygo sync                            把 constitution 投影到 AGENTS.md / CLAUDE.md（模板态投影初始引导）
  ponygo retire   --level <N|off>        退级 / 整体退场（停止线执行器）
  ponygo observe  status|init|audit|upgrade  可观测性治理维度（ob0/ob1/ob2 判定；详见 'ponygo observe --help'）

选项：
  --yes       破坏性动作前不再确认
  --dry-run   只打印将执行的动作，不落盘
  --level S|M 强制指定审计深度档（默认按项目特征自适应）
  --run-specs 执行 gates/ 下 *.spec.sh 负样本自检（opt-in；默认不执行仓库脚本）
  --check     ponygo upgrade 专用：存在漂移 → exit 非零（供 CI；与 --dry-run 互斥）
EOF
  usage_observe
}

# ---------- 入口 ----------
DRY_RUN=0; YES=0; LEVEL=""; CMD=""; RETIRE_LEVEL=""; RUN_SPECS=0; UPGRADE_CHECK=0
# observe 独立变量族：OBSERVE_SUB 承载子命令（与顶层 CMD 分离，防 'observe audit' 被
# 'audit)' 分支二次覆盖），OBSERVE_LEVEL 只收 ob0|ob1|ob2（不复用 LEVEL 的 S|M 值域）。
OBSERVE_SUB=""; OBSERVE_LEVEL=""; OBSERVE_JSON=0; OBSERVE_SKILL_DIR=""; OBSERVE_MAPPING_FILE=""; OBSERVE_STRICT=0
# observe init/audit 旗标族（值型：--kind/--service/--dims/--anchor-<dim>/--reason-<dim>/--base）
OBS_KIND=""; OBS_SERVICE=""; OBS_DIMS=""; OBS_FORCE=0; OBSERVE_BASE=""
OBS_ANCHOR_METRICS=""; OBS_ANCHOR_TRACING=""; OBS_ANCHOR_LOGS=""; OBS_ANCHOR_ISSUES=""
OBS_REASON_METRICS=""; OBS_REASON_TRACING=""; OBS_REASON_LOGS=""; OBS_REASON_ISSUES=""
# 惰性求值的探测缓存（映射数据块校验 / `timeout` 语义探针 + 一次性 WARN 旗标）
OBS_MAP_VERIFIED=0; OBS_TIMEOUT_OK=""; OBS_TIMEOUT_WARNED=0
# observe 外部命令临时文件（F3）：路径登记到全局，EXIT 兜底 rm，防信号打断执行中的 skill 时残留。
# INT/TERM 单独处理：清理后按默认信号语义退出（若只 rm 不退出，Ctrl-C/TERM 会被吞掉、进程继续跑）。
# CT-9：需同时覆盖两个临时文件——observe_run_skill 的输出捕获与 audit-diff 的 stderr 捕获；
# 原实现的 trap 只删单个路径，预算放宽到 60s 后 audit-diff 运行窗口变长，残留概率显著上升。
OBS_TMPFILE=""; OBS_DIFF_TMPFILE=""
observe_tmp_cleanup() {
  local f
  for f in "${OBS_TMPFILE:-}" "${OBS_DIFF_TMPFILE:-}"; do
    [ -n "$f" ] && rm -f "$f" 2>/dev/null
  done
  return 0
}
trap 'observe_tmp_cleanup' EXIT
trap 'observe_tmp_cleanup; trap - EXIT INT TERM; exit 130' INT
trap 'observe_tmp_cleanup; trap - EXIT INT TERM; exit 143' TERM
while [ $# -gt 0 ]; do
  case "$1" in
    --yes) YES=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --run-specs) RUN_SPECS=1 ;;
    --check) UPGRADE_CHECK=1 ;;
    --strict) OBSERVE_STRICT=1 ;;
    --json) OBSERVE_JSON=1 ;;
    --force) OBS_FORCE=1 ;;
    --skill-dir) [ $# -ge 2 ] || die "--skill-dir 需要目录取值（如 --skill-dir .agents/skills/observability-onboarding）"; shift; OBSERVE_SKILL_DIR="$1" ;;
    --mapping) [ $# -ge 2 ] || die "--mapping 需要文件取值（如 --mapping ./observe-mapping.txt）"; shift; OBSERVE_MAPPING_FILE="$1" ;;
    --base) [ $# -ge 2 ] || die "--base 需要取值（如 --base origin/main）"; shift; OBSERVE_BASE="$1" ;;
    --kind) [ $# -ge 2 ] || die "--kind 需要取值（如 --kind desktop；枚举见映射 kind_enum）"; shift; OBS_KIND="$1" ;;
    --service) [ $# -ge 2 ] || die "--service 需要取值（如 --service checkout-api）"; shift; OBS_SERVICE="$1" ;;
    --dims) [ $# -ge 2 ] || die "--dims 需要取值（如 --dims metrics,tracing）"; shift; OBS_DIMS="$1" ;;
    --anchor-metrics) [ $# -ge 2 ] || die "--anchor-metrics 需要取值（如 --anchor-metrics src/metrics.ts）"; shift; OBS_ANCHOR_METRICS="$1" ;;
    --anchor-tracing) [ $# -ge 2 ] || die "--anchor-tracing 需要取值（如 --anchor-tracing src/tracing.ts）"; shift; OBS_ANCHOR_TRACING="$1" ;;
    --anchor-logs) [ $# -ge 2 ] || die "--anchor-logs 需要取值（如 --anchor-logs src/log.ts）"; shift; OBS_ANCHOR_LOGS="$1" ;;
    --anchor-issues) [ $# -ge 2 ] || die "--anchor-issues 需要取值（如 --anchor-issues src/sentry.ts）"; shift; OBS_ANCHOR_ISSUES="$1" ;;
    --reason-metrics) [ $# -ge 2 ] || die "--reason-metrics 需要取值（结构性理由，不是排期理由）"; shift; OBS_REASON_METRICS="$1" ;;
    --reason-tracing) [ $# -ge 2 ] || die "--reason-tracing 需要取值（结构性理由，不是排期理由）"; shift; OBS_REASON_TRACING="$1" ;;
    --reason-logs) [ $# -ge 2 ] || die "--reason-logs 需要取值（结构性理由，不是排期理由）"; shift; OBS_REASON_LOGS="$1" ;;
    --reason-issues) [ $# -ge 2 ] || die "--reason-issues 需要取值（结构性理由，不是排期理由）"; shift; OBS_REASON_ISSUES="$1" ;;
    --level) [ $# -ge 2 ] || die "--level 需要取值（如 --level S / --level off）"; shift; LEVEL="$1" ;;
    -h|--help)
      # 'ponygo observe --help' 与本段帮助同源（usage_observe 是 usage 的子集文案）
      if [ "${CMD:-}" = "observe" ]; then usage_observe; exit 0; fi
      usage; exit 0 ;;
    observe)
      # 不盲取下一词：子命令词交给下面的 'init|audit|status|upgrade' 分支（A1 守卫）认领，
      # 旗标仍由本循环正常解析（'observe --skill-dir /x audit' 不得被吞掉或串味）。
      # F6 顶层路由守卫：'ponygo init observe ...' 不得改跑 observe（否则 init 被顶替、还真的写盘）
      if [ -n "${CMD:-}" ] && [ "${CMD:-}" != "observe" ]; then
        die "子命令位置非法：'$CMD' 后不接受 'observe'（见 'ponygo --help'）"
      fi
      CMD=observe
      ;;
    init|audit|status|upgrade|sync|retire)
      # A1 守卫：observe 已占 CMD 时，紧随的第二个子命令词不得覆盖它（'observe status init' 不得变成 init）；
      # 但 'observe --skill-dir /x audit' 这类旗标前置后出现的子命令词仍归 observe。
      if [ "${CMD:-}" = "observe" ]; then
        if [ -n "${OBSERVE_SUB:-}" ]; then
          die "observe 后不接受第二个子命令词：$1（见 'ponygo observe --help'）"
        fi
        OBSERVE_SUB="$1"
      else
        CMD="$1"
      fi
      ;;
    *)
      # observe 上下文里的裸词：不是第二个子命令词就是未知子命令，绝不落到顶层未知参数
      if [ "${CMD:-}" = "observe" ] && [ "${1#-}" = "$1" ]; then
        if [ -n "${OBSERVE_SUB:-}" ]; then
          die "observe 不接受第二个子命令词：$1（见 'ponygo observe --help'）"
        fi
        die "未知 observe 子命令：$1（用 status|init|audit|upgrade，见 'ponygo observe --help'）"
      fi
      die "未知参数或子命令：$1（见 'ponygo --help'）"
      ;;
  esac
  shift
done

# B2 归一（解析循环结束后、守卫之前）：'--level obN' 写在 observe 之前时先落进 LEVEL，
# 必须在此归一到 OBSERVE_LEVEL 再清空，否则会被后面的守卫当「非 observe 的 --level」丢掉。
if [ "${CMD:-}" = "observe" ]; then
  case "${LEVEL:-}" in
    ob0|ob1|ob2) OBSERVE_LEVEL="$LEVEL"; LEVEL="" ;;
    ob3) die "--level ob3 不可用于判定：ob3 是成本与 SLO 的目标画像，不参与判定；判定档用 ob0|ob1|ob2" ;;
    "") : ;;
    *) die "observe 侧 --level 只收 ob0|ob1|ob2（收到：${LEVEL}）" ;;
  esac
fi
# obN 值域只属 observe；非 observe 命令不得静默接收（LEVEL 的 S|M|off 值域另属 legacy 分支）
if [ "${CMD:-}" != "observe" ] && [ -n "${OBSERVE_LEVEL:-}" ]; then
  die "--level obN 仅适用于 'ponygo observe audit'"
fi
# F5 CONTRACT：--level 的判定目标档只属 'observe audit'；init/status/upgrade 收到即拒绝（不静默忽略）
if [ "${CMD:-}" = "observe" ] && [ -n "${OBSERVE_LEVEL:-}" ]; then
  case "${OBSERVE_SUB:-}" in
    audit|"") : ;;
    *) die "observe 侧 --level 只属 audit（${OBSERVE_SUB} 不接受 --level ${OBSERVE_LEVEL}）" ;;
  esac
fi

# --run-specs 只属于 audit（执行仓库脚本的 opt-in 入口）；其余命令一律拒绝，避免静默忽略
if [ "$RUN_SPECS" = "1" ] && [ "${CMD:-}" != "audit" ]; then
  die "--run-specs 仅适用于 'ponygo audit'（只读命令不执行仓库脚本）"
fi
# --check 只属于 upgrade 与 'observe upgrade'（漂移/版本兼容门）；其余命令一律拒绝（对齐 --run-specs 互斥守卫）
if [ "$UPGRADE_CHECK" = "1" ] && [ "${CMD:-}" != "upgrade" ] \
   && ! { [ "${CMD:-}" = "observe" ] && [ "${OBSERVE_SUB:-}" = "upgrade" ]; }; then
  die "--check 仅适用于 'ponygo upgrade'（骨架漂移检查；其余命令无此语义）"
fi
# --check 必须读真实文件：与 --dry-run 互斥（--check --dry-run → die）
if [ "$UPGRADE_CHECK" = "1" ] && [ "$DRY_RUN" = "1" ]; then
  die "--check 与 --dry-run 互斥——检查必须读真实文件，dry-run 只打印不落盘"
fi
# --strict 只属于 'observe audit'（严格门禁：任一缺口非零退出）；其余命令拒绝，避免静默忽略
if [ "$OBSERVE_STRICT" = "1" ] \
   && ! { [ "${CMD:-}" = "observe" ] && [ "${OBSERVE_SUB:-}" = "audit" ]; }; then
  die "--strict 仅适用于 'ponygo observe audit'（严格门禁：任一缺口均非零退出）"
fi
# --json 只属于 'observe status|audit'（固定词表 JSON 供 CI）；其余命令拒绝，避免静默忽略
if [ "$OBSERVE_JSON" = "1" ] \
   && ! { [ "${CMD:-}" = "observe" ] && { [ "${OBSERVE_SUB:-}" = "status" ] || [ "${OBSERVE_SUB:-}" = "audit" ]; }; }; then
  die "--json 仅适用于 'ponygo observe status|audit'（固定词表输出，供 CI 解析）"
fi
# --skill-dir / --mapping 只属于 observe（其余命令拒绝，避免静默忽略）
if [ -n "$OBSERVE_SKILL_DIR" ] && [ "${CMD:-}" != "observe" ]; then
  die "--skill-dir 仅适用于 'ponygo observe'（技能安装目录）"
fi
if [ -n "$OBSERVE_MAPPING_FILE" ] && [ "${CMD:-}" != "observe" ]; then
  die "--mapping 仅适用于 'ponygo observe'（嵌入映射数据块的覆盖文件）"
fi
# --kind/--service/--dims/--anchor-<dim>/--reason-<dim>/--force 只属 observe init（唯一写命令）；
# --base 只属 observe audit（audit-diff 比较基线）。其余命令一律拒绝，避免静默忽略。
if [ "${CMD:-}" != "observe" ]; then
  if [ -n "${OBS_KIND:-}" ]; then die "--kind 仅适用于 'ponygo observe init'（可观测性声明种类）"; fi
  if [ -n "${OBS_SERVICE:-}" ]; then die "--service 仅适用于 'ponygo observe init'（声明服务名）"; fi
  if [ -n "${OBS_DIMS:-}" ]; then die "--dims 仅适用于 'ponygo observe init'（四维适用性列表）"; fi
  if [ -n "${OBS_ANCHOR_METRICS:-}${OBS_ANCHOR_TRACING:-}${OBS_ANCHOR_LOGS:-}${OBS_ANCHOR_ISSUES:-}" ]; then
    die "--anchor-<dim> 仅适用于 'ponygo observe init'（该维唯一实现落点）"
  fi
  if [ -n "${OBS_REASON_METRICS:-}${OBS_REASON_TRACING:-}${OBS_REASON_LOGS:-}${OBS_REASON_ISSUES:-}" ]; then
    die "--reason-<dim> 仅适用于 'ponygo observe init'（不适用维的结构性理由）"
  fi
  if [ "${OBS_FORCE:-0}" = "1" ]; then die "--force 仅适用于 'ponygo observe init'（覆盖已存在声明）"; fi
fi
if [ -n "${OBSERVE_BASE:-}" ] \
   && ! { [ "${CMD:-}" = "observe" ] && [ "${OBSERVE_SUB:-}" = "audit" ]; }; then
  die "--base 仅适用于 'ponygo observe audit'（audit-diff 比较基线）"
fi

case "${CMD:-}" in
  init) cmd_init ;;
  audit) cmd_audit ;;
  status) cmd_status ;;
  upgrade) cmd_upgrade ;;
  sync) do_sync ;;
  retire) cmd_retire "${LEVEL:-}" ;;
  observe)
    case "${OBSERVE_SUB:-}" in
      status) observe_status ;;
      init) observe_init ;;
      audit) observe_audit ;;
      upgrade) observe_upgrade ;;
      *) die "未知 observe 子命令：${OBSERVE_SUB:-（缺）}（见 'ponygo observe --help'）" ;;
    esac
    ;;
  "") usage; exit 0 ;;
esac

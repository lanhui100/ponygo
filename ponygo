}

# ---------- 工具函数 ----------
die() { printf 'ponygo: %s\n' "$*" >&2; exit 1; }
info() { printf 'ponygo: %s\n' "$*"; }
warn() { printf 'ponygo: %s\n' "$*" >&2; }

# 是否已有治理根
has_meta() { [ -d "$META_DIR" ]; }

# 决策文件计数——排除集 {README.md, AGENTS.md, *.zh.md} 的唯一真源（audit / status / verify_ladder 共用）
count_decisions() {
  find "$DECISIONS_DIR" -type f -name '*.md' ! -name 'README.md' ! -name 'AGENTS.md' ! -name '*.zh.md' 2>/dev/null | wc -l | tr -d ' '
}

# 实例扩展 class（L5 领域定制的开放口）：notes/classes.local 每行一个额外 class 名
# （小写字母/数字/连字符；# 起注释与空行忽略）。封闭集本身不放开，扩展必须显式落盘成文件——
# 扩展是一次治理决策，留有可审计的载体，而非随手 mkdir。
extra_classes() {
  [ -f "$DECISIONS_DIR/classes.local" ] || return 0
  sed 's/\r$//' "$DECISIONS_DIR/classes.local" | grep -vE '^[[:space:]]*(#|$)' | grep -E '^[a-z0-9][a-z0-9-]*$'
}

# ai-surface 开关状态（单一读取真源）：on / off / undeclared / invalid。
# 读者有三处语义、一个值：2.6（AI 常载命约投影块）、1.9b（根 AGENTS.md 索引链）、status/audit 的
# JSON coverage 与人类结论行。
# 归一规则（2026-11-09 收口，防"写了值却被当没写"）：去首尾空白 → 去包裹引号（单/双）→ 大小写不敏感。
# 故 `on` / `ON` / `"on"` / `'on'` / `on ` 全部兑现语义；有值但归一后不是 on|off → `invalid`
# （按未声明处理，**不兑现** on/off 语义，并由调用方给「值非法（仅 on|off）」WARN——不得静默当没写）。
# 只剥 \r 发生在归一之前（CRLF 防御）；键名本身仍严格顶格 `ai-surface:`（缩进键走非法键 WARN）。
ai_surface_state() {
  local raw="" norm=""
  raw=$(sed -n 's/^ai-surface:[[:space:]]*//p' "$META_YAML" 2>/dev/null | head -n1 | tr -d '\r')
  norm=$(printf '%s' "$raw" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')
  case "$norm" in
    \"*\") norm="${norm#\"}"; norm="${norm%\"}" ;;
    \'*\') norm="${norm#\'}"; norm="${norm%\'}" ;;
  esac
  norm=$(printf '%s' "$norm" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  case "$norm" in
    on)  printf 'on' ;;
    off) printf 'off' ;;
    "")  printf 'undeclared' ;;
    *)   printf 'invalid' ;;
  esac
}

# ---------- 判据辅助（与判定真源 verify-note.sh 逐项同语义；两面必须一起改） ----------
# 理由正文归一（判据 1.7）：剥掉 ASCII 空白/标点、em dash、全角空格与 CJK 标点闭集后，剩下的才是"正文"。
# 为什么每个字符用独立 -e 而不是 `[。，、]` 字符组：C locale 下字符组按**字节**匹配，会连带剥掉恰好
# 共享字节的正常汉字（`突` = E7 AA 81 含 0x81，而 `、` = E3 80 81 也含 0x81）——逐序列替换是精确的
# UTF-8 序列匹配，不误伤正文。闭集见 .dev-team/wave-2-contract.md §D1。
reason_body_of() {
  printf '%s' "$1" | tr -d '[:space:][:punct:]' \
    | sed -e 's/—//g' -e 's/　//g' \
          -e 's/，//g' -e 's/。//g' -e 's/、//g' -e 's/；//g' -e 's/：//g' \
          -e 's/！//g' -e 's/？//g' -e 's/「//g' -e 's/」//g' -e 's/『//g' -e 's/』//g' \
          -e 's/（//g' -e 's/）//g' -e 's/【//g' -e 's/】//g' -e 's/《//g' -e 's/》//g' \
          -e 's/…//g' -e 's/～//g' -e 's/·//g' -e 's/﹁//g' -e 's/﹂//g' \
          -e 's/“//g' -e 's/”//g' -e 's/‘//g' -e 's/’//g'
}

# 围栏感知的标题探测（判据 1.8；判定真源 1.10 用同一实现）：只在**围栏外**认 `## ` 标题。
# 围栏口径（契约 §D2）：以「可选缩进 + ```」开头的行**切换**围栏态；未闭合围栏 → 其后全部视为围栏内
# （fail-closed：不认里面的标题）。返回 0 = 围栏外存在该标题。
heading_outside_fence() {
  awk -v pat="$2" '
    /^[[:space:]]*```/ { infence = !infence; next }
    infence { next }
    $0 ~ ("^" pat) { found = 1 }
    END { exit(found ? 0 : 1) }
  ' "$1" 2>/dev/null
}

# 读取当前成熟度级（缺 yaml 或缺 level 行视为 L0；把 "L2" 形式防御性归一为 2）
# 注意：level 行存在但值为空/畸形时**不默认归 0**——返回空串交由 verify_ladder 0.4 判 FAIL，
# 否则 "level: "（空值）会被宽放成假 L0 PASS（判据宽于 maturity-ladder 真源）。
read_level() {
  if [ -f "$META_YAML" ]; then
    if grep -q '^level:' "$META_YAML"; then
      local lv
      lv=$(sed -n 's/^level:[[:space:]]*//p' "$META_YAML" | head -n1 | tr -d '[:space:]"L')
      printf '%s' "$lv"
    else
      echo "0"
    fi
  else
    echo "0"
  fi
}

# 把 level 缓冲成 "L<n>" 显示（内部传整数；空/畸形值显式显示为非法，不伪装成 L0）
fmt_level() { case "$1" in ''|*[!0-9]*) printf 'L<非法:%s>' "${1:-空}" ;; *) printf 'L%s' "$1" ;; esac; }

# 是否空项目（无代码迹象：无常见 manifest / 无源码目录 / 无 .git 之外的文件）
looks_empty() {
  [ -d "$META_DIR" ] && return 1
  # 有任一常见 manifest 或源码树即视为"有代码"（比 depth-selector 的多栈计数更宽——
  # 这里只需判"有没有代码"，depth-selector 才判"有几种栈"）
  for f in package.json Cargo.toml go.mod pyproject.toml setup.py pom.xml build.gradle *.csproj; do
    [ -e "$f" ] && return 1
  done
  for d in src lib app packages crates; do
    [ -d "$d" ] && return 1
  done
  return 0
}


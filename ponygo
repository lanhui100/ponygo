# projection_body：求 constitution 的 canonical 投影体并写到 stdout（**字节保真，不做转义**）。
#   全文件含 TODO:（模板态）→ bootstrap_body()——不能只判截断后的 body，槽位在「## 常载命约」之前
#     （模板态不再拒绝投影，而是投影初始引导，见 revisions/accepted/2026-08-31-bootstrap-projection.md）
#   否则 <!-- sync-body --> 锚点之后（语言无关，EXTERNAL-001 P1-3）；无锚点回退中文
#     「## 常载命约」标题（兼容旧模板）。槽位表与头部 H1 均被跳过。
#   空体（仅空白）→ source 错误。
# 返回 0 = 有投影体；非 0 = source 错误。**本函数不 die**：status/audit 的 --json 路径必须能闭合，
# 错误分类交调用方（sync → die 给修法；2.6 → vl_fail 进 FAIL 清单）。
projection_body() {
  local const="${CONSTITUTION:-.meta/constitution/constitution.md}"
  [ -f "$const" ] || return 1
  local body=""
  if grep -q 'TODO:' "$const"; then
    body=$(bootstrap_body)
  elif grep -q '<!-- sync-body -->' "$const"; then
    body=$(awk 'BEGIN{ok=0} /<!-- sync-body -->/{ok=1; next} ok' "$const")
  else
    body=$(awk 'BEGIN{ok=0} /^## 常载命约/{ok=1} ok' "$const")
  fi
  [ -n "${body//[[:space:]]/}" ] || return 1
  printf '%s\n' "$body"
}

# canonical 块序列化（唯一格式）：BEGIN / <body> / END。块内正文的末尾空行只由本函数
# （= 投影体本身）决定——checker 不得单侧 trim/补空行（EOL 归一仅限比较时的 \r）。
canonical_block() { # <body>
  printf '%s\n%s\n%s\n' "$SYNC_BEGIN" "$1" "$SYNC_END"
}

# 整行哨兵判定（写入与校验共用）：inline marker（行内出现）不算，独占整行才算；
# 行尾 \r 归一——CRLF 文件不得被当成「无哨兵」（P2-4 已知缺陷的另一半）。
projection_marker_count() { # <file> <sentinel> → 整行匹配计数
  awk -v s="$2" '{ l=$0; sub(/\r$/, "", l) } l==s { n++ } END { print n+0 }' "$1"
}
projection_marker_line() { # <file> <sentinel> → 首个整行匹配的行号（0 = 无）
  awk -v s="$2" '{ l=$0; sub(/\r$/, "", l) } l==s { print NR; found=1; exit } END { if (!found) print 0 }' "$1"
}
projection_block_body() { # <file> <begin_ln> <end_ln> → 块内正文（\r 归一；不裁剪任何行）
  awk -v a="$2" -v b="$3" 'NR>a && NR<b { sub(/\r$/, ""); print }' "$1"
}

# projection_write <target> <body>：把 canonical 块写进 target（写入路径的唯一实现）。
#   · 无标记区：整块追加（文件末行无换行时先补一个 \n，避免把用户末行粘进 BEGIN）
#   · 恰一对合法标记区：只替换块内正文，块外用户字节逐行原样保留（顺序不变）
#   · 标记区结构损坏（缺 END / 重复 / 倒序）：不猜、不写，返回非零交调用方报「手工清理」

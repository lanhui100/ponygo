# ponygo 最小 .gitignore（栈无关）
# OS/编辑器噪声：
.DS_Store
Thumbs.db
*~

# 临时与过程副产物（工作区抗熵增）
.scratch/
.dev-team/
# 编码代理本地运行时（会话快照/日志，机器本地，不入仓）
.pony-agent/

# backlog 任务级租约（本地运行时，含 pid/会话/心跳；干净克隆不应有此目录）
backlog/.locks/

# 构建产物/依赖目录按栈补充，例如：
# target/         # Rust
# node_modules/   # Node
# __pycache__/    # Python

# backlog v3 当前工作区活动批次（本地运行时，不入仓）
backlog/.state/
